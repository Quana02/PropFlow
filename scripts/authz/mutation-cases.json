  { "method": "POST", "path": "/api/v1/complaints/{id:guid}/followups", "test": "Complaint_lifecycle_requires_owner_manager_and_assigned_staff_and_delivers_only_to_reporter", "feature": "FE-06", "resourceScope": "Phản ánh đang xem xét và STAFF đủ điều kiện", "effect": "Ghi đúng phân công. ACCOUNTANT không được chọn làm STAFF. Caller ngoài MANAGER không làm thay đổi snapshot." },
  { "method": "PUT", "path": "/api/v1/complaints/{id:guid}/followups/{followupId:guid}", "test": "Complaint_lifecycle_requires_owner_manager_and_assigned_staff_and_delivers_only_to_reporter", "feature": "FE-06", "resourceScope": "STAFF hiện hành được giao công việc trên đúng phản ánh", "effect": "Ghi đúng tiến độ, kết quả, assignee và actor. Chặn STAFF khác, sai parent, bearer đã thu hồi và cập nhật lặp." },
