  { "method": "PUT", "path": "/api/v1/manager/service-requests/{id:guid}/classification/review", "test": "Classification_review_requires_manager_current_suggestion_and_preserves_request_ownership", "feature": "FE-10", "resourceScope": "Manager, đề xuất mới nhất thuộc đúng yêu cầu và danh mục còn hiệu lực", "effect": "Giữ đề xuất gốc, ghi actor từ JWT và chỉ đổi danh mục chính thức. Sai phiếu hoặc danh mục bị chặn. Hai review khác quyết định chỉ giữ một bản ghi." },
  { "method": "POST", "path": "/api/v1/manager/service-requests/{id:guid}/recommendation", "test": "Recommendation_generation_and_review_require_manager_and_keep_advice_separate_from_business_state", "feature": "FE-11", "resourceScope": "Manager, yêu cầu hiện hữu còn ở trạng thái xử lý", "effect": "Đề xuất chỉ nhập bảng AI. Lệnh cạnh tranh bị chặn trong lúc gọi provider. Retry dùng lại kết quả, output thiếu trường giữ ưu tiên cũ." },
  { "method": "PUT", "path": "/api/v1/manager/service-requests/{id:guid}/recommendation/review", "test": "Recommendation_generation_and_review_require_manager_and_keep_advice_separate_from_business_state", "feature": "FE-11", "resourceScope": "Manager, đề xuất đúng yêu cầu và phiên bản hiện hành", "effect": "Ghi đúng người duyệt và giá trị chính thức. Chặn sai phiếu, đề xuất cũ, thiếu lý do và priority sai. STAFF được giao chỉ nhận phương án đã duyệt." },
  { "method": "POST", "path": "/api/v1/knowledge/documents", "test": "Knowledge_mutations_require_admin_or_manager_and_keep_drafts_tokens_and_audiences_isolated", "feature": "FE-12", "resourceScope": "ADMIN hoặc MANAGER có quyền quản lý tài liệu chung cư", "effect": "Tạo bản nháp v1 và lịch sử đúng actor. STAFF không đọc được bản nháp. Không tin creator, revision hay trạng thái do payload chèn." },
  { "method": "PUT", "path": "/api/v1/knowledge/documents/{id:guid}", "test": "Knowledge_mutations_require_admin_or_manager_and_keep_drafts_tokens_and_audiences_isolated", "feature": "FE-12", "resourceScope": "ADMIN hoặc MANAGER, đúng token tài liệu", "effect": "Hai lượt sửa đồng thời chỉ tạo một revision. Giữ bản và audience đã xuất bản khi bản nháp thay đổi." },
  { "method": "POST", "path": "/api/v1/knowledge/documents/{id:guid}/publication", "test": "Knowledge_mutations_require_admin_or_manager_and_keep_drafts_tokens_and_audiences_isolated", "feature": "FE-12", "resourceScope": "ADMIN hoặc MANAGER, token thuộc tài liệu và bản mới nhất đã lưu", "effect": "Xuất bản theo token. Cạnh tranh và replay token cũ bị chặn, STAFF nhận đúng bản đã xuất bản." },
  { "method": "POST", "path": "/api/v1/knowledge/documents/{id:guid}/unpublish", "test": "Knowledge_mutations_require_admin_or_manager_and_keep_drafts_tokens_and_audiences_isolated", "feature": "FE-12", "resourceScope": "ADMIN hoặc MANAGER, token đúng tài liệu đang xuất bản", "effect": "Thu hồi bản công bố một lần khi cạnh tranh. Giữ lịch sử và chặn STAFF đọc lại bằng ID cũ." },
  { "method": "POST", "path": "/api/v1/resident/chatbot/ask", "test": "Resident_chat_requires_current_residency_and_only_sends_published_resident_knowledge", "feature": "FE-12", "resourceScope": "RESIDENT có cư trú hiện hành, nguồn RESIDENT đang xuất bản", "effect": "Chặn user ngoài scope trước Gemini. Chỉ gửi nguồn hiện hành; fallback timeout và citation giả giữ nguồn hợp lệ; thu hồi trong lúc chạy bỏ kết quả cũ." }
