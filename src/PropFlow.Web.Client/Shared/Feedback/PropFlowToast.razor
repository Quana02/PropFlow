@implements IAsyncDisposable
@inject IJSRuntime JS

<aside id="@toastId" @ref="toast" popover="manual" class="pf-toast pf-toast--@Kind @(closing ? "pf-toast--leaving" : "")"
       role="@(Kind == "error" ? "alert" : "status")" aria-live="@(Kind == "error" ? "assertive" : "polite")" aria-atomic="true">
    <span class="pf-toast-icon material-symbols-outlined" aria-hidden="true">@Icon</span>
    <div class="pf-toast-copy">
        @if (!string.IsNullOrWhiteSpace(Title)) { <strong>@Title</strong> }
        @if (!string.IsNullOrWhiteSpace(Message)) { <p>@Message</p> }
    </div>
    <button type="button" title="Đóng thông báo" aria-label="Đóng thông báo" @onclick="DismissAsync"><span aria-hidden="true">×</span></button>
    @if (DurationMs > 0) { <span class="pf-toast-progress" style="--toast-duration: @(DurationMs)ms" aria-hidden="true"></span> }
</aside>

@code {
    [Parameter, EditorRequired] public string Message { get; set; } = "";
    [Parameter] public string? Title { get; set; }
    [Parameter] public string Severity { get; set; } = "info";
    [Parameter] public int DurationMs { get; set; } = 3000;
    [Parameter] public EventCallback OnDismiss { get; set; }
    private readonly CancellationTokenSource lifetime = new();
    private readonly CancellationTokenSource timer = new();
    private readonly string toastId = "pf-toast-" + Guid.NewGuid().ToString("N");
    private ElementReference toast;
    private IJSObjectReference? module;
    private bool disposed, closing;
    private string Kind => Severity.ToLowerInvariant();
    private string Icon => Kind switch { "success" => "check_circle", "error" => "error", "warning" => "warning", _ => "info" };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || disposed) return;
        try
        {
            var imported = await JS.InvokeAsync<IJSObjectReference>("import", "./Shared/Feedback/PropFlowToast.razor.js?v=20261108.4");
            if (disposed) { await imported.DisposeAsync(); return; }
            module = imported;
            await module.InvokeVoidAsync("show", toast, toastId);
            if (!disposed && DurationMs > 0) _ = DismissLaterAsync(timer.Token);
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) when (disposed) { }
    }
    private async Task DismissLaterAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(DurationMs, cancellationToken);
            if (!disposed) await InvokeAsync(DismissAsync);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }
    private async Task DismissAsync()
    {
        if (disposed || closing) return;
        closing = true;
        timer.Cancel();
        StateHasChanged();
        try
        {
            await Task.Delay(180, lifetime.Token);
            if (disposed) return;
            if (module is not null) await module.InvokeVoidAsync("hide", toastId);
            if (!disposed) await OnDismiss.InvokeAsync();
        }
        catch (OperationCanceledException) when (disposed) { }
        catch (JSDisconnectedException) { }
    }
    public async ValueTask DisposeAsync()
    {
        if (disposed) return;
        disposed = true;
        timer.Cancel(); lifetime.Cancel();
        if (module is not null)
        {
            try { await module.InvokeVoidAsync("hide", toastId); await module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        timer.Dispose(); lifetime.Dispose();
    }
}
