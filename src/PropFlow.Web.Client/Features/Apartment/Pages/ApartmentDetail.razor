@page "/apartments/{Id:guid}"
@layout PropFlow.Web.Client.Layout.MainLayout
@attribute [Authorize(Roles="MANAGER,STAFF,ACCOUNTANT")]
@using PropFlow.Web.Client.Features.Apartment.Models
@using PropFlow.Web.Client.Features.Apartment.Services
@using PropFlow.Web.Client.Shared.Forms
@using PropFlow.Web.Client.Shared.Feedback
@inject IApartmentApiClient Apartments
@inject PropFlow.Web.Client.Services.Authentication.AuthSession Session
@inject NavigationManager Navigation
<PageTitle>Chi tiết căn hộ - PropFlow</PageTitle>

<div class="apartment-page detail-page">
 <button class="back-link" @onclick="Back"><span class="material-symbols-outlined">arrow_back</span>Danh sách căn hộ</button>
 @if(!string.IsNullOrWhiteSpace(message)){<p class="notice" role="alert">@message</p>}
 @if(loading){<div class="detail-loading">Đang tải thông tin căn hộ…</div>}
 else if(apartment is null){<div class="detail-empty"><span class="material-symbols-outlined">search_off</span><h1>Không tìm thấy căn hộ</h1><button @onclick="Back">Quay lại danh sách</button></div>}
 else {<section class="detail-hero"><div class="detail-identity"><span class="hero-icon material-symbols-outlined">apartment</span><div><span class="eyebrow">APARTMENT PROFILE</span><h1>Căn hộ @apartment.UnitNumber</h1><p>Tầng @apartment.FloorNumber · @apartment.UnitType</p></div></div><div class="hero-actions"><span class="status-chip @(IsActive?"active":"inactive")">@(IsActive?"Đang quản lý":"Ngừng quản lý")</span>@if(CanManage){<button class="secondary-action" @onclick="OpenEdit"><span class="material-symbols-outlined">edit</span>Chỉnh sửa</button><button class="more-action" @onclick="ToggleActions"><span class="material-symbols-outlined">more_horiz</span></button>@if(showActions){<div class="action-menu"><button title="@(IsActive?"Thêm chủ sở hữu":"Không thể thêm chủ sở hữu cho căn hộ đang ngừng quản lý.")" disabled="@(!IsActive)" @onclick="OpenOwnerDialog"><span class="material-symbols-outlined">person_add</span>Thêm chủ sở hữu</button><button @onclick="OpenHistory"><span class="material-symbols-outlined">history</span>Lịch sử sở hữu</button><button class="danger" title="@StatusActionTitle" @onclick="OpenStatusDialog"><span class="material-symbols-outlined">@(IsActive?"pause_circle":"play_circle")</span>@(IsActive?"Ngừng quản lý":"Kích hoạt lại")</button></div>}}else{<button class="secondary-action" @onclick="OpenHistory"><span class="material-symbols-outlined">history</span>Lịch sử sở hữu</button>}</div></section>
 <div class="detail-layout"><div class="main-stack"><section class="detail-card"><header><div><span class="section-kicker">MASTER DATA</span><h2>Thông tin căn hộ</h2></div></header><dl class="definition-grid"><div><dt>Mã căn hộ</dt><dd>@apartment.UnitNumber</dd></div><div><dt>Tầng</dt><dd>@apartment.FloorNumber</dd></div><div><dt>Loại căn hộ</dt><dd>@apartment.UnitType</dd></div><div><dt>Diện tích sử dụng</dt><dd>@apartment.UsableAreaM2.ToString("0.##") m²</dd></div><div><dt>Phòng ngủ</dt><dd>@(apartment.BedroomCount?.ToString()??"Chưa cập nhật")</dd></div><div><dt>Phòng tắm</dt><dd>@(apartment.BathroomCount?.ToString()??"Chưa cập nhật")</dd></div><div><dt>Ngày bàn giao</dt><dd>@DateText(apartment.HandoverDate)</dd></div></dl><div class="description"><span>Mô tả</span><p>@(string.IsNullOrWhiteSpace(apartment.Description)?"Chưa có mô tả":apartment.Description)</p></div></section>
 <section class="detail-card occupancy-card"><header><div><span class="section-kicker">RESIDENCY HISTORY</span><h2>Lịch sử cư trú (@ResidencyTimeline.Count)</h2></div></header>@if(ResidencyTimeline.Count==0){<div class="compact-empty"><span class="material-symbols-outlined">history</span><div><strong>Chưa có lịch sử cư trú</strong><p>Chưa ghi nhận cư dân tại căn hộ này.</p></div></div>}else{<div class="owner-list">@foreach(var resident in ResidencyTimeline){<div class="person-row"><span class="avatar">@Initials(resident.FullName)</span><div><strong>@resident.FullName</strong><span>@resident.ResidentCode · @resident.ResidencyType · @resident.HouseholdRole</span><span>@DateText(resident.StartDate) – @(resident.EndDate is null?"Hiện tại":DateText(resident.EndDate)) · @resident.Status</span></div></div>}</div>}</section></div><aside class="side-stack"><section class="detail-card owner-card"><header><div><span class="section-kicker">OWNERSHIP</span><h2>Chủ sở hữu (@apartment.Owners.Count)</h2></div>@if(CanManage){<button class="text-action" title="@(IsActive?"Thêm chủ sở hữu":"Không thể thêm chủ sở hữu cho căn hộ đang ngừng quản lý.")" disabled="@(!IsActive)" @onclick="OpenOwnerDialog">Thêm chủ sở hữu</button>}</header>@if(apartment.Owners.Count==0){<div class="compact-empty"><span class="material-symbols-outlined">person_off</span><div><strong>Chưa xác định chủ sở hữu</strong><p>Căn hộ chưa được gán chủ sở hữu.</p></div></div>}else{<div class="owner-list">@foreach(var owner in apartment.Owners){<div class="person-row"><span class="avatar">@Initials(owner.Owner?.FullName??"?")</span><div><strong>@(owner.Owner?.FullName??"Cư dân không còn khả dụng")</strong><span>@(owner.Owner?.ResidentCode??owner.ResidentId.ToString()) · từ @DateText(owner.StartDate)</span></div>@if(CanManage){<button class="end-owner" title="Kết thúc quyền sở hữu" @onclick="()=>OpenEndOwnership(owner)"><span class="material-symbols-outlined">person_remove</span></button>}</div>}</div>}<button class="history-link" @onclick="OpenHistory"><span class="material-symbols-outlined">history</span>Xem lịch sử sở hữu</button></section>
 <section class="detail-card occupancy-card"><header><div><span class="section-kicker">OCCUPANCY</span><h2>Cư dân đang cư trú (@apartment.CurrentResidents.Count)</h2></div></header><div class="occupancy-summary @(apartment.CurrentResidents.Count>0?"occupied":"vacant")"><span class="material-symbols-outlined">@(apartment.CurrentResidents.Count>0?"groups":"meeting_room")</span><div><strong>@(apartment.CurrentResidents.Count>0?"Có cư dân":"Trống")</strong><p>@apartment.CurrentResidents.Count cư dân đang cư trú</p></div></div>@if(apartment.CurrentResidents.Count>0){<div class="owner-list">@foreach(var resident in apartment.CurrentResidents){<div class="person-row"><span class="avatar">@Initials(resident.FullName)</span><div><strong>@resident.FullName</strong><span>@resident.ResidentCode · @resident.ResidencyType · @resident.HouseholdRole</span><span>Từ @DateText(resident.StartDate)@(resident.HouseholdHeadFullName is null?"":$" · Chủ hộ: {resident.HouseholdHeadFullName}")</span></div></div>}</div>}<p class="occupancy-help">Suy diễn từ quan hệ ResidentApartment đang hiệu lực, độc lập với ownership.</p></section>
 </aside></div>}
</div>

@if(editing && apartment is not null){<div class="apartment-overlay" @onclick="CloseEdit"><section class="apartment-dialog edit-dialog" @onclick:stopPropagation="true"><header><div class="dialog-title"><span class="material-symbols-outlined">edit</span><div><h2>Chỉnh sửa căn hộ</h2><p>Cập nhật thông tin căn hộ</p></div></div><button @onclick="CloseEdit">×</button></header><div class="dialog-body"><div class="edit-form"><label>Mã căn hộ <em>*</em><input @bind="editForm.UnitNumber" /></label><label>Tầng <em>*</em><input type="number" @bind="editForm.FloorNumber" /></label><label>Loại căn hộ <em>*</em><PropFlowSelect Options="ApartmentTypeOptions" Value="@(editForm.ApartmentUnitTypeId?.ToString()??string.Empty)" ValueChanged="SetEditUnitType" Placeholder="Chọn loại căn hộ" AriaLabel="Loại căn hộ" /></label><label>Diện tích sử dụng (m²) <em>*</em><input type="number" step="0.01" @bind="editForm.UsableAreaM2" /></label><label>Số phòng ngủ<input type="number" @bind="editForm.BedroomCount" /></label><label>Số phòng tắm<input type="number" @bind="editForm.BathroomCount" /></label><label>Ngày bàn giao<PropFlowDatePicker @bind-Value="editForm.HandoverDate" ValidityChanged="v=>handoverDateValid=v" AriaLabel="Ngày bàn giao" /></label><label class="wide">Mô tả<textarea @bind="editForm.Description"></textarea></label></div>@if(editErrors.Count>0){<div class="edit-errors">@foreach(var e in editErrors){<p>@e</p>}</div>}</div><footer><button class="dialog-cancel" @onclick="CloseEdit">Hủy</button><button class="dialog-save" disabled="@(savingEdit||!handoverDateValid)" @onclick="SaveEdit">@(savingEdit?"Đang lưu…":"Lưu thay đổi")</button></footer></section></div>}
@if(changingOwner){<div class="apartment-overlay" @onclick="CloseOwnerDialog"><section class="apartment-dialog owner-dialog" @onclick:stopPropagation="true"><header><div class="dialog-title"><span class="material-symbols-outlined">person_add</span><div><h2>Thêm chủ sở hữu</h2><p>Có thể gán nhiều chủ sở hữu cho căn hộ</p></div></div><button @onclick="CloseOwnerDialog">×</button></header><div class="dialog-body"><div class="owner-context"><span>Chủ sở hữu hiện tại</span><strong>@OwnerNames()</strong></div>@if(ownerCandidatesLoading){<div class="dialog-state">Đang tải danh sách cư dân…</div>}else if(!string.IsNullOrWhiteSpace(ownerCandidatesError)){<div class="dialog-state error"><strong>@ownerCandidatesError</strong><button class="retry" @onclick="LoadOwnerCandidates">Thử lại</button></div>}else if(ownerCandidates.Count==0){<div class="dialog-state"><strong>Không còn cư dân phù hợp</strong></div>}else{<label>Chủ sở hữu mới <em>*</em><PropFlowSelect Options="OwnerOptions" Value="@newOwnerId" ValueChanged="SelectOwner" Placeholder="Chọn cư dân" AriaLabel="Chủ sở hữu mới" /></label>}</div><footer><button class="dialog-cancel" @onclick="CloseOwnerDialog">Hủy</button><button class="dialog-save" disabled="@(savingOwner||ownerCandidatesLoading||ownerCandidates.Count==0)" @onclick="AddOwner">@(savingOwner?"Đang lưu…":"Thêm chủ sở hữu")</button></footer></section></div>}
@if(endingOwnership is not null){<div class="apartment-overlay" @onclick="CloseEndOwnership"><section class="apartment-dialog confirm-dialog" @onclick:stopPropagation="true"><header><div class="dialog-title"><span class="material-symbols-outlined">person_remove</span><div><h2>Kết thúc quyền sở hữu?</h2><p>@(endingOwnership.Owner?.FullName??endingOwnership.ResidentId.ToString())</p></div></div><button @onclick="CloseEndOwnership">×</button></header><div class="dialog-body"><p class="confirmation-text">Chỉ quyền sở hữu này kết thúc. Chủ sở hữu khác và quan hệ cư trú không bị ảnh hưởng.</p></div><footer><button class="dialog-cancel" @onclick="CloseEndOwnership">Hủy</button><button class="dialog-save danger-save" disabled="@savingEndOwnership" @onclick="EndOwnership">@(savingEndOwnership?"Đang cập nhật…":"Kết thúc quyền sở hữu")</button></footer></section></div>}
@if(showHistory){<div class="apartment-overlay" @onclick="CloseHistory"><section class="apartment-dialog history-dialog" @onclick:stopPropagation="true"><header><div class="dialog-title"><span class="material-symbols-outlined">history</span><div><h2>Lịch sử sở hữu</h2><p>Các giai đoạn của các chủ sở hữu có thể chồng lấp</p></div></div><button @onclick="CloseHistory">×</button></header><div class="dialog-body">@if(historyLoading){<div class="dialog-state">Đang tải lịch sử sở hữu…</div>}else if(!string.IsNullOrWhiteSpace(historyError)){<div class="dialog-state error"><strong>@historyError</strong><button class="retry" @onclick="LoadHistory">Thử lại</button></div>}else if(ownershipHistory.Count==0){<div class="dialog-state"><strong>Chưa có lịch sử sở hữu</strong><button class="retry" @onclick="OpenOwnerFromHistory">Thêm chủ sở hữu</button></div>}else{<div class="ownership-timeline">@foreach(var item in ownershipHistory){<article><i></i><div><strong>@(item.Owner?.FullName??"Cư dân không còn khả dụng")</strong><span>@(item.Owner?.ResidentCode??item.OwnerResidentId.ToString())</span><p>@DateText(item.StartDate) – @(item.EndDate is null?"Hiện tại":DateText(item.EndDate)) @if(item.EndDate is null){<b>Đang hiệu lực</b>}</p></div></article>}</div>}</div><footer><button class="dialog-cancel" @onclick="CloseHistory">Đóng</button></footer></section></div>}
@if(showStatusDialog && apartment is not null){<PropFlowConfirmationDialog @key="statusDialogVersion" Title="@StatusDialogTitle" Message="@StatusDialogMessage" ConfirmText="@(statusBlocked?"Đã hiểu":IsActive?"Ngừng quản lý":"Kích hoạt lại")" BusyText="Đang cập nhật…" Busy="@changingStatus" InformationOnly="@statusBlocked" Destructive="@IsActive" OnConfirm="ChangeStatus" OnCancel="CloseStatusDialog" />}
@if(!string.IsNullOrWhiteSpace(toastMessage)){<PropFlowToast @key="toastVersion" Message="@toastMessage" Severity="success" DurationMs="3000" OnDismiss="DismissToast" />}

@code {
 [Parameter] public Guid Id {get;set;} private ApartmentResponse? apartment; private bool loading=true,editing,savingEdit,changingOwner,savingOwner,showActions,showHistory,historyLoading,showStatusDialog,ownerCandidatesLoading,savingEndOwnership,handoverDateValid=true,statusBlocked,changingStatus; private string? message,newOwnerId,ownerCandidatesError,historyError,statusDialogMessage,toastMessage; private int statusDialogVersion,toastVersion; private ApartmentOwnerItem? endingOwnership; private ApartmentEditState editForm=new(); private List<string> editErrors=[]; private IReadOnlyList<ResidentLookupItem> ownerCandidates=[]; private IReadOnlyList<ApartmentOwnershipHistoryItem> ownershipHistory=[]; private IReadOnlyList<ApartmentUnitTypeResponse> apartmentTypes=[]; private bool IsActive=>apartment?.Status=="ACTIVE"; private string StatusActionTitle=>IsActive?"Ngừng quản lý":"Kích hoạt lại"; private string StatusDialogTitle=>statusBlocked?ApartmentStatusActionUx.BlockerTitle:IsActive?"Ngừng quản lý căn hộ?":"Kích hoạt lại căn hộ?"; private string StatusDialogMessage=>statusDialogMessage??string.Empty; private bool CanManage=>string.Equals(Session.User?.Role,"MANAGER",StringComparison.OrdinalIgnoreCase); private IReadOnlyList<PropFlowSelectOption> OwnerOptions=>ownerCandidates.Select(x=>new PropFlowSelectOption(x.ResidentId.ToString(),$"{x.ResidentCode} – {x.FullName}")).ToArray(); private IReadOnlyList<PropFlowSelectOption> ApartmentTypeOptions=>apartmentTypes.Select(x=>new PropFlowSelectOption(x.Id.ToString(),x.Name)).ToArray();
 private IReadOnlyList<ResidentAssociationItem> ResidencyTimeline=>apartment is null?[]:apartment.CurrentResidents.Concat(apartment.ResidentHistory).GroupBy(x=>x.ResidencyId).Select(x=>x.First()).OrderByDescending(x=>x.StartDate).ToArray();
 protected override Task OnParametersSetAsync()=>Reload(); private async Task Reload(){loading=true;message=null;var r=await Apartments.GetAsync(Id);apartment=r.IsSuccess?r.Data:null;if(!r.IsSuccess)message=r.Message;loading=false;} private void ToggleActions()=>showActions=!showActions; private async Task OpenOwnerDialog(){if(!IsActive)return;showActions=false;newOwnerId=null;changingOwner=true;await LoadOwnerCandidates();} private async Task LoadOwnerCandidates(){ownerCandidatesLoading=true;ownerCandidatesError=null;var r=await Apartments.OwnerCandidatesAsync(Id,null);ownerCandidates=r.Data??[];if(!r.IsSuccess)ownerCandidatesError=r.Message??"Không thể tải danh sách cư dân.";ownerCandidatesLoading=false;} private void CloseOwnerDialog(){changingOwner=false;savingOwner=false;newOwnerId=null;ownerCandidates=[];ownerCandidatesError=null;} private Task SelectOwner(string v){newOwnerId=v;return Task.CompletedTask;} private async Task AddOwner(){if(!Guid.TryParse(newOwnerId,out var residentId)){message="Vui lòng chọn chủ sở hữu.";return;}savingOwner=true;var r=await Apartments.AddOwnerAsync(Id,new(){OwnerResidentId=residentId});savingOwner=false;if(!r.IsSuccess){message=r.Message??"Không thể thêm chủ sở hữu.";return;}CloseOwnerDialog();await Reload();}
 private void OpenEndOwnership(ApartmentOwnerItem owner)=>endingOwnership=owner; private void CloseEndOwnership(){endingOwnership=null;savingEndOwnership=false;} private async Task EndOwnership(){if(endingOwnership is null)return;savingEndOwnership=true;var r=await Apartments.EndOwnershipAsync(Id,endingOwnership.OwnershipId,new());savingEndOwnership=false;if(!r.IsSuccess){message=r.Message??"Không thể kết thúc quyền sở hữu.";CloseEndOwnership();return;}CloseEndOwnership();await Reload();} private async Task OpenHistory(){showActions=false;showHistory=true;await LoadHistory();} private async Task LoadHistory(){historyLoading=true;historyError=null;var r=await Apartments.OwnershipHistoryAsync(Id);ownershipHistory=r.Data??[];if(!r.IsSuccess)historyError=r.Message??"Không thể tải lịch sử sở hữu.";historyLoading=false;} private void CloseHistory(){showHistory=false;historyError=null;ownershipHistory=[];} private async Task OpenOwnerFromHistory(){CloseHistory();await OpenOwnerDialog();}
 private void OpenStatusDialog(){if(apartment is null)return;showActions=false;statusDialogMessage=IsActive?ApartmentStatusActionUx.BlockerMessage(apartment.Owners.Count>0,apartment.CurrentResidents.Count>0):$"Bạn có chắc muốn kích hoạt lại căn hộ “{apartment.UnitNumber}” không?";statusBlocked=IsActive&&statusDialogMessage is not null;if(IsActive&&!statusBlocked)statusDialogMessage=$"Bạn có chắc muốn ngừng quản lý căn hộ “{apartment.UnitNumber}” không?";statusDialogVersion++;showStatusDialog=true;} private void CloseStatusDialog(){if(changingStatus)return;showStatusDialog=false;statusBlocked=false;statusDialogMessage=null;} private async Task ChangeStatus(){if(apartment is null||statusBlocked)return;var wasActive=IsActive;var unitNumber=apartment.UnitNumber;changingStatus=true;var r=await Apartments.SetStatusAsync(Id,wasActive?"INACTIVE":"ACTIVE");changingStatus=false;if(!r.IsSuccess){if(wasActive&&ApartmentStatusActionUx.TryMapConflict(r.Code,out var blocker)){statusBlocked=true;statusDialogMessage=blocker;statusDialogVersion++;return;}CloseStatusDialog();message=r.Message??"Không thể cập nhật trạng thái.";return;}CloseStatusDialog();await Reload();toastMessage=wasActive?$"Đã ngừng quản lý căn hộ {unitNumber}.":$"Đã kích hoạt lại căn hộ {unitNumber}.";toastVersion++;} private void DismissToast()=>toastMessage=null; private async Task OpenEdit(){if(apartment is null)return;editErrors=[];var types=await Apartments.UnitTypesAsync();if(!types.IsSuccess||types.Data is null){message=types.Message??"Không thể tải loại căn hộ.";return;}apartmentTypes=types.Data;editForm=new(){UnitNumber=apartment.UnitNumber,FloorNumber=apartment.FloorNumber,ApartmentUnitTypeId=apartment.ApartmentUnitTypeId,UsableAreaM2=apartment.UsableAreaM2,BedroomCount=apartment.BedroomCount,BathroomCount=apartment.BathroomCount,HandoverDate=apartment.HandoverDate,Description=apartment.Description};editing=true;} private Task SetEditUnitType(string value){editForm.ApartmentUnitTypeId=Guid.TryParse(value,out var id)?id:null;return Task.CompletedTask;} private void CloseEdit(){editing=false;savingEdit=false;editErrors=[];} private async Task SaveEdit(){editErrors=ValidateEdit();if(editErrors.Count>0)return;savingEdit=true;var r=await Apartments.UpdateAsync(Id,new UpdateApartmentRequest{UnitNumber=editForm.UnitNumber.Trim(),FloorNumber=editForm.FloorNumber!.Value,ApartmentUnitTypeId=editForm.ApartmentUnitTypeId!.Value,UsableAreaM2=editForm.UsableAreaM2!.Value,BedroomCount=editForm.BedroomCount,BathroomCount=editForm.BathroomCount,HandoverDate=editForm.HandoverDate,Description=editForm.Description});savingEdit=false;if(!r.IsSuccess){editErrors=[r.Message??"Không thể lưu thay đổi."];return;}CloseEdit();await Reload();}
 private List<string> ValidateEdit(){var e=new List<string>();if(string.IsNullOrWhiteSpace(editForm.UnitNumber))e.Add("Vui lòng nhập mã căn hộ.");if(!editForm.FloorNumber.HasValue||editForm.FloorNumber<0)e.Add("Tầng phải lớn hơn hoặc bằng 0.");if(!editForm.ApartmentUnitTypeId.HasValue)e.Add("Vui lòng chọn loại căn hộ.");if(!editForm.UsableAreaM2.HasValue||editForm.UsableAreaM2<=0)e.Add("Diện tích sử dụng phải lớn hơn 0.");return e;} private string OwnerNames()=>apartment is null||apartment.Owners.Count==0?"Chưa có":string.Join(", ",apartment.Owners.Select(x=>x.Owner?.FullName??"Không xác định")); private void Back()=>Navigation.NavigateTo("/apartments"); private static string DateText(DateOnly? d)=>d?.ToString("dd/MM/yyyy")??"Chưa cập nhật"; private static string Initials(string n)=>string.Concat(n.Split(' ',StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(x=>char.ToUpperInvariant(x[0]))); private sealed class ApartmentEditState{public string UnitNumber{get;set;}="";public int? FloorNumber{get;set;}public Guid? ApartmentUnitTypeId{get;set;}public decimal? UsableAreaM2{get;set;}public int? BedroomCount{get;set;}public int? BathroomCount{get;set;}public DateOnly? HandoverDate{get;set;}public string? Description{get;set;}}
}
