 private List<string> ValidateEdit(){var e=new List<string>();if(maximumFloor is null)e.Add("Không tải được số tầng chung cư. Vui lòng mở lại biểu mẫu.");else if(editForm.FloorNumber>maximumFloor)e.Add($"Tầng căn hộ không được vượt quá {maximumFloor} tầng của chung cư.");if(string.IsNullOrWhiteSpace(editForm.UnitNumber))e.Add("Vui lòng nhập mã căn hộ.");if(!editForm.FloorNumber.HasValue||editForm.FloorNumber<0)e.Add("Tầng phải lớn hơn hoặc bằng 0.");if(!editForm.ApartmentUnitTypeId.HasValue)e.Add("Vui lòng chọn loại căn hộ.");if(editForm.UsableAreaM2 is null or <25)e.Add("Diện tích sử dụng phải từ 25 m² trở lên.");else if(editForm.UsableAreaM2>99999999.99m||decimal.Round(editForm.UsableAreaM2.Value,2)!=editForm.UsableAreaM2)e.Add("Diện tích không hợp lệ hoặc có quá 2 chữ số thập phân.");return e;} private string OwnerNames()=>apartment is null||apartment.Owners.Count==0?"Chưa có":string.Join(", ",apartment.Owners.Select(x=>x.Owner?.FullName??"Không xác định")); private void Back()=>Navigation.NavigateTo("/apartments"); private static string DateText(DateOnly? d)=>d?.ToString("dd/MM/yyyy")??"Chưa cập nhật"; private static string Initials(string n)=>string.Concat(n.Split(' ',StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(x=>char.ToUpperInvariant(x[0]))); private sealed class ApartmentEditState{public string UnitNumber{get;set;}="";public int? FloorNumber{get;set;}public Guid? ApartmentUnitTypeId{get;set;}public decimal? UsableAreaM2{get;set;}public int? BedroomCount{get;set;}public int? BathroomCount{get;set;}public DateOnly? HandoverDate{get;set;}public string? Description{get;set;}}
