@implements IDisposable
@inject PropFlow.Web.Client.Shared.Feedback.ToastService Toasts
@page "/apartments/{Id:guid}"
@layout PropFlow.Web.Client.Layout.MainLayout
@attribute [Authorize(Roles="MANAGER,STAFF,ACCOUNTANT")]
@using PropFlow.Web.Client.Features.Apartment.Models
@using PropFlow.Web.Client.Features.Apartment.Services
@using PropFlow.Web.Client.Shared.Forms
@using PropFlow.Web.Client.Shared.Feedback
@inject IApartmentApiClient Apartments
@inject PropFlow.Web.Client.Features.Facility.Services.IBuildingApiClient BuildingApi
@inject PropFlow.Web.Client.Services.Authentication.AuthSession Session
@inject NavigationManager Navigation
<PageTitle>Chi tiết căn hộ - PropFlow</PageTitle>

<div class="apartment-page detail-page">
 <button class="back-link" @onclick="Back"><span class="material-symbols-outlined">arrow_back</span>Danh sách căn hộ</button>
 @if(!string.IsNullOrWhiteSpace(message)){<p class="notice" role="alert">@message</p>}
 @if(loading){<div class="detail-loading">Đang tải thông tin căn hộ…</div>}
 else if(apartment is null){<div class="detail-empty"><span class="material-symbols-outlined">search_off</span><h1>Không tìm thấy căn hộ</h1><button @onclick="Back">Quay lại danh sách</button></div>}
 else {<section class="detail-hero pf-management-header pf-management-existing-header"><div class="detail-identity"><span class="hero-icon material-symbols-outlined">apartment</span><div><span class="eyebrow">APARTMENT PROFILE</span><h1>Căn hộ @apartment.UnitNumber</h1><p>Tầng @apartment.FloorNumber · @apartment.UnitType</p></div></div><div class="hero-actions"><span class="status-chip @(IsActive?"active":"inactive")">@(IsActive?"Đang quản lý":"Ngừng quản lý")</span>@if(CanManage){<button class="secondary-action" @onclick="OpenEdit"><span class="material-symbols-outlined">edit</span>Chỉnh sửa</button><button class="more-action" @onclick="ToggleActions"><span class="material-symbols-outlined">more_horiz</span></button>@if(showActions){<div class="action-menu"><button title="@(IsActive?"Thêm chủ sở hữu":"Không thể thêm chủ sở hữu cho căn hộ đang ngừng quản lý.")" disabled="@(!IsActive)" @onclick="OpenOwnerDialog"><span class="material-symbols-outlined">person_add</span>Thêm chủ sở hữu</button><button @onclick="OpenHistory"><span class="material-symbols-outlined">history</span>Lịch sử sở hữu</button><button class="danger" title="@StatusActionTitle" @onclick="OpenStatusDialog"><span class="material-symbols-outlined">@(IsActive?"pause_circle":"play_circle")</span>@(IsActive?"Ngừng quản lý":"Kích hoạt lại")</button></div>}}else{<button class="secondary-action" @onclick="OpenHistory"><span class="material-symbols-outlined">history</span>Lịch sử sở hữu</button>}</div></section>
 <div class="detail-layout"><div class="main-stack"><section class="detail-card"><header><div><span class="section-kicker">MASTER DATA</span><h2>Thông tin căn hộ</h2></div></header><dl class="definition-grid"><div><dt>Mã căn hộ</dt><dd>@apartment.UnitNumber</dd></div><div><dt>Tầng</dt><dd>@apartment.FloorNumber</dd></div><div><dt>Loại căn hộ</dt><dd>@apartment.UnitType</dd></div><div><dt>Diện tích sử dụng</dt><dd>@apartment.UsableAreaM2.ToString("0.##") m²</dd></div><div><dt>Phòng ngủ</dt><dd>@(apartment.BedroomCount?.ToString()??"Chưa cập nhật")</dd></div><div><dt>Phòng tắm</dt><dd>@(apartment.BathroomCount?.ToString()??"Chưa cập nhật")</dd></div><div><dt>Ngày bàn giao</dt><dd>@DateText(apartment.HandoverDate)</dd></div></dl><div class="description"><span>Mô tả</span><p>@(string.IsNullOrWhiteSpace(apartment.Description)?"Chưa có mô tả":apartment.Description)</p></div></section>
 <section class="detail-card occupancy-card"><header><div><span class="section-kicker">RESIDENCY HISTORY</span><h2>Lịch sử cư trú (@ResidencyTimeline.Count)</h2></div></header>@if(ResidencyTimeline.Count==0){<div class="compact-empty"><span class="material-symbols-outlined">history</span><div><strong>Chưa có lịch sử cư trú</strong><p>Chưa ghi nhận cư dân tại căn hộ này.</p></div></div>}else{<div class="owner-list">@foreach(var resident in ResidencyTimeline){<div class="person-row"><span class="avatar">@Initials(resident.FullName)</span><div><strong><a href="@($"/residents/{resident.ResidentId}")">@resident.FullName</a></strong><span>@resident.ResidentCode · @ResidencyTypeLabel(resident.ResidencyType) · @RoleLabel(resident.HouseholdRole)</span><span>Từ ngày: @DateText(resident.StartDate)</span><span>Đến ngày: @(resident.EndDate is null?"Chưa ghi nhận kết thúc":DateText(resident.EndDate))</span><span>@ResidencyStateLabel(resident)</span></div></div>}</div>}</section>
 <section class="detail-card ownership-history-card">
  <header><div><span class="section-kicker">LỊCH SỬ SỞ HỮU</span><h2>Lịch sử sở hữu (@apartment.OwnershipHistory.Count)</h2></div></header>
  @if(apartment.OwnershipHistory.Count==0){<div class="compact-empty"><strong>Chưa ghi nhận lịch sử sở hữu</strong></div>}
  else{<div class="relationship-table-wrap" tabindex="0" role="region" aria-label="Lịch sử sở hữu căn hộ"><table class="relationship-table"><thead><tr><th scope="col">Chủ sở hữu</th><th scope="col">Từ ngày</th><th scope="col">Đến ngày</th><th scope="col">Tình trạng</th></tr></thead><tbody>
   @foreach(var owner in apartment.OwnershipHistory.OrderByDescending(x=>x.StartDate)){<tr><td><a href="@($"/residents/{owner.OwnerResidentId}")">@(owner.Owner?.FullName??"Cư dân không còn khả dụng")</a><small>@(owner.Owner?.ResidentCode??owner.OwnerResidentId.ToString())</small></td><td>@DateText(owner.StartDate)</td><td>@(owner.EndDate is null?"Chưa ghi nhận kết thúc":DateText(owner.EndDate))</td><td>@(owner.EndDate is null?"Đang sở hữu":"Đã kết thúc")</td></tr>}
  </tbody></table></div>}
 </section></div><aside class="side-stack"><section class="detail-card owner-card"><header><div><span class="section-kicker">OWNERSHIP</span><h2>Chủ sở hữu hiện tại (@apartment.Owners.Count)</h2></div>@if(CanManage){<button class="text-action" title="@(IsActive?"Thêm chủ sở hữu":"Không thể thêm chủ sở hữu cho căn hộ đang ngừng quản lý.")" disabled="@(!IsActive)" @onclick="OpenOwnerDialog">Thêm chủ sở hữu</button>}</header>@if(apartment.Owners.Count==0){<div class="compact-empty"><span class="material-symbols-outlined">person_off</span><div><strong>Chưa xác định chủ sở hữu</strong><p>Căn hộ chưa được gán chủ sở hữu.</p></div></div>}else{<div class="owner-list">@foreach(var owner in apartment.Owners){<div class="person-row"><span class="avatar">@Initials(owner.Owner?.FullName??"?")</span><div><strong><a href="@($"/residents/{owner.ResidentId}")">@(owner.Owner?.FullName??"Cư dân không còn khả dụng")</a></strong><span>@(owner.Owner?.ResidentCode??owner.ResidentId.ToString()) · Từ ngày: @DateText(owner.StartDate)</span></div>@if(CanManage){<button class="end-owner" title="Kết thúc quyền sở hữu" @onclick="()=>OpenEndOwnership(owner)"><span class="material-symbols-outlined">person_remove</span></button>}</div>}</div>}<button class="history-link" @onclick="OpenHistory"><span class="material-symbols-outlined">history</span>Xem lịch sử sở hữu</button></section>
 <section class="detail-card occupancy-card"><header><div><span class="section-kicker">OCCUPANCY</span><h2>Cư dân đang cư trú (@apartment.CurrentResidents.Count)</h2></div></header><div class="occupancy-summary @(apartment.CurrentResidents.Count>0?"occupied":"vacant")"><span class="material-symbols-outlined">@(apartment.CurrentResidents.Count>0?"groups":"meeting_room")</span><div><strong>@(apartment.CurrentResidents.Count>0?"Có cư dân":"Trống")</strong><p>@apartment.CurrentResidents.Count cư dân đang cư trú</p></div></div>@if(apartment.CurrentResidents.Count>0){<div class="owner-list">@foreach(var resident in apartment.CurrentResidents){<div class="person-row"><span class="avatar">@Initials(resident.FullName)</span><div><strong><a href="@($"/residents/{resident.ResidentId}")">@resident.FullName</a></strong><span>@resident.ResidentCode · @ResidencyTypeLabel(resident.ResidencyType) · @RoleLabel(resident.HouseholdRole)</span><span>Từ ngày: @DateText(resident.StartDate) · Đến ngày: @(resident.EndDate is null?"Chưa ghi nhận kết thúc":DateText(resident.EndDate))</span>@if(resident.HouseholdHeadFullName is not null){<span>Chủ hộ: @resident.HouseholdHeadFullName</span>}</div></div>}</div>}<p class="occupancy-help">Chủ sở hữu có thể không sống tại căn hộ. Danh sách trên chỉ gồm người có quan hệ cư trú đang hiệu lực.</p></section>
 </aside></div>}
</div>

@if(editing && apartment is not null){<div class="apartment-overlay" @onclick="CancelEditFeedbackCloseEdit"><section class="apartment-dialog edit-dialog" @onclick:stopPropagation="true"><header><div class="dialog-title"><span class="material-symbols-outlined">edit</span><div><h2>Chỉnh sửa căn hộ</h2><p>Cập nhật thông tin căn hộ</p></div></div><button @onclick="CancelEditFeedbackCloseEdit">×</button></header><div class="dialog-body"><div class="edit-form"><label>Mã căn hộ <em>*</em><input @bind="editForm.UnitNumber" /></label><label>Tầng <em>*</em><input type="number" min="0" max="@maximumFloor" @bind="editForm.FloorNumber" /></label><label>Loại căn hộ <em>*</em><PropFlowSelect Options="ApartmentTypeOptions" Value="@(editForm.ApartmentUnitTypeId?.ToString()??string.Empty)" ValueChanged="SetEditUnitType" Placeholder="Chọn loại căn hộ" AriaLabel="Loại căn hộ" /></label><label>Diện tích sử dụng (m²) <em>*</em><input type="text" inputmode="decimal" placeholder="Nhập diện tích từ 25 m²" @bind="AreaText" @bind:event="oninput" /></label><label>Số phòng ngủ<input type="number" @bind="editForm.BedroomCount" /></label><label>Số phòng tắm<input type="number" @bind="editForm.BathroomCount" /></label><label>Ngày bàn giao<PropFlowDatePicker @bind-Value="editForm.HandoverDate" ValidityChanged="v=>handoverDateValid=v" AriaLabel="Ngày bàn giao" /></label><label class="wide">Mô tả<textarea @bind="editForm.Description"></textarea></label></div>@if(editErrors.Count>0){<div class="edit-errors">@foreach(var e in editErrors){<p>@e</p>}</div>}</div><footer><button class="dialog-cancel" @onclick="CancelEditFeedbackCloseEdit">Hủy</button><button class="dialog-save" disabled="@(savingEdit||!handoverDateValid)" @onclick="SaveEdit">@(savingEdit?"Đang lưu…":"Lưu thay đổi")</button></footer></section></div>}
@if(changingOwner){<div class="apartment-overlay" @onclick="CancelOwnerFeedbackCloseOwnerDialog"><section class="apartment-dialog owner-dialog" @onclick:stopPropagation="true"><header><div class="dialog-title"><span class="material-symbols-outlined">person_add</span><div><h2>Thêm chủ sở hữu</h2><p>Có thể gán nhiều chủ sở hữu cho căn hộ</p></div></div><button @onclick="CancelOwnerFeedbackCloseOwnerDialog">×</button></header><div class="dialog-body"><div class="owner-context"><span>Chủ sở hữu hiện tại</span><strong>@OwnerNames()</strong></div>@if(ownerCandidatesLoading){<div class="dialog-state">Đang tải danh sách cư dân…</div>}else if(!string.IsNullOrWhiteSpace(ownerCandidatesError)){<div class="dialog-state error"><strong>@ownerCandidatesError</strong><button class="retry" @onclick="LoadOwnerCandidates">Thử lại</button></div>}else if(ownerCandidates.Count==0){<div class="dialog-state"><strong>Không còn cư dân phù hợp</strong></div>}else{<label>Chủ sở hữu mới <em>*</em><PropFlowSelect Options="OwnerOptions" Value="@newOwnerId" ValueChanged="SelectOwner" Placeholder="Chọn cư dân" AriaLabel="Chủ sở hữu mới" /></label>}</div><footer><button class="dialog-cancel" @onclick="CancelOwnerFeedbackCloseOwnerDialog">Hủy</button><button class="dialog-save" disabled="@(savingOwner||ownerCandidatesLoading||ownerCandidates.Count==0)" @onclick="AddOwner">@(savingOwner?"Đang lưu…":"Thêm chủ sở hữu")</button></footer></section></div>}
@if (endingOwnership is not null)
{
    <PropFlowConfirmationDialog Title="Kết thúc quyền sở hữu?" Tone="DialogTone.Danger"
        Message="@($"{endingOwnership.Owner?.FullName ?? endingOwnership.ResidentId.ToString()} sẽ kết thúc quyền sở hữu căn hộ này.")"
        Detail="Chủ sở hữu khác và các quan hệ cư trú vẫn được giữ nguyên."
        ConfirmText="Kết thúc quyền sở hữu" Busy="@savingEndOwnership" BusyText="Đang cập nhật…"
        OnConfirm="EndOwnership" OnCancel="CancelOwnerFeedbackCloseEndOwnership" />
}
@if(showHistory){<div class="apartment-overlay" @onclick="CloseHistory"><section class="apartment-dialog history-dialog" @onclick:stopPropagation="true"><header><div class="dialog-title"><span class="material-symbols-outlined">history</span><div><h2>Lịch sử sở hữu</h2><p>Các giai đoạn của các chủ sở hữu có thể chồng lấp</p></div></div><button @onclick="CloseHistory">×</button></header><div class="dialog-body">@if(historyLoading){<div class="dialog-state">Đang tải lịch sử sở hữu…</div>}else if(!string.IsNullOrWhiteSpace(historyError)){<div class="dialog-state error"><strong>@historyError</strong><button class="retry" @onclick="LoadHistory">Thử lại</button></div>}else if(ownershipHistory.Count==0){<div class="dialog-state"><strong>Chưa có lịch sử sở hữu</strong><button class="retry" @onclick="OpenOwnerFromHistory">Thêm chủ sở hữu</button></div>}else{<div class="ownership-timeline">@foreach(var item in ownershipHistory){<article><i></i><div><strong>@(item.Owner?.FullName??"Cư dân không còn khả dụng")</strong><span>@(item.Owner?.ResidentCode??item.OwnerResidentId.ToString())</span><p>@DateText(item.StartDate) – @(item.EndDate is null?"Chưa ghi nhận kết thúc":DateText(item.EndDate)) @if(item.EndDate is null){<b>Đang hiệu lực</b>}</p></div></article>}</div>}</div><footer><button class="dialog-cancel" @onclick="CloseHistory">Đóng</button></footer></section></div>}
@if(showStatusDialog && apartment is not null){<PropFlowConfirmationDialog @key="statusDialogVersion" Title="@StatusDialogTitle" Message="@StatusDialogMessage" ConfirmText="@(statusBlocked?"Đã hiểu":IsActive?"Ngừng quản lý":"Kích hoạt lại")" BusyText="Đang cập nhật…" Busy="@changingStatus" Tone="@(statusBlocked ? DialogTone.Info : IsActive ? DialogTone.Danger : DialogTone.Confirm)" OnConfirm="ChangeStatus" OnCancel="CloseStatusDialog" />}

@code {
    private readonly PropFlow.Web.Client.Shared.Feedback.ToastLifetime ownerFeedback = new();
    private void CancelOwnerFeedbackCloseOwnerDialog() { CloseOwnerDialog(); if (!changingOwner) ownerFeedback.Invalidate(); }
    private void CancelOwnerFeedbackCloseEndOwnership() { CloseEndOwnership(); if (endingOwnership is null) ownerFeedback.Invalidate(); }

    private readonly PropFlow.Web.Client.Shared.Feedback.ToastLifetime editFeedback = new();
    private void CancelEditFeedbackCloseEdit() { CloseEdit(); if (!editing) editFeedback.Invalidate(); }

    private readonly PropFlow.Web.Client.Shared.Feedback.ToastLifetime toastLifetime = new();
    public void Dispose() => toastLifetime.Dispose();

 private string areaText = ""; private string AreaText { get => areaText; set { areaText=value;editForm.UsableAreaM2=ApartmentAreaInput.Parse(value); } }
 private int? maximumFloor;
 [Parameter] public Guid Id {get;set;} private ApartmentResponse? apartment; private bool loading=true,editing,savingEdit,changingOwner,savingOwner,showActions,showHistory,historyLoading,showStatusDialog,ownerCandidatesLoading,savingEndOwnership,handoverDateValid=true,statusBlocked,changingStatus; private string? message,newOwnerId,ownerCandidatesError,historyError,statusDialogMessage; private int statusDialogVersion; private ApartmentOwnerItem? endingOwnership; private ApartmentEditState editForm=new(); private List<string> editErrors=[]; private IReadOnlyList<ResidentLookupItem> ownerCandidates=[]; private IReadOnlyList<ApartmentOwnershipHistoryItem> ownershipHistory=[]; private IReadOnlyList<ApartmentUnitTypeResponse> apartmentTypes=[]; private bool IsActive=>apartment?.Status=="ACTIVE"; private string StatusActionTitle=>IsActive?"Ngừng quản lý":"Kích hoạt lại"; private string StatusDialogTitle=>statusBlocked?ApartmentStatusActionUx.BlockerTitle:IsActive?"Ngừng quản lý căn hộ?":"Kích hoạt lại căn hộ?"; private string StatusDialogMessage=>statusDialogMessage??string.Empty; private bool CanManage=>string.Equals(Session.User?.Role,"MANAGER",StringComparison.OrdinalIgnoreCase); private IReadOnlyList<PropFlowSelectOption> OwnerOptions=>ownerCandidates.Select(x=>new PropFlowSelectOption(x.ResidentId.ToString(),$"{x.ResidentCode} – {x.FullName}")).ToArray(); private IReadOnlyList<PropFlowSelectOption> ApartmentTypeOptions=>apartmentTypes.Select(x=>new PropFlowSelectOption(x.Id.ToString(),x.Name)).ToArray();
 private string ResidencyStateLabel(ResidentAssociationItem item)=>apartment!.CurrentResidents.Any(x=>x.ResidencyId==item.ResidencyId)?"Đang cư trú":item.ResidencyStatus=="ACTIVE"&&item.StartDate>DateOnly.FromDateTime(DateTime.Today)?"Chưa bắt đầu":"Đã kết thúc";
 private static string ResidencyTypeLabel(string value)=>value switch{"OWNER_OCCUPIED"=>"Chủ sở hữu đang cư trú","TENANT"=>"Người thuê","AUTHORIZED_OCCUPANT"=>"Người được phép cư trú",_=>value};
 private static string RoleLabel(string value)=>value switch{"HOUSEHOLD_HEAD"=>"Chủ hộ","HOUSEHOLD_MEMBER"=>"Thành viên hộ",_=>value};
 private IReadOnlyList<ResidentAssociationItem> ResidencyTimeline=>apartment is null?[]:apartment.CurrentResidents.Concat(apartment.ResidentHistory).GroupBy(x=>x.ResidencyId).Select(x=>x.First()).OrderByDescending(x=>x.StartDate).ToArray();
 protected override Task OnParametersSetAsync()=>Reload(); private async Task Reload(){loading=true;message=null;var r=await Apartments.GetAsync(Id);apartment=r.IsSuccess?r.Data:null;if(!r.IsSuccess)message=r.Message;loading=false;} private void ToggleActions()=>showActions=!showActions; private async Task OpenOwnerDialog(){if(!IsActive)return;showActions=false;newOwnerId=null;changingOwner=true;await LoadOwnerCandidates();} private async Task LoadOwnerCandidates(){ownerCandidatesLoading=true;ownerCandidatesError=null;var r=await Apartments.OwnerCandidatesAsync(Id,null);ownerCandidates=r.Data??[];if(!r.IsSuccess)ownerCandidatesError=r.Message??"Không thể tải danh sách cư dân.";ownerCandidatesLoading=false;} private void CloseOwnerDialog(){changingOwner=false;savingOwner=false;newOwnerId=null;ownerCandidates=[];ownerCandidatesError=null;} private Task SelectOwner(string v){newOwnerId=v;return Task.CompletedTask;} private async Task AddOwner(){
        var operationFeedback = Toasts.BeginOperation(toastLifetime, ownerFeedback);
if(!Guid.TryParse(newOwnerId,out var residentId)){message="Vui lòng chọn chủ sở hữu.";return;}savingOwner=true;var r=await Apartments.AddOwnerAsync(Id,new(){OwnerResidentId=residentId});savingOwner=false;if(!r.IsSuccess){operationFeedback.Publish(() => ShowOwnershipFailure(r,"Không thể thêm chủ sở hữu."));return;}CloseOwnerDialog();await Reload();operationFeedback.Publish(() => Toasts.Success("Đã thêm chủ sở hữu căn hộ."));}
 private void ShowOwnershipFailure(PropFlow.Web.Client.Services.Api.ApiResult result,string fallback)
 {
  if(result.ValidationErrors?.Count is not >0 && result.StatusCode is null or 0 or >=500)Toasts.Error(result.Message??fallback);
  else message=result.Message??fallback;
 }
 private void OpenEndOwnership(ApartmentOwnerItem owner)=>endingOwnership=owner; private void CloseEndOwnership(){endingOwnership=null;savingEndOwnership=false;} private async Task EndOwnership(){
        var operationFeedback = Toasts.BeginOperation(toastLifetime, ownerFeedback);
if(endingOwnership is null)return;savingEndOwnership=true;var r=await Apartments.EndOwnershipAsync(Id,endingOwnership.OwnershipId,new());savingEndOwnership=false;if(!r.IsSuccess){operationFeedback.Publish(() => ShowOwnershipFailure(r,"Không thể kết thúc quyền sở hữu."));CloseEndOwnership();return;}CloseEndOwnership();await Reload();operationFeedback.Publish(() => Toasts.Success("Đã kết thúc quyền sở hữu căn hộ."));} private async Task OpenHistory(){showActions=false;showHistory=true;await LoadHistory();} private async Task LoadHistory(){historyLoading=true;historyError=null;var r=await Apartments.OwnershipHistoryAsync(Id);ownershipHistory=r.Data??[];if(!r.IsSuccess)historyError=r.Message??"Không thể tải lịch sử sở hữu.";historyLoading=false;} private void CloseHistory(){showHistory=false;historyError=null;ownershipHistory=[];} private async Task OpenOwnerFromHistory(){CloseHistory();await OpenOwnerDialog();}
 private void OpenStatusDialog(){if(apartment is null)return;showActions=false;statusDialogMessage=IsActive?ApartmentStatusActionUx.BlockerMessage(apartment.Owners.Count>0,apartment.CurrentResidents.Count>0):$"Bạn có chắc muốn kích hoạt lại căn hộ “{apartment.UnitNumber}” không?";statusBlocked=IsActive&&statusDialogMessage is not null;if(IsActive&&!statusBlocked)statusDialogMessage=$"Bạn có chắc muốn ngừng quản lý căn hộ “{apartment.UnitNumber}” không?";statusDialogVersion++;showStatusDialog=true;} private void CloseStatusDialog(){if(changingStatus)return;showStatusDialog=false;statusBlocked=false;statusDialogMessage=null;} private async Task ChangeStatus(){
        var operationFeedback = Toasts.BeginOperation(toastLifetime);
if(apartment is null||statusBlocked)return;var wasActive=IsActive;var unitNumber=apartment.UnitNumber;changingStatus=true;var r=await Apartments.SetStatusAsync(Id,wasActive?"INACTIVE":"ACTIVE");changingStatus=false;if(!r.IsSuccess){if(wasActive&&ApartmentStatusActionUx.TryMapConflict(r.Code,out var blocker)){statusBlocked=true;statusDialogMessage=blocker;statusDialogVersion++;return;}CloseStatusDialog();operationFeedback.Publish(() => Toasts.Error(r.Message??"Không thể cập nhật trạng thái."));return;}CloseStatusDialog();await Reload();operationFeedback.Publish(() => Toasts.Success(wasActive?$"Đã ngừng quản lý căn hộ {unitNumber}.":$"Đã kích hoạt lại căn hộ {unitNumber}."));} private async Task OpenEdit(){var buildingResult=await BuildingApi.GetCurrentBuildingOverviewAsync();maximumFloor=buildingResult.IsSuccess?buildingResult.Data?.NumberOfFloors:null;if(apartment is null)return;editErrors=[];var types=await Apartments.UnitTypesAsync();if(!types.IsSuccess||types.Data is null){message=types.Message??"Không thể tải loại căn hộ.";return;}apartmentTypes=types.Data;editForm=new(){UnitNumber=apartment.UnitNumber,FloorNumber=apartment.FloorNumber,ApartmentUnitTypeId=apartment.ApartmentUnitTypeId,UsableAreaM2=apartment.UsableAreaM2,BedroomCount=apartment.BedroomCount,BathroomCount=apartment.BathroomCount,HandoverDate=apartment.HandoverDate,Description=apartment.Description};areaText=ApartmentAreaInput.Format(editForm.UsableAreaM2);editing=true;} private Task SetEditUnitType(string value){editForm.ApartmentUnitTypeId=Guid.TryParse(value,out var id)?id:null;return Task.CompletedTask;} private void CloseEdit(){editing=false;savingEdit=false;editErrors=[];} private async Task SaveEdit(){
        var operationFeedback = Toasts.BeginOperation(toastLifetime, editFeedback);
