@page "/apartments"
@layout PropFlow.Web.Client.Layout.MainLayout
@attribute [Authorize(Roles="MANAGER,STAFF,ACCOUNTANT")]
@using PropFlow.Web.Client.Features.Apartment.Models
@using PropFlow.Web.Client.Features.Apartment.Services
@using PropFlow.Web.Client.Shared.Forms
@using PropFlow.Web.Client.Shared.Feedback
@using PropFlow.Web.Client.Features.Finance.Components
@inject IApartmentApiClient Apartments
@inject PropFlow.Web.Client.Features.Facility.Services.IBuildingApiClient BuildingApi
@inject NavigationManager Navigation
@inject PropFlow.Web.Client.Services.Authentication.AuthSession Session

<PageTitle>Quản lý căn hộ - PropFlow</PageTitle>
<div class="apartment-page">
 <section class="apartment-header apartment-directory">
  <div><span class="material-symbols-outlined">apartment</span><div><div class="directory-title"><h1>Quản lý căn hộ</h1><span>APARTMENT DIRECTORY</span></div><p>Tra cứu căn hộ, chủ sở hữu và tình trạng cư trú.</p></div></div>
  @if(CanManage){<div class="header-actions"><button type="button" class="type-management-button" title="Danh sách loại căn hộ" aria-label="Danh sách loại căn hộ" @onclick="OpenTypeManager"><span class="material-symbols-outlined">category</span>Loại căn hộ</button><button type="button" class="create-apartment-button" @onclick="OpenCreate">＋ Thêm căn hộ mới</button></div>}
 </section>
 @if(initialized){<section class="apartment-kpis"><div><span class="material-symbols-outlined">domain</span><p>Tổng số căn hộ<strong>@data.Summary.TotalCount</strong></p></div><div><span class="material-symbols-outlined">groups</span><p>Đang có cư dân<strong>@data.Summary.OccupiedCount</strong></p></div><div><span class="material-symbols-outlined">meeting_room</span><p>Căn hộ trống<strong>@data.Summary.VacantCount</strong></p></div><div><span class="material-symbols-outlined">pause_circle</span><p>Ngừng quản lý<strong>@data.Summary.InactiveCount</strong></p></div></section>}
 @if(!string.IsNullOrWhiteSpace(message)){<p class="notice" role="alert">@message <button class="link" @onclick="Load">Thử lại</button></p>}
 <section class="apartment-panel">
  <div class="toolbar-shell">
   <div class="toolbar">
    <div class="apartment-search"><span class="material-symbols-outlined">search</span><input aria-label="Tìm theo mã căn hộ" placeholder="Tìm theo mã căn hộ..." @bind="search" @bind:event="oninput" @onkeyup="SearchKey" />@if(!string.IsNullOrWhiteSpace(search)){<button type="button" class="clear-search" title="Xóa mã căn hộ" aria-label="Xóa mã căn hộ" @onclick="ClearSearch"><span class="material-symbols-outlined">close</span></button>}</div>
    <button type="button" class="filter-toggle @(showFilters||ActiveFilterCount>0?"active":null)" aria-expanded="@showFilters" aria-haspopup="dialog" @onclick="ToggleFilters"><span class="material-symbols-outlined">filter_alt</span><span>Bộ lọc</span>@if(ActiveFilterCount>0){<strong class="filter-count">@ActiveFilterCount</strong>}</button>
    <span class="result-count"><i></i>Hiển thị @data.Items.Count / @data.TotalCount căn hộ</span>
   </div>
  </div>
  <div class="apartment-results @(loading?"is-loading":null)" aria-busy="@loading">
   @if(loading&&data.Items.Count>0){<div class="list-loading-overlay" role="status"><span class="loading-spinner"></span><span>Đang cập nhật…</span></div>}
   @if(loading&&data.Items.Count==0){<p class="state">Đang tải căn hộ…</p>}
   else if(data.Items.Count==0){<div class="state">Không tìm thấy căn hộ phù hợp.</div>}
   else{<table><thead><tr><th>CĂN HỘ</th><th>LOẠI & DIỆN TÍCH</th><th>CHỦ SỞ HỮU / CƯ TRÚ</th><th>TRẠNG THÁI</th><th>HÀNH ĐỘNG</th></tr></thead><tbody>
    @foreach(var x in data.Items){<tr><td><button class="link" @onclick="()=>Detail(x.Id)">@x.UnitNumber</button><small>Tầng @x.FloorNumber</small></td><td><strong>@x.UsableAreaM2.ToString("0.##") m²</strong> · @x.UnitType</td><td>@OwnerSummary(x.Owners)<small>@(x.IsOccupied?"Có cư dân đang cư trú":"Căn hộ trống")</small></td><td><span class="status-chip @(x.Status=="ACTIVE"?"active":"inactive")">@(x.Status=="ACTIVE"?"Đang quản lý":"Ngừng quản lý")</span></td><td class="row-actions"><button title="Xem chi tiết" @onclick="()=>Detail(x.Id)"><span class="material-symbols-outlined">visibility</span></button>@if(CanManage){<button type="button" title="Nhập điện và nước đã dùng" aria-label="Nhập điện và nước căn hộ @x.UnitNumber" @onclick="()=>electricityApartment=x"><span class="material-symbols-outlined">electric_meter</span></button><button title="Chỉnh sửa" @onclick="()=>OpenEdit(x.Id)"><span class="material-symbols-outlined">edit</span></button><button title="@StatusActionTitle(x)" @onclick="()=>RequestStatusChange(x)"><span class="material-symbols-outlined">@(x.Status=="ACTIVE"?"pause_circle":"play_circle")</span></button>}</td></tr>}
   </tbody></table>}
   @if(initialized&&TotalPages>1){<nav class="pagination"><span>Trang @data.PageIndex / @TotalPages</span><button disabled="@(loading||data.PageIndex<=1)" @onclick="()=>GoToPage(data.PageIndex-1)">Trước</button>@foreach(var p in Enumerable.Range(1,TotalPages)){<button disabled="@loading" class="@(p==data.PageIndex?"current":null)" @onclick="()=>GoToPage(p)">@p</button>}<button disabled="@(loading||data.PageIndex>=TotalPages)" @onclick="()=>GoToPage(data.PageIndex+1)">Sau</button></nav>}
  </div>
 </section>
</div>

@if(electricityApartment is not null && CanManage){<ElectricityUsageDialog @key="electricityApartment.Id" ApartmentId="electricityApartment.Id" UnitNumber="@electricityApartment.UnitNumber" Closed="()=>electricityApartment=null" />}
@if(showFilters){<div class="filter-popover-backdrop" @onclick="CloseFilters"><section class="filter-popover" role="dialog" aria-modal="true" aria-labelledby="apartment-filter-title" @onclick:stopPropagation="true"><header><div><span class="material-symbols-outlined">filter_alt</span><div><h2 id="apartment-filter-title">Bộ lọc căn hộ</h2><p>Thu hẹp danh sách theo thông tin căn hộ.</p></div></div><button type="button" class="filter-close" title="Đóng bộ lọc" aria-label="Đóng bộ lọc" @onclick="CloseFilters"><span class="material-symbols-outlined">close</span></button></header><div class="filter-grid"><label><span>Trạng thái quản lý</span><PropFlowSelect Options="StatusOptions" Value="@draftStatus" ValueChanged="SetDraftStatus" Variant="Filter" AriaLabel="Trạng thái quản lý" /></label><label><span>Tầng</span><input type="number" min="0" placeholder="Nhập số tầng" @bind="draftFloorText" /></label><label><span>Loại căn hộ</span><PropFlowSelect Options="UnitTypeOptions" Value="@(draftUnitTypeId?.ToString()??string.Empty)" ValueChanged="SetDraftUnitType" Variant="Filter" AriaLabel="Loại căn hộ" Disabled="@unitTypesLoading" />@if(unitTypesLoading){<small class="filter-field-note"><span class="loading-spinner"></span>Đang tải loại căn hộ…</small>}else if(!string.IsNullOrWhiteSpace(unitTypesError)){<small class="filter-field-note error">@unitTypesError</small>}</label><label><span>Tình trạng cư trú</span><PropFlowSelect Options="OccupancyOptions" Value="@draftOccupancy" ValueChanged="SetDraftOccupancy" Variant="Filter" AriaLabel="Tình trạng cư trú" /></label></div><footer><button type="button" class="filter-reset" @onclick="ResetFilters">Đặt lại bộ lọc</button><button type="button" class="filter-apply" @onclick="ApplyFilters"><span class="material-symbols-outlined">check</span>Áp dụng</button></footer></section></div>}

@if(editing&&CanManage){<div class="apartment-dialog-backdrop" @onclick="Close"><section class="apartment-dialog" @onclick:stopPropagation="true"><header><div class="dialog-title"><span class="material-symbols-outlined">apartment</span><h2>@(editId is null?"Thêm căn hộ mới":"Chỉnh sửa căn hộ")</h2></div><button @onclick="Close">×</button></header>@if(validationErrors.Count>0){<div class="form-errors"><ul>@foreach(var e in validationErrors){<li>@e</li>}</ul></div>}<div class="form"><h3 class="full">Thông tin định danh</h3><label>Mã căn hộ <em>*</em><input @bind="form.UnitNumber" /></label><label>Tầng <em>*</em><input type="number" min="0" max="@maximumFloor" @bind="form.FloorNumber" /></label><h3 class="full">Thông tin căn hộ</h3><label>Loại căn hộ <em>*</em><PropFlowSelect Options="ApartmentTypeOptions" Value="@(form.ApartmentUnitTypeId?.ToString()??string.Empty)" ValueChanged="SetFormUnitType" Placeholder="Chọn loại căn hộ" AriaLabel="Loại căn hộ" Disabled="@unitTypesLoading" /></label><label>Diện tích sử dụng (m²) <em>*</em><input type="text" inputmode="decimal" placeholder="Nhập diện tích từ 25 m²" @bind="AreaText" @bind:event="oninput" /></label><label>Số phòng ngủ<input type="number" @bind="form.BedroomCount" /></label><label>Số phòng tắm<input type="number" @bind="form.BathroomCount" /></label><label>Ngày bàn giao<PropFlowDatePicker @bind-Value="form.HandoverDate" ValidityChanged="v=>handoverDateValid=v" AriaLabel="Ngày bàn giao" /></label><label class="full">Mô tả<textarea @bind="form.Description"></textarea></label></div><footer><button class="dialog-cancel" @onclick="Close">Hủy bỏ</button><button class="dialog-save" disabled="@(saving||!handoverDateValid)" @onclick="Save">@(saving?"Đang lưu…":"Lưu căn hộ")</button></footer></section></div>}

@if(managingTypes&&CanManage){<div class="filter-popover-backdrop type-dialog-backdrop" @onclick="CloseTypeManager"><section class="filter-popover type-manager-dialog" role="dialog" aria-modal="true" aria-labelledby="type-manager-title" @onclick:stopPropagation="true"><header><div><span class="material-symbols-outlined">category</span><div><h2 id="type-manager-title">Danh sách loại căn hộ</h2><p>Danh mục dùng chung khi tạo căn hộ và thiết lập giá thuê.</p></div></div><button type="button" class="filter-close" title="Đóng" aria-label="Đóng" @onclick="CloseTypeManager"><span class="material-symbols-outlined">close</span></button></header><div class="type-manager-body">@foreach(var type in apartmentTypes){<p>@type.Name</p>}</div></section></div>}

@if(statusTarget is not null){<PropFlowConfirmationDialog @key="statusDialogVersion" Title="@StatusDialogTitle" Message="@StatusDialogMessage" ConfirmText="@(statusBlocked?"Đã hiểu":statusTarget.Status=="ACTIVE"?"Ngừng quản lý":"Kích hoạt lại")" BusyText="Đang cập nhật…" Busy="@changingStatus" InformationOnly="@statusBlocked" Destructive="@(statusTarget.Status=="ACTIVE")" OnConfirm="ConfirmStatusChange" OnCancel="CloseStatusDialog" />}
@if(!string.IsNullOrWhiteSpace(toastMessage)){<PropFlowToast @key="toastVersion" Message="@toastMessage" Severity="@toastSeverity" DurationMs="@toastDurationMs" OnDismiss="DismissToast" />}

@code {
 private string areaText = ""; private string AreaText { get => areaText; set { areaText=value;form.UsableAreaM2=ApartmentAreaInput.Parse(value); } }
 int? maximumFloor;
 async Task LoadFloorLimit(){var r=await BuildingApi.GetCurrentBuildingOverviewAsync();maximumFloor=r.IsSuccess?r.Data?.NumberOfFloors:null;}
 ApartmentListItem? electricityApartment;
 const int PageSize=10; PagedApartmentsResponse data=new([],0,1,PageSize,new(0,0,0,0)); string? search,status,floorText,occupancy,message,draftStatus,draftFloorText,draftOccupancy,unitTypesError,toastMessage,statusDialogMessage; string toastSeverity="info"; int toastDurationMs=3000,toastVersion,statusDialogVersion; bool loading=true,initialized,editing,saving,showFilters,unitTypesLoading,unitTypesLoaded,managingTypes,handoverDateValid=true,statusBlocked,changingStatus; Guid? editId,unitTypeId,draftUnitTypeId; ApartmentListItem? statusTarget; ApartmentFormState form=new(); List<string> validationErrors=[]; IReadOnlyList<ApartmentUnitTypeResponse> apartmentTypes=[]; IReadOnlyList<PropFlowSelectOption> UnitTypeOptions=>[new("","Tất cả"),..apartmentTypes.Select(x=>new PropFlowSelectOption(x.Id.ToString(),x.Name))]; IReadOnlyList<PropFlowSelectOption> ApartmentTypeOptions=>apartmentTypes.Select(x=>new PropFlowSelectOption(x.Id.ToString(),x.Name)).ToArray(); string StatusDialogTitle=>statusBlocked?ApartmentStatusActionUx.BlockerTitle:statusTarget?.Status=="ACTIVE"?"Ngừng quản lý căn hộ?":"Kích hoạt lại căn hộ?"; string StatusDialogMessage=>statusDialogMessage??string.Empty;
 bool CanManage=>string.Equals(Session.User?.Role,"MANAGER",StringComparison.OrdinalIgnoreCase); int TotalPages=>Math.Max(1,(int)Math.Ceiling(data.TotalCount/(double)PageSize)); int ActiveFilterCount=>(string.IsNullOrWhiteSpace(status)?0:1)+(string.IsNullOrWhiteSpace(floorText)?0:1)+(unitTypeId.HasValue?1:0)+(string.IsNullOrWhiteSpace(occupancy)?0:1);
 static readonly IReadOnlyList<PropFlowSelectOption> StatusOptions=[new("","Tất cả"),new("ACTIVE","Đang quản lý"),new("INACTIVE","Ngừng quản lý")];
 static readonly IReadOnlyList<PropFlowSelectOption> OccupancyOptions=[new("","Tất cả"),new("OCCUPIED","Có cư dân"),new("VACANT","Trống")];
 protected override Task OnInitializedAsync()=>Load();
 async Task Load(){loading=true;message=null;try{int? floor=int.TryParse(floorText,out var value)?value:null;var r=await Apartments.ListAsync(search,status,floor,unitTypeId,occupancy,data.PageIndex,PageSize);if(r.IsSuccess&&r.Data is not null)data=r.Data;else message=r.Message??"Không thể tải danh sách căn hộ.";}catch{message="Không thể tải danh sách căn hộ.";}finally{loading=false;initialized=true;}}
 async Task Search(){data=data with{PageIndex=1};await Load();} async Task SearchKey(KeyboardEventArgs e){if(e.Key=="Enter"&&!loading)await Search();} async Task ClearSearch(){search=null;await Search();} async Task ToggleFilters(){if(showFilters){showFilters=false;return;}draftStatus=status;draftFloorText=floorText;draftUnitTypeId=unitTypeId;draftOccupancy=occupancy;showFilters=true;if(!unitTypesLoaded&&!unitTypesLoading)await LoadUnitTypes();} void CloseFilters()=>showFilters=false; Task SetDraftStatus(string v){draftStatus=v;return Task.CompletedTask;} Task SetDraftUnitType(string v){draftUnitTypeId=Guid.TryParse(v,out var id)?id:null;return Task.CompletedTask;} Task SetFormUnitType(string v){form.ApartmentUnitTypeId=Guid.TryParse(v,out var id)?id:null;return Task.CompletedTask;} Task SetDraftOccupancy(string v){draftOccupancy=v;return Task.CompletedTask;} async Task LoadUnitTypes(bool force=false){if(unitTypesLoaded&&!force)return;unitTypesLoading=true;unitTypesError=null;try{var result=await Apartments.UnitTypesAsync();if(result.IsSuccess&&result.Data is not null){apartmentTypes=result.Data;unitTypesLoaded=true;}else unitTypesError=result.Message??"Không thể tải loại căn hộ.";}catch{unitTypesError="Không thể tải loại căn hộ.";}finally{unitTypesLoading=false;}} async Task ApplyFilters(){status=Clean(draftStatus);floorText=Clean(draftFloorText);unitTypeId=draftUnitTypeId;occupancy=Clean(draftOccupancy);showFilters=false;await Search();} async Task ResetFilters(){status=floorText=occupancy=draftStatus=draftFloorText=draftOccupancy=null;unitTypeId=draftUnitTypeId=null;showFilters=false;await Search();} async Task GoToPage(int p){if(loading||p<1||p>TotalPages)return;data=data with{PageIndex=p};await Load();}
 async Task OpenCreate(){await LoadFloorLimit();validationErrors=[];form=new();areaText="";editId=null;editing=true;await LoadUnitTypes();} async Task OpenEdit(Guid id){await LoadFloorLimit();if(!CanManage)return;await LoadUnitTypes();var r=await Apartments.GetAsync(id);if(!r.IsSuccess||r.Data is null){message=r.Message;return;}var x=r.Data;form=new(){UnitNumber=x.UnitNumber,FloorNumber=x.FloorNumber,ApartmentUnitTypeId=x.ApartmentUnitTypeId,UsableAreaM2=x.UsableAreaM2,BedroomCount=x.BedroomCount,BathroomCount=x.BathroomCount,HandoverDate=x.HandoverDate,Description=x.Description};areaText=ApartmentAreaInput.Format(form.UsableAreaM2);editId=id;editing=true;} void Close(){editing=saving=false;validationErrors=[];}
 async Task Save(){validationErrors=Validate();if(validationErrors.Count>0)return;saving=true;var create=new CreateApartmentRequest{UnitNumber=form.UnitNumber.Trim(),FloorNumber=form.FloorNumber!.Value,ApartmentUnitTypeId=form.ApartmentUnitTypeId!.Value,UsableAreaM2=form.UsableAreaM2!.Value,BedroomCount=form.BedroomCount,BathroomCount=form.BathroomCount,HandoverDate=form.HandoverDate,Description=form.Description};if(editId is null){var r=await Apartments.CreateAsync(create);if(!r.IsSuccess)message=r.Message;}else{var r=await Apartments.UpdateAsync(editId.Value,new(){UnitNumber=create.UnitNumber,FloorNumber=create.FloorNumber,ApartmentUnitTypeId=create.ApartmentUnitTypeId,UsableAreaM2=create.UsableAreaM2,BedroomCount=create.BedroomCount,BathroomCount=create.BathroomCount,HandoverDate=create.HandoverDate,Description=create.Description});if(!r.IsSuccess)message=r.Message;}saving=false;if(string.IsNullOrWhiteSpace(message)){Close();await Load();}}
 async Task OpenTypeManager(){if(!CanManage)return;managingTypes=true;await LoadUnitTypes(true);} void CloseTypeManager(){managingTypes=false;} void ShowToast(string text,string severity,int durationMs){toastMessage=text;toastSeverity=severity;toastDurationMs=durationMs;toastVersion++;} void DismissToast(){toastMessage=null;}
 List<string> Validate(){var e=new List<string>();if(maximumFloor is null)e.Add("Không tải được số tầng chung cư. Vui lòng mở lại biểu mẫu.");else if(form.FloorNumber>maximumFloor)e.Add($"Tầng căn hộ không được vượt quá {maximumFloor} tầng của chung cư.");if(string.IsNullOrWhiteSpace(form.UnitNumber)||form.UnitNumber.Trim().Length>30)e.Add("Mã căn hộ là bắt buộc và tối đa 30 ký tự.");if(form.FloorNumber is null or <0)e.Add("Tầng phải lớn hơn hoặc bằng 0.");if(!form.ApartmentUnitTypeId.HasValue)e.Add("Loại căn hộ là bắt buộc.");if(form.UsableAreaM2 is null or <25)e.Add("Diện tích sử dụng phải từ 25 m² trở lên.");else if(form.UsableAreaM2>99999999.99m||decimal.Round(form.UsableAreaM2.Value,2)!=form.UsableAreaM2)e.Add("Diện tích không hợp lệ hoặc có quá 2 chữ số thập phân.");if(form.BedroomCount<0||form.BathroomCount<0)e.Add("Số phòng không được nhỏ hơn 0.");return e;}
 void Detail(Guid id)=>Navigation.NavigateTo($"/apartments/{id}"); void RequestStatusChange(ApartmentListItem x){statusTarget=x;statusDialogVersion++;statusDialogMessage=x.Status=="ACTIVE"?ApartmentStatusActionUx.BlockerMessage(x.Owners.Count>0,x.IsOccupied):$"Bạn có chắc muốn kích hoạt lại căn hộ “{x.UnitNumber}” không?";statusBlocked=statusDialogMessage is not null&&x.Status=="ACTIVE";if(!statusBlocked&&x.Status=="ACTIVE")statusDialogMessage=$"Bạn có chắc muốn ngừng quản lý căn hộ “{x.UnitNumber}” không?";} void CloseStatusDialog(){if(changingStatus)return;statusTarget=null;statusDialogMessage=null;statusBlocked=false;} async Task ConfirmStatusChange(){if(statusTarget is null||statusBlocked)return;var target=statusTarget;changingStatus=true;var r=await Apartments.SetStatusAsync(target.Id,target.Status=="ACTIVE"?"INACTIVE":"ACTIVE");changingStatus=false;if(!r.IsSuccess){if(target.Status=="ACTIVE"&&ApartmentStatusActionUx.TryMapConflict(r.Code,out var blocker)){statusBlocked=true;statusDialogMessage=blocker;statusDialogVersion++;return;}CloseStatusDialog();ShowToast(r.Message??"Không thể cập nhật trạng thái căn hộ.","error",5000);return;}CloseStatusDialog();await Load();ShowToast(target.Status=="ACTIVE"?$"Đã ngừng quản lý căn hộ {target.UnitNumber}.":$"Đã kích hoạt lại căn hộ {target.UnitNumber}.","success",3000);} static string StatusActionTitle(ApartmentListItem x)=>x.Status=="ACTIVE"?"Ngừng quản lý":"Kích hoạt lại"; static string? Clean(string? value)=>string.IsNullOrWhiteSpace(value)?null:value.Trim(); static string OwnerSummary(IReadOnlyList<ResidentLookupItem> x)=>x.Count switch{0=>"Chưa xác định",1=>x[0].FullName,_=>$"{x[0].FullName} +{x.Count-1}"};
 sealed class ApartmentFormState{public string UnitNumber{get;set;}="";public int? FloorNumber{get;set;}public Guid? ApartmentUnitTypeId{get;set;}public decimal? UsableAreaM2{get;set;}public int? BedroomCount{get;set;}public int? BathroomCount{get;set;}public DateOnly? HandoverDate{get;set;}public string? Description{get;set;}}
}
