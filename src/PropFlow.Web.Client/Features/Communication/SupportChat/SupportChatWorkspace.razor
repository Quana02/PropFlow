@inject PropFlow.Web.Client.Shared.Feedback.ToastService Toasts
@using PropFlow.Modules.Communication.Contracts
@using PropFlow.Web.Client.Shared.Feedback
@implements IAsyncDisposable
@inject SupportChatApi Api
@inject ISupportChatConnection Connection
@inject IJSRuntime JS
@inject PropFlow.Web.Client.Services.Authentication.AuthSession Session
@inject NavigationManager Navigation

<div class="support-workspace @(ForManager ? "internal-workspace" : null)" @ref="workspace">
    @if (identityChanged)
    { <p class="support-error" role="alert">Phiên đăng nhập đã thay đổi. Vui lòng tải lại trang để mở đúng cuộc trò chuyện của tài khoản hiện tại.</p> }
    else
    {
    @if (ForManager)
    {
        <h1 class="support-sr">Chat với cư dân</h1>
    }
    else
    {
        <header class="support-heading">
            <div>
                <span class="support-eyebrow">KẾT NỐI TRỰC TIẾP</span>
                <h1>Liên hệ Ban quản lý</h1>
                <p>Mô tả nhu cầu của bạn để được kết nối với Manager đang sẵn sàng.</p>
            </div>
            <span class="support-connection @(Connection.Connected ? "online" : "")">@(Connection.Connected ? "Đã kết nối trực tuyến" : "Đang kết nối lại…")</span>
        </header>
    }
    @if (error is not null) { <div class="support-error" role="alert">@error <button type="button" disabled="@busy" @onclick="Reload">Tải lại</button></div> }
    <div class="support-columns">
        @if (ForManager)
        {
            <ManagerSupportConversationList Conversations="conversations" SelectedId="selected?.Id"
                Page="page" Busy="busy" Loading="loading" OnSelect="Select" OnPageChanged="ChangePageAsync" />
        }
        else
        {
        <aside class="support-list" aria-label="Lịch sử liên hệ">
            <div class="support-list-heading"><h2>Lịch sử liên hệ</h2>
                <button type="button" disabled="@(busy || activeId is not null)" @onclick="New">+ Phiên mới</button></div>
            @if (loading) { <p class="support-empty" role="status">Đang tải…</p> }
            else if (conversations is null || conversations.Items.Count == 0) { <p class="support-empty">Bạn chưa có cuộc trò chuyện nào. Hãy gửi nội dung cần hỗ trợ ở khung bên cạnh.</p> }
            @if (conversations is not null)
            {
                @foreach (var item in conversations.Items)
                { <button type="button" class="conversation-link @(selected?.Id == item.Id ? "selected" : "")" disabled="@busy" @onclick="() => Select(item.Id)"><span><strong>@(item.ManagerName ?? "Ban quản lý")</strong><small>@Status(item.Status)</small></span><time>@Time(item.UpdatedAt)</time></button> }
                <nav class="support-pagination" aria-label="Phân trang hội thoại"><button disabled="@(busy || page <= 1)" @onclick="Previous">Trước</button><span>Trang @(page)</span><button disabled="@(busy || page * 12 >= conversations.Total)" @onclick="Next">Sau</button></nav>
            }
        </aside>
        }
        <section class="support-chat" aria-label="Khung trò chuyện với Ban quản lý">
            <header class="support-chat-heading"><div><h2>@(selected is null ? ForManager ? "Chọn cuộc trò chuyện" : "Trợ lý tiếp nhận BQL" : ForManager ? selected.ResidentName : selected.ManagerName ?? "Đang tìm Manager")</h2><small>@ConversationStatus</small></div>
                @if (selected is { Status: not "CLOSED" }) { <button class="support-close" disabled="@busy" @onclick="CloseConversation">Kết thúc phiên</button> }</header>
            @if (!ForManager)
            { <p class="draft-disclosure">Khi đã kết nối, Manager phụ trách có thể xem trực tiếp nội dung bạn đang gõ trước khi bấm Gửi. Chỉ tin đã gửi được lưu vào lịch sử.</p> }
            <div class="support-thread" @ref="thread" role="log" aria-live="polite" aria-relevant="additions text">
                @if (hasMore) { <button class="support-older" disabled="@busy" @onclick="Older">Tải tin nhắn trước</button> }
                @if (selected is null && !ForManager)
                { <article class="support-bubble system"><small>Trợ lý tiếp nhận</small><p>Xin chào! Bạn cần Ban quản lý hỗ trợ việc gì? Hãy mô tả để mình kết nối với Manager đang sẵn sàng.</p></article> }
                @foreach (var message in messages)
                {
                    var side = BubbleClass(message);
                    var menuId = $"support-message-menu-{message.Id:N}";
                    var selectable = selecting && message.Kind != "SYSTEM";
                    var picked = selectedMessages.Contains(message.Id);
                    <div @key="message.Id" class="support-message-row @side">
                        <article class="support-bubble @side @(selectable ? "selectable" : null)" data-message-id="@message.Id">
                            <div>
                                <strong>@message.SenderName</strong><time>@Time(message.CreatedAt)</time>
                            </div>
                            @if (message.Reply is { } quoted)
                            {
                                <blockquote class="support-message-quote">
                                    @if (quoted.SenderName is { } sender) { <strong>@sender</strong> }
                                    <span>@(quoted.Text ?? "Tin nhắn gốc không còn hiển thị")</span>
                                </blockquote>
                            }
                            @if (message.Forwarded) { <small class="support-message-label">Đã chuyển tiếp</small> }
                            <p class="@(message.RecalledAt is null ? null : "recalled")">@message.Text</p>
                            @if (IsMine(message) && message.RecalledAt is null)
                            { <small class="support-message-label support-receipt">@ReceiptLabel(message)</small> }
                            @if (selectable)
                            {
                                <input class="support-message-picker" type="checkbox"
                                       aria-label="@($"Chọn tin của {message.SenderName} lúc {Time(message.CreatedAt)}")"
                                       checked="@picked" disabled="@(busy || (selectedMessages.Count >= 50 && !picked))"
                                       @onchange="() => ToggleMessageSelection(message.Id)" />
                            }
                        </article>
                        @if (!selecting && message.Kind != "SYSTEM")
                        {
                            <div class="support-message-tools" role="group" aria-label="@($"Thao tác với tin của {message.SenderName} lúc {Time(message.CreatedAt)}")">
                                @if (message.RecalledAt is null)
                                {
                                    @if (selected is { Status: not "CLOSED" })
                                    {
                                        <button type="button" aria-label="Trả lời" title="Trả lời" disabled="@busy" @onclick="() => ReplyTo(message)">
                                            <span class="material-symbols-outlined" aria-hidden="true">format_quote</span>
                                        </button>
                                    }
                                    <button type="button" aria-label="Chuyển tiếp" title="Chuyển tiếp" disabled="@busy" @onclick="() => PrepareForward([message.Id])">
                                        <span class="material-symbols-outlined" aria-hidden="true">forward</span>
                                    </button>
                                }
                                <button type="button" class="support-message-more" aria-label="Tùy chọn" title="Tùy chọn"
                                        popovertarget="@menuId" disabled="@busy">
                                    <span class="material-symbols-outlined" aria-hidden="true">more_horiz</span>
                                </button>
                                <div id="@menuId" class="support-message-menu" popover="auto" role="group" aria-label="Tùy chọn tin nhắn">
                                    @if (message.RecalledAt is null)
                                    {
                                        <button type="button" popovertarget="@menuId" popovertargetaction="hide" disabled="@busy" @onclick="() => CopyMessageText(message.Text)">
                                            <span class="material-symbols-outlined" aria-hidden="true">content_copy</span>Sao chép tin nhắn
                                        </button>
                                        <hr />
                                    }
                                    <button type="button" popovertarget="@menuId" popovertargetaction="hide" disabled="@busy" @onclick="() => BeginSelection(message.Id)">
                                        <span class="material-symbols-outlined" aria-hidden="true">checklist</span>Chọn nhiều tin nhắn
                                    </button>
                                    <button type="button" aria-haspopup="dialog" popovertarget="@menuId" popovertargetaction="hide" disabled="@busy" @onclick="() => OpenMessageDetails(message.Id)">
                                        <span class="material-symbols-outlined" aria-hidden="true">info</span>Xem chi tiết
                                    </button>
                                    <hr />
                                    @if (message.RecalledAt is null && IsMine(message))
                                    {
                                        <button type="button" class="danger" popovertarget="@menuId" popovertargetaction="hide" disabled="@busy" @onclick="() => PrepareRecall([message.Id])">
                                            <span class="material-symbols-outlined" aria-hidden="true">undo</span>Thu hồi
                                        </button>
                                    }
                                    <button type="button" class="danger" popovertarget="@menuId" popovertargetaction="hide" disabled="@busy" @onclick="() => PrepareHide([message.Id])">
                                        <span class="material-symbols-outlined" aria-hidden="true">delete</span>Xóa ở phía tôi
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
                @if (!ForManager && selected is not null && Connection.IsTyping(selected.Id)) { <p class="support-typing" role="status">Manager đang nhập câu trả lời…</p> }
            </div>
            @if (ForManager && selected is { Status: "ACTIVE" } && Connection.Connected && Connection.Draft(selected.Id) is { } draft)
            { <aside class="support-live-draft" aria-label="Bản nháp cư dân đang gõ"><strong>Cư dân đang soạn — chưa gửi</strong><p>@draft</p><small>Nội dung có thể thay đổi trước khi gửi và không được lưu.</small></aside> }
            @if (selecting)
            {
                <div class="support-selection" role="group" aria-label="Thao tác với các tin đã chọn">
                    <span class="support-selection-count" aria-live="polite" aria-atomic="true">
                        <strong>@selectedMessages.Count</strong> Đã chọn
                    </span>
                    <button type="button" aria-label="Sao chép" title="Sao chép" disabled="@(busy || !HasSelectedContent)" @onclick="CopySelection">
                        <span class="material-symbols-outlined" aria-hidden="true">content_copy</span>
                    </button>
                    <button type="button" aria-label="Chuyển tiếp" title="Chuyển tiếp" disabled="@(busy || !CanForwardSelection)" @onclick="ForwardSelection">
                        <span class="material-symbols-outlined" aria-hidden="true">forward</span>
                    </button>
                    <button type="button" class="danger" aria-label="Thu hồi" title="Thu hồi" disabled="@(busy || !CanRecallSelection)" @onclick="RecallSelection">
                        <span class="material-symbols-outlined" aria-hidden="true">undo</span>
                    </button>
                    <button type="button" class="danger" aria-label="Xóa ở phía tôi" title="Xóa ở phía tôi" disabled="@(busy || selectedMessages.Count == 0)" @onclick="HideSelection">
                        <span class="material-symbols-outlined" aria-hidden="true">delete</span>
                    </button>
                    <button type="button" class="support-selection-cancel" disabled="@busy" @onclick="CancelSelection">Hủy</button>
                </div>
            }
            else if (selected?.Status == "CLOSED")
            { <div class="support-ended">Phiên đã kết thúc. @if (!ForManager && activeId is null) { <button type="button" @onclick="New">Bắt đầu phiên mới</button> }</div> }
            else if (!ForManager || selected is not null)
            {
                <form class="support-compose" aria-label="Soạn tin nhắn" @onsubmit="Send" @onsubmit:preventDefault>
                    @if (replyTo is { } reply)
                    {
                        <div class="support-reply-draft">
                            <div><strong>Đang trả lời @reply.SenderName</strong><span>@reply.Text</span></div>
                            <button type="button" aria-label="Hủy trả lời" disabled="@busy" @onclick="CancelReply">×</button>
                        </div>
                    }
                    <label class="support-sr" for="support-message">Nội dung tin nhắn</label>
                    <div class="support-compose-row">
                        <textarea id="support-message" value="@text" @oninput="Input" rows="1" maxlength="4000"
                                  readonly="@busy" enterkeyhint="send" aria-describedby="support-compose-hint"
                                  placeholder="@(ForManager ? "Nhập tin nhắn…" : "Bạn cần Ban quản lý hỗ trợ điều gì?")"></textarea>
                        <button type="submit" class="support-send" aria-label="Gửi tin nhắn" title="Gửi tin nhắn"
                                disabled="@(busy || string.IsNullOrWhiteSpace(text))">
                            @if (sending)
                            {
                                <span class="support-send-progress" aria-hidden="true"></span>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M22 2 7 12l-5-2 20-8Zm0 0-8 20-2-5 10-15ZM7 12l5 5" />
                                </svg>
                            }
                        </button>
                    </div>
                    <div class="support-compose-meta">
                        <small id="support-compose-hint">
                            <span class="support-compose-shortcuts">Enter để gửi · Shift+Enter để xuống dòng</span>
                            @if (!ForManager) { <span>@DraftStatus</span> }
                        </small>
                        <small>@text.Length / 4.000 ký tự</small>
                    </div>
                    @if (sending) { <small class="support-send-status" role="status">Đang gửi…</small> }
                    else if (sendFailed) { <small class="support-send-status failed" role="status">Chưa gửi được. Bạn có thể thử lại.</small> }
                </form>
            }
        </section>
    </div>
    }
</div>

@if (!identityChanged && confirmation is { } action)
{
    <PropFlowConfirmationDialog Title="@(action.Close ? "Kết thúc cuộc trò chuyện?" : "Chuyển cuộc trò chuyện?")"
        Message="@(action.Close ? "Các tin đã gửi vẫn được giữ trong lịch sử. Bản nháp chưa gửi sẽ bị xóa khi kết thúc phiên." : "Bản nháp đang soạn sẽ bị xóa khi chuyển sang cuộc trò chuyện khác.")"
        ConfirmText="@(action.Close ? "Kết thúc phiên" : "Chuyển cuộc trò chuyện")" CancelText="Ở lại" Tone="@(action.Close ? DialogTone.Danger : DialogTone.Confirm)"
        Busy="@busy" OnConfirm="ConfirmAction" OnCancel="CancelConfirmation" />
}

@if (!identityChanged && messageAction is { } pending)
{
    <PropFlowConfirmationDialog Title="@pending.Title" Message="@pending.Message" ConfirmText="@pending.ConfirmText"
        Tone="@(pending.Kind == MessageActionKind.Forward ? DialogTone.Confirm : DialogTone.Danger)" Busy="@busy"
        OnConfirm="ConfirmMessageAction" OnCancel="CancelMessageAction" />
}
@if (!identityChanged && messageDetails is { } details)
{
    var recipient = details.Kind == "MANAGER" ? selected?.ResidentName : selected?.ManagerName;
    var received = details.DeliveredAt is not null || details.SeenAt is not null;
    <PropFlowConfirmationDialog Title="Thông tin tin nhắn" Tone="DialogTone.Info" OnCancel="CloseMessageDetails">
        <ChildContent>
            <div class="support-details-preview">
                <article class="support-details-bubble @(IsMine(details) ? "mine" : null)">
                    <strong>@details.SenderName</strong>
                    <p>@details.Text</p>
                    <time datetime="@details.CreatedAt.ToString("O")">@DetailsTime(details.CreatedAt)</time>
                    @if (details.RecalledAt is { } recalled)
                    {
                        <small>Đã thu hồi · @DetailsTime(recalled)</small>
                    }
                </article>
            </div>
            <section class="support-details-receipt">
                <h3>@(details.SeenAt is not null ? "Đã xem (1)" : received ? "Đã nhận (1)" : "Đã nhận (0)")</h3>
                @if (received)
                {
                    <div class="support-details-recipient">
                        <span class="material-symbols-outlined support-details-avatar" aria-hidden="true">person</span>
                        <div>
                            <strong>@(recipient ?? "Người nhận")</strong>
                            @if (details.DeliveredAt is { } deliveredAt)
                            {
                                <small>Đã nhận · @DetailsTime(deliveredAt)</small>
                            }
                            @if (details.SeenAt is { } seenAt)
                            {
                                <small>Đã xem · @DetailsTime(seenAt)</small>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <p>Chưa có xác nhận đã nhận.</p>
                }
            </section>
        </ChildContent>
    </PropFlowConfirmationDialog>
}

@code {
    private readonly PropFlow.Web.Client.Shared.Feedback.ToastLifetime toastLifetime = new();

    [Parameter] public bool ForManager { get; set; }
    [Parameter] public Guid? RequestedConversationId { get; set; }
    private Guid? lastRequested;
    private readonly CancellationTokenSource lifetime = new();
    private readonly SemaphoreSlim refreshGate = new(1, 1);
    private SupportConversationPage? conversations;
    private SupportConversationView? selected;
    private List<SupportMessageView> messages = [];
    private Guid? activeId, pendingKey;
    private PendingConfirmation? confirmation;
    private sealed record PendingConfirmation(Guid ConversationId, bool Close);
    private string text = "", timeZoneId = "Asia/Ho_Chi_Minh", pendingText = "";
    private string? error;
    private int page = 1;
    private bool loading = true, busy, hasMore, disposed, scrollToEnd;
    private bool reloadAgain;
    private bool identityChanged;
    private Guid? ownerUserId;
    private Task? poll;
    private Task? draftPump;
    private long draftRevision;
    private CancellationTokenSource? draftDebounce;
    private IJSObjectReference? workspaceModule;
    private ElementReference workspace, thread;
    private string ConversationStatus => selected?.Status switch {
        "WAITING" => "Yêu cầu đang chờ Manager sẵn sàng. Bạn vẫn có thể gửi thêm nội dung.",
        "ACTIVE" => selected.ManagerOnline ? "Đang trao đổi với Ban quản lý" : "Manager đang mất kết nối. Tin đã gửi vẫn được lưu; bạn có thể chờ hoặc kết thúc phiên.",
        "CLOSED" => "Cuộc trò chuyện đã kết thúc", _ => ForManager ? "Chọn một phiên được phân để trả lời" : "Trợ lý sẽ tìm Manager sau khi bạn gửi nhu cầu hỗ trợ"
    };
    private string DraftStatus => selected is { Status: "ACTIVE", ManagerOnline: true } && Connection.Connected
        ? "Đang chia sẻ bản nháp với Manager" : "Bản nháp chưa được chia sẻ trực tiếp";
    protected override async Task OnInitializedAsync()
    {
        ownerUserId = Session.User?.Id; Session.AuthenticationStateChanged += AuthenticationChanged;
        Connection.Changed += Changed; Connection.TransientChanged += Transient; Connection.StateChanged += Transient;
        await Connection.EnsureAsync(lifetime.Token); await Reload(); poll = Poll();
    }
    private void AuthenticationChanged(Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState> state)
    {
        if (Session.User?.Id == ownerUserId) return;
        identityChanged = true; confirmation = null; ResetMessageTools(); lifetime.Cancel(); draftDebounce?.Cancel(); text = ""; messages.Clear(); selected = null; conversations = null;
        if (!disposed) _ = InvokeAsync(StateHasChanged);
    }
    protected override async Task OnParametersSetAsync()
    {
        if (RequestedConversationId is Guid id && id != lastRequested && !busy)
        { lastRequested = id; if (selected?.Id != id) await Select(id); }
    }
    private void Transient() { if (!disposed) _ = InvokeAsync(StateHasChanged); }
    private Task Changed(Guid id) => InvokeAsync(Reload);
    private async Task Reload()
    {
        if (disposed || identityChanged) return;
        if (!await refreshGate.WaitAsync(0)) { reloadAgain = true; return; }
        try
        {
            var list = await Api.List(page, lifetime.Token);
            if (disposed || identityChanged) return;
            if (!list.IsSuccess || list.Data is null) { error = list.Message; return; }
            error = null;
            conversations = list.Data; timeZoneId = list.Data.TimeZoneId;
            if (page == 1) activeId = conversations.Items.FirstOrDefault(x => x.Status != "CLOSED")?.Id;
            var id = selected?.Id ?? RequestedConversationId ?? activeId ?? (ForManager ? conversations.Items.FirstOrDefault()?.Id : null);
            if (id is Guid current) await LoadConversation(current, false);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        finally
        {
            loading = false; refreshGate.Release();
            if (!disposed) { StateHasChanged(); if (reloadAgain) { reloadAgain = false; _ = InvokeAsync(Reload); } }
        }
    }
    private async Task LoadConversation(Guid id, bool reset)
    {
        var detail = await Api.Get(id, lifetime.Token);
        if (!detail.IsSuccess || detail.Data is null) { error = detail.Message; return; }
        var history = await Api.Messages(id, null, lifetime.Token);
        if (!history.IsSuccess || history.Data is null) { error = history.Message; return; }
        var incoming = history.Data.Items.ToList();
        var previousLastResident = messages.Where(m => m.Kind == "RESIDENT").Select(m => m.Sequence).DefaultIfEmpty().Max();
        var changedSelection = selected?.Id != id;
        var more = history.Data.HasMore;
        if (!reset && !changedSelection && messages.Count > 0)
        {
            var oldest = messages[0].Sequence;
            while (more && incoming.Count > 0 && incoming[0].Sequence > oldest)
            {
                var older = await Api.Messages(id, incoming[0].Sequence, lifetime.Token);
                if (!older.IsSuccess || older.Data is null) { error = older.Message; return; }
                more = older.Data.HasMore;
                if (older.Data.Items.Count == 0) break;
                incoming.InsertRange(0, older.Data.Items);
            }
        }
        if (disposed || identityChanged) return;
        var newTail = changedSelection || (incoming.LastOrDefault()?.Sequence ?? 0) > (messages.LastOrDefault()?.Sequence ?? 0);
        if (changedSelection) ResetMessageTools();
        selected = detail.Data; timeZoneId = history.Data.TimeZoneId;
        messages = incoming;
        hasMore = more;
        SyncMessageTools();
        if (messages.Where(m => m.Kind == "RESIDENT").Select(m => m.Sequence).DefaultIfEmpty().Max() > previousLastResident || selected.Status != "ACTIVE") Connection.ClearDraft(id);
        scrollToEnd |= newTail || reset || changedSelection;
    }
    private async Task Select(Guid id)
    {
        if (busy || identityChanged || selected?.Id == id) return;
        if (!string.IsNullOrWhiteSpace(text)) { confirmation = new(id, false); return; }
        await SelectConversation(id);
    }
    private async Task SelectConversation(Guid id)
    {
        await ClearTransientForSelected(); ResetMessageTools(); text = ""; pendingKey = null; messages.Clear(); error = null;
        if (ForManager && RequestedConversationId != id)
        { Navigation.NavigateTo($"/manager/support-chat?conversation={id}"); return; }
        await refreshGate.WaitAsync(lifetime.Token); try { await LoadConversation(id, true); } finally { refreshGate.Release(); }
    }
    private async Task New()
    {
        if (busy || activeId is not null) return;
        await ClearTransientForSelected(); ResetMessageTools(); selected = null; messages.Clear(); text = ""; hasMore = false; error = null; pendingKey = null;
    }
    private void OperationError(PropFlow.Web.Client.Services.Api.ApiResult result)
    {
        if (lifetime.IsCancellationRequested) return;
        if (result.StatusCode is 401 or 403 || result.ValidationErrors?.Count > 0) error = result.Message;
        else Toasts.Error(result.Message);
    }
    private async Task Send()
    {
        var operationFeedback = Toasts.BeginOperation(toastLifetime);

        if (busy || disposed || identityChanged || selecting || confirmation is not null || messageAction is not null || string.IsNullOrWhiteSpace(text)
            || selected?.Status == "CLOSED" || (ForManager && selected is null)) return;
        busy = sending = true; sendFailed = false; error = null; var value = text.Trim();
        var replyId = replyTo?.Id;
        if (pendingKey is null || pendingText != value || pendingReplyId != replyId)
        { pendingKey = Guid.NewGuid(); pendingText = value; pendingReplyId = replyId; }
        try
        {
            await ClearTransientForSelected();
            if (disposed || identityChanged) return;
            if (selected is null)
            {
                var result = await Api.Start(new(pendingKey.Value, value), lifetime.Token);
                if (disposed || identityChanged) return;
                if (!result.IsSuccess || result.Data is null) { sendFailed = true; operationFeedback.Publish(() => OperationError(result)); return; }
                selected = result.Data;
            }
            else
            {
                var result = await Api.Send(selected.Id, new(pendingKey.Value, value, replyId), lifetime.Token);
                if (disposed || identityChanged) return;
                if (!result.IsSuccess || result.Data is null) { sendFailed = true; operationFeedback.Publish(() => OperationError(result)); return; }
                if (messages.All(message => message.Id != result.Data.Id))
                    messages = messages.Append(result.Data).OrderBy(message => message.Sequence).ToList();
            }
            text = ""; pendingKey = null; replyTo = null; await Reload(); scrollToEnd = true;
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        finally { busy = sending = false; }
    }
    private void CloseConversation()
    {
        if (busy || identityChanged || selected is null || selected.Status == "CLOSED") return;
        confirmation = new(selected.Id, true);
    }
    private void CancelConfirmation() { if (!busy) confirmation = null; }
    private async Task ConfirmAction()
    {
        if (busy || identityChanged || confirmation is not { } action) return;
        if (action.Close)
        {
            if (selected?.Id != action.ConversationId || selected.Status == "CLOSED") { confirmation = null; return; }
            await EndConversation(action.ConversationId);
        }
        else { confirmation = null; await SelectConversation(action.ConversationId); }
    }
    private async Task EndConversation(Guid id)
    {
        var operationFeedback = Toasts.BeginOperation(toastLifetime);

        busy = true;
        try
        {
            await ClearTransientForSelected(); var result = await Api.Close(id, lifetime.Token);
            if (disposed || identityChanged) return;
            if (!result.IsSuccess) { operationFeedback.Publish(() => OperationError(result)); return; }
            selected = result.Data; text = ""; pendingKey = null; ResetMessageTools(); await Reload(); operationFeedback.Publish(() => Toasts.Success("Đã kết thúc cuộc trò chuyện."));
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        finally { busy = false; confirmation = null; }
    }
    private async Task Older()
    {
        if (busy || selected is null || messages.Count == 0) return;
        busy = true;
        try { var result = await Api.Messages(selected.Id, messages[0].Sequence, lifetime.Token); if (result.IsSuccess && result.Data is not null) { messages = result.Data.Items.Concat(messages).DistinctBy(x => x.Id).OrderBy(x => x.Sequence).ToList(); hasMore = result.Data.HasMore; } else error = result.Message; }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        finally { busy = false; }
    }
    private void Input(ChangeEventArgs args)
    {
        text = args.Value?.ToString() ?? ""; sendFailed = false; draftRevision++;
        if (draftPump is { IsCompleted: false }) return;
        draftDebounce?.Dispose(); draftDebounce = CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token);
        draftPump = SendDraftWhileTyping(draftDebounce.Token);
    }
    private async Task SendDraftWhileTyping(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(300, ct);
                if (selected is not { Status: "ACTIVE" } current) return;
                var revision = draftRevision; var value = text;
                ct.ThrowIfCancellationRequested();
                if (ForManager) await Connection.PublishTyping(current.Id, value.Length > 0);
                else if (current.ManagerOnline) await Connection.PublishDraft(current.Id, value);
                if (revision == draftRevision) return;
            }
        }
        catch (OperationCanceledException) { }
    }
    private async Task ClearTransientForSelected()
    {
        draftDebounce?.Cancel();
        if (draftPump is { IsCompleted: false }) await draftPump;
        if (selected is null) return;
        if (ForManager) await Connection.PublishTyping(selected.Id, false); else await Connection.PublishDraft(selected.Id, "");
    }
    private Task Previous() => page > 1 ? ChangePageAsync(page - 1) : Task.CompletedTask;
    private Task Next() => ChangePageAsync(page + 1);
    private async Task ChangePageAsync(int target)
    {
        page = target;
        await Reload();
    }
    private async Task Poll()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1)); var tick = 0;
        try
        {
            while (await timer.WaitForNextTickAsync(lifetime.Token))
                await InvokeAsync(async () =>
                {
                    if (++tick % 10 == 0 && !busy) await Reload(); else StateHasChanged();
                    await SendReceipts();
                });
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./Features/Communication/SupportChat/SupportChatWorkspace.razor.js");
            if (disposed) { await module.DisposeAsync(); return; }
            workspaceModule = module;
            await module.InvokeVoidAsync("bindComposer", workspace);
        }
        if (disposed || workspaceModule is null) return;
        if (focusSelectionId is Guid messageId)
        {
            focusSelectionId = null;
            await workspaceModule.InvokeVoidAsync("focusMessagePicker", thread, messageId);
        }
        if (focusReply)
        {
            focusReply = false;
            await workspaceModule.InvokeVoidAsync("focusComposer", workspace);
        }
        if (!scrollToEnd) return;
        scrollToEnd = false;
        await workspaceModule.InvokeVoidAsync("bottom", thread);
    }
    private string Time(DateTimeOffset value) => TimeZoneInfo.ConvertTime(value, TimeZoneInfo.FindSystemTimeZoneById(timeZoneId)).ToString("dd/MM HH:mm");
    private string BubbleClass(SupportMessageView message) => message.Kind == "SYSTEM" ? "system" : (message.Kind == "MANAGER") == ForManager ? "mine" : "theirs";
    private static string Status(string value) => value switch { "WAITING" => "Đang chờ Manager", "ACTIVE" => "Đang trao đổi", "CLOSED" => "Đã kết thúc", _ => value };
    public async ValueTask DisposeAsync()
    { toastLifetime.Dispose();
        Session.AuthenticationStateChanged -= AuthenticationChanged;
        disposed = true; Connection.Changed -= Changed; Connection.TransientChanged -= Transient; Connection.StateChanged -= Transient;
        await ClearTransientForSelected(); lifetime.Cancel(); draftDebounce?.Cancel();
        if (poll is not null) await poll; if (draftPump is not null) await draftPump; draftDebounce?.Dispose();
        if (!ForManager) await Connection.ReleaseResidentAsync();
        if (workspaceModule is not null) try { await workspaceModule.DisposeAsync(); } catch (JSDisconnectedException) { }
        lifetime.Dispose();
    }
}
