@implements IAsyncDisposable
@inject EmergencyCallClient Calls
@inject IJSRuntime JS

<audio @ref="audio" autoplay playsinline></audio>

<section @ref="panel" class="emergency-overlay" popover="manual" role="dialog" aria-modal="true" aria-labelledby="emergency-title" tabindex="-1">
    @if (Calls.PanelOpen)
    {
        <div class="emergency-shell">
            <header><span class="emergency-icon material-symbols-outlined" aria-hidden="true">emergency</span><div><small>PROPFLOW · HỖ TRỢ KHẨN CẤP</small><h1 id="emergency-title">@(Calls.ForManager ? "Cư dân đang cần hỗ trợ" : "Kết nối khẩn cấp với BQL")</h1></div></header>
            @if (Calls.Current is { } call)
            {
                <div class="caller-card">
                    <span class="caller-avatar material-symbols-outlined" aria-hidden="true">@(Calls.ForManager ? "person" : "support_agent")</span>
                    <h2>@(Calls.ForManager ? call.ResidentName : call.ManagerName ?? "Đang tìm Manager trực")</h2>
                    @if (call.Apartment is { } apartment) { <p>Căn hộ cư dân: @apartment</p><small>Vị trí xảy ra sự cố cần được xác nhận qua cuộc gọi.</small> }
                    <p class="call-status" role="status">@Status</p>
                    @if (call.Status == "WAITING") { <p class="call-explanation">Báo khẩn cấp đã được ghi nhận. Chưa có Manager trực nhận cuộc gọi; chưa thể xác nhận có người đang hỗ trợ.</p> }
                    @if (!call.ResidentOnline && Calls.ForManager) { <p class="call-explanation">Cư dân đang mất kết nối với hệ thống. Báo khẩn cấp vẫn được giữ lại.</p> }
                </div>
                <div class="call-controls">
                    @if (call.Status != "ENDED")
                    {
                        <button class="microphone-control" type="button" @onclick="Calls.ToggleMuteAsync" aria-pressed="@Calls.Muted"><span class="material-symbols-outlined">@(Calls.Muted ? "mic_off" : "mic")</span>@(Calls.Muted ? "Bật micro" : "Tắt micro")</button>
                        <button class="end-call" type="button" @onclick="Calls.EndAsync" disabled="@Calls.Busy"><span class="material-symbols-outlined">call_end</span>Kết thúc cuộc gọi</button>
                        <button class="retry-call" type="button" @onclick="Calls.RetryAsync" disabled="@Calls.Busy"><span class="material-symbols-outlined">refresh</span>Kết nối lại</button>
                    }
                </div>
            }
            else if (Calls.Busy) { <p class="call-status" role="status">Đang gửi báo khẩn cấp và kết nối…</p> }
            @if (Calls.Error is { } error) { <p class="call-error" role="alert">@error</p> }
            @if (Calls.Current is { Status: not "ENDED" } && Calls.MediaState is "permission" or "microphone")
            { <button class="permission-button" type="button" @onclick="Calls.EnableMicrophoneAsync">Cho phép micro / tiếp tục kết nối</button> }
            @if (Calls.AudioBlocked) { <button class="permission-button" type="button" @onclick="Calls.PlayAudioAsync">Bật âm thanh để nghe người bên kia</button> }
            <aside class="direct-help"><strong>Nếu có cháy hoặc cần cứu nạn, gọi trực tiếp 114 ngay.</strong><p>Cuộc gọi PropFlow không thay thế đường dây cứu nạn. Không chờ kết nối trong ứng dụng nếu đang có nguy hiểm.</p><a href="tel:114"><span class="material-symbols-outlined" aria-hidden="true">call</span>Gọi 114</a></aside>
            @if (Calls.Current is null or { Status: "ENDED" }) { <button class="dismiss-call" type="button" @onclick="Calls.DismissAsync">Đóng giao diện cuộc gọi</button> }
        </div>
    }
</section>

@code {
    private ElementReference audio;
    private ElementReference panel;
    private IJSObjectReference? panelModule;
    private bool panelOpened;
    private string Status => Calls.Current?.Status switch
    {
        "ENDED" => "Cuộc gọi đã kết thúc",
        "WAITING" => "Đang chờ Manager trực",
        "CONNECTED" when Calls.MediaState == "connected" => "Đã kết nối thoại",
        _ when Calls.MediaState == "paused" => "Đã ngắt âm thanh tại thiết bị này",
        _ when Calls.MediaState is "disconnected" or "failed" => "Âm thanh bị gián đoạn — hãy thử kết nối lại",
        _ when Calls.MediaState is "permission" or "microphone" => "Cần quyền micro để nối âm thanh",
        _ => "Đang thiết lập cuộc gọi thoại…"
    };
    protected override void OnInitialized() => Calls.Changed += Changed;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Calls.ActivateAsync(audio);
        if (Calls.PanelOpen == panelOpened) return;
        panelOpened = Calls.PanelOpen;
        panelModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Shared/Feedback/PropFlowConfirmationDialog.razor.js?v=20261015.2");
        await panelModule.InvokeVoidAsync(panelOpened ? "open" : "close", panel);
    }
    private void Changed() => _ = InvokeAsync(StateHasChanged);
    public async ValueTask DisposeAsync()
    {
        Calls.Changed -= Changed;
        try
        {
            if (panelModule is not null) { await panelModule.InvokeVoidAsync("close", panel); await panelModule.DisposeAsync(); }
        }
        catch (JSDisconnectedException) { }
        finally { await Calls.DisposeAsync(); }
    }
}
