@page "/manager/service-requests"
@layout PropFlow.Web.Client.Layout.MainLayout
@attribute [Authorize(Roles = "MANAGER")]
@implements IDisposable
@using PropFlow.Web.Client.Shared.Management
@inject NavigationManager Navigation
@inject PropFlow.Web.Client.Features.ServiceRequests.Services.IManagerServiceRequestApiClient Api
@inject PropFlow.Web.Client.Features.ServiceRequests.Services.ServiceRequestRealtimeClient Realtime
@inject PropFlow.Web.Client.Features.Facility.Services.IBuildingApiClient BuildingApi

<PageTitle>Quản lý yêu cầu dịch vụ - PropFlow</PageTitle>

<div class="manager-request-list">
    <ManagementPageHeader Icon="support_agent" Title="Quản lý yêu cầu dịch vụ"
                          Description="Tiếp nhận, theo dõi và điều phối yêu cầu hỗ trợ từ cư dân." />

    <section class="metric-grid pf-management-metric-group" aria-label="Thống kê yêu cầu dịch vụ">
        <article><span class="metric-icon sky"><span class="material-symbols-outlined">inbox</span></span><div><small>Tổng yêu cầu</small><strong>@(summary?.Total ?? 0)</strong><p>Tất cả yêu cầu đã ghi nhận</p></div></article>
        <article><span class="metric-icon amber"><span class="material-symbols-outlined">pending_actions</span></span><div><small>Chờ tiếp nhận</small><strong>@(summary?.Submitted ?? 0)</strong><p>Cần Manager xem xét</p></div></article>
        <article><span class="metric-icon blue"><span class="material-symbols-outlined">engineering</span></span><div><small>Đang xử lý</small><strong>@(summary?.InProgress ?? 0)</strong><p>Đang trong luồng vận hành</p></div></article>
        <article><span class="metric-icon emerald"><span class="material-symbols-outlined">task_alt</span></span><div><small>Đã hoàn thành</small><strong>@(summary?.Completed ?? 0)</strong><p>Đã xử lý hoặc đóng</p></div></article>
    </section>

    <section class="request-panel pf-list-panel pf-management-list" aria-labelledby="request-table-title">
        <header class="panel-heading">
            <div><h2 id="request-table-title">Danh sách yêu cầu</h2><p>Dữ liệu trực tiếp từ hệ thống Service Request</p></div>
        </header>

        <div class="status-tabs" role="tablist" aria-label="Lọc theo trạng thái">
            @foreach (var tab in StatusTabs)
            {
                <button type="button" role="tab" aria-selected="@(selectedStatus == tab.Value)" class="@(selectedStatus == tab.Value ? "is-selected" : null)" @onclick="() => SelectStatus(tab.Value)">
                    @if (!string.IsNullOrWhiteSpace(tab.DotClass)) { <i class="@tab.DotClass"></i> }
                    <span>@tab.Label</span><b>@tab.Count</b>
                </button>
            }
        </div>

        <div class="filter-toolbar pf-list-toolbar pf-management-toolbar">
            <label class="search-field pf-list-search pf-management-search">
                <span class="material-symbols-outlined" aria-hidden="true">search</span>
                <input aria-label="Tìm yêu cầu dịch vụ" @bind="searchText" @onkeyup="HandleSearchKey" placeholder="Tìm theo mã hoặc tiêu đề…" />
                @if (!string.IsNullOrWhiteSpace(searchText))
                {
                    <button type="button" aria-label="Xóa tìm kiếm" @onclick="ClearSearch"><span class="material-symbols-outlined">close</span></button>
                }
            </label>
            <PropFlowFilterPopover Variant="Directory" ActiveCount="@ActiveFilterCount" Disabled="@loading" OnOpen="OpenFilters"
                                 OnReset="ResetDraft" OnApply="ApplyDraft" Validate="ValidateDraft">
                <label><span>Trạng thái yêu cầu</span><PropFlowFilterMultiSelect Options="RequestStatusOptions" Values="draft.Statuses" ValuesChanged="v=>draft=draft with {Statuses=v}" AriaLabel="Trạng thái yêu cầu" /></label>
                <label><span>Mức ưu tiên</span><PropFlowFilterMultiSelect Options="RequestPriorityOptions" Values="draft.Priorities" ValuesChanged="v=>draft=draft with {Priorities=v}" AriaLabel="Mức ưu tiên yêu cầu" /></label>
                <label><span>Loại yêu cầu</span><PropFlowFilterMultiSelect Options="CategoryOptions" Values="draft.Categories" ValuesChanged="v=>draft=draft with {Categories=v}" Searchable="true" Disabled="@(optionsLoading||optionsError is not null)" AriaLabel="Loại yêu cầu" /></label>
                <label><span>Nhân viên phụ trách</span><PropFlowFilterMultiSelect Options="StaffOptions" Values="draft.Staff" ValuesChanged="v=>draft=draft with {Staff=v}" Searchable="true" Disabled="@(optionsLoading||optionsError is not null)" AriaLabel="Nhân viên phụ trách yêu cầu" /></label>
                @if(optionsError is not null){<small role="alert">@optionsError</small>}
                <label><span>Phân công</span><PropFlowSelect Value="@(draft.Unassigned ? "true":"")" ValueChanged="SetUnassigned" Options="AssignmentFilterOptions" AriaLabel="Tình trạng phân công yêu cầu" Variant="Filter" /></label>
                <div class="pf-filter-range"><label><span>Ngày gửi từ</span><input type="date" @bind="draftFrom" /></label><label><span>Ngày gửi đến</span><input type="date" @bind="draftTo" /></label></div>
                <label><span>Thời gian nhanh</span><PropFlowSelect Value="@(draft.Recent ? "30":"")" ValueChanged="SetRecent" Options="RecentFilterOptions" AriaLabel="Thời gian nhanh yêu cầu" Variant="Filter" /></label>
                @if(filterError is not null){<small role="alert">@filterError</small>}
            </PropFlowFilterPopover>
            <span class="pf-management-count result-count">@items.Count yêu cầu đang hiển thị</span>
            <PropFlowListRefresh OnRefresh="LoadAsync" Busy="@loading" />
        </div>

        @if (loading)
        {
            <div class="empty-state"><span class="material-symbols-outlined">hourglass_top</span><h3>Đang tải yêu cầu</h3></div>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="empty-state"><span class="material-symbols-outlined">error</span><h3>Không tải được dữ liệu</h3><p>@errorMessage</p><button type="button" @onclick="LoadAsync">Thử lại</button></div>
        }
        else if (items.Count == 0)
        {
            <div class="empty-state">
                <span class="material-symbols-outlined">search_off</span>
                <h3>Không tìm thấy yêu cầu phù hợp</h3>
                <p>Thử thay đổi từ khóa hoặc đặt lại bộ lọc.</p>
                <button type="button" @onclick="ResetFilters">Đặt lại bộ lọc</button>
            </div>
        }
        else
        {
            <div class="request-table-wrap">
                <table class="pf-list-table request-table">
                    <thead><tr><th>Yêu cầu</th><th>Cư dân / Căn hộ</th><th>Thời gian</th><th>Ưu tiên</th><th>Trạng thái</th><th>Phụ trách</th><th><span class="sr-only">Thao tác</span></th></tr></thead>
                    <tbody>
                        @foreach (var request in items)
                        {
                            <tr class="request-row" @onclick="() => OpenDetail(request.Id)">
                                <td data-label="Yêu cầu">
                                    <button type="button" class="request-identity" @onclick="() => OpenDetail(request.Id)" @onclick:stopPropagation="true">
                                        <span class="request-number">@request.RequestNumber</span>
                                        <strong>@request.Title</strong>
                                        <small><span class="material-symbols-outlined">category</span>@(request.CategoryName ?? "Chưa phân loại")</small>
                                    </button>
                                </td>
                                <td data-label="Cư dân / Căn hộ"><div class="resident-cell"><span class="resident-mini-avatar">@Initials(request.ResidentName)</span><div><strong>@(request.ResidentName ?? "Chưa xác định")</strong><small>@ApartmentLabel(request)</small></div></div></td>
                                <td data-label="Thời gian"><div class="date-cell"><strong>@request.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy")</strong><small>@request.SubmittedAt.ToLocalTime().ToString("HH:mm")</small></div></td>
                                <td data-label="Ưu tiên"><span class="priority-chip @PriorityClass(request.PriorityCode)"><i></i>@PriorityLabel(request.PriorityCode)</span></td>
                                <td data-label="Trạng thái"><span class="status-chip @StatusClass(request.Status)"><i></i>@StatusLabel(request.Status)</span></td>
                                <td data-label="Phụ trách">
                                    @if (request.AssignedStaffUserId is null)
                                    {
                                        <span class="unassigned"><span class="material-symbols-outlined">person_add</span>Chưa phân công</span>
                                    }
                                    else
                                    {
                                        <div class="assignee-cell"><span>✓</span><div><strong>@(request.AssignedStaffDisplayName ?? "Đã phân công")</strong><small>@(request.AssignedStaffUsername ?? request.AssignedStaffUserId.ToString())</small></div></div>
                                    }
                                </td>
                                <td class="row-action"><button type="button" title="Xem chi tiết @request.RequestNumber" aria-label="Xem chi tiết @request.RequestNumber" @onclick="() => OpenDetail(request.Id)" @onclick:stopPropagation="true"><span class="material-symbols-outlined">arrow_forward</span></button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <TablePagination Page="page" TotalPages="@((int)Math.Ceiling(totalCount / (double)PageSize))" Busy="loading" Label="Phân trang yêu cầu"
            PageChanged="ChangePageAsync">
            <span>Hiển thị @items.Count / @totalCount yêu cầu phù hợp</span>
        </TablePagination>
    </section>
</div>

@code {
    private const int PageSize = 20;
    private string? searchText;
    private string selectedStatus = "ALL";
    private sealed record RequestFilters(IReadOnlyList<string> Statuses,IReadOnlyList<string> Priorities,IReadOnlyList<string> Categories,IReadOnlyList<string> Staff,bool Unassigned=false,bool Recent=false,DateTime? From=null,DateTime? To=null);
    private RequestFilters applied=new([],[],[],[]),draft=new([],[],[],[]);
    private DateTime? draftFrom,draftTo;
    private TimeZoneInfo? filterZone;
    private bool optionsLoading;
    private string? optionsError;
    private string? filterError;
    private IReadOnlyList<PropFlowSelectOption> CategoryOptions=[],StaffOptions=[];
    private static readonly PropFlowSelectOption[] RequestStatusOptions=[..new[]{"SUBMITTED","UNDER_REVIEW","ASSIGNED","IN_PROGRESS","RESOLVED","CLOSED","CANCELLED"}.Select(x=>new PropFlowSelectOption(x,StatusLabel(x)))];
    private static readonly PropFlowSelectOption[] RequestPriorityOptions=[new("LOW","Thấp"),new("NORMAL","Tiêu chuẩn"),new("HIGH","Cao"),new("URGENT","Khẩn cấp")];
    private static readonly PropFlowSelectOption[] AssignmentFilterOptions=[new("","Tất cả"),new("true","Chưa phân công")];
    private static readonly PropFlowSelectOption[] RecentFilterOptions=[new("","Không giới hạn"),new("30","30 ngày gần nhất")];
    private DateTimeOffset? Boundary(DateTime? value,bool end=false)=>value is null?null:new DateTimeOffset(TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(value.Value.Date.Add(end?TimeOnly.MaxValue.ToTimeSpan():TimeSpan.Zero),DateTimeKind.Unspecified),filterZone!));
    private int page = 1;
    private int totalCount;
    private bool loading;
    private bool disposed;
    private string? errorMessage;
    private readonly SemaphoreSlim loadGate = new(1, 1);
    private PropFlow.Web.Client.Features.ServiceRequests.Services.RealtimeRefreshQueue? realtimeRefresh;
    private PropFlow.Modules.ServiceRequests.Contracts.ManagerServiceRequestSummary? summary;
    private IReadOnlyList<PropFlow.Modules.ServiceRequests.Contracts.ManagerServiceRequestListItem> items = [];

    private IReadOnlyList<StatusTab> StatusTabs =>
    [
        new("ALL", "Tất cả", summary?.Total ?? 0, null),
        new("SUBMITTED", "Chờ tiếp nhận", summary?.Submitted ?? 0, "amber-dot"),
        new("ACTIVE", "Đang xử lý", summary?.InProgress ?? 0, "blue-dot"),
        new("RESOLVED", "Hoàn thành", summary?.Completed ?? 0, "emerald-dot")
    ];

    protected override async Task OnInitializedAsync()
    {
        realtimeRefresh = new(
            () => InvokeAsync(LoadCoreAsync),
            afterRefresh: () => InvokeAsync(StateHasChanged));
        Realtime.Changed += HandleRealtimeChangedAsync;
        await Task.WhenAll(LoadAsync(), Realtime.EnsureStartedAsync());
    }

    private Task LoadAsync() => realtimeRefresh?.RefreshNowAsync() ?? LoadCoreAsync();

    private async Task LoadCoreAsync()
    {
        await loadGate.WaitAsync();
        try
        {
            loading = true;
            errorMessage = null;
            var result = await Api.ListAsync(new(searchText,null,null,applied.Unassigned,page,PageSize,applied.Recent?30:null,
                applied.Statuses.ToArray(),applied.Priorities.ToArray(),applied.Categories.Select(Guid.Parse).ToArray(),applied.Staff.Select(Guid.Parse).ToArray(),Boundary(applied.From),Boundary(applied.To,true),selectedStatus));
            if (!result.IsSuccess || result.Data is null) { errorMessage = result.Message; items = []; return; }
            items = result.Data.Items;
            totalCount = result.Data.TotalCount;
            summary = result.Data.Summary;
        }
        finally
        {
            loading = false;
            loadGate.Release();
        }
    }

    private Task HandleRealtimeChangedAsync(Guid _) =>
        disposed ? Task.CompletedTask : realtimeRefresh?.RequestAsync() ?? Task.CompletedTask;
    public void Dispose() { disposed = true; Realtime.Changed -= HandleRealtimeChangedAsync; realtimeRefresh?.Dispose(); }

    private async Task SelectStatus(string status) { selectedStatus = status; page = 1; await LoadAsync(); }
    private int ActiveFilterCount => new[]{applied.Statuses.Count>0,applied.Priorities.Count>0,applied.Categories.Count>0,applied.Staff.Count>0,applied.Unassigned,applied.Recent,applied.From.HasValue||applied.To.HasValue}.Count(x=>x);
    private async Task OpenFilters()
    {
        draft=applied;draftFrom=applied.From;draftTo=applied.To;optionsLoading=true;optionsError=null;filterError=null;
        try
        {
            var result=await Api.FilterOptionsAsync();
            if(result.IsSuccess && result.Data is {} data && !data.LimitExceeded){CategoryOptions=data.Categories.Select(x=>new PropFlowSelectOption(x.Id.ToString(),x.Label)).ToArray();StaffOptions=data.Staff.Select(x=>new PropFlowSelectOption(x.Id.ToString(),x.Label)).ToArray();}
            else optionsError=result.Data?.LimitExceeded==true?"Danh mục vượt giới hạn tải an toàn. Chưa thể chọn loại/nhân viên; cần tìm kiếm danh mục phía server.":result.Message??"Không tải được danh mục bộ lọc.";
            var building=await BuildingApi.GetCurrentBuildingOverviewAsync();
            if(building.IsSuccess && building.Data is {} current)filterZone=TimeZoneInfo.FindSystemTimeZoneById(current.TimeZoneId);
        }
        finally{optionsLoading=false;}
    }
    private void ResetDraft(){draft=new([],[],[],[]);draftFrom=draftTo=null;filterError=null;}
    private void SetUnassigned(string value)=>draft=draft with {Unassigned=value=="true"};
    private void SetRecent(string value)=>draft=draft with {Recent=value=="30"};
    private bool ValidateDraft()
    {
        filterError=null;
        if(draftFrom>draftTo)filterError="Ngày bắt đầu phải trước hoặc bằng ngày kết thúc.";
        else if((draftFrom.HasValue||draftTo.HasValue)&&filterZone is null)filterError="Chưa đọc được múi giờ chung cư. Đóng và mở lại bộ lọc.";
        else {try{Boundary(draftFrom);Boundary(draftTo,true);}catch(ArgumentException){filterError="Ngày không hợp lệ trong múi giờ chung cư.";}}
        return filterError is null;
    }
    private async Task ApplyDraft()
    {
        applied=draft with {From=draftFrom,To=draftTo};
        page = 1;
        await LoadAsync();
    }
    private async Task ClearSearch() { searchText = null; page = 1; await LoadAsync(); }
    private async Task ResetFilters() { searchText = null; selectedStatus = "ALL"; applied=new([],[],[],[]); page = 1; await LoadAsync(); }
    private async Task ChangePageAsync(int target) { page = target; await LoadAsync(); }
    private async Task HandleSearchKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args) { if (args.Key == "Enter") { page = 1; await LoadAsync(); } }
    private void OpenDetail(Guid id) => Navigation.NavigateTo($"/manager/service-requests/{id}");

    private static string StatusLabel(string status) => status switch { "SUBMITTED" => "Chờ tiếp nhận", "UNDER_REVIEW" => "Đã tiếp nhận", "ASSIGNED" => "Đã phân công", "IN_PROGRESS" => "Đang tiến hành", "RESOLVED" => "Đã xử lý", "CLOSED" => "Đã đóng", "CANCELLED" => "Đã hủy", _ => status };
    private static string StatusClass(string status) => status switch { "SUBMITTED" => "status-amber", "UNDER_REVIEW" or "ASSIGNED" => "status-violet", "IN_PROGRESS" => "status-blue", "RESOLVED" or "CLOSED" => "status-emerald", _ => "" };
    private static string PriorityLabel(string? priority) => priority switch { "URGENT" => "Khẩn cấp", "HIGH" => "Cao", "LOW" => "Thấp", null => "Chưa xác định", _ => "Tiêu chuẩn" };
    private static string PriorityClass(string? priority) => priority switch { "URGENT" => "priority-urgent", "HIGH" => "priority-high", _ => "priority-standard" };
    private static string Initials(string? name) => string.IsNullOrWhiteSpace(name) ? "?" : string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(x => char.ToUpperInvariant(x[0])));
    private static string ApartmentLabel(PropFlow.Modules.ServiceRequests.Contracts.ManagerServiceRequestListItem x) => x.ApartmentUnitNumber is null ? "Chưa gắn căn hộ" : $"{x.ApartmentUnitNumber} · Tầng {x.FloorNumber}";

    private sealed record StatusTab(string Value, string Label, int Count, string? DotClass);
}
