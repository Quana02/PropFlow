 private Task SetRenewDeadlineDate(DateOnly? value){renewDeadlineDate=value;renewError=null;return Task.CompletedTask;}
 private async Task SaveRenewAsync(){if(renewingContract is null||RenewValidationMessage is not null)return;busy=true;renewError=null;try{var result=await Remote.RenewDeadlineAsync(renewingContract.Id,new(RenewDeadline()!.Value,renewingContract.Version));if(!result.IsSuccess){renewError=result.Code=="contract_not_expired"?"Hợp đồng không còn ở trạng thái hết hạn. Vui lòng tải lại danh sách.":result.Code=="metadata_concurrency_conflict"?"Dữ liệu hợp đồng đã thay đổi, vui lòng tải lại thông tin trước khi chỉnh sửa tiếp.":result.Code=="deadline_must_be_future"?"Hạn ký mới phải ở tương lai.":result.Message??"Không thể cập nhật hạn ký.";return;}renewingContract=null;await ReloadAsync();successMessage="Đã cập nhật hạn ký.";}finally{busy=false;}}
 private async Task<RejectionInfo?> LoadRejectionAsync(RemoteContractSummary item){var result=await Remote.HistoryAsync(item.Id);if(!result.IsSuccess)return null;var item2=result.Data?.Where(x=>x.Type=="CONTRACT_REJECTED").OrderByDescending(x=>x.OccurredAt).FirstOrDefault();if(item2 is null)return new(null,null,item.MetadataUpdatedAt);string? reason=null;try{using var json=System.Text.Json.JsonDocument.Parse(item2.Metadata);reason=json.RootElement.TryGetProperty("reason",out var r)?r.GetString():null;}catch(System.Text.Json.JsonException){}return new(reason,item2.ActorId,item2.OccurredAt);}
 private async Task OpenRejectInfoAsync(RemoteContractSummary item){rejectInfoContract=item;rejectInfo=null;rejectInfoError=null;rejectInfoLoading=true;try{rejectInfo=await LoadRejectionAsync(item);if(rejectInfo is null)rejectInfoError="Không thể tải lý do từ chối.";}finally{rejectInfoLoading=false;}}
 private void CloseRejectInfo(){if(busy)return;rejectInfoContract=null;rejectInfo=null;rejectInfoError=null;}
 private void OpenReassignFromInfo(){if(rejectInfoContract is null)return;var item=rejectInfoContract;CloseRejectInfo();OpenReassignCoreAsync(item);}
 private void OpenReassignAsync(RemoteContractSummary item)=>OpenReassignCoreAsync(item);
 private void OpenReassignCoreAsync(RemoteContractSummary item){reassignContract=item;reassignSelected=null;reassignCandidates=[];reassignSearch=null;reassignError=null;reassignSearchCts?.Cancel();}
 private void CloseReassign(){if(busy)return;reassignContract=null;reassignSelected=null;reassignCandidates=[];reassignSearch=null;reassignError=null;reassignSearchCts?.Cancel();reassignSearchCts=null;}
 private void SelectReassignCandidate(RemoteResidentCandidate candidate){reassignSelected=candidate;reassignError=null;}
 private async Task ReassignSearchInputAsync(ChangeEventArgs args){reassignSearch=args.Value?.ToString();reassignCandidates=[];reassignSelected=null;if(reassignContract is null)return;reassignSearchCts?.Cancel();var cts=new CancellationTokenSource();reassignSearchCts=cts;try{reassignSearching=true;await Task.Delay(350,cts.Token);if(string.IsNullOrWhiteSpace(reassignSearch)){reassignSearching=false;return;}var result=await Remote.SearchResidentsAsync(reassignSearch,cts.Token);if(cts.IsCancellationRequested)return;if(!result.IsSuccess){reassignError=result.Message??"Không thể tìm cư dân.";return;}reassignCandidates=(result.Data??[]).ToList();}catch(OperationCanceledException){}finally{if(reassignSearchCts==cts){reassignSearchCts=null;reassignSearching=false;}}}
 private async Task ConfirmReassignAsync(){if(reassignContract is null||reassignSelected is null)return;busy=true;reassignError=null;try{var result=await Remote.ReassignResidentAsync(reassignContract.Id,new(reassignSelected.UserId,reassignContract.Version));if(!result.IsSuccess){reassignError=result.Code=="deadline_expired"?"Hạn ký đã hết. Vui lòng cập nhật hạn ký trước khi gửi lại.":result.Code=="contract_not_rejected"?"Hợp đồng không còn ở trạng thái đã từ chối. Vui lòng tải lại danh sách.":result.Code=="metadata_concurrency_conflict"?"Dữ liệu hợp đồng đã thay đổi, vui lòng tải lại thông tin.":result.Message??"Không thể chuyển cư dân ký.";return;}var sameResident=reassignSelected.UserId==reassignContract.ResidentId;reassignContract=null;reassignSelected=null;reassignCandidates=[];await ReloadAsync();successMessage=sameResident?"Đã gửi lại hợp đồng cho cư dân.":"Đã chuyển và gửi hợp đồng cho cư dân mới.";}finally{busy=false;}}
 private void OpenDelete(RemoteContractSummary item){deleteContract=item;deleteError=null;}
 private void CloseDelete(){if(busy)return;deleteContract=null;deleteError=null;}
 private async Task ConfirmDeleteAsync(){if(deleteContract is null)return;busy=true;deleteError=null;try{var result=await Remote.DeleteDraftAsync(deleteContract.Id);if(!result.IsSuccess){deleteError=result.Code=="contract_not_draft"?"Hợp đồng không còn ở trạng thái bản nháp và không thể xóa.":result.Message??"Không thể xóa hợp đồng. Vui lòng thử lại.";return;}deleteContract=null;await ReloadAsync();if(page>Math.Max(1,TotalPages))page=Math.Max(1,TotalPages);successMessage="Đã xóa hợp đồng bản nháp.";}finally{busy=false;}}
 private sealed record RejectionInfo(string? Reason,Guid? ActorId,DateTimeOffset OccurredAt);
 public ValueTask DisposeAsync(){disposed=true;Realtime.Changed-=HandleRealtimeChangedAsync;reassignSearchCts?.Cancel();reassignSearchCts?.Dispose();return ValueTask.CompletedTask;}
}
