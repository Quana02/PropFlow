@page "/remote-contracts"
@layout PropFlow.Web.Client.Features.RemoteOnlineSign.RemoteContractLayout
@attribute [Authorize(Roles="ADMIN,RESIDENT")]
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using PropFlow.Web.Client.Features.RemoteOnlineSign.Models
@using PropFlow.Web.Client.Features.RemoteOnlineSign.Services
@using PropFlow.Web.Client.Services.Api
@using PropFlow.Web.Client.Features.RemoteOnlineSign.Components
@using PropFlow.Web.Client.Shared.Forms
@using PropFlow.Web.Client.Shared.Management
@using PropFlow.Web.Client.Shared.Tables
@inject RemoteOnlineSignApiClient Remote
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject RemoteOnlineSignRealtimeClient Realtime

<PageTitle>Hợp đồng ký từ xa - PropFlow</PageTitle>
<div class="app-page-body remote-contracts-page">
 <ManagementPageHeader Icon="draw" Title="Hợp đồng ký từ xa" Description="Theo dõi tài liệu, tiến độ và trạng thái ký hợp đồng từ xa.">
  <Actions>
   @if (isAdmin)
   {
    <button type="button" class="pf-management-primary" @onclick="OpenCreate" disabled="@busy"><span class="material-symbols-outlined" aria-hidden="true">add</span>Tạo hợp đồng</button>
   }
  </Actions>
 </ManagementPageHeader>
 @if (!string.IsNullOrWhiteSpace(error)) { <p class="remote-notice" role="alert"><span class="material-symbols-outlined" aria-hidden="true">error</span>@error</p> }
 @if (!string.IsNullOrWhiteSpace(successMessage)) { <p class="remote-success-notice" role="status"><span class="material-symbols-outlined" aria-hidden="true">check_circle</span>@successMessage</p> }
 <RemoteContractHistoryModal Open="@(historyContract is not null)" Contract="historyContract" Events="historyEvents" Loading="historyLoading" Error="@historyError" OnClose="CloseHistory" />
 @if (createOpen)
 {
  <div class="remote-create-backdrop" role="presentation" @onclick="CloseCreate">
   <section class="remote-create-modal" role="dialog" aria-modal="true" aria-labelledby="remote-create-title" @onclick:stopPropagation="true">
    <header class="remote-create-modal__header"><div><h2 id="remote-create-title">Tạo hợp đồng mới</h2><p>Tạo bản nháp, kiểm tra PDF và tiếp tục thiết lập ký sau khi lưu.</p></div><button type="button" class="remote-create-modal__close" aria-label="Đóng" title="Đóng" @onclick="CloseCreate" disabled="@busy"><span class="material-symbols-outlined" aria-hidden="true">close</span></button></header>
    <div class="remote-create-modal__body">
     <section class="remote-create-form" aria-label="Thông tin hợp đồng">
      <h3>Thông tin hợp đồng</h3>
      @if (!string.IsNullOrWhiteSpace(createError)) { <p class="remote-create-error" role="alert">@createError</p> }
      <div class="remote-create-field"><label>Hạn ký <small>(Không bắt buộc)</small></label><label class="remote-metadata-deadline"><input type="checkbox" @bind="hasDeadline" disabled="@busy" /> Thiết lập hạn ký</label>@if(hasDeadline){<div class="remote-create-date-time"><label>Ngày hết hạn<PropFlowDatePicker Value="deadlineDate" ValueChanged="SetDeadlineDate" AriaLabel="Ngày hạn ký" Disabled="@busy" /></label><label>Giờ (24h)<PropFlowSelect @bind-Value="deadlineHour" Options="HourOptions" AriaLabel="Giờ hạn ký" Disabled="@busy" /></label><label>Phút<PropFlowSelect @bind-Value="deadlineMinute" Options="MinuteOptions" AriaLabel="Phút hạn ký" Disabled="@busy" /></label></div><small>Múi giờ: TP. Hồ Chí Minh (UTC+7).</small>}</div>
      <div class="remote-create-field"><label>PDF hợp đồng <small>@selectedPdfs.Count/20 · @FormatFileSize(selectedPdfs.Sum(x => (long)x.Bytes.Length))/100 MB</small></label><div class="remote-pdf-upload"><InputFile @key="fileInputVersion" id="@fileInputId" class="remote-pdf-upload__input" OnChange="ChoosePdfAsync" accept="application/pdf,.pdf" multiple disabled="@busy" /><label for="@fileInputId" class="remote-pdf-upload__choose"><span class="material-symbols-outlined" aria-hidden="true">add</span>Chọn thêm tệp PDF</label><small class="remote-pdf-upload__hint">Tối đa 20 tệp · mỗi tệp 20 MB · tổng 100 MB</small>@if (pdfErrors.Count > 0) { <ul class="remote-pdf-upload__errors" role="alert">@foreach (var message in pdfErrors) { <li>@message</li> }</ul> }<div class="remote-pdf-upload__list">@foreach (var pdf in selectedPdfs) { <div class="remote-pdf-upload__item @(pdf.Id == activePdfId ? "is-active" : null)"><div class="remote-pdf-upload__file-row"><button type="button" class="remote-pdf-upload__select" @onclick="() => SelectPdf(pdf.Id)"><span class="material-symbols-outlined" aria-hidden="true">picture_as_pdf</span><span><strong>@pdf.Name</strong><small>@FormatFileSize(pdf.Bytes.Length)</small></span></button><button type="button" class="remote-pdf-upload__remove material-symbols-outlined" aria-label="Xóa @pdf.Name" title="Xóa @pdf.Name" @onclick="() => RemovePdf(pdf.Id)" disabled="@busy">delete</button></div><label class="remote-pdf-upload__name"><span>Tên hợp đồng</span><input value="@pdf.ContractName" maxlength="200" aria-label="Tên hợp đồng cho @pdf.Name" @oninput="args => ChangeContractName(pdf.Id, args.Value?.ToString())" disabled="@busy" /></label>@if (!string.IsNullOrWhiteSpace(pdf.Error)) { <p class="remote-pdf-upload__file-error" role="alert">@pdf.Error</p> }</div> }</div></div></div>
     </section>
     <RemoteLocalPdfPreview PdfBytes="@ActivePdf?.Bytes" FileName="@(ActivePdf?.Name ?? string.Empty)" FilePosition="@(ActivePdf is null ? string.Empty : $"{selectedPdfs.IndexOf(ActivePdf) + 1}/{selectedPdfs.Count}")" HasDocument="@(ActivePdf is not null)" Revision="@pdfRevision" />
    </div>
    <footer class="remote-create-modal__footer"><button type="button" class="remote-secondary-button" @onclick="CloseCreate" disabled="@busy">Hủy</button><button type="button" class="pf-management-primary" @onclick="CreateAsync" disabled="@(busy || selectedPdfs.Count == 0)">@(busy ? "Đang tạo hợp đồng..." : "Tạo hợp đồng")</button></footer>
   </section>
  </div>
 }
 @if (editingContract is not null)
 {
  <div class="remote-create-backdrop remote-metadata-backdrop" role="presentation"><section class="remote-metadata-modal" role="dialog" aria-modal="true" aria-labelledby="remote-metadata-title"><header class="remote-metadata-modal__header"><div class="remote-metadata-modal__heading"><h2 id="remote-metadata-title">Chỉnh sửa thông tin hợp đồng</h2><p>Cập nhật tên hợp đồng và hạn ký.</p></div><button type="button" class="remote-metadata-modal__close" aria-label="Đóng" title="Đóng" @onclick="CloseEdit" disabled="@busy"><span class="material-symbols-outlined" aria-hidden="true">close</span></button></header><div class="remote-metadata-modal__body"><div class="remote-metadata-code"><span>Mã hợp đồng</span><strong>@editingContract.ContractCode</strong></div>@if (!string.IsNullOrWhiteSpace(editError)) { <p class="remote-create-error" role="alert">@editError</p> }@if (EditingWasSentToResident) { <p class="remote-metadata-warning" role="status">Hợp đồng đã được gửi cho cư dân. Các thay đổi về tên hợp đồng hoặc hạn ký sẽ được ghi nhận trong lịch sử hợp đồng.</p> }<label class="remote-metadata-field"><span class="remote-metadata-label">Tên hợp đồng <span aria-hidden="true">*</span></span><input class="remote-metadata-input" @bind="editName" @bind:event="oninput" maxlength="200" aria-invalid="@(EditValidationMessage is not null)" disabled="@busy" /></label>@if (!string.IsNullOrWhiteSpace(EditValidationMessage) && !busy) { <p class="remote-create-error" role="alert">@EditValidationMessage</p> }<label class="remote-metadata-deadline"><input type="checkbox" @bind="editHasDeadline" disabled="@busy" /><span>Thiết lập hạn ký</span></label>@if(editHasDeadline){<div class="remote-metadata-date-time"><label>Ngày hết hạn<PropFlowDatePicker Value="editDeadlineDate" ValueChanged="SetEditDeadlineDate" AriaLabel="Ngày hết hạn" Disabled="@busy" /></label><label>Giờ<PropFlowSelect @bind-Value="editDeadlineHour" Options="HourOptions" AriaLabel="Giờ hạn ký" Disabled="@busy" /></label><label>Phút<PropFlowSelect @bind-Value="editDeadlineMinute" Options="MinuteOptions" AriaLabel="Phút hạn ký" Disabled="@busy" /></label></div><p class="remote-metadata-timezone">Múi giờ: TP. Hồ Chí Minh (UTC+7)</p>}@if (!string.IsNullOrWhiteSpace(EditSaveHint) && EditSaveHint != EditValidationMessage) { <p class="remote-metadata-hint" role="status">@EditSaveHint</p> }</div><footer class="remote-metadata-modal__footer"><button type="button" class="remote-secondary-button" @onclick="CloseEdit" disabled="@busy">Hủy</button><button type="button" class="pf-management-primary" @onclick="SaveEditAsync" disabled="@(busy || !CanSaveEdit)">@(busy ? "Đang lưu…" : "Lưu thay đổi")</button></footer></section></div>
 }
 @if (renewingContract is not null)
 {
  <div class="remote-create-backdrop remote-metadata-backdrop" role="presentation"><section class="remote-metadata-modal" role="dialog" aria-modal="true" aria-labelledby="remote-renew-title"><header class="remote-metadata-modal__header"><div class="remote-metadata-modal__heading"><h2 id="remote-renew-title">Cập nhật hạn ký</h2><p>Gia hạn thời gian ký cho hợp đồng đã hết hạn.</p></div><button type="button" class="remote-metadata-modal__close" aria-label="Đóng" title="Đóng" @onclick="CloseRenew" disabled="@busy"><span class="material-symbols-outlined" aria-hidden="true">close</span></button></header><div class="remote-metadata-modal__body">
   <div class="remote-metadata-code"><span>Mã hợp đồng</span><strong>@renewingContract.ContractCode</strong></div>
   <div class="remote-metadata-code"><span>Tên hợp đồng</span><strong class="remote-metadata-name">@renewingContract.ContractName</strong></div>
   <div class="remote-metadata-code"><span>Trạng thái</span><strong>Hết hạn</strong></div>
   <div class="remote-metadata-code"><span>Hạn ký hiện tại</span><strong>@FormatDeadline(renewingContract.Deadline)</strong></div>
   @if (!string.IsNullOrWhiteSpace(renewError)) { <p class="remote-create-error" role="alert">@renewError</p> }
   <div class="remote-metadata-field"><span class="remote-metadata-label">Hạn ký mới <span aria-hidden="true">*</span></span></div>
   <div class="remote-metadata-date-time"><label>Ngày hết hạn<PropFlowDatePicker Value="renewDeadlineDate" ValueChanged="SetRenewDeadlineDate" AriaLabel="Ngày hết hạn mới" Disabled="@busy" /></label><label>Giờ<PropFlowSelect @bind-Value="renewDeadlineHour" Options="HourOptions" AriaLabel="Giờ hạn ký" Disabled="@busy" /></label><label>Phút<PropFlowSelect @bind-Value="renewDeadlineMinute" Options="MinuteOptions" AriaLabel="Phút hạn ký" Disabled="@busy" /></label></div>
   <p class="remote-metadata-timezone">Múi giờ: TP. Hồ Chí Minh (UTC+7)</p>
   @if (!string.IsNullOrWhiteSpace(RenewValidationMessage) && !busy) { <p class="remote-create-error" role="alert">@RenewValidationMessage</p> }
  </div><footer class="remote-metadata-modal__footer"><button type="button" class="remote-secondary-button" @onclick="CloseRenew" disabled="@busy">Hủy</button><button type="button" class="pf-management-primary" @onclick="SaveRenewAsync" disabled="@(busy || RenewValidationMessage is not null)">@(busy ? "Đang cập nhật…" : "Cập nhật hạn ký")</button></footer></section></div>
 }
 @if (rejectInfoContract is not null)
 {
  <div class="remote-create-backdrop remote-metadata-backdrop" role="presentation"><section class="remote-metadata-modal" role="dialog" aria-modal="true" aria-labelledby="remote-reject-info-title"><header class="remote-metadata-modal__header"><div class="remote-metadata-modal__heading"><h2 id="remote-reject-info-title">Lý do từ chối ký</h2><p>@rejectInfoContract.ContractName</p></div><button type="button" class="remote-metadata-modal__close" aria-label="Đóng" title="Đóng" @onclick="CloseRejectInfo" disabled="@busy"><span class="material-symbols-outlined" aria-hidden="true">close</span></button></header><div class="remote-metadata-modal__body">
   <div class="remote-metadata-code"><span>Mã hợp đồng</span><strong>@rejectInfoContract.ContractCode</strong></div>
   <div class="remote-metadata-code"><span>Cư dân đã từ chối</span><strong>@(rejectInfoContract.ResidentName ?? "Chưa gán")@(string.IsNullOrWhiteSpace(rejectInfoContract.ResidentCode)?"":" · "+rejectInfoContract.ResidentCode)</strong></div>
   @if (rejectInfo is not null) { <div class="remote-metadata-code"><span>Thời gian từ chối</span><strong>@FormatMetadataUpdated(rejectInfo.OccurredAt)</strong></div> }
   @if (rejectInfoLoading) { <p class="remote-metadata-hint" role="status">Đang tải lý do từ chối…</p> }
   else if (!string.IsNullOrWhiteSpace(rejectInfoError)) { <p class="remote-create-error" role="alert">@rejectInfoError</p> }
   <div class="remote-metadata-field"><span class="remote-metadata-label">Lý do từ chối</span><div class="remote-reject-reason-box">@(rejectInfo?.Reason ?? "Không có lý do được ghi nhận")</div></div>
  </div><footer class="remote-metadata-modal__footer"><button type="button" class="remote-secondary-button" @onclick="CloseRejectInfo" disabled="@busy">Đóng</button><button type="button" class="pf-management-primary" @onclick="OpenReassignFromInfo" disabled="@(busy || rejectInfoLoading)">Gửi lại hợp đồng</button></footer></section></div>
 }
 @if (reassignContract is not null)
 {
  <div class="remote-create-backdrop remote-metadata-backdrop" role="presentation"><section class="remote-metadata-modal" role="dialog" aria-modal="true" aria-labelledby="remote-reassign-title"><header class="remote-metadata-modal__header"><div class="remote-metadata-modal__heading"><h2 id="remote-reassign-title">Gửi lại hợp đồng</h2><p>@reassignContract.ContractName · @reassignContract.ContractCode</p></div><button type="button" class="remote-metadata-modal__close" aria-label="Đóng" title="Đóng" @onclick="CloseReassign" disabled="@busy"><span class="material-symbols-outlined" aria-hidden="true">close</span></button></header><div class="remote-metadata-modal__body">
   <div class="remote-metadata-code"><span>Cư dân hiện tại</span><strong>@(reassignContract.ResidentName ?? "Chưa gán")@(string.IsNullOrWhiteSpace(reassignContract.ResidentCode)?"":" · "+reassignContract.ResidentCode)</strong></div>
   <p class="remote-metadata-warning" role="status"><span class="material-symbols-outlined" aria-hidden="true">warning</span>Nội dung PDF có thể chứa thông tin định danh của cư dân trước. Vui lòng kiểm tra tài liệu trước khi gửi cho cư dân mới.</p>
   @if (reassignContract.Deadline is { } dl && dl <= DateTimeOffset.UtcNow) { <p class="remote-create-error" role="alert">Hạn ký đã hết. Vui lòng cập nhật hạn ký trước khi gửi lại.</p> }
   @if (!string.IsNullOrWhiteSpace(reassignError)) { <p class="remote-create-error" role="alert">@reassignError</p> }
   <label class="remote-metadata-field"><span class="remote-metadata-label">Chọn cư dân ký</span><div class="remote-reassign-search"><span class="material-symbols-outlined" aria-hidden="true">search</span><input value="@reassignSearch" @oninput="ReassignSearchInputAsync" placeholder="Tên, mã cư dân hoặc email" autocomplete="off" disabled="@busy" /></div></label>
   @if (reassignSearching) { <p class="remote-metadata-hint" role="status">Đang tìm cư dân…</p> }
   else if (reassignCandidates.Count > 0) { <ul class="remote-reassign-list">@foreach (var candidate in reassignCandidates) { var isSel = reassignSelected?.UserId == candidate.UserId; <li><button type="button" class="remote-reassign-item @(isSel ? "selected" : "")" @onclick="() => SelectReassignCandidate(candidate)" disabled="@busy"><span class="material-symbols-outlined" aria-hidden="true">person</span><span class="remote-reassign-item__text"><strong>@candidate.FullName</strong>@if(candidate.UserId==reassignContract.ResidentId){<em class="remote-reassign-badge">Cư dân hiện tại</em>}<small>@candidate.ResidentCode@(candidate.Apartments.Count > 0 ? $" · {string.Join(", ", candidate.Apartments)}" : "")</small></span>@if (isSel) { <span class="material-symbols-outlined" aria-hidden="true">check_circle</span> }</button></li> }</ul> }
   else if (!string.IsNullOrWhiteSpace(reassignSearch)) { <p class="remote-metadata-hint" role="status">Không có cư dân đủ điều kiện ký.</p> }
   <p class="remote-metadata-hint" role="status">Bạn có thể gửi lại hợp đồng cho cư dân hiện tại hoặc chọn cư dân khác đủ điều kiện ký. Sau khi xác nhận, hợp đồng sẽ được chuyển sang trạng thái Chờ cư dân ký.</p>
  </div><footer class="remote-metadata-modal__footer"><button type="button" class="remote-secondary-button" @onclick="CloseReassign" disabled="@busy">Hủy</button><button type="button" class="pf-management-primary" @onclick="ConfirmReassignAsync" disabled="@(busy || reassignSelected is null || (reassignContract.Deadline is { } d2 && d2 <= DateTimeOffset.UtcNow))">@(busy ? "Đang xử lý…" : "Xác nhận gửi lại")</button></footer></section></div>
 }
 @if (deleteContract is not null)
 {
  <div class="remote-create-backdrop remote-metadata-backdrop" role="presentation"><section class="remote-metadata-modal" role="dialog" aria-modal="true" aria-labelledby="remote-delete-title"><header class="remote-metadata-modal__header"><div class="remote-metadata-modal__heading"><h2 id="remote-delete-title">Xóa hợp đồng</h2><p>@deleteContract.ContractName · @deleteContract.ContractCode</p></div><button type="button" class="remote-metadata-modal__close" aria-label="Đóng" title="Đóng" @onclick="CloseDelete" disabled="@busy"><span class="material-symbols-outlined" aria-hidden="true">close</span></button></header><div class="remote-metadata-modal__body">
   <div class="remote-metadata-code"><span>Trạng thái</span><strong>Bản nháp</strong></div>
   <p class="remote-metadata-warning" role="status"><span class="material-symbols-outlined" aria-hidden="true">warning</span>Hợp đồng và các tài liệu liên quan sẽ bị xóa. Thao tác này không thể hoàn tác.</p>
   @if (!string.IsNullOrWhiteSpace(deleteError)) { <p class="remote-create-error" role="alert">@deleteError</p> }
  </div><footer class="remote-metadata-modal__footer"><button type="button" class="remote-secondary-button" @onclick="CloseDelete" disabled="@busy">Hủy</button><button type="button" class="remote-delete-danger" @onclick="ConfirmDeleteAsync" disabled="@busy">@(busy ? "Đang xóa…" : "Xóa hợp đồng")</button></footer></section></div>
 }
 <section class="remote-contracts-panel pf-list-panel pf-management-list" aria-label="Danh sách hợp đồng ký từ xa" aria-busy="@loading">
  <form class="remote-toolbar pf-list-toolbar pf-management-toolbar" @onsubmit="ApplyFilters" @onsubmit:preventDefault="true">
   <label class="remote-search"><span class="material-symbols-outlined" aria-hidden="true">search</span><input type="search" aria-label="Tìm kiếm hợp đồng" @bind="searchDraft" placeholder="Tìm tên, mã hợp đồng hoặc cư dân" /></label>
   <div class="remote-toolbar-controls">
    <div class="remote-toolbar-deadlines"><label class="remote-date-filter"><span>Hạn ký từ</span><PropFlowDatePicker Value="deadlineFrom" ValueChanged="SetDeadlineFrom" AriaLabel="Hạn ký từ ngày" /></label><label class="remote-date-filter"><span>Hạn ký đến</span><PropFlowDatePicker Value="deadlineTo" ValueChanged="SetDeadlineTo" AriaLabel="Hạn ký đến ngày" /></label></div>
    <div class="remote-filter-select"><PropFlowSelect @bind-Value="signingModeFilter" Options="SigningModeFilters" Variant="Filter" AriaLabel="Lọc theo chế độ ký" /></div><div class="remote-filter-select"><PropFlowSelect @bind-Value="residentFilter" Options="ResidentFilters" Variant="Filter" AriaLabel="Lọc theo cư dân" /></div><button type="submit" class="remote-filter-submit"><span class="material-symbols-outlined" aria-hidden="true">filter_alt</span><span>Tìm</span></button><button type="button" class="remote-filter-clear" @onclick="ClearFilters" disabled="@(!HasActiveFilters)">Xóa bộ lọc</button><PropFlowListRefresh OnRefresh="ReloadAsync" Busy="@loading" />
    @if (IsDeadlineRangeInvalid) { <span class="remote-filter-date-error" role="alert">Từ ngày không được sau Đến ngày.</span> }
   </div>
  </form>
  <div class="remote-status-filters" role="group" aria-label="Lọc theo trạng thái hợp đồng">@foreach (var filter in VisibleStatusFilters) { <button type="button" class="remote-status-filter @(statusFilter == filter.Value ? "is-active" : null)" data-tone="@filter.Tone" aria-pressed="@(statusFilter == filter.Value)" @onclick="() => SetStatusFilter(filter.Value)">@filter.Label</button> }</div>
  @if (loading) { <div class="remote-state" role="status"><span class="material-symbols-outlined" aria-hidden="true">progress_activity</span><p>Đang tải danh sách hợp đồng…</p></div> }
  else if (VisibleContracts.Count == 0) { <div class="remote-state"><span class="material-symbols-outlined" aria-hidden="true">description</span><h2>Chưa có hợp đồng phù hợp</h2><p>@(contracts.Count == 0 ? "Tạo hợp đồng đầu tiên để bắt đầu quy trình ký PDF." : "Thử thay đổi từ khóa hoặc bộ lọc trạng thái.")</p></div> }
