@page "/remote-contracts/{Id:guid}"
@layout PropFlow.Web.Client.Features.RemoteOnlineSign.RemoteContractLayout
@attribute [Authorize(Roles="ADMIN,RESIDENT")]
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.Text.Json
@using PropFlow.Web.Client.Features.RemoteOnlineSign.Models
@using PropFlow.Web.Client.Features.RemoteOnlineSign.Services
@using PropFlow.Web.Client.Features.RemoteOnlineSign.Components
@inject RemoteOnlineSignApiClient Remote
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject RemoteOnlineSignRealtimeClient Realtime

<PageTitle>Không gian ký hợp đồng - PropFlow</PageTitle>
@if (loading) { <p>Đang tải không gian hợp đồng…</p> }
else if (contract is not null) {
<section class="remote-workspace">
 <header class="workspace-header">
  <div class="workspace-title"><button class="remote-back" @onclick="NavigateList" aria-label="Quay lại danh sách hợp đồng"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span><span>Danh sách</span></button><div><h1 title="@contract.ContractName">@contract.ContractName</h1><p class="workspace-subtitle">@contract.ContractCode</p></div></div>
  <div class="workspace-actions"><span class="status-pill" data-tone="@StatusTone(contract.Status)">@Status(contract.Status)</span>@if(CanSign){<button class="remote-primary" @onclick="OpenSigning">Ký hợp đồng</button>}</div>
 </header>
 <div class="workspace-controls">
 @if(IsAdmin && contract.Status is "DRAFT" or "INVESTOR_SIGNED_DRAFT") { <ol class="workspace-stepper" aria-label="Các bước thiết lập hợp đồng"><li class="@StepClass(1)"><span>1</span><small>Chế độ ký</small></li><li class="@StepClass(2)"><span>2</span><small>Vị trí chữ ký</small></li>@if(contract.SigningMode=="INVESTOR_AND_RESIDENT"){<li class="@StepClass(3)"><span>3</span><small>Chủ đầu tư ký</small></li>}<li class="@StepClass(contract.SigningMode=="INVESTOR_AND_RESIDENT"?4:3)"><span>@(contract.SigningMode=="INVESTOR_AND_RESIDENT"?4:3)</span><small>Chọn cư dân</small></li><li class="@StepClass(contract.SigningMode=="INVESTOR_AND_RESIDENT"?5:4)"><span>@(contract.SigningMode=="INVESTOR_AND_RESIDENT"?5:4)</span><small>Gửi hợp đồng</small></li></ol> }
 @if(showModeConfirmation) { <RemoteModeChangeDialog Busy="@busy" Error="@modeChangeError" OnCancel="() => showModeConfirmation=false" OnConfirm="() => SaveModeAsync(true)" /> }
 <nav class="workspace-toolbar" aria-label="Công cụ hợp đồng">
  @if(IsAdmin&&contract.Status=="DRAFT"){<button class='@(activePanel == "fields" ? "active" : "")' @onclick='() => OpenPanel("fields")'>Vùng ký</button>@if(CanAssignResident){<button class='@(activePanel == "resident" ? "active" : "")' @onclick="ContinueToResident">Chọn cư dân</button>}}@if(IsAdmin&&contract.Status=="INVESTOR_SIGNED_DRAFT"&&CanAssignResident){<button class='@(activePanel == "resident" ? "active" : "")' @onclick="ContinueToResident">Chọn cư dân</button>}@if(IsAdmin&&CanSend){<button class='@(activePanel == "send" ? "active" : "")' @onclick='() => OpenPanel("send")'>Gửi hợp đồng</button>}
  @if(CanSign){<button class='@(activePanel == "sign" ? "active" : "")' @onclick="OpenSigning">Chữ ký</button>}
  <span class="toolbar-spacer"></span>
  <button @onclick="ZoomOutAsync" disabled="@(busy||document is null)" title="Thu nhỏ">−</button><span>@(Math.Round(viewerZoom*100))%</span><button @onclick="ZoomInAsync" disabled="@(busy||document is null)" title="Phóng to">+</button>
  <button @onclick="RotateAsync" disabled="@(busy||document is null)">Xoay @viewerRotation°</button><button @onclick="DownloadAsync" disabled="@(busy||document is null)">Tải xuống</button><button @onclick="PrintAsync" disabled="@(busy||document is null)">In</button>
 </nav>
 </div>
 <div class="workspace-body">
  <aside class="workspace-pages"><h2>Trang</h2>
   @if(document is not null)
   {
    @for(var page=1;page<=document.PageCount;page++)
    {
     var selected=page==viewerPage;
     <button class='page-thumb @(selected ? "current" : "")' @onclick='() => GoToPageAsync(page)'>Trang @(page)</button>
    }
   }
  </aside>
   <main class="workspace-document">
    @if(!string.IsNullOrWhiteSpace(message)) { <p class='workspace-message @(error ? "error" : "")' role="alert">@message</p> }
    @if(document is null)
    { @if(documentFailed) { <div class="workspace-empty"><span class="material-symbols-outlined" aria-hidden="true">cloud_off</span><h2>Không tải được thông tin PDF</h2><p>@(message ?? "Vui lòng thử lại.")</p><button class="remote-primary" @onclick="() => ReloadAsync()" disabled="@busy">Thử lại</button></div> } else { <div class="workspace-empty"><span class="material-symbols-outlined" aria-hidden="true">upload_file</span><h2>Chưa có tài liệu hợp đồng</h2><p>@(IsAdmin&&contract.Status=="DRAFT"?"Tải PDF để bắt đầu đặt vùng ký.":"Tài liệu chưa sẵn sàng để xem.")</p>@if(IsAdmin&&contract.Status=="DRAFT") { <InputFile id="workspace-pdf-upload" class="workspace-upload-input" OnChange="UploadAsync" accept="application/pdf" disabled="@busy"/><label for="workspace-pdf-upload" class="remote-primary workspace-upload-action">Tải lên PDF</label><small>PDF tối đa 20 MB và 100 trang.</small> }@if(error&&!string.IsNullOrWhiteSpace(message)){<p class="remote-create-error" role="alert">@message</p>}</div> } }
    else
    { <div class="remote-pdf-viewer" @ref="viewerHost" aria-label="Nội dung PDF hợp đồng" style="@(viewerFailed?"display:none":"")"></div>@if(viewerFailed){<div class="workspace-empty"><span class="material-symbols-outlined" aria-hidden="true">picture_as_pdf</span><h2>Không tải được nội dung PDF</h2><p>@(message ?? "Vui lòng thử lại.")</p><button class="remote-primary" @onclick="RetryViewerAsync" disabled="@busy">Thử lại</button></div>} }
   </main>
  <aside class="workspace-side">
   @if(ActiveSidebarPanel=="progress")
   { <div class="side-panel">
    <header class="side-panel__header"><span class="side-panel__icon material-symbols-outlined" aria-hidden="true">description</span><div class="side-panel__heading"><h2>@(IsAdmin?"Tiến độ hợp đồng":"Thông tin hợp đồng")</h2><p>@SigningProgress(contract)</p></div></header>
    <div class="side-panel__body">
     @if(IsAdmin&&contract.Status=="DRAFT"){<section class="side-section"><p class="side-kicker">Bước 1/@(contract.SigningMode=="INVESTOR_AND_RESIDENT"?"5":"4") · Chế độ ký</p><div class="side-modes"><label class="workspace-mode-card @(selectedSigningMode == "INVESTOR_AND_RESIDENT" ? "selected" : "")"><input type="radio" name="detail-signing-mode" value="INVESTOR_AND_RESIDENT" @onchange='() => selectedSigningMode = "INVESTOR_AND_RESIDENT"' checked="@(selectedSigningMode == "INVESTOR_AND_RESIDENT")" /><span class="material-symbols-outlined" aria-hidden="true">group</span><span><strong>Hai bên ký</strong><small>Chủ đầu tư và cư dân lần lượt ký.</small></span></label><label class="workspace-mode-card @(selectedSigningMode == "PRE_SIGNED_INVESTOR" ? "selected" : "")"><input type="radio" name="detail-signing-mode" value="PRE_SIGNED_INVESTOR" @onchange='() => selectedSigningMode = "PRE_SIGNED_INVESTOR"' checked="@(selectedSigningMode == "PRE_SIGNED_INVESTOR")" /><span class="material-symbols-outlined" aria-hidden="true">file_download_done</span><span><strong>PDF đã được chủ đầu tư ký sẵn</strong><small>Chỉ yêu cầu cư dân ký.</small></span></label></div><button class="side-btn side-btn--primary side-btn--block" disabled="@(busy||string.IsNullOrWhiteSpace(selectedSigningMode))" @onclick="SelectModeAsync">@(busy?"Đang lưu…":contract.SigningMode=="UNSELECTED"?"Lưu và tiếp tục":"Lưu thay đổi")</button><div class="side-divider"></div></section>}
     @if(!(IsAdmin&&contract.Status=="DRAFT")){var st=SideStatus;<div class="side-status" data-tone="@st.Tone"><span class="material-symbols-outlined" aria-hidden="true">@st.Icon</span><div><strong>@st.Title</strong><p>@st.Text</p></div></div>}
     <dl class="side-kv">
      <div class="side-kv__row"><dt>Chế độ ký</dt><dd>@Mode(contract.SigningMode)</dd></div>
      <div class="side-kv__row"><dt>Chủ đầu tư</dt><dd>@InvestorStatusLabel</dd></div>
      <div class="side-kv__row"><dt>Cư dân</dt><dd>@ResidentLabel</dd></div>
      <div class="side-kv__row"><dt>Hạn ký</dt><dd>@DeadlineLabel</dd></div>
      <div class="side-kv__row"><dt>Tài liệu</dt><dd>@DocumentLabel</dd></div>
     </dl>
     @if(CanSign&&(!IsAdmin||contract.Status=="PENDING_INVESTOR_SIGNATURE")){<button class="side-btn side-btn--primary side-btn--block" @onclick="OpenSigning" disabled="@busy"><span class="material-symbols-outlined" aria-hidden="true">draw</span>Ký hợp đồng</button>}
     @if(!isAdmin&&contract.Status=="PENDING_RESIDENT_SIGNATURE"){<button class="side-btn side-btn--danger side-btn--block" @onclick="OpenReject" disabled="@busy"><span class="material-symbols-outlined" aria-hidden="true">block</span>Từ chối ký</button>}
     @if(contract.Status=="REJECTED"&&RejectionReason is not null){<div class="side-reject-reason"><span class="material-symbols-outlined" aria-hidden="true">info</span><div><strong>Lý do từ chối</strong><p>@RejectionReason</p></div></div>}
    </div>
   </div> }
   else if(ActiveSidebarPanel=="sign"&&IsAdmin&&contract.Status=="DRAFT"&&contract.SigningMode=="INVESTOR_AND_RESIDENT"&&HasSavedRequiredFields)
   { <div class="side-panel">
    <header class="side-panel__header"><span class="side-panel__icon material-symbols-outlined" aria-hidden="true">draw</span><div class="side-panel__heading"><h2>Chủ đầu tư ký</h2><p>Bước 3/5 · Ký hợp đồng với tư cách chủ đầu tư trước khi chọn cư dân.</p></div></header>
    <div class="side-panel__body">
     <div class="side-status side-status--saved"><span class="material-symbols-outlined" aria-hidden="true">check_circle</span><div><strong>Đã lưu đủ hai vùng ký</strong><p>Vùng ký Chủ đầu tư và Cư dân đã được lưu trên PDF.</p></div></div>
     <div class="side-status" data-tone="warning"><span class="material-symbols-outlined" aria-hidden="true">pending</span><div><strong>Chủ đầu tư chưa ký</strong><p>Vui lòng ký hợp đồng trước khi chọn cư dân.</p></div></div>
    </div>
    <footer class="side-panel__footer"><button class="side-btn side-btn--primary side-btn--block" @onclick="OpenSigning" disabled="@busy"><span class="material-symbols-outlined" aria-hidden="true">draw</span>Ký hợp đồng</button></footer>
   </div> }
    else if(ActiveSidebarPanel=="send"&&IsAdmin&&CanSend)
    { <div class="side-panel">
    <header class="side-panel__header"><span class="side-panel__icon material-symbols-outlined" aria-hidden="true">send</span><div class="side-panel__heading"><h2>Gửi hợp đồng</h2><p>Kiểm tra thông tin trước khi gửi hợp đồng cho cư dân ký.</p></div></header>
    <div class="side-panel__body">
     <dl class="side-kv side-kv--card">
      <div class="side-kv__row"><dt>Tên hợp đồng</dt><dd class="side-kv__wrap">@contract.ContractName</dd></div>
      <div class="side-kv__row"><dt>Mã hợp đồng</dt><dd class="side-kv__code">@contract.ContractCode</dd></div>
      <div class="side-kv__row"><dt>Chế độ ký</dt><dd>@Mode(contract.SigningMode)</dd></div>
      @if(contract.SigningMode=="INVESTOR_AND_RESIDENT"){<div class="side-kv__row"><dt>Chủ đầu tư</dt><dd><span class="side-ok"><span class="material-symbols-outlined" aria-hidden="true">check_circle</span>Đã ký</span></dd></div>}
      <div class="side-kv__row"><dt>Cư dân</dt><dd>@contract.ResidentName (@contract.ResidentCode)</dd></div>
      <div class="side-kv__row"><dt>Hạn ký</dt><dd>@DeadlineLabel</dd></div>
     </dl>
    </div>
    <footer class="side-panel__footer side-panel__footer--stack">
     <button class="side-btn side-btn--secondary side-btn--block" @onclick="ContinueToResident" disabled="@busy"><span class="material-symbols-outlined" aria-hidden="true">group</span>Chọn lại cư dân</button>
     <button class="side-btn side-btn--primary side-btn--block" @onclick="SendAsync" disabled="@(busy||!CanSend)"><span class="material-symbols-outlined" aria-hidden="true">send</span>Gửi hợp đồng</button>
    </footer>
   </div> }
    else if(ActiveSidebarPanel=="resident"&&IsAdmin&&CanAssignResident)
   { <div class="side-panel">
    <header class="side-panel__header"><span class="side-panel__icon material-symbols-outlined" aria-hidden="true">person_search</span><div class="side-panel__heading"><h2>Chọn cư dân</h2><p>Chọn cư dân đủ điều kiện để nhận và ký hợp đồng.</p></div></header>
    <div class="side-panel__body">
     <label class="side-search"><span class="material-symbols-outlined" aria-hidden="true">search</span><input value="@residentSearch" @oninput="ResidentSearchInputAsync" placeholder="Tên, mã cư dân hoặc email" autocomplete="off"/></label>
     @if(residentSearching){<p class="side-hint"><span class="material-symbols-outlined" aria-hidden="true">progress_activity</span>Đang tìm cư dân…</p>}
     else if(residentCandidates.Count>0){<ul class="side-cards">@foreach(var candidate in residentCandidates){var isSel=selectedResident?.UserId==candidate.UserId;<li><button type="button" class="side-card @(isSel?"selected":"")" @onclick='() => SelectResident(candidate)' disabled="@busy"><span class="side-card__badge material-symbols-outlined" aria-hidden="true">person</span><span class="side-card__text"><strong>@candidate.FullName</strong><small>@candidate.ResidentCode@(candidate.Apartments.Count>0?$" · {string.Join(", ",candidate.Apartments)}":"")</small></span>@if(isSel){<span class="material-symbols-outlined side-card__check" aria-hidden="true">check_circle</span>}</button></li>}</ul>}
     else if(!string.IsNullOrWhiteSpace(residentSearch)){<p class="side-hint"><span class="material-symbols-outlined" aria-hidden="true">search_off</span>Không có cư dân đủ điều kiện ký.</p>}
     @if(contract.ResidentId is not null){<div class="side-status" data-tone="success"><span class="material-symbols-outlined" aria-hidden="true">how_to_reg</span><div><strong>Đã gán cư dân</strong><p>@contract.ResidentName (@contract.ResidentCode)</p></div></div>}
     @if(selectedResident is not null){<p class="side-hint side-hint--selected"><span class="material-symbols-outlined" aria-hidden="true">check</span>Đã chọn: @selectedResident.FullName · @selectedResident.ResidentCode</p>}
     <p class="side-hint"><span class="material-symbols-outlined" aria-hidden="true">info</span>Hệ thống kiểm tra lại tài khoản và quyền ký khi xác nhận.</p>
    </div>
    <footer class="side-panel__footer side-panel__footer--stack">
     @if(selectedResident is not null){<button class="side-btn side-btn--primary side-btn--block" @onclick="AssignAsync" disabled="@busy"><span class="material-symbols-outlined" aria-hidden="true">person_add</span>Xác nhận gán cư dân</button>}
     @if(contract.ResidentId is not null){<button class="side-btn side-btn--primary side-btn--block" @onclick='() => OpenPanel("send")' disabled="@busy"><span class="material-symbols-outlined" aria-hidden="true">send</span>Tiếp tục — Gửi hợp đồng</button>}
    </footer>
   </div> }
   else if(ActiveSidebarPanel=="fields"&&IsAdmin&&contract.Status=="DRAFT")
    { <div class="side-panel">
    <header class="side-panel__header"><span class="side-panel__icon material-symbols-outlined" aria-hidden="true">draw</span><div class="side-panel__heading"><h2>Vùng ký</h2><p>Chọn trang rồi thêm vùng ký. Kéo để di chuyển, kéo góc để đổi kích thước.</p></div></header>
    <div class="side-panel__body">
     <button class="side-link" @onclick="BackToMode" disabled="@busy"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>Chế độ ký</button>
     <div class="side-actions">
      @if(contract.SigningMode!="PRE_SIGNED_INVESTOR"){<button class="side-btn side-btn--ghost" @onclick="AddInvestor" disabled="@busy"><span class="material-symbols-outlined" aria-hidden="true">add</span>Vùng Chủ đầu tư</button>}
      <button class="side-btn side-btn--ghost" @onclick="AddResident" disabled="@busy"><span class="material-symbols-outlined" aria-hidden="true">add</span>Vùng Cư dân</button>
      @if(selectedFieldRole is not null){<button class="side-btn side-btn--ghost side-btn--danger" @onclick="RemoveSelectedField" disabled="@busy"><span class="material-symbols-outlined" aria-hidden="true">delete</span>Xóa vùng đã chọn</button>}
     </div>
     <ul class="side-cards field-cards">@foreach(var field in fields.OrderBy(x=>x.Page).ThenBy(x=>x.Role)){var isSel=selectedFieldRole==field.Role;<li><button type="button" class="side-card side-card--@(field.Role=="INVESTOR"?"investor":"resident") @(isSel?"selected":"")" @onclick='()=>SelectFieldAsync(field)' disabled="@busy"><span class="side-card__badge material-symbols-outlined" aria-hidden="true">@(field.Role=="INVESTOR"?"apartment":"person")</span><span class="side-card__text"><strong>@FieldLabel(field.Role)</strong><small>Trang @field.Page</small></span>@if(isSel){<span class="material-symbols-outlined side-card__check" aria-hidden="true">check_circle</span>}</button></li>}</ul>
     @if(fieldsDirty){<p class="side-status" data-tone="warning"><span class="material-symbols-outlined" aria-hidden="true">edit</span>Có thay đổi vùng ký chưa lưu.</p>}
     else if(HasSavedRequiredFields){<p class="side-status" data-tone="success"><span class="material-symbols-outlined" aria-hidden="true">check_circle</span>@(contract.SigningMode=="INVESTOR_AND_RESIDENT"?"Đã lưu đủ vùng ký. Tiếp tục ký với tư cách chủ đầu tư.":"Đã lưu đủ vùng ký. Tiếp tục chọn cư dân.")</p>}
    </div>
    <footer class="side-panel__footer side-panel__footer--stack">
     <button class="side-btn side-btn--primary side-btn--block" @onclick="SaveFieldsAsync" disabled="@(busy||document is null||!HasRequiredFields)">Lưu vùng ký</button>
     @if(HasSavedRequiredFields){@if(contract.SigningMode=="INVESTOR_AND_RESIDENT"){<button class="side-btn side-btn--secondary side-btn--block" @onclick="OpenSigning" disabled="@busy"><span class="material-symbols-outlined" aria-hidden="true">draw</span>Tiếp tục — Ký hợp đồng</button>}else{<button class="side-btn side-btn--secondary side-btn--block" @onclick="ContinueToResident" disabled="@busy"><span class="material-symbols-outlined" aria-hidden="true">person_search</span>Tiếp tục — Chọn cư dân</button>}}
    </footer>
   </div> }
   else if(ActiveSidebarPanel=="history")
   { <div class="side-panel">
    <header class="side-panel__header"><span class="side-panel__icon material-symbols-outlined" aria-hidden="true">history</span><div class="side-panel__heading"><h2>Lịch sử</h2></div></header>
    <div class="side-panel__body">@if(!VisibleHistory.Any()){<p class="side-hint">Chưa có sự kiện.</p>}else{<ul class="history-list">@foreach(var item in VisibleHistory){var metadataChange=MetadataChange(item);<li><strong>@RemoteContractHistoryLabels.For(item.Type)</strong><br/><small>@FormatVietnamTime(item.OccurredAt) — @(item.Type=="CONTRACT_METADATA_UPDATED"?"ADMIN":"")</small>@if(metadataChange is not null){<div class="metadata-history">@if(metadataChange.ContractNameChanged){<div><span>Tên hợp đồng</span><small>Trước: @metadataChange.BeforeContractName</small><small>Sau: @metadataChange.AfterContractName</small></div>}@if(metadataChange.DeadlineChanged){<div><span>Hạn ký</span><small>Trước: @FormatDeadline(metadataChange.BeforeDeadline)</small><small>Sau: @FormatDeadline(metadataChange.AfterDeadline)</small></div>}</div>}</li>}</ul>}</div>
   </div> }
   else { <div class="side-panel"><header class="side-panel__header"><span class="side-panel__icon material-symbols-outlined" aria-hidden="true">contract</span><div class="side-panel__heading"><h2>Không gian hợp đồng</h2><p>Chọn công cụ trên thanh phía trên để tiếp tục.</p></div></header></div> }
  </aside>
 </div>
</section>
}

@if(showSigning&&contract is not null){if(sessionId==Guid.Empty){<RemoteSignatureModal Subtitle="@(contract.SigningMode=="INVESTOR_AND_RESIDENT"&&contract.Status=="DRAFT"?"Vui lòng tạo chữ ký của chủ đầu tư để tiếp tục.":SigningProgress(contract))" Busy="@busy" ErrorMessage="@(error?message:null)" OnCancel="CloseSigning" OnSubmit="HandleSignatureSubmitAsync" />}else{<RemoteSignatureOtpModal ContractName="@DocumentTitle" ContractCode="@contract.ContractCode" Otp="@(otp??string.Empty)" ExpiryRemaining="@OtpRemaining" ResendRemaining="@ResendRemaining" CanResend="@CanResendOtp" Expired="@OtpExpired" Busy="@busy" ErrorMessage="@(error?message:null)" OtpChanged="@(value=>otp=value)" OnConfirm="VerifyAsync" OnResend="RequestOtpAsync" OnClose="CloseSigning"/>}}
@if(showReject&&contract is not null){<RemoteContractRejectDialog ContractName="@contract.ContractName" ContractCode="@contract.ContractCode" Busy="@busy" Error="@rejectError" OnCancel="CloseReject" OnSubmit="RejectAsync"/>}
@code {
 [Parameter] public Guid Id {get;set;} private RemoteContractSummary? contract; private RemoteDocumentMetadata? document; private List<RemoteSignatureField> fields=[]; private List<RemoteAuditEvent> history=[]; private List<RemoteResidentCandidate> residentCandidates=[]; private RemoteResidentCandidate? selectedResident; private CancellationTokenSource? residentSearchCts; private bool residentSearching,loading=true,busy,error,isAdmin,viewerRefresh,showSigning,fieldsDirty,documentFailed,viewerFailed,pdfRendered; private string activePanel="progress"; private string? message,residentSearch,signatureMethod="TYPE",otp,selectedFieldRole; private byte[]? signatureImage; private Guid sessionId; private DateTimeOffset? otpExpiresAt,otpResendAfter; private DateTimeOffset otpClock=DateTimeOffset.UtcNow; private Timer? otpTimer; private ElementReference viewerHost; private IJSObjectReference? pdfModule,signatureModule; private DotNetObjectReference<RemoteContractDetail>? dotNet; private int viewerPage=1,viewerRotation; private decimal viewerZoom=1m;
