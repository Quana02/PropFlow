@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using PropFlow.Web.Client.Features.RemoteOnlineSign.Models
@implements IAsyncDisposable
@inject IJSRuntime JS
<div class="rsm-backdrop"><section class="rsm-modal" role="dialog" aria-modal="true" aria-labelledby="rsm-title">
 <header><div><h2 id="rsm-title">Ký hợp đồng</h2><p>@Subtitle</p></div><button class="rsm-icon" title="Đóng" @onclick="OnCancel">×</button></header>
 <nav role="tablist"><button class="@Tab("DRAW")" @onclick='()=>SetTab("DRAW")'><span class="material-symbols-outlined">draw</span>Vẽ chữ ký</button><button class="@Tab("UPLOAD")" @onclick='()=>SetTab("UPLOAD")'><span class="material-symbols-outlined">image</span>Hình ảnh</button><button class="@Tab("TYPE")" @onclick='()=>SetTab("TYPE")'><span class="material-symbols-outlined">text_fields</span>Gõ chữ ký</button></nav>
 <div class="rsm-body">@if(method=="DRAW"){<div class="rsm-toolbar"><label>Kiểu<PropFlowSelect Options="DrawStyleOptions" @bind-Value="drawStyle" AriaLabel="Kiểu nét vẽ" /></label><button class="rsm-icon" title="Xóa chữ ký" aria-label="Xóa chữ ký" @onclick="Clear"><span class="material-symbols-outlined">delete</span></button></div><div class="rsm-canvas-wrap"><canvas @ref="canvas" @onpointerdown="MarkDrawn"></canvas>@if(!drawn){<span>Vẽ chữ ký của bạn tại đây</span>}</div>}
 else if(method=="UPLOAD"){<div class="rsm-upload" @ondragover:preventDefault @ondrop="Drop">@if(image is null){<span class="material-symbols-outlined">add_photo_alternate</span><strong>Kéo và thả ảnh chữ ký vào đây</strong><small>PNG, JPG, JPEG · tối đa 5 MB</small><label class="rsm-secondary rsm-file-trigger"><span class="material-symbols-outlined">upload</span>Chọn ảnh từ thiết bị<InputFile class="rsm-file" OnChange="Pick" accept="image/png,image/jpeg"/></label>}else{<img src="@preview" alt="Xem trước chữ ký"/><strong>@fileName · @Size(image.Length)</strong><div><label class="rsm-secondary">Thay ảnh<InputFile class="rsm-file" OnChange="Pick" accept="image/png,image/jpeg"/></label><button class="rsm-icon" title="Xóa ảnh" aria-label="Xóa ảnh" @onclick="ClearImage"><span class="material-symbols-outlined">delete</span></button></div>}</div>}
 else{<label class="rsm-field">Phông chữ<PropFlowSelect Options="FontOptions" @bind-Value="font" AriaLabel="Phông chữ ký" Searchable="true" /></label><label class="rsm-field">Chữ ký<input maxlength="50" placeholder="Nhập chữ ký của bạn" @bind="text"/></label><small class="rsm-count">@(text?.Length??0)/50</small><div class="rsm-type-preview" style="font-family:@font">@text</div>}</div>
 @if(!string.IsNullOrWhiteSpace(ErrorMessage)){<p class="rsm-error" role="alert">@ErrorMessage</p>}<footer><button class="rsm-secondary" @onclick="OnCancel">Hủy</button><button class="rsm-primary" disabled="@(!Valid||Busy)" @onclick="Submit">@(Busy?"Đang xử lý…":"Yêu cầu OTP")</button></footer>
</section></div>
@code{[Parameter]public string Subtitle{get;set;}="Xác nhận chữ ký của bạn.";[Parameter]public bool Busy{get;set;}[Parameter]public string? ErrorMessage{get;set;}[Parameter]public EventCallback OnCancel{get;set;}[Parameter]public EventCallback<RemoteSignaturePayload> OnSubmit{get;set;}private ElementReference canvas;private IJSObjectReference? js;private string method="DRAW",drawStyle="DEFAULT",font="Dancing Script",text="";private byte[]? image;private string? preview,fileName;private bool drawn;private static readonly (string Value,string Label)[] Fonts=[("Dancing Script","Dancing Script"),("Great Vibes","Great Vibes"),("Pacifico","Pacifico"),("Caveat","Caveat"),("Lobster","Lobster"),("Allura","Allura")];private static readonly IReadOnlyList<PropFlowSelectOption> DrawStyleOptions=[new("DEFAULT","Mặc định"),new("PEN","Viết bằng bút")];private static readonly IReadOnlyList<PropFlowSelectOption> FontOptions=Fonts.Select(x=>new PropFlowSelectOption(x.Value,x.Label)).ToArray();private string Tab(string x)=>method==x?"active":"";private bool Valid=>method=="DRAW"?drawn:method=="UPLOAD"?image is not null:!string.IsNullOrWhiteSpace(text);protected override async Task OnAfterRenderAsync(bool first){if(method=="DRAW"){js??=await JS.InvokeAsync<IJSObjectReference>("import","./Features/RemoteOnlineSign/Pages/remote-signature.js");await js.InvokeVoidAsync("initialize",canvas,drawStyle);}}private async Task SetTab(string value){method=value;await InvokeAsync(StateHasChanged);}private void MarkDrawn(){drawn=true;}private async Task Clear(){if(js is not null)await js.InvokeVoidAsync("clear",canvas);drawn=false;}private async Task Pick(InputFileChangeEventArgs e){var f=e.File;if(f.Size>5*1024*1024||f.ContentType is not ("image/png" or "image/jpeg"))return;await using var s=f.OpenReadStream(5*1024*1024);using var m=new MemoryStream();await s.CopyToAsync(m);image=m.ToArray();fileName=f.Name;preview=$"data:{f.ContentType};base64,{Convert.ToBase64String(image)}";}private async Task Drop(DragEventArgs _)=>await Task.CompletedTask;private void ClearImage(){image=null;preview=fileName=null;}private async Task Submit(){if(method=="DRAW"){if(js is null||!await js.InvokeAsync<bool>("hasInk",canvas))return;image=await js.InvokeAsync<byte[]>("toPng",canvas);drawn=image is not null;}else if(method=="TYPE"){js??=await JS.InvokeAsync<IJSObjectReference>("import","./Features/RemoteOnlineSign/Pages/remote-signature.js");image=await js.InvokeAsync<byte[]>("textToPng",text,font);}if(image is not null)await OnSubmit.InvokeAsync(new(method,image));}private static string Size(int b)=>$"{Math.Round(b/1024d,1)} KB";public async ValueTask DisposeAsync(){if(js is not null){try{await js.InvokeVoidAsync("disposeCanvas",canvas);}catch{}await js.DisposeAsync();}}}
