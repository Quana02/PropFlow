@page "/terms"
@layout PublicInformationLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Điều khoản sử dụng · PropFlow</PageTitle>
<InformationHeader Title="Điều khoản sử dụng" Description="Phạm vi dịch vụ, tài khoản và cách sử dụng PropFlow trong chung cư." Draft />
<PolicyDocument Path="/terms" Sections="Sections" />

@code {
    private static readonly PolicySection[] Sections =
    [
        new("dich-vu", "Dịch vụ và phạm vi",
            "PropFlow hỗ trợ vận hành một chung cư trên mỗi hệ thống triển khai, gồm hồ sơ căn hộ và cư dân, yêu cầu dịch vụ, phản ánh, thông báo, liên lạc và theo dõi nghĩa vụ thanh toán. Cư dân và nhân sự truy cập theo vai trò và phạm vi nghiệp vụ của mình."),
        new("tai-khoan", "Đăng ký và quản lý tài khoản",
            "Chủ sở hữu hiện hành đủ điều kiện hoặc người thuê là chủ hộ đang cư trú tại căn chưa có chủ sở hữu hiện hành có thể đăng ký nếu hồ sơ còn hiệu lực, chưa liên kết tài khoản và thông tin đối chiếu khớp. Đăng ký gồm xác minh email theo quy trình hiện hành.",
