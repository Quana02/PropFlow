 catch{data=new([],0,1,PageSize);loadError="Không thể kết nối máy chủ. Vui lòng thử lại.";loading=false;initialized=true;}}
 async Task SearchChanged(){data=data with{PageIndex=1};await LoadAsync(350);} async Task Search(){data=data with{PageIndex=1};await LoadAsync();} async Task SearchKeyDown(KeyboardEventArgs e){if(e.Key=="Enter"&&!loading)await Search();} async Task ClearSearch(){search=null;await Search();} async Task GoPage(int p){if(loading||p<1||p>TotalPages)return;data=data with{PageIndex=p};await LoadAsync();}
 void OpenFilters(){draftStatus=status;draftApartmentFilter=apartmentFilter;draftRelationshipFilter=relationshipFilter;draftResidencyFilter=residencyFilter;draftHouseholdRoleFilter=householdRoleFilter;} Task DraftRelationshipChanged(string value){draftRelationshipFilter=value;if(value=="OWNER_ONLY")draftResidencyFilter=draftHouseholdRoleFilter="";return Task.CompletedTask;} async Task ApplyFilters()
