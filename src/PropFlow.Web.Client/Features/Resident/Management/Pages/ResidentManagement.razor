 async Task RelationshipChangedWithHeadCheck(string value)
 {
     ApplyRelationshipState(ResidentRelationshipFormRules.ChangeRelationship(RelationshipState,value));
     Notify(nameof(form.RelationshipKind));
     ClearResidencyValidation();
     if(!IsResident){form.Residency=null;heads=[];headAvailabilityKnown=false;return;}
     await LoadHouseholdAvailabilityAsync();
 }

 async Task ApartmentChangedWithHeadCheck(string value)
 {
     ApplyRelationshipState(ResidentRelationshipFormRules.ChangeApartment(RelationshipState,Guid.TryParse(value,out var id)?id:Guid.Empty));
     Notify(nameof(form.ApartmentUnitId));
     ClearResidencyValidation();
     await LoadHouseholdAvailabilityAsync();
 }

 Task HouseholdRoleChangedWithHeadCheck(string value)
 {
     if(value=="HOUSEHOLD_HEAD"&&HasActiveHouseholdHead)return Task.CompletedTask;
     ApplyRelationshipState(ResidentRelationshipFormRules.ChangeHouseholdRole(RelationshipState,value));
     ClearResidencyValidation();
     return Task.CompletedTask;
 }

 async Task LoadHouseholdAvailabilityAsync()
 {
        var operationFeedback = Toasts.BeginOperation(toastLifetime, createFeedback);

     heads=[];
     headAvailabilityKnown=false;
     if(!IsResident||form.ApartmentUnitId==Guid.Empty)return;
     var apartmentId=form.ApartmentUnitId;
     loadingHeads=true;
     try
     {
         var result=await Residents.EligibleHeadsAsync(apartmentId);
         if(form.ApartmentUnitId!=apartmentId)return;
         if(!result.IsSuccess){operationFeedback.Publish(() => ShowActionError(result.Message??"Không thể kiểm tra chủ hộ của căn hộ."));return;}
         heads=result.Data??[];
         headAvailabilityKnown=true;
         ApplyRelationshipState(ResidentRelationshipFormRules.ReconcileHouseholdHeadAvailability(RelationshipState,HasActiveHouseholdHead));
     }
     finally{loadingHeads=false;}
 }
