@inject PropFlow.Web.Client.Shared.Feedback.ToastService Toasts
@using PropFlow.Web.Client.Features.Finance.Services
@page "/residents"
@layout PropFlow.Web.Client.Layout.MainLayout
@attribute [Authorize(Roles="MANAGER,STAFF,ACCOUNTANT")]
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using PropFlow.Modules.Authentication.Contracts
@using PropFlow.Web.Client.Features.Resident.Management.Models
@using PropFlow.Web.Client.Features.Resident.Shared.Models
@using PropFlow.Web.Client.Features.Resident.Shared.Services
@using PropFlow.Web.Client.Shared.Forms
@using PropFlow.Web.Client.Shared.Feedback
@using PropFlow.Web.Client.Shared.Management
@inject IResidentApiClient Residents
@inject NavigationManager Navigation
@inject PropFlow.Web.Client.Services.Authentication.AuthSession Session
@inject IJSRuntime JS

<PageTitle>Quản lý cư dân - PropFlow</PageTitle>
<div class="resident-page">
 <section class="resident-header pf-management-header pf-management-existing-header">
     <div class="pf-management-heading">
         <span class="pf-management-icon material-symbols-outlined" aria-hidden="true">groups</span>
         <div><h1>Quản lý cư dân</h1><p>Tra cứu hồ sơ và các quan hệ căn hộ hiện hành.</p></div>
     </div>
     @if (CanManage)
     {
         <div class="resident-header-actions">
             <AuthorizeView Policy="@ResidentAccountPolicies.Read">
                 <a class="resident-secondary" href="/residents/accounts">
                     <svg class="header-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="7" r="3"/><path d="M3 20v-2a4 4 0 0 1 4-4h4"/><circle cx="17" cy="16" r="3"/><path d="M17 12v1m0 6v1m-4-4h1m6 0h1"/></svg>
                     Tài khoản cư dân
                 </a>
             </AuthorizeView>
             <button type="button" class="resident-primary" @onclick="Open">
                 <svg class="header-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                 Thêm cư dân
             </button>
         </div>
     }
 </section>
 <section class="resident-overview" aria-label="Tổng quan cư dân" aria-busy="@summaryLoading">
     <div class="pf-management-metrics resident-kpis">
         <ManagementKpi Icon="groups" Label="Tổng cư dân" Value="@KpiValue(summary?.TotalResidents)" />
         <ManagementKpi Icon="how_to_reg" Label="Đang hoạt động" Value="@KpiValue(summary?.ActiveResidents)" Tone="success" />
         <ManagementKpi Icon="verified_user" Label="Đã liên kết tài khoản" Value="@KpiValue(summary?.LinkedAccounts)" />
         <ManagementKpi Icon="person_add" Label="Cư dân mới trong tháng" Value="@KpiValue(summary?.NewResidentsThisMonth)" Tone="warning" />
     </div>
     @if (summaryLoading)
     {
         <span class="visually-hidden" role="status">Đang tải tổng quan cư dân…</span>
     }
     else if (summaryFailed)
     {
         <div class="resident-summary-error">
             <span role="alert">Không thể tải số liệu tổng quan.</span>
             <button type="button" class="resident-link" @onclick="LoadSummaryAsync">Thử lại số liệu</button>
         </div>
     }
 </section>
 @if(!string.IsNullOrWhiteSpace(loadError)){<p class="resident-notice error" role="alert">@loadError <button class="resident-link" @onclick="() => LoadAsync()">Thử lại</button></p>}
 <section class="resident-panel pf-list-panel pf-management-list">
  <div class="resident-toolbar pf-list-toolbar pf-management-toolbar"><div class="resident-search pf-list-search"><span class="material-symbols-outlined">search</span><input aria-label="Tìm kiếm cư dân" placeholder="@(Session.User?.Role == "ACCOUNTANT" ? "Tìm theo mã hoặc họ tên cư dân..." : "Tìm theo mã, họ tên, số điện thoại hoặc email...")" @bind="search" @bind:event="oninput" @bind:after="SearchChanged" />@if(!string.IsNullOrWhiteSpace(search)){<button type="button" class="clear-search" aria-label="Xóa tìm kiếm" @onclick="ClearSearch"><span class="material-symbols-outlined">close</span></button>}</div><PropFlowFilterPopover ActiveCount="@ActiveFilterCount" OnOpen="OpenFilters" OnReset="ResetFilters" OnApply="ApplyFilters">
                <label><span>Trạng thái cư dân</span><PropFlowSelect Options="StatusOptions" Value="@draftStatus" ValueChanged="v=>draftStatus=v" Variant="Filter" AriaLabel="Trạng thái cư dân" /></label>
                <label><span>Căn hộ</span><PropFlowSelect Options="ApartmentFilterOptions" Value="@draftApartmentFilter" ValueChanged="v=>draftApartmentFilter=v" Variant="Filter" AriaLabel="Căn hộ" /></label>
                <label><span>Quan hệ với căn hộ</span><PropFlowSelect Options="RelationshipFilterOptions" Value="@draftRelationshipFilter" ValueChanged="DraftRelationshipChanged" Variant="Filter" AriaLabel="Quan hệ với căn hộ" /></label>@if(draftRelationshipFilter!="OWNER_ONLY"){<label><span>Hình thức cư trú</span><PropFlowSelect Options="ResidencyFilterOptions" Value="@draftResidencyFilter" ValueChanged="v=>draftResidencyFilter=v" Variant="Filter" AriaLabel="Hình thức cư trú" /></label>
                <label><span>Vai trò trong hộ</span><PropFlowSelect Options="HouseholdRoleFilterOptions" Value="@draftHouseholdRoleFilter" ValueChanged="v=>draftHouseholdRoleFilter=v" Variant="Filter" AriaLabel="Vai trò trong hộ" /></label>}
            </PropFlowFilterPopover><span class="result-count"><i></i>Hiển thị @data.Items.Count / @data.TotalCount cư dân</span><PropFlowListRefresh OnRefresh="RefreshAsync" Busy="@(loading || summaryLoading)" /></div>
  <div class="resident-results @(loading?"is-loading":null)" aria-busy="@loading">
   @if(loading&&data.Items.Count>0){<div class="list-loading-overlay" role="status"><span class="loading-spinner"></span>Đang cập nhật…</div>}
   @if(loading&&data.Items.Count==0){<p class="resident-state">Đang tải danh sách cư dân…</p>}else if(data.Items.Count==0){<p class="resident-state">Không tìm thấy cư dân phù hợp.</p>}else{<div class="resident-table-wrap"><table class="pf-list-table"><thead><tr><th>MÃ CƯ DÂN</th><th>CƯ DÂN</th><th>LIÊN HỆ</th><th>QUAN HỆ CĂN HỘ</th><th>TRẠNG THÁI</th><th>HÀNH ĐỘNG</th></tr></thead><tbody>@foreach(var x in data.Items){<tr><td><strong>@x.ResidentCode</strong><small>@(x.HasAccount?"Đã có tài khoản":"Chưa có tài khoản")</small></td><td><strong>@x.FullName</strong></td><td>@(x.PhoneNumber??"Chưa cập nhật")<small>@(x.Email??"Chưa cập nhật email")</small></td><td>@if(x.ApartmentRelationships.Count==0){<span class="resident-muted">Chưa có quan hệ hiện hành</span>}else{@foreach(var relation in x.ApartmentRelationships){<div class="resident-apartment"><strong>@relation.UnitNumber</strong><small>Tầng @relation.FloorNumber · @RelationLabel(relation)</small></div>}}</td><td><span class="resident-status @x.Status.ToLowerInvariant()">@StatusLabel(x.Status)</span></td><td><button type="button" class="resident-row-action" title="Xem chi tiết" aria-label="Xem chi tiết cư dân @x.FullName" @onclick="()=>Detail(x.Id)"><span class="material-symbols-outlined" aria-hidden="true">visibility</span></button></td></tr>}</tbody></table></div>}
   @if (initialized && data.TotalCount > 0)
   {
       <TablePagination Page="data.PageIndex" TotalPages="TotalPages" Busy="loading" Label="Phân trang cư dân"
           PageChanged="GoPage">
           <span>@data.TotalCount cư dân</span>
       </TablePagination>
   }
  </div>
 </section>
</div>


@if(creating&&editContext is not null){<div class="resident-modal-backdrop" @onclick="CancelCreateFeedbackClose"><section class="resident-modal" role="dialog" aria-modal="true" aria-labelledby="resident-create-title" @onclick:stopPropagation="true" @onkeydown="ModalKeyDown"><header class="resident-modal-header"><div class="resident-modal-title"><span class="material-symbols-outlined">person_add</span><div><h2 id="resident-create-title">Thêm hồ sơ cư dân</h2><p>Thông tin hồ sơ và quan hệ với căn hộ.</p></div></div><button type="button" class="resident-modal-close" @onclick="CancelCreateFeedbackClose" aria-label="Đóng">×</button></header><div class="resident-modal-form-shell"><EditForm EditContext="editContext" OnSubmit="Submit" class="resident-modal-form"><DataAnnotationsValidator /><div class="resident-modal-body">@if(showValidationSummary){<p class="resident-validation-summary" role="alert">Vui lòng kiểm tra các trường được đánh dấu bên dưới.</p>}<section class="resident-modal-section"><strong>THÔNG TIN CƯ DÂN</strong><div class="resident-form-grid">
 <label>Họ và tên <em>*</em><InputText id="resident-full-name" @bind-Value="form.FullName" disabled="@saving" /><ValidationMessage For="()=>form.FullName" /></label>
 <label>Ngày sinh <em>*</em><div id="resident-date-of-birth"><PropFlowDatePicker Value="form.DateOfBirth" ValueChanged="v=>DateChanged(nameof(form.DateOfBirth),v)" ValidityChanged="v=>dateOfBirthValid=v" AriaLabel="Ngày sinh" Disabled="@saving" /></div><ValidationMessage For="()=>form.DateOfBirth" /></label>
 <label>Giới tính<PropFlowSelect Options="GenderOptions" Value="@(form.Gender??string.Empty)" ValueChanged="GenderChanged" Disabled="@saving" Placeholder="Chọn giới tính" AriaLabel="Giới tính" /></label>
 <label>Quốc tịch <em>*</em><InputText id="resident-nationality" @bind-Value="form.Nationality" disabled="@saving" /><ValidationMessage For="()=>form.Nationality" /></label>
 <label>Loại giấy tờ <em>*</em><PropFlowSelect Id="resident-identity-type" Options="IdentityTypeOptions" Value="@(form.IdentityType??string.Empty)" ValueChanged="IdentityTypeChanged" ValueExpression="()=>form.IdentityType!" Disabled="@saving" Placeholder="Chọn loại giấy tờ" AriaLabel="Loại giấy tờ" /><ValidationMessage For="()=>form.IdentityType" /></label>
 <label>Số giấy tờ <em>*</em><InputText id="resident-identity-number" inputmode="numeric" maxlength="12" @bind-Value="form.IdentityNumber" disabled="@saving" /><ValidationMessage For="()=>form.IdentityNumber" /></label>
 <label>Ngày cấp<div id="resident-identity-issued-date"><PropFlowDatePicker Value="form.IdentityIssuedDate" ValueChanged="v=>DateChanged(nameof(form.IdentityIssuedDate),v)" ValidityChanged="v=>identityIssuedDateValid=v" AriaLabel="Ngày cấp giấy tờ" Disabled="@saving" /></div><ValidationMessage For="()=>form.IdentityIssuedDate" /></label>
 <label>Ngày hết hạn<div id="resident-identity-expiry-date"><PropFlowDatePicker Value="form.IdentityExpiryDate" ValueChanged="v=>DateChanged(nameof(form.IdentityExpiryDate),v)" ValidityChanged="v=>identityExpiryDateValid=v" AriaLabel="Ngày hết hạn giấy tờ" Disabled="@saving" /></div><ValidationMessage For="()=>form.IdentityExpiryDate" /></label>
 <label>Số điện thoại <em>*</em><InputText id="resident-phone-number" type="tel" @bind-Value="form.PhoneNumber" disabled="@saving" /><ValidationMessage For="()=>form.PhoneNumber" /></label>
 <label>Email<InputText id="resident-email" type="email" @bind-Value="form.Email" disabled="@saving" /><ValidationMessage For="()=>form.Email" /></label>
 <label class="resident-form-full">Ghi chú<InputTextArea @bind-Value="form.Note" disabled="@saving" /></label>
 </div></section><section class="resident-modal-section"><strong>QUAN HỆ VỚI CĂN HỘ</strong><div class="resident-form-grid">
 <label>Quan hệ với căn hộ <em>*</em><PropFlowSelect Id="resident-relationship-kind" Options="RelationshipKindOptions" Value="@form.RelationshipKind" ValueChanged="RelationshipChangedWithHeadCheck" ValueExpression="()=>form.RelationshipKind" Disabled="@saving" Placeholder="Chọn quan hệ" AriaLabel="Quan hệ với căn hộ" /><ValidationMessage For="()=>form.RelationshipKind" /></label>
 <label>Căn hộ <em>*</em><PropFlowSelect Id="resident-apartment" Options="ApartmentOptions" Value="@(form.ApartmentUnitId==Guid.Empty?string.Empty:form.ApartmentUnitId.ToString())" ValueChanged="ApartmentChangedWithHeadCheck" Disabled="@saving" Placeholder="Chọn căn hộ" AriaLabel="Căn hộ" /><ValidationMessage For="()=>form.ApartmentUnitId" /></label>
 @if(IsResident){@if(IsOwnerAndResident){<label>Hình thức cư trú<input value="Chủ sở hữu đang cư trú" readonly /><ValidationMessage For="()=>residencyType" /></label>}else{<label>Hình thức cư trú <em>*</em><PropFlowSelect Options="ResidencyTypeOptions" Value="@residencyType" ValueChanged="ResidencyTypeChanged" Disabled="@saving" AriaLabel="Hình thức cư trú" /><ValidationMessage For="()=>residencyType" /></label>}<label>Vai trò trong hộ <em>*</em><PropFlowSelect Options="HouseholdRoleOptions" Value="@householdRole" ValueChanged="HouseholdRoleChangedWithHeadCheck" Disabled="@(saving||loadingHeads||!headAvailabilityKnown)" AriaLabel="Vai trò trong hộ" />@if(HasActiveHouseholdHead){<span class="resident-field-note">Căn hộ đã có chủ hộ @heads[0].FullName. Chỉ có thể chọn Thành viên hộ.</span>}<ValidationMessage For="()=>householdRole" /></label>@if(IsMember&&form.ApartmentUnitId!=Guid.Empty){<label>Chủ hộ <em>*</em><PropFlowSelect Options="HouseholdHeadOptions" Value="@(householdHeadResidencyId??string.Empty)" ValueChanged="HouseholdHeadChanged" Disabled="@saving" Placeholder="@(heads.Count==0?"Chưa có chủ hộ phù hợp":"Chọn chủ hộ")" AriaLabel="Chủ hộ" /><ValidationMessage For="()=>householdHeadResidencyId" /></label><label>Quan hệ với chủ hộ <em>*</em><PropFlowSelect Options="HouseholdRelationshipOptions" Value="@(relationshipToHead??string.Empty)" ValueChanged="RelationshipToHeadChanged" Disabled="@saving" Placeholder="Chọn quan hệ" AriaLabel="Quan hệ với chủ hộ" /><ValidationMessage For="()=>relationshipToHead" /></label>}<div class="resident-form-full"><ValidationMessage For="()=>form.Residency" /></div>}
 </div></section></div><footer class="resident-modal-footer"><button type="button" class="resident-cancel" @onclick="CancelCreateFeedbackClose">Hủy bỏ</button><button type="submit" class="resident-primary" disabled="@(saving||!dateOfBirthValid||!identityIssuedDateValid||!identityExpiryDateValid)">@(saving?"Đang lưu…":"Lưu cư dân")</button></footer></EditForm></div></section></div>}

@code {
    private readonly PropFlow.Web.Client.Shared.Feedback.ToastLifetime createFeedback = new();
    private void CancelCreateFeedbackClose() { Close(); if (!creating) createFeedback.Invalidate(); }

    private readonly PropFlow.Web.Client.Shared.Feedback.ToastLifetime toastLifetime = new();
    private readonly LatestRequest summaryRequests = new();
    private ResidentManagementSummary? summary;
    private bool summaryLoading = true;
    private bool summaryFailed;

    protected override Task OnInitializedAsync() => Task.WhenAll(LoadApartmentOptionsAsync(), RefreshAsync());

    private async Task LoadApartmentOptionsAsync()
    {
        var apartments = await Residents.ActiveApartmentsAsync();
        units = apartments.Data ?? [];
    }

    private Task RefreshAsync() => Task.WhenAll(LoadAsync(), LoadSummaryAsync());

    private async Task LoadSummaryAsync()
    {
        summaryLoading = true;
        summaryFailed = false;
        await summaryRequests.RunAsync(Residents.GetSummaryAsync, result =>
        {
            summary = result.IsSuccess ? result.Data : null;
            summaryFailed = summary is null;
            summaryLoading = false;
        });
    }

    private static string KpiValue(int? value) => value?.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) ?? "—";

 const int PageSize=20; PagedResidentsResponse data=new([],0,1,PageSize); IReadOnlyList<ActiveApartmentOption> units=[]; IReadOnlyList<EligibleHouseholdHead> heads=[]; CreateResidentRequest form=new(); EditContext? editContext; ValidationMessageStore? serverMessages; IJSObjectReference? module;
 string? loadError,search,householdHeadResidencyId,relationshipToHead; string status="",apartmentFilter="",relationshipFilter="",residencyFilter="",householdRoleFilter="",draftStatus="",draftApartmentFilter="",draftRelationshipFilter="",draftResidencyFilter="",draftHouseholdRoleFilter="",residencyType="",householdRole=""; bool loading=true,initialized,creating,saving,showValidationSummary,loadingHeads,headAvailabilityKnown,dateOfBirthValid=true,identityIssuedDateValid=true,identityExpiryDateValid=true;
 static readonly IReadOnlyList<PropFlowSelectOption> StatusOptions=[new("","Tất cả"),new("ACTIVE","Đang hoạt động"),new("INACTIVE","Ngừng hoạt động"),new("MOVED_OUT","Đã chuyển đi")]; static readonly IReadOnlyList<PropFlowSelectOption> RelationshipFilterOptions=[new("","Tất cả"),new("OWNER_ONLY","Chủ sở hữu"),new("RESIDENT_ONLY","Cư trú"),new("OWNER_AND_RESIDENT","Chủ sở hữu và đang cư trú")]; static readonly IReadOnlyList<PropFlowSelectOption> ResidencyFilterOptions=[new("","Tất cả"),new("OWNER_OCCUPIED","Chủ sở hữu đang cư trú"),new("TENANT","Người thuê"),new("AUTHORIZED_OCCUPANT","Người được phép cư trú")]; static readonly IReadOnlyList<PropFlowSelectOption> HouseholdRoleFilterOptions=[new("","Tất cả"),new("HOUSEHOLD_HEAD","Chủ hộ"),new("HOUSEHOLD_MEMBER","Thành viên hộ")]; static readonly IReadOnlyList<PropFlowSelectOption> IdentityTypeOptions=[new("CCCD","CCCD"),new("CMND","CMND")]; static readonly IReadOnlyList<PropFlowSelectOption> RelationshipKindOptions=[new("OWNER_ONLY","Chủ sở hữu"),new("RESIDENT_ONLY","Cư trú"),new("OWNER_AND_RESIDENT","Chủ sở hữu và đang cư trú")]; static readonly IReadOnlyList<PropFlowSelectOption> ResidencyTypeOptions=[new("TENANT","Người thuê"),new("AUTHORIZED_OCCUPANT","Người được phép cư trú")]; static readonly IReadOnlyList<PropFlowSelectOption> HouseholdRelationshipOptions=[new("SPOUSE","Vợ/chồng"),new("CHILD","Con"),new("PARENT","Cha/mẹ"),new("SIBLING","Anh/chị/em"),new("OTHER_RELATIVE","Người thân khác")];
 IReadOnlyList<PropFlowSelectOption> ApartmentOptions=>units.Select(x=>new PropFlowSelectOption(x.Id.ToString(),$"{x.UnitNumber} · Tầng {x.FloorNumber}")).ToArray(); IReadOnlyList<PropFlowSelectOption> ApartmentFilterOptions=>[new("","Tất cả căn hộ"),..ApartmentOptions]; IReadOnlyList<PropFlowSelectOption> HouseholdHeadOptions=>heads.Select(x=>new PropFlowSelectOption(x.ResidencyId.ToString(),$"{x.FullName} · {x.ResidentCode}")).ToArray(); IReadOnlyList<PropFlowSelectOption> HouseholdRoleOptions=>[new("HOUSEHOLD_HEAD",HasActiveHouseholdHead?"Chủ hộ (căn hộ đã có chủ hộ)":"Chủ hộ",HasActiveHouseholdHead),new("HOUSEHOLD_MEMBER","Thành viên hộ")]; ResidentRelationshipFormState RelationshipState=>new(form.RelationshipKind,form.ApartmentUnitId,residencyType,householdRole,householdHeadResidencyId,relationshipToHead); bool IsResident=>form.RelationshipKind is "RESIDENT_ONLY" or "OWNER_AND_RESIDENT"; bool IsOwnerAndResident=>form.RelationshipKind=="OWNER_AND_RESIDENT"; bool IsMember=>IsResident&&householdRole=="HOUSEHOLD_MEMBER"; bool HasActiveHouseholdHead=>heads.Count>0; bool CanManage=>string.Equals(Session.User?.Role,"MANAGER",StringComparison.OrdinalIgnoreCase); int TotalPages=>Math.Max(1,(int)Math.Ceiling(data.TotalCount/(double)PageSize)); int ActiveFilterCount=>(Empty(status)?0:1)+(Empty(apartmentFilter)?0:1)+(Empty(relationshipFilter)?0:1)+(Empty(residencyFilter)?0:1)+(Empty(householdRoleFilter)?0:1);
 readonly LatestRequest listRequests=new();
