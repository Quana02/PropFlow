 void PrepareResidencyConfirmation(){if(!Guid.TryParse(residencyApartment,out var apartmentId)){dialogError="Vui lòng chọn căn hộ.";return;}if(residencyForm.ResidencyType=="OWNER_OCCUPIED"&&!CanUseOwnerOccupied){dialogError="Chỉ chủ sở hữu hiện tại của căn hộ mới được chọn hình thức chủ sở hữu đang cư trú.";return;}if(IsMember&&(!Guid.TryParse(headId,out _)||string.IsNullOrWhiteSpace(relationship))){dialogError="Vui lòng chọn chủ hộ và quan hệ với chủ hộ.";return;}residencyForm.ApartmentUnitId=apartmentId;residencyForm.HouseholdHeadResidencyId=Guid.TryParse(headId,out var h)?h:null;residencyForm.RelationshipToHead=IsMember?relationship:null;dialogError=null;residencyConfirmation=true;}
