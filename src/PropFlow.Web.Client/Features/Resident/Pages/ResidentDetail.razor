 static string? NormalizeIdentity(string? value)=>string.IsNullOrWhiteSpace(value)?null:new string(value.Where(character=>character is>='0' and<='9').ToArray());
 string? ValidateEdit(){var today=DateOnly.FromDateTime(DateTime.Today);if(string.IsNullOrWhiteSpace(edit.FullName))return"Họ và tên là bắt buộc.";if(edit.FullName.Trim().Length>150)return"Họ và tên không được vượt quá 150 ký tự.";if(!edit.DateOfBirth.HasValue)return"Ngày sinh là bắt buộc.";if(edit.DateOfBirth>today)return"Ngày sinh không được ở tương lai.";if(string.IsNullOrWhiteSpace(edit.Nationality))return"Quốc tịch là bắt buộc.";if(edit.Nationality.Trim().Length>80)return"Quốc tịch không được vượt quá 80 ký tự.";var identityType=edit.IdentityType?.Trim().ToUpperInvariant();var identityNumber=NormalizeIdentity(edit.IdentityNumber);if(identityType is not("CCCD" or "CMND"))return"Loại giấy tờ chỉ được phép là CCCD hoặc CMND.";if(string.IsNullOrWhiteSpace(edit.IdentityNumber)||!Regex.IsMatch(edit.IdentityNumber.Trim(),"^[0-9\\s./-]+$"))return"Số giấy tờ chỉ được gồm chữ số và dấu phân cách.";if(identityType=="CCCD"&&!Regex.IsMatch(identityNumber??"","^\\d{12}$"))return"Số CCCD phải gồm đúng 12 chữ số.";if(identityType=="CMND"&&!Regex.IsMatch(identityNumber??"","^(\\d{9}|\\d{12})$"))return"Số CMND phải gồm 9 hoặc 12 chữ số.";if(string.IsNullOrWhiteSpace(edit.PhoneNumber)||!Regex.IsMatch(edit.PhoneNumber.Trim(),"^(?:\\+84|0)\\d{9,10}$"))return"Số điện thoại không đúng định dạng.";if(!string.IsNullOrWhiteSpace(edit.Email)&&(edit.Email.Trim().Length>255||!MailAddress.TryCreate(edit.Email.Trim(),out _)))return"Email không đúng định dạng.";if(edit.IdentityIssuedDate.HasValue&&edit.IdentityExpiryDate.HasValue&&edit.IdentityExpiryDate<edit.IdentityIssuedDate)return"Ngày hết hạn phải sau ngày cấp.";return null;}
 async Task SetStatus(string value){showActions=false;if(resident is null||value==resident.Status)return;var r=await Residents.SetStatusAsync(Id,value);if(!r.IsSuccess){ShowToast(r.Message??"Không thể cập nhật trạng thái.","error",5000);return;}await LoadAsync();ShowToast("Đã cập nhật trạng thái cư dân.");}
