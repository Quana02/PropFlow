@page "/residents/{Id:guid}"
@layout PropFlow.Web.Client.Layout.MainLayout
@attribute [Authorize(Roles = "MANAGER,STAFF,ACCOUNTANT")]
@implements IDisposable
@using PropFlow.Web.Client.Features.Resident.Models
@using PropFlow.Web.Client.Features.Resident.Services
@using PropFlow.Web.Client.Features.Apartment.Models
@using PropFlow.Web.Client.Features.Apartment.Services
@using PropFlow.Web.Client.Shared.Forms
@using PropFlow.Web.Client.Shared.Feedback
@using System.Net.Mail
@using System.Text.RegularExpressions
@inject IResidentApiClient Residents
@inject IApartmentApiClient Apartments
@inject NavigationManager Navigation
@inject PropFlow.Web.Client.Services.Authentication.AuthSession Session

<PageTitle>Chi tiết cư dân - PropFlow</PageTitle>
<div class="resident-page detail-page">
 <button class="back-link" @onclick="Back"><span class="material-symbols-outlined">arrow_back</span>Danh sách cư dân</button>
 @if(loading){
  <div class="resident-skeleton" aria-label="Đang tải hồ sơ cư dân"><div class="skeleton-hero"><i></i><div><b></b><span></span></div></div><div class="skeleton-grid"><section></section><section></section></div><section class="skeleton-wide"></section></div>
 }
 else if(!string.IsNullOrWhiteSpace(loadError) || resident is null){
  <section class="detail-error" role="alert"><span class="material-symbols-outlined">person_off</span><h1>Không thể tải hồ sơ cư dân</h1><p>@(loadError??"Không tìm thấy hồ sơ cư dân.")</p><div><button class="secondary-action" @onclick="LoadAsync"><span class="material-symbols-outlined">refresh</span>Thử lại</button><button class="text-action" @onclick="Back">Quay lại danh sách</button></div></section>
 }
 else {
  <section class="detail-hero">
   <div class="detail-identity"><span class="resident-avatar">@Initials</span><div><span class="eyebrow">RESIDENT PROFILE</span><h1>@resident.FullName</h1><p>@resident.ResidentCode</p><div class="identity-badges"><span class="status-chip @resident.Status.ToLowerInvariant()">@StatusLabel(resident.Status)</span><span class="account-chip @(resident.HasAccount?"linked":"unlinked")"><span class="material-symbols-outlined">@(resident.HasAccount?"link":"link_off")</span>@(resident.HasAccount?"Đã liên kết tài khoản":"Chưa liên kết tài khoản")</span></div></div></div>
   @if(CanManage){<div class="hero-actions"><button class="secondary-action" @onclick="OpenEdit"><span class="material-symbols-outlined">edit</span>Chỉnh sửa</button><div class="action-anchor"><button class="more-action" title="Đổi trạng thái" aria-label="Đổi trạng thái cư dân" aria-expanded="@showActions" @onclick="ToggleActions"><span class="material-symbols-outlined">more_horiz</span></button>@if(showActions){<div class="action-menu"><strong>Đổi trạng thái</strong>@foreach(var option in StatusOptions){<button class="@(option.Value==resident.Status?"selected":"")" disabled="@(option.Value==resident.Status)" @onclick="()=>SetStatus(option.Value)"><span class="material-symbols-outlined">@StatusIcon(option.Value)</span>@option.Label</button>}</div>}</div></div>}
  </section>
  @if(!string.IsNullOrWhiteSpace(toastMessage)){<PropFlowToast @key="toastKey" Message="@toastMessage" Severity="@toastSeverity" DurationMs="@toastDuration" OnDismiss="DismissToast" />}

  <div class="detail-layout">
   <section class="detail-card profile-card">
    <header><div class="section-heading"><span class="section-icon material-symbols-outlined">badge</span><div><span class="section-kicker">RESIDENT INFORMATION</span><h2>Thông tin cư dân</h2></div></div></header>
    <div class="profile-section"><h3>Thông tin cá nhân</h3><dl class="definition-grid"><div><dt>Ngày sinh</dt><dd>@DateLabel(resident.DateOfBirth)</dd></div><div><dt>Giới tính</dt><dd>@ValueOrEmpty(resident.Gender)</dd></div><div><dt>Quốc tịch</dt><dd>@ValueOrEmpty(resident.Nationality)</dd></div><div><dt>Điện thoại</dt><dd>@ValueOrEmpty(resident.PhoneNumber)</dd></div><div class="wide-field"><dt>Email</dt><dd>@ValueOrEmpty(resident.Email)</dd></div></dl></div>
    <div class="profile-section identity-section"><h3>Giấy tờ định danh</h3><dl class="definition-grid"><div><dt>Loại giấy tờ</dt><dd>@ValueOrEmpty(resident.IdentityType)</dd></div><div><dt>Số giấy tờ</dt><dd>@ValueOrEmpty(resident.IdentityNumber)</dd></div><div><dt>Ngày cấp</dt><dd>@DateLabel(resident.IdentityIssuedDate)</dd></div><div><dt>Ngày hết hạn</dt><dd>@DateLabel(resident.IdentityExpiryDate)</dd></div></dl></div>
    @if(!string.IsNullOrWhiteSpace(resident.Note)){<div class="resident-note"><span>Ghi chú</span><p>@resident.Note</p></div>}
   </section>

   <aside class="side-stack">
    <section class="detail-card ownership-card"><header><div class="section-heading"><span class="section-icon material-symbols-outlined">real_estate_agent</span><div><span class="section-kicker">OWNERSHIP</span><h2>Quyền sở hữu căn hộ <b>@CurrentOwnerships.Count</b></h2></div></div>@if(CanManage){<button class="secondary-action ownership-add" disabled="@(ownershipRefreshing||savingOwnership)" @onclick="OpenOwnershipDialog"><span class="material-symbols-outlined">add_home</span>Thêm quyền sở hữu</button>}</header>
     @if(ownershipRefreshing){<div class="ownership-refreshing"><span></span>Đang đồng bộ quyền sở hữu…</div>}
     @if(CurrentOwnerships.Count==0){<div class="compact-empty"><span class="material-symbols-outlined">home_work</span><div><strong>Chưa có quyền sở hữu</strong><p>Cư dân chưa có quyền sở hữu căn hộ.</p></div></div>}
     else{<div class="compact-list">@foreach(var item in CurrentOwnerships){<article class="compact-item"><span class="item-icon material-symbols-outlined">apartment</span><div><strong>Căn hộ @item.UnitNumber</strong><span>Tầng @item.FloorNumber</span><small>@DateRange(item.StartDate,item.EndDate)</small></div><div class="compact-item-actions"><span class="status-chip active">Đang sở hữu</span>@if(CanManage){<button class="danger-action compact-end" title="Kết thúc quyền sở hữu" @onclick="()=>RequestEndOwnership(item)"><span class="material-symbols-outlined">link_off</span></button>}</div></article>}</div>}
     @if(OwnershipHistory.Count>0){<details class="ownership-history"><summary>Lịch sử sở hữu <b>@OwnershipHistory.Count</b></summary><div class="compact-list">@foreach(var item in OwnershipHistory){<article class="compact-item"><span class="item-icon history material-symbols-outlined">history</span><div><strong>Căn hộ @item.UnitNumber</strong><span>Tầng @item.FloorNumber</span><small>@DateRange(item.StartDate,item.EndDate)</small></div><span class="status-chip ended">Đã kết thúc</span></article>}</div></details>}
    </section>
   </aside>
  </div>

  <section class="detail-card residency-card">
   <header><div class="section-heading"><span class="section-icon material-symbols-outlined">groups</span><div><span class="section-kicker">RESIDENCY</span><h2>Quan hệ cư trú <b>@resident.Residencies.Count</b></h2></div></div>@if(CanManage){<button class="text-action add-residency" @onclick="()=>OpenResidency(null)"><span class="material-symbols-outlined">person_add</span>Thêm cư trú</button>}</header>
   <div class="residency-section"><div class="subsection-title"><div><span class="material-symbols-outlined">home_pin</span><h3>Cư trú hiện tại</h3></div>@if(ActiveResidencies.Count>0){<span>@ActiveResidencies.Count quan hệ đang hoạt động</span>}</div>
    @if(ActiveResidencies.Count==0){<div class="compact-empty"><span class="material-symbols-outlined">meeting_room</span><div><strong>Không có cư trú hiện tại</strong><p>Cư dân hiện không có quan hệ cư trú đang hoạt động. Quyền sở hữu không tự tạo quan hệ cư trú.</p></div></div>}
    else{<div class="current-residency-list">@foreach(var item in ActiveResidencies){<article class="current-residency"><div class="residency-main"><span class="residency-home material-symbols-outlined">home</span><div><span class="section-kicker">CURRENT RESIDENCY</span><h3>Căn hộ @item.UnitNumber</h3><p>Tầng @item.FloorNumber · @ResidencyTypeLabel(item.ResidencyType)</p></div><span class="status-chip active">Đang cư trú</span></div><dl class="residency-facts"><div><dt>Vai trò trong hộ</dt><dd>@RoleLabel(item.HouseholdRole)</dd></div><div><dt>Bắt đầu</dt><dd>@DateLabel(item.StartDate)</dd></div>@if(item.HouseholdRole=="HOUSEHOLD_MEMBER"){<div><dt>Chủ hộ</dt><dd>@HeadLabel(item)</dd></div><div><dt>Quan hệ với chủ hộ</dt><dd>@RelationshipLabel(item.RelationshipToHead)</dd></div>}</dl>@if(CanManage){<footer class="residency-actions"><button class="secondary-action" @onclick="()=>OpenResidency(item)"><span class="material-symbols-outlined">move_item</span>Chuyển căn hộ</button><button class="danger-action" @onclick="()=>RequestEndResidency(item)"><span class="material-symbols-outlined">person_remove</span>Kết thúc cư trú</button></footer>}</article>}</div>}
   </div>
   <div class="residency-section history-section"><div class="subsection-title"><div><span class="material-symbols-outlined">history</span><h3>Lịch sử cư trú</h3></div><span>@ResidencyHistory.Count quan hệ đã kết thúc</span></div>
    @if(ResidencyHistory.Count==0){<div class="compact-empty history-empty"><span class="material-symbols-outlined">history_toggle_off</span><div><strong>Chưa có lịch sử cư trú</strong><p>Các quan hệ đã kết thúc sẽ được lưu tại đây.</p></div></div>}
    else{<div class="history-list">@foreach(var item in ResidencyHistory){<article class="history-item"><span class="history-dot"></span><div class="history-home"><strong>Căn hộ @item.UnitNumber</strong><span>Tầng @item.FloorNumber</span></div><div><span>@ResidencyTypeLabel(item.ResidencyType) · @RoleLabel(item.HouseholdRole)</span>@if(item.HouseholdRole=="HOUSEHOLD_MEMBER"){<small>@HeadLabel(item) · @RelationshipLabel(item.RelationshipToHead)</small>}</div><div class="history-period"><span>@DateRange(item.StartDate,item.EndDate)</span></div><span class="status-chip ended">Đã kết thúc</span></article>}</div>}
   </div>
  </section>
 }
</div>

@if(editing && resident is not null){<div class="resident-modal-backdrop"><section class="resident-modal" role="dialog" aria-modal="true"><header class="resident-modal-header"><div><h2>Chỉnh sửa hồ sơ</h2><p>Mã cư dân @resident.ResidentCode là dữ liệu chỉ đọc.</p></div><button class="resident-modal-close" @onclick="CloseEdit">×</button></header><div class="resident-modal-section"><div class="resident-form-grid"><label>Họ và tên <em>*</em><input @bind="edit.FullName"/></label><label>Ngày sinh <em>*</em><input type="date" @bind="edit.DateOfBirth"/></label><label>Giới tính<input @bind="edit.Gender"/></label><label>Quốc tịch <em>*</em><input @bind="edit.Nationality"/></label><label>Loại giấy tờ<input @bind="edit.IdentityType"/></label><label>Số giấy tờ<input class="@(editIdentityError is null?null:"invalid")" aria-invalid="@(editIdentityError is not null)" @bind="edit.IdentityNumber"/>@if(editIdentityError is not null){<small class="field-error">@editIdentityError</small>}</label><label>Ngày cấp<input type="date" @bind="edit.IdentityIssuedDate"/></label><label>Ngày hết hạn<input type="date" @bind="edit.IdentityExpiryDate"/></label><label>Số điện thoại<input type="tel" @bind="edit.PhoneNumber"/></label><label>Email<input class="@(editEmailError is null?null:"invalid")" aria-invalid="@(editEmailError is not null)" type="email" @bind="edit.Email"/>@if(editEmailError is not null){<small class="field-error">@editEmailError</small>}</label><label class="resident-form-full">Ghi chú<textarea @bind="edit.Note"></textarea></label></div>@if(!string.IsNullOrWhiteSpace(dialogError)){<p class="resident-notice error">@dialogError</p>}</div><footer class="resident-modal-footer"><button class="resident-cancel" @onclick="CloseEdit">Hủy</button><button class="resident-primary" disabled="@saving" @onclick="SaveEdit">@(saving?"Đang lưu…":"Lưu thay đổi")</button></footer></section></div>}

@if(residencyDialog){<div class="resident-modal-backdrop"><section class="resident-modal" role="dialog" aria-modal="true"><header class="resident-modal-header"><div><h2>@(movingSource is not null?"Chuyển căn hộ":"Thêm quan hệ cư trú")</h2><p>@(movingSource is not null?$"Chọn căn hộ đích cho quan hệ tại {movingSource.UnitNumber}.":"Tạo thêm quan hệ cư trú mà không kết thúc các quan hệ hiện tại.")</p></div><button class="resident-modal-close" aria-label="Đóng" @onclick="CloseResidency">×</button></header><div class="resident-modal-section"><div class="resident-form-grid"><label>Căn hộ <em>*</em><PropFlowSelect Options="ApartmentOptions" Value="@residencyApartment" ValueChanged="ResidencyApartmentChanged" Placeholder="Chọn căn hộ" AriaLabel="Căn hộ mới" /></label><label>Ngày bắt đầu <em>*</em><input type="date" @bind="residencyForm.StartDate"/></label><label>Hình thức cư trú <em>*</em><PropFlowSelect Options="ResidencyTypeOptions" @bind-Value="residencyForm.ResidencyType" AriaLabel="Hình thức cư trú" />@if(!CanUseOwnerOccupied){<small>Chỉ cư dân có quyền sở hữu hiện tại tại căn hộ đã chọn mới dùng được “Chủ sở hữu đang cư trú”.</small>}</label><label>Vai trò trong hộ <em>*</em><PropFlowSelect Options="HouseholdRoleOptions" Value="@residencyForm.HouseholdRole" ValueChanged="ResidencyRoleChanged" AriaLabel="Vai trò trong hộ" /></label>@if(IsMember){<label>Chủ hộ <em>*</em><PropFlowSelect Options="HeadOptions" Value="@headId" ValueChanged="HeadChanged" Placeholder="Chọn chủ hộ" AriaLabel="Chủ hộ" /></label><label>Quan hệ với chủ hộ <em>*</em><PropFlowSelect Options="RelationshipOptions" @bind-Value="relationship" Placeholder="Chọn quan hệ" AriaLabel="Quan hệ với chủ hộ" /></label>}<label class="resident-form-full">Ghi chú<textarea @bind="residencyForm.Note"></textarea></label></div>@if(!string.IsNullOrWhiteSpace(dialogError)){<p class="resident-notice error">@dialogError</p>}</div><footer class="resident-modal-footer"><button class="resident-cancel" @onclick="CloseResidency">Hủy</button><button class="resident-primary" disabled="@saving" @onclick="PrepareResidencyConfirmation">@(movingSource is not null?"Tiếp tục chuyển":"Tiếp tục thêm")</button></footer></section></div>}

@if(ownershipDialog && resident is not null){<div class="resident-modal-backdrop" @onclick="CloseOwnershipDialog"><section class="resident-modal ownership-dialog" role="dialog" aria-modal="true" aria-labelledby="ownership-dialog-title" @onclick:stopPropagation="true"><header class="resident-modal-header"><div><h2 id="ownership-dialog-title">Thêm quyền sở hữu căn hộ</h2><p>Chọn căn hộ để ghi nhận quyền sở hữu cho cư dân này.</p></div><button class="resident-modal-close" aria-label="Đóng" disabled="@savingOwnership" @onclick="CloseOwnershipDialog">×</button></header><div class="resident-modal-section"><div class="ownership-resident-context"><span class="resident-avatar">@Initials</span><div><strong>@resident.FullName</strong><span>@resident.ResidentCode</span></div></div><label class="ownership-search">Tìm theo mã căn hộ<input value="@ownershipSearch" @oninput="SearchOwnershipCandidates" placeholder="Ví dụ: P203" autocomplete="off" /></label><label class="ownership-picker">Căn hộ <em>*</em><PropFlowSelect Options="OwnershipCandidateOptions" Value="@selectedOwnershipApartment" ValueChanged="SelectOwnershipCandidate" Placeholder="Chọn căn hộ" AriaLabel="Căn hộ thêm quyền sở hữu" Disabled="@ownershipCandidatesLoading" /></label>@if(ownershipCandidatesLoading){<p class="ownership-loading"><span></span>Đang tải căn hộ phù hợp…</p>}else if(ownershipCandidates.Count==0&&string.IsNullOrWhiteSpace(ownershipDialogError)){<p class="ownership-empty">Không còn căn hộ phù hợp. Cư dân đã sở hữu các căn hộ trong kết quả hiện tại.</p>}@if(!string.IsNullOrWhiteSpace(ownershipDialogError)){<p class="resident-notice error ownership-dialog-error">@ownershipDialogError</p>}<p class="ownership-boundary-note"><span class="material-symbols-outlined">info</span>Thao tác này chỉ ghi nhận quyền sở hữu, không tạo quan hệ cư trú và không thay đổi số người đang ở.</p></div><footer class="resident-modal-footer"><button class="resident-cancel" disabled="@savingOwnership" @onclick="CloseOwnershipDialog">Hủy</button><button class="resident-primary" disabled="@(savingOwnership||ownershipCandidatesLoading||!Guid.TryParse(selectedOwnershipApartment,out _))" @onclick="PrepareAddOwnership">Thêm quyền sở hữu</button></footer></section></div>}

@if(residencyConfirmation && resident is not null){<PropFlowConfirmationDialog Title="@(movingSource is null?"Thêm quan hệ cư trú?":"Chuyển quan hệ cư trú?")" Message="@ResidencyConfirmationMessage" ConfirmText="@(movingSource is null?"Thêm cư trú":"Xác nhận chuyển")" Busy="@saving" Destructive="false" OnConfirm="ConfirmResidencyMutation" OnCancel="CloseResidencyConfirmation" />}
@if(endingResidency is not null && resident is not null){<PropFlowConfirmationDialog Title="Kết thúc quan hệ cư trú?" Message="@($"Kết thúc quan hệ cư trú của {resident.FullName} tại căn hộ {endingResidency.UnitNumber}? Lịch sử cư trú sẽ được giữ lại và quyền sở hữu không thay đổi.")" ConfirmText="Kết thúc cư trú" Busy="@saving" OnConfirm="ConfirmEndResidency" OnCancel="CloseEndResidency" />}
@if(pendingOwnership is not null && resident is not null){<PropFlowConfirmationDialog Title="Xác nhận thêm quyền sở hữu?" Message="@($"{resident.FullName} sẽ được ghi nhận là chủ sở hữu hiện hành của căn hộ {pendingOwnership.UnitNumber}. Thao tác này không tạo quan hệ cư trú.")" ConfirmText="Thêm quyền sở hữu" Busy="@savingOwnership" Destructive="false" OnConfirm="ConfirmAddOwnership" OnCancel="CloseAddOwnershipConfirmation" />}
@if(endingOwnership is not null && resident is not null){<PropFlowConfirmationDialog Title="Kết thúc quyền sở hữu?" Message="@($"Bạn có chắc muốn kết thúc quyền sở hữu của {resident.FullName} đối với căn hộ {endingOwnership.UnitNumber} không? Quan hệ cư trú không tự động bị kết thúc.")" ConfirmText="Kết thúc quyền sở hữu" Busy="@savingOwnership" OnConfirm="ConfirmEndOwnership" OnCancel="CloseEndOwnershipConfirmation" />}
@if(!string.IsNullOrWhiteSpace(blockerMessage)){<PropFlowConfirmationDialog Title="@blockerTitle" Message="@blockerMessage" ConfirmText="Đã hiểu" InformationOnly="true" Destructive="false" OnCancel="CloseBlocker" />}

@code {
 [Parameter] public Guid Id{get;set;} ResidentDetailResponse? resident; ResidencyItem? endingResidency,movingSource; OwnershipItem? endingOwnership; ApartmentOwnershipCandidate? pendingOwnership; bool loading=true,editing,residencyDialog,saving,showActions,ownershipDialog,ownershipCandidatesLoading,savingOwnership,ownershipRefreshing,residencyConfirmation; int ownershipCandidateRequest,toastKey,toastDuration=3000; string? loadError,dialogError,editIdentityError,editEmailError,residencyApartment,headId,relationship,ownershipSearch,selectedOwnershipApartment,ownershipDialogError,toastMessage,blockerTitle,blockerMessage; string toastSeverity="success"; UpdateResidentRequest edit=new(); CreateResidencyRequest residencyForm=new(); IReadOnlyList<ActiveApartmentOption> units=[]; IReadOnlyList<EligibleHouseholdHead> heads=[]; IReadOnlyList<ApartmentOwnershipCandidate> ownershipCandidates=[];
 bool CanManage=>string.Equals(Session.User?.Role,"MANAGER",StringComparison.OrdinalIgnoreCase); IReadOnlyList<ResidencyItem> ActiveResidencies=>resident?.Residencies.Where(x=>x.Status=="ACTIVE"&&x.EndDate is null).OrderBy(x=>x.UnitNumber).ToArray()??[]; IReadOnlyList<ResidencyItem> ResidencyHistory=>resident?.Residencies.Where(x=>x.Status!="ACTIVE"||x.EndDate is not null).OrderByDescending(x=>x.EndDate??x.StartDate).ThenByDescending(x=>x.StartDate).ToArray()??[]; IReadOnlyList<OwnershipItem> CurrentOwnerships=>resident?.Ownerships.Where(x=>x.EndDate is null).OrderByDescending(x=>x.StartDate).ToArray()??[]; IReadOnlyList<OwnershipItem> OwnershipHistory=>resident?.Ownerships.Where(x=>x.EndDate is not null).OrderByDescending(x=>x.EndDate).ThenByDescending(x=>x.StartDate).ToArray()??[]; bool IsMember=>residencyForm.HouseholdRole=="HOUSEHOLD_MEMBER"; bool CanUseOwnerOccupied=>Guid.TryParse(residencyApartment,out var apartmentId)&&ResidentRelationshipFormRules.HasCurrentOwnership(resident?.Ownerships,apartmentId,residencyForm.StartDate);
 static readonly IReadOnlyList<PropFlowSelectOption> StatusOptions=[new("ACTIVE","Đang hoạt động"),new("INACTIVE","Ngừng hoạt động"),new("MOVED_OUT","Đã chuyển đi")]; static readonly IReadOnlyList<PropFlowSelectOption> HouseholdRoleOptions=[new("HOUSEHOLD_HEAD","Chủ hộ"),new("HOUSEHOLD_MEMBER","Thành viên hộ")]; static readonly IReadOnlyList<PropFlowSelectOption> RelationshipOptions=[new("SPOUSE","Vợ/chồng"),new("CHILD","Con"),new("PARENT","Cha/mẹ"),new("SIBLING","Anh/chị/em"),new("OTHER_RELATIVE","Người thân khác")]; IReadOnlyList<PropFlowSelectOption> ResidencyTypeOptions=>[new("OWNER_OCCUPIED","Chủ sở hữu đang cư trú",!CanUseOwnerOccupied),new("TENANT","Người thuê"),new("AUTHORIZED_OCCUPANT","Người được phép cư trú")]; IReadOnlyList<PropFlowSelectOption> ApartmentOptions=>units.Select(x=>new PropFlowSelectOption(x.Id.ToString(),$"{x.UnitNumber} · Tầng {x.FloorNumber}")).ToArray(); IReadOnlyList<PropFlowSelectOption> HeadOptions=>heads.Select(x=>new PropFlowSelectOption(x.ResidencyId.ToString(),$"{x.FullName} · {x.ResidentCode}")).ToArray(); IReadOnlyList<PropFlowSelectOption> OwnershipCandidateOptions=>ownershipCandidates.Select(x=>new PropFlowSelectOption(x.Id.ToString(),$"{x.UnitNumber} · Tầng {x.FloorNumber} · {x.UnitType}")).ToArray();
 string ResidencyConfirmationMessage{get{var target=units.FirstOrDefault(x=>x.Id.ToString()==residencyApartment)?.UnitNumber??"đã chọn";return movingSource is null?$"Thêm quan hệ cư trú của {resident?.FullName} tại căn hộ {target}? Các quan hệ cư trú hiện tại vẫn được giữ nguyên.":$"Chuyển quan hệ cư trú của {resident?.FullName} từ căn hộ {movingSource.UnitNumber} sang căn hộ {target}? Thao tác được thực hiện nguyên tử và lịch sử vẫn được giữ lại.";}}
 string Initials=>string.Concat((resident?.FullName??"?").Split(' ',StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(x=>x[0])).ToUpperInvariant();
 protected override Task OnParametersSetAsync()=>LoadAsync(); async Task LoadAsync(){loading=true;loadError=null;resident=null;try{var r=await Residents.GetAsync(Id);if(r.IsSuccess&&r.Data is not null)resident=r.Data;else loadError=r.Message??"Không tìm thấy hồ sơ cư dân.";}catch{loadError="Không thể kết nối máy chủ. Vui lòng thử lại.";}finally{loading=false;}}
 async Task RefreshOwnerships(){ownershipRefreshing=true;try{var r=await Residents.GetAsync(Id);if(r.IsSuccess&&r.Data is not null)resident=r.Data;else ShowToast(r.Message??"Không thể đồng bộ quyền sở hữu.","error",5000);}finally{ownershipRefreshing=false;}}
 async Task OpenOwnershipDialog(){ownershipDialog=true;ownershipSearch=selectedOwnershipApartment=ownershipDialogError=null;await LoadOwnershipCandidates();}
 void CloseOwnershipDialog(){if(savingOwnership)return;ownershipDialog=false;ownershipCandidateRequest++;ownershipCandidates=[];ownershipDialogError=null;}
