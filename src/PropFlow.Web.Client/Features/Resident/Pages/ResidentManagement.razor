@page "/residents"
@layout PropFlow.Web.Client.Layout.MainLayout
@attribute [Authorize(Roles="MANAGER,STAFF,ACCOUNTANT")]
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using PropFlow.Web.Client.Features.Resident.Models
@using PropFlow.Web.Client.Features.Resident.Services
@using PropFlow.Web.Client.Shared.Forms
@using PropFlow.Web.Client.Shared.Feedback
@inject IResidentApiClient Residents
@inject NavigationManager Navigation
@inject PropFlow.Web.Client.Services.Authentication.AuthSession Session
@inject IJSRuntime JS

<PageTitle>Quản lý cư dân - PropFlow</PageTitle>
<div class="resident-page">
 <section class="resident-header"><div><h1>Quản lý cư dân</h1><p>Tra cứu hồ sơ và các quan hệ căn hộ hiện hành.</p></div>@if(CanManage){<button class="resident-primary" @onclick="Open">＋ Thêm cư dân</button>}</section>
 @if(!string.IsNullOrWhiteSpace(loadError)){<p class="resident-notice error" role="alert">@loadError <button class="resident-link" @onclick="LoadAsync">Thử lại</button></p>}
 <section class="resident-panel">
  <div class="resident-toolbar"><div class="resident-search"><span class="material-symbols-outlined">search</span><input aria-label="Tìm kiếm cư dân" placeholder="Tìm theo mã, họ tên, số điện thoại hoặc email..." @bind="search" @bind:event="oninput" @onkeydown="SearchKeyDown" />@if(!string.IsNullOrWhiteSpace(search)){<button type="button" class="clear-search" aria-label="Xóa tìm kiếm" @onclick="ClearSearch"><span class="material-symbols-outlined">close</span></button>}</div><button type="button" class="filter-toggle @(showFilters||ActiveFilterCount>0?"active":null)" aria-expanded="@showFilters" aria-haspopup="dialog" @onclick="ToggleFilters"><span class="material-symbols-outlined">filter_alt</span><span>Bộ lọc</span>@if(ActiveFilterCount>0){<strong>@ActiveFilterCount</strong>}</button><span class="result-count"><i></i>Hiển thị @data.Items.Count / @data.TotalCount cư dân</span></div>
  <div class="resident-results @(loading?"is-loading":null)" aria-busy="@loading">
   @if(loading&&data.Items.Count>0){<div class="list-loading-overlay" role="status"><span class="loading-spinner"></span>Đang cập nhật…</div>}
   @if(loading&&data.Items.Count==0){<p class="resident-state">Đang tải danh sách cư dân…</p>}else if(data.Items.Count==0){<p class="resident-state">Không tìm thấy cư dân phù hợp.</p>}else{<div class="resident-table-wrap"><table><thead><tr><th>MÃ CƯ DÂN</th><th>CƯ DÂN</th><th>LIÊN HỆ</th><th>QUAN HỆ CĂN HỘ</th><th>TRẠNG THÁI</th><th>HÀNH ĐỘNG</th></tr></thead><tbody>@foreach(var x in data.Items){<tr><td><strong>@x.ResidentCode</strong><small>@(x.HasAccount?"Đã có tài khoản":"Chưa có tài khoản")</small></td><td><strong>@x.FullName</strong></td><td>@(x.PhoneNumber??"Chưa cập nhật")<small>@(x.Email??"Chưa cập nhật email")</small></td><td>@if(x.ApartmentRelationships.Count==0){<span class="resident-muted">Chưa có quan hệ hiện hành</span>}else{@foreach(var relation in x.ApartmentRelationships){<div class="resident-apartment"><strong>@relation.UnitNumber</strong><small>Tầng @relation.FloorNumber · @RelationLabel(relation)</small></div>}}</td><td><span class="resident-status @x.Status.ToLowerInvariant()">@StatusLabel(x.Status)</span></td><td><button type="button" class="resident-row-action" title="Xem chi tiết" aria-label="Xem chi tiết cư dân @x.FullName" @onclick="()=>Detail(x.Id)"><span class="material-symbols-outlined" aria-hidden="true">visibility</span></button></td></tr>}</tbody></table></div>}
   @if(initialized&&TotalPages>1){<nav class="resident-pagination" aria-label="Phân trang cư dân"><span>Trang @data.PageIndex / @TotalPages</span><button disabled="@(loading||data.PageIndex<=1)" @onclick="()=>GoPage(data.PageIndex-1)">Trước</button>@foreach(var p in Enumerable.Range(1,TotalPages)){<button disabled="@loading" class="@(p==data.PageIndex?"current":null)" @onclick="()=>GoPage(p)">@p</button>}<button disabled="@(loading||data.PageIndex>=TotalPages)" @onclick="()=>GoPage(data.PageIndex+1)">Sau</button></nav>}
  </div>
 </section>
</div>

@if(showFilters){<div class="filter-popover-backdrop" @onclick="CloseFilters"><section class="filter-popover" role="dialog" aria-modal="true" aria-labelledby="resident-filter-title" @onclick:stopPropagation="true"><header><div><span class="material-symbols-outlined">filter_alt</span><div><h2 id="resident-filter-title">Bộ lọc cư dân</h2><p>Thu hẹp danh sách theo hồ sơ và quan hệ hiện hành.</p></div></div><button type="button" class="filter-close" aria-label="Đóng bộ lọc" @onclick="CloseFilters"><span class="material-symbols-outlined">close</span></button></header><div class="filter-grid"><label><span>Trạng thái cư dân</span><PropFlowSelect Options="StatusOptions" Value="@draftStatus" ValueChanged="v=>draftStatus=v" Variant="Filter" AriaLabel="Trạng thái cư dân" /></label><label><span>Căn hộ</span><PropFlowSelect Options="ApartmentFilterOptions" Value="@draftApartmentFilter" ValueChanged="v=>draftApartmentFilter=v" Variant="Filter" AriaLabel="Căn hộ" /></label><label><span>Quan hệ với căn hộ</span><PropFlowSelect Options="RelationshipFilterOptions" Value="@draftRelationshipFilter" ValueChanged="DraftRelationshipChanged" Variant="Filter" AriaLabel="Quan hệ với căn hộ" /></label>@if(draftRelationshipFilter!="OWNER_ONLY"){<label><span>Hình thức cư trú</span><PropFlowSelect Options="ResidencyFilterOptions" Value="@draftResidencyFilter" ValueChanged="v=>draftResidencyFilter=v" Variant="Filter" AriaLabel="Hình thức cư trú" /></label><label><span>Vai trò trong hộ</span><PropFlowSelect Options="HouseholdRoleFilterOptions" Value="@draftHouseholdRoleFilter" ValueChanged="v=>draftHouseholdRoleFilter=v" Variant="Filter" AriaLabel="Vai trò trong hộ" /></label>}</div><footer><button type="button" class="filter-reset" @onclick="ResetFilters">Đặt lại bộ lọc</button><button type="button" class="filter-apply" @onclick="ApplyFilters"><span class="material-symbols-outlined">check</span>Áp dụng</button></footer></section></div>}

@if(creating&&editContext is not null){<div class="resident-modal-backdrop" @onclick="Close"><section class="resident-modal" role="dialog" aria-modal="true" aria-labelledby="resident-create-title" @onclick:stopPropagation="true" @onkeydown="ModalKeyDown"><header class="resident-modal-header"><div class="resident-modal-title"><span class="material-symbols-outlined">person_add</span><div><h2 id="resident-create-title">Thêm hồ sơ cư dân</h2><p>Thông tin hồ sơ và quan hệ với căn hộ.</p></div></div><button type="button" class="resident-modal-close" @onclick="Close" aria-label="Đóng">×</button></header><div class="resident-modal-form-shell"><EditForm EditContext="editContext" OnSubmit="Submit" class="resident-modal-form"><DataAnnotationsValidator /><div class="resident-modal-body">@if(showValidationSummary){<p class="resident-validation-summary" role="alert">Vui lòng kiểm tra các trường được đánh dấu bên dưới.</p>}<section class="resident-modal-section"><strong>THÔNG TIN CƯ DÂN</strong><div class="resident-form-grid">
 <label>Họ và tên <em>*</em><InputText id="resident-full-name" @bind-Value="form.FullName" @oninput="(_)=>ClearActionError()" disabled="@saving" /><ValidationMessage For="()=>form.FullName" /></label>
 <label>Ngày sinh <em>*</em><div id="resident-date-of-birth"><PropFlowDatePicker Value="form.DateOfBirth" ValueChanged="v=>DateChanged(nameof(form.DateOfBirth),v)" ValidityChanged="v=>dateOfBirthValid=v" AriaLabel="Ngày sinh" Disabled="@saving" /></div><ValidationMessage For="()=>form.DateOfBirth" /></label>
 <label>Giới tính<PropFlowSelect Options="GenderOptions" Value="@(form.Gender??string.Empty)" ValueChanged="GenderChanged" Disabled="@saving" Placeholder="Chọn giới tính" AriaLabel="Giới tính" /></label>
 <label>Quốc tịch <em>*</em><InputText id="resident-nationality" @bind-Value="form.Nationality" @oninput="(_)=>ClearActionError()" disabled="@saving" /><ValidationMessage For="()=>form.Nationality" /></label>
 <label>Loại giấy tờ <em>*</em><PropFlowSelect Id="resident-identity-type" Options="IdentityTypeOptions" Value="@(form.IdentityType??string.Empty)" ValueChanged="IdentityTypeChanged" ValueExpression="()=>form.IdentityType!" Disabled="@saving" Placeholder="Chọn loại giấy tờ" AriaLabel="Loại giấy tờ" /><ValidationMessage For="()=>form.IdentityType" /></label>
 <label>Số giấy tờ <em>*</em><InputText id="resident-identity-number" inputmode="numeric" maxlength="12" @bind-Value="form.IdentityNumber" @oninput="(_)=>ClearActionError()" disabled="@saving" /><ValidationMessage For="()=>form.IdentityNumber" /></label>
 <label>Ngày cấp<div id="resident-identity-issued-date"><PropFlowDatePicker Value="form.IdentityIssuedDate" ValueChanged="v=>DateChanged(nameof(form.IdentityIssuedDate),v)" ValidityChanged="v=>identityIssuedDateValid=v" AriaLabel="Ngày cấp giấy tờ" Disabled="@saving" /></div><ValidationMessage For="()=>form.IdentityIssuedDate" /></label>
 <label>Ngày hết hạn<div id="resident-identity-expiry-date"><PropFlowDatePicker Value="form.IdentityExpiryDate" ValueChanged="v=>DateChanged(nameof(form.IdentityExpiryDate),v)" ValidityChanged="v=>identityExpiryDateValid=v" AriaLabel="Ngày hết hạn giấy tờ" Disabled="@saving" /></div><ValidationMessage For="()=>form.IdentityExpiryDate" /></label>
 <label>Số điện thoại <em>*</em><InputText id="resident-phone-number" type="tel" @bind-Value="form.PhoneNumber" @oninput="(_)=>ClearActionError()" disabled="@saving" /><ValidationMessage For="()=>form.PhoneNumber" /></label>
 <label>Email<InputText id="resident-email" type="email" @bind-Value="form.Email" @oninput="(_)=>ClearActionError()" disabled="@saving" /><ValidationMessage For="()=>form.Email" /></label>
 <label class="resident-form-full">Ghi chú<InputTextArea @bind-Value="form.Note" @oninput="(_)=>ClearActionError()" disabled="@saving" /></label>
 </div></section><section class="resident-modal-section"><strong>QUAN HỆ VỚI CĂN HỘ</strong><div class="resident-form-grid">
 <label>Quan hệ với căn hộ <em>*</em><PropFlowSelect Id="resident-relationship-kind" Options="RelationshipKindOptions" Value="@form.RelationshipKind" ValueChanged="RelationshipChangedWithHeadCheck" ValueExpression="()=>form.RelationshipKind" Disabled="@saving" Placeholder="Chọn quan hệ" AriaLabel="Quan hệ với căn hộ" /><ValidationMessage For="()=>form.RelationshipKind" /></label>
 <label>Căn hộ <em>*</em><PropFlowSelect Id="resident-apartment" Options="ApartmentOptions" Value="@(form.ApartmentUnitId==Guid.Empty?string.Empty:form.ApartmentUnitId.ToString())" ValueChanged="ApartmentChangedWithHeadCheck" Disabled="@saving" Placeholder="Chọn căn hộ" AriaLabel="Căn hộ" /><ValidationMessage For="()=>form.ApartmentUnitId" /></label>
 @if(IsResident){@if(IsOwnerAndResident){<label>Hình thức cư trú<input value="Chủ sở hữu đang cư trú" readonly /><ValidationMessage For="()=>residencyType" /></label>}else{<label>Hình thức cư trú <em>*</em><PropFlowSelect Options="ResidencyTypeOptions" Value="@residencyType" ValueChanged="ResidencyTypeChanged" Disabled="@saving" AriaLabel="Hình thức cư trú" /><ValidationMessage For="()=>residencyType" /></label>}<label>Vai trò trong hộ <em>*</em><PropFlowSelect Options="HouseholdRoleOptions" Value="@householdRole" ValueChanged="HouseholdRoleChangedWithHeadCheck" Disabled="@(saving||loadingHeads||!headAvailabilityKnown)" AriaLabel="Vai trò trong hộ" />@if(HasActiveHouseholdHead){<span class="resident-field-note">Căn hộ đã có chủ hộ @heads[0].FullName. Chỉ có thể chọn Thành viên hộ.</span>}<ValidationMessage For="()=>householdRole" /></label>@if(IsMember&&form.ApartmentUnitId!=Guid.Empty){<label>Chủ hộ <em>*</em><PropFlowSelect Options="HouseholdHeadOptions" Value="@(householdHeadResidencyId??string.Empty)" ValueChanged="HouseholdHeadChanged" Disabled="@saving" Placeholder="@(heads.Count==0?"Chưa có chủ hộ phù hợp":"Chọn chủ hộ")" AriaLabel="Chủ hộ" /><ValidationMessage For="()=>householdHeadResidencyId" /></label><label>Quan hệ với chủ hộ <em>*</em><PropFlowSelect Options="HouseholdRelationshipOptions" Value="@(relationshipToHead??string.Empty)" ValueChanged="RelationshipToHeadChanged" Disabled="@saving" Placeholder="Chọn quan hệ" AriaLabel="Quan hệ với chủ hộ" /><ValidationMessage For="()=>relationshipToHead" /></label>}<div class="resident-form-full"><ValidationMessage For="()=>form.Residency" /></div>}
 </div></section></div><footer class="resident-modal-footer"><button type="button" class="resident-cancel" @onclick="Close">Hủy bỏ</button><button type="submit" class="resident-primary" disabled="@(saving||!dateOfBirthValid||!identityIssuedDateValid||!identityExpiryDateValid)">@(saving?"Đang lưu…":"Lưu cư dân")</button></footer></EditForm></div></section></div>}
@if(!string.IsNullOrWhiteSpace(actionMessage)){<PropFlowToast @key="toastVersion" Message="@actionMessage" Severity="error" DurationMs="4000" OnDismiss="DismissActionMessage" />}

@code {
 const int PageSize=20; PagedResidentsResponse data=new([],0,1,PageSize); IReadOnlyList<ActiveApartmentOption> units=[]; IReadOnlyList<EligibleHouseholdHead> heads=[]; CreateResidentRequest form=new(); EditContext? editContext; ValidationMessageStore? serverMessages; IJSObjectReference? module;
 string? loadError,search,actionMessage,householdHeadResidencyId,relationshipToHead; string status="",apartmentFilter="",relationshipFilter="",residencyFilter="",householdRoleFilter="",draftStatus="",draftApartmentFilter="",draftRelationshipFilter="",draftResidencyFilter="",draftHouseholdRoleFilter="",residencyType="",householdRole=""; bool loading=true,initialized,creating,saving,showFilters,showValidationSummary,loadingHeads,headAvailabilityKnown,dateOfBirthValid=true,identityIssuedDateValid=true,identityExpiryDateValid=true; int toastVersion;
 static readonly IReadOnlyList<PropFlowSelectOption> StatusOptions=[new("","Tất cả"),new("ACTIVE","Đang hoạt động"),new("INACTIVE","Ngừng hoạt động"),new("MOVED_OUT","Đã chuyển đi")]; static readonly IReadOnlyList<PropFlowSelectOption> RelationshipFilterOptions=[new("","Tất cả"),new("OWNER_ONLY","Chủ sở hữu"),new("RESIDENT_ONLY","Cư trú"),new("OWNER_AND_RESIDENT","Chủ sở hữu và đang cư trú")]; static readonly IReadOnlyList<PropFlowSelectOption> ResidencyFilterOptions=[new("","Tất cả"),new("OWNER_OCCUPIED","Chủ sở hữu đang cư trú"),new("TENANT","Người thuê"),new("AUTHORIZED_OCCUPANT","Người được phép cư trú")]; static readonly IReadOnlyList<PropFlowSelectOption> HouseholdRoleFilterOptions=[new("","Tất cả"),new("HOUSEHOLD_HEAD","Chủ hộ"),new("HOUSEHOLD_MEMBER","Thành viên hộ")]; static readonly IReadOnlyList<PropFlowSelectOption> IdentityTypeOptions=[new("CCCD","CCCD"),new("CMND","CMND")]; static readonly IReadOnlyList<PropFlowSelectOption> RelationshipKindOptions=[new("OWNER_ONLY","Chủ sở hữu"),new("RESIDENT_ONLY","Cư trú"),new("OWNER_AND_RESIDENT","Chủ sở hữu và đang cư trú")]; static readonly IReadOnlyList<PropFlowSelectOption> ResidencyTypeOptions=[new("TENANT","Người thuê"),new("AUTHORIZED_OCCUPANT","Người được phép cư trú")]; static readonly IReadOnlyList<PropFlowSelectOption> HouseholdRelationshipOptions=[new("SPOUSE","Vợ/chồng"),new("CHILD","Con"),new("PARENT","Cha/mẹ"),new("SIBLING","Anh/chị/em"),new("OTHER_RELATIVE","Người thân khác")];
 IReadOnlyList<PropFlowSelectOption> ApartmentOptions=>units.Select(x=>new PropFlowSelectOption(x.Id.ToString(),$"{x.UnitNumber} · Tầng {x.FloorNumber}")).ToArray(); IReadOnlyList<PropFlowSelectOption> ApartmentFilterOptions=>[new("","Tất cả căn hộ"),..ApartmentOptions]; IReadOnlyList<PropFlowSelectOption> HouseholdHeadOptions=>heads.Select(x=>new PropFlowSelectOption(x.ResidencyId.ToString(),$"{x.FullName} · {x.ResidentCode}")).ToArray(); IReadOnlyList<PropFlowSelectOption> HouseholdRoleOptions=>[new("HOUSEHOLD_HEAD",HasActiveHouseholdHead?"Chủ hộ (căn hộ đã có chủ hộ)":"Chủ hộ",HasActiveHouseholdHead),new("HOUSEHOLD_MEMBER","Thành viên hộ")]; ResidentRelationshipFormState RelationshipState=>new(form.RelationshipKind,form.ApartmentUnitId,residencyType,householdRole,householdHeadResidencyId,relationshipToHead); bool IsResident=>form.RelationshipKind is "RESIDENT_ONLY" or "OWNER_AND_RESIDENT"; bool IsOwnerAndResident=>form.RelationshipKind=="OWNER_AND_RESIDENT"; bool IsMember=>IsResident&&householdRole=="HOUSEHOLD_MEMBER"; bool HasActiveHouseholdHead=>heads.Count>0; bool CanManage=>string.Equals(Session.User?.Role,"MANAGER",StringComparison.OrdinalIgnoreCase); int TotalPages=>Math.Max(1,(int)Math.Ceiling(data.TotalCount/(double)PageSize)); int ActiveFilterCount=>(Empty(status)?0:1)+(Empty(apartmentFilter)?0:1)+(Empty(relationshipFilter)?0:1)+(Empty(residencyFilter)?0:1)+(Empty(householdRoleFilter)?0:1);
 protected override async Task OnInitializedAsync(){var apartments=await Residents.ActiveApartmentsAsync();units=apartments.Data??[];await LoadAsync();} async Task LoadAsync(){loading=true;loadError=null;try{var unit=Guid.TryParse(apartmentFilter,out var id)?id:(Guid?)null;var r=await Residents.ListAsync(search,status,unit,relationshipFilter,residencyFilter,householdRoleFilter,data.PageIndex);if(r.IsSuccess&&r.Data is not null)data=r.Data;else loadError=r.Message??"Không thể tải danh sách cư dân.";}catch{loadError="Không thể kết nối máy chủ. Vui lòng thử lại.";}finally{loading=false;initialized=true;}} async Task Search(){data=data with{PageIndex=1};await LoadAsync();} async Task SearchKeyDown(KeyboardEventArgs e){if(e.Key=="Enter"&&!loading)await Search();} async Task ClearSearch(){search=null;await Search();} async Task GoPage(int p){if(loading||p<1||p>TotalPages)return;data=data with{PageIndex=p};await LoadAsync();}
 void ToggleFilters(){if(showFilters){showFilters=false;return;}draftStatus=status;draftApartmentFilter=apartmentFilter;draftRelationshipFilter=relationshipFilter;draftResidencyFilter=residencyFilter;draftHouseholdRoleFilter=householdRoleFilter;showFilters=true;} void CloseFilters()=>showFilters=false; Task DraftRelationshipChanged(string value){draftRelationshipFilter=value;if(value=="OWNER_ONLY")draftResidencyFilter=draftHouseholdRoleFilter="";return Task.CompletedTask;} async Task ApplyFilters(){status=draftStatus;apartmentFilter=draftApartmentFilter;relationshipFilter=draftRelationshipFilter;residencyFilter=draftResidencyFilter;householdRoleFilter=draftHouseholdRoleFilter;showFilters=false;await Search();} async Task ResetFilters(){status=apartmentFilter=relationshipFilter=residencyFilter=householdRoleFilter=draftStatus=draftApartmentFilter=draftRelationshipFilter=draftResidencyFilter=draftHouseholdRoleFilter="";showFilters=false;await Search();}
 static string StatusLabel(string value)=>value switch{"ACTIVE"=>"Đang hoạt động","MOVED_OUT"=>"Đã chuyển đi",_=>"Ngừng hoạt động"}; static string RelationLabel(ResidentApartmentRelationshipSummary x)=>x switch{{IsCurrentOwner:true,IsCurrentResident:true}=>"Chủ sở hữu · Đang cư trú",{IsCurrentOwner:true}=>"Chủ sở hữu",_=>"Đang cư trú"}; void Open(){form=new();residencyType=householdRole="";householdHeadResidencyId=relationshipToHead=null;heads=[];loadingHeads=headAvailabilityKnown=false;showValidationSummary=false;editContext=new(form);serverMessages=new(editContext);editContext.OnFieldChanged+=FormFieldChanged;creating=true;} void Close(){if(editContext is not null)editContext.OnFieldChanged-=FormFieldChanged;creating=saving=false;editContext=null;serverMessages=null;showValidationSummary=false;} void Detail(Guid id)=>Navigation.NavigateTo("/residents/"+id); void ModalKeyDown(KeyboardEventArgs e){if(e.Key=="Escape")Close();}
 void FormFieldChanged(object? sender,FieldChangedEventArgs e){ClearActionError();serverMessages?.Clear(e.FieldIdentifier);editContext?.NotifyValidationStateChanged();showValidationSummary=editContext?.GetValidationMessages().Any()==true;} async Task IdentityTypeChanged(string value){var identityNumberField=new FieldIdentifier(form,nameof(form.IdentityNumber));var shouldRevalidateNumber=ShouldRevalidateIdentityNumber(identityNumberField);form.IdentityType=value;Notify(nameof(form.IdentityType));if(shouldRevalidateNumber)Notify(nameof(form.IdentityNumber));await Task.CompletedTask;} bool ShouldRevalidateIdentityNumber(FieldIdentifier identityNumberField)=>!string.IsNullOrWhiteSpace(form.IdentityNumber)||editContext?.IsModified(identityNumberField)==true; async Task DateChanged(string name,DateOnly? value){if(name==nameof(form.DateOfBirth))form.DateOfBirth=value;else if(name==nameof(form.IdentityIssuedDate))form.IdentityIssuedDate=value;else form.IdentityExpiryDate=value;Notify(name);await Task.CompletedTask;} async Task RelationshipChanged(string value){ApplyRelationshipState(ResidentRelationshipFormRules.ChangeRelationship(RelationshipState,value));Notify(nameof(form.RelationshipKind));ClearResidencyValidation();if(!IsResident){form.Residency=null;heads=[];return;}await LoadHeadsAsync();} async Task ApartmentChanged(string value){ApplyRelationshipState(ResidentRelationshipFormRules.ChangeApartment(RelationshipState,Guid.TryParse(value,out var id)?id:Guid.Empty));Notify(nameof(form.ApartmentUnitId));ClearResidencyValidation();heads=[];await LoadHeadsAsync();} async Task ResidencyTypeChanged(string value){residencyType=value;ClearResidencyValidation();await Task.CompletedTask;} async Task HouseholdRoleChanged(string value){ApplyRelationshipState(ResidentRelationshipFormRules.ChangeHouseholdRole(RelationshipState,value));ClearResidencyValidation();if(!IsMember)heads=[];else await LoadHeadsAsync();} void HouseholdHeadChanged(string value){householdHeadResidencyId=value;