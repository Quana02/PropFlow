@page "/resident/service-requests"
@attribute [Authorize(Roles = "RESIDENT")]
@layout PropFlow.Web.Client.Features.Resident.Components.ResidentPortalLayout
@using PropFlow.Web.Client.Features.Resident.Components

<PageTitle>Yêu cầu dịch vụ của tôi - PropFlow</PageTitle>

<div class="page-heading">
    <div>
        <p class="eyebrow">FE-05 · Yêu cầu dịch vụ</p>
        <h1>Yêu cầu của tôi</h1>
        <p>Theo dõi trạng thái và lịch sử xử lý các yêu cầu thuộc phạm vi cư trú của bạn.</p>
    </div>
    <a class="primary-action" href="/resident/service-requests/new">
        <span aria-hidden="true">+</span> Tạo yêu cầu mới
    </a>
</div>

<section class="request-panel" aria-labelledby="request-list-title">
    <div class="panel-heading">
        <div>
            <h2 id="request-list-title">Danh sách yêu cầu</h2>
            <p>Dữ liệu luôn được giới hạn theo tài khoản cư dân đã đăng nhập.</p>
        </div>
        <span class="scope-badge">Phạm vi cá nhân</span>
    </div>

    <div class="filter-bar" aria-label="Tìm kiếm và lọc yêu cầu">
        <label class="search-field">
            <span class="sr-only">Tìm kiếm yêu cầu</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 21-4.4-4.4M19 11a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" /></svg>
            <input type="search" placeholder="Tìm theo mã hoặc tiêu đề..." disabled aria-describedby="api-state-title" />
        </label>
        <div class="filter-select">
            <PropFlowSelect @bind-Value="_status" Options="StatusOptions" Variant="Filter"
                            AriaLabel="Lọc theo trạng thái" Disabled="true" />
        </div>
        <input type="date" disabled aria-label="Lọc từ ngày" aria-describedby="api-state-title" />
    </div>

    <ServiceRequestApiUnavailable />

    <div class="empty-state">
        <span aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" /></svg>
        </span>
        <h3>Chưa có dữ liệu yêu cầu để hiển thị</h3>
        <p>Danh sách sẽ xuất hiện tại đây sau khi API FE-05 được công bố và kết nối.</p>
    </div>
</section>

@code {
    private string _status = string.Empty;
    private static readonly IReadOnlyList<PropFlowSelectOption> StatusOptions =
    [
        new(string.Empty, "Tất cả trạng thái")
    ];
}
