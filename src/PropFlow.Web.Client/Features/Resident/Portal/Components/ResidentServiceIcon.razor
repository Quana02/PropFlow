<span class="service-icon @Accent" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" focusable="false" data-service-icon="@Kind">
        @switch (Kind)
        {
            case "EMERGENCY":
                <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.4 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z" />
                <path d="M15 2a9 9 0 0 1 7 7M15 6a5 5 0 0 1 3 3" />
                break;
            case "BILLING":
                <rect x="3" y="5" width="18" height="14" rx="3" />
                <path d="M3 10h18M7 15h3M14 15h3" />
                break;
            case "CONTACT":
                <path d="M21 14a3 3 0 0 1-3 3H9l-6 4V7a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3Z" />
                <path d="M7 8h10M7 12h7" />
                break;
            default:
                <rect x="5" y="5" width="14" height="16" rx="2" />
                <rect x="9" y="3" width="6" height="4" rx="1" />
                <path d="m9 13 2 2 4-4" />
                break;
        }
    </svg>
</span>

@code {
    [Parameter] public string Kind { get; set; } = "OTHER";
    [Parameter] public string Accent { get; set; } = "sky";
}
