@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Forms
@using PropFlow.Modules.ServiceRequests.Contracts
@using PropFlow.Web.Client.Features.Resident.Portal.Models
@using PropFlow.Web.Client.Features.Resident.Portal.Services
@using PropFlow.Web.Client.Services.Api

@if (_open)
{
    <div class="resident-portal-modal service-modal" id="serviceModal">
        <button class="resident-portal-modal-backdrop" type="button" aria-label="Đóng popup" @onclick="Close"></button>
        <section class="service-modal-card glass-panel" role="dialog" aria-modal="true" aria-labelledby="serviceModalTitle">
            <header class="service-modal-header">
                <div>
                    <div class="service-modal-title-row">
                        <span class="service-modal-icon" aria-hidden="true">📋</span>
                        <h2 id="serviceModalTitle">Tạo yêu cầu dịch vụ</h2>
                    </div>
                    <div class="service-modal-meta">
                        <span>@ProfileContext.ApartmentLabel.ToUpperInvariant()</span>
                        <small>Ban quản lý sẽ tiếp nhận yêu cầu của bạn</small>
                    </div>
                </div>
                <button class="service-modal-close" type="button" aria-label="Đóng popup" @onclick="Close">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18 18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" /></svg>
                </button>
            </header>

            @if (_created is not null)
            {
                <div class="service-submit-success" role="status">
                    <span aria-hidden="true">✓</span>
                    <h3>Yêu cầu đã được ghi nhận</h3>
                    <p>Mã yêu cầu <strong>#@_created.RequestNumber</strong> đang chờ tiếp nhận.</p>
                    <button class="service-submit-button" type="button" @onclick="Close">Hoàn tất</button>
                </div>
            }
            else
            {
                <EditForm Model="_form" OnValidSubmit="SubmitAsync" class="service-registration-form">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    @if (_result is { IsSuccess: false })
                    {
                        <div class="service-submit-error" role="alert">@_result.Message</div>
                    }

                    <div class="service-scope-card">
                        <span class="service-scope-icon" aria-hidden="true">⌂</span>
                        <span><small>Căn hộ của bạn</small><strong>@ProfileContext.ApartmentLabel</strong></span>
                    </div>
                    <p class="service-ai-guidance">Nói hoặc nhập điều bạn muốn đăng ký. AI chỉ hỏi thêm thông tin phù hợp với khách thăm, xe, chuyển đồ hoặc dịch vụ bạn chọn. Bạn có thể ghi thêm thời gian nếu đã xác định; không bắt buộc lịch hẹn cho mọi yêu cầu.</p>

                    <div class="service-form-section">
                        <div class="voice-field-heading">
                            <label class="service-field-label" for="service-description">Mô tả yêu cầu <b>*</b></label>
                            <button class="voice-button @(_listening ? "is-listening" : null)" type="button" @onclick="ToggleVoiceAsync" disabled="@(_submitting || _checking || !_voiceSupported)">
                                <span class="material-symbols-outlined" aria-hidden="true">@(_listening ? "stop_circle" : "mic")</span>
                                @(_listening ? "Dừng nói" : string.IsNullOrWhiteSpace(_form.Description) ? "Nhập bằng giọng nói" : "Nói bổ sung")
                            </button>
                        </div>
                        <textarea id="service-description" @ref="_descriptionInput" @bind="_form.Description" @bind:event="oninput" @bind:after="InvalidateReview" rows="6" maxlength="3500" disabled="_submitting" readonly="_listening" placeholder="Khách thăm: nêu họ tên khách. Chuyển đồ: nêu đồ cần chuyển và chuyển vào/ra. Dịch vụ: nêu dịch vụ cần đăng ký, nhu cầu và nơi thực hiện. Có thể ghi thêm thời gian nếu đã xác định."></textarea>
                        <ValidationMessage For="@(() => _form.Description)" />
                        <small class="voice-privacy">Giọng nói được trình duyệt chuyển thành chữ, có thể qua dịch vụ trực tuyến. PropFlow chỉ nhận văn bản.</small>
                        @if (_listening) { <p class="voice-status" role="status"><span class="voice-recording-dot"></span>Đang nghe tiếng Việt. Bấm Dừng nói khi hoàn tất.</p> }
                        @if (!string.IsNullOrWhiteSpace(_interimText)) { <p class="voice-interim" aria-live="polite">@_interimText</p> }
                        @if (_voiceNotice is not null) { <p class="voice-notice" role="status">@_voiceNotice</p> }
                        <div class="draft-check-actions">
                            <button class="draft-check-button" type="button" @onclick="CheckManuallyAsync" disabled="@(_listening || _checking || _submitting || _form.Description.Trim().Length < 3)"><span class="material-symbols-outlined" aria-hidden="true">auto_awesome</span>@(_checking ? "AI đang kiểm tra…" : "Kiểm tra nội dung")</button>
                            @if (_checkNotice is not null) { <span role="status">@_checkNotice</span> }
                        </div>
                        @if (_review is { Available: true } && (_form.PreferredDate is not null || _form.PreferredTimeCode is not null))
                        {
                            <p class="draft-schedule">Lịch ghi nhận từ nội dung: @ScheduleLabel. Bạn có thể sửa mô tả nếu chưa đúng.</p>
                        }
                    </div>

                    <div class="service-form-section">
                        <label class="service-field-label">Hình ảnh / Video tham khảo</label>
                        <label class="service-file-drop">
                            <InputFile OnChange="SelectAttachments" multiple accept="image/png,image/jpeg,video/mp4" />
                            <span class="service-upload-icon" aria-hidden="true">⇧</span>
                            <strong>Kéo thả hoặc chọn tệp đính kèm</strong>
                            <small>PNG, JPG, MP4 • tối đa 5 tệp, 25MB/tệp</small>
                        </label>
                        @if (_selectedFiles.Count > 0)
                        {
                            <div class="service-selected-files">
                                @foreach (var file in _selectedFiles)
                                {
                                    <span title="@file.Name">📎 @file.Name</span>
                                }
                                <small>Tệp đang được xem trước; API lưu tệp sẽ được kết nối sau.</small>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_attachmentError))
                        {
                            <div class="service-attachment-error" role="alert">@_attachmentError</div>
                        }
                    </div>

                    <footer class="service-modal-actions">
                        <small><i></i>Yêu cầu được gửi tới Ban quản lý</small>
                        <span>
                            <button class="service-cancel-button" type="button" disabled="@_submitting" @onclick="Close">Hủy bỏ</button>
                            <button class="service-submit-button" type="submit" disabled="@(_submitting || _checking || _listening)"><span aria-hidden="true">➤</span> @(_submitting ? "Đang gửi…" : _checking ? "Đang kiểm tra…" : "Gửi yêu cầu")</button>
                        </span>
                    </footer>
                </EditForm>
            }
        </section>
    </div>
}


@if (_showReviewPopup)
{
    <PropFlow.Web.Client.Shared.Feedback.PropFlowConfirmationDialog
        Title="@(_review?.Available == true ? "Cần bổ sung thông tin" : "Chưa kiểm tra được nội dung")"
        Message="@ReviewMessage" InformationOnly="@(!_popupSendIntent)" Destructive="false"
        ConfirmText="@(_popupSendIntent ? "Vẫn gửi nội dung này" : "Bổ sung nội dung")" CancelText="Bổ sung nội dung"
        OnConfirm="SendFromPopupAsync" OnCancel="DismissReviewAsync" />
}
