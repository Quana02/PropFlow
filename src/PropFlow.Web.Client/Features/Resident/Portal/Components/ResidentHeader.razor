@inject PropFlow.Web.Client.Services.Authentication.AuthSession Session
@inject NavigationManager Navigation
@inject PropFlow.Web.Client.Features.Finance.Services.FinanceCycleApi Finance
@using PropFlow.Web.Client.Features.Resident.Portal.Models
@using PropFlow.Web.Client.Features.Finance.Services
@implements IDisposable

<header class="resident-header" data-purpose="top-navigation">
    <NavLink class="resident-brand glass-panel" href="/resident" Match="NavLinkMatch.All" aria-label="Về trang chủ cư dân">
        <span class="resident-brand-mark">P</span>
        <span class="resident-brand-content">
            <span class="resident-brand-title"><strong>PropFlow</strong><small>Resident</small></span>
            <span class="resident-apartment">@ProfileContext.ApartmentLabel</span>
        </span>
    </NavLink>

    <div class="resident-header-actions">
        <div class="resident-context-strip">
            <div class="resident-clock-compact glass-panel" aria-hidden="true" aria-label="Đồng hồ chung cư">
                <strong data-clock-time>--:--</strong><small data-clock-period>--</small><span data-clock-date></span>
            </div>
            <ResidentWeather />
        </div>

        <button class="resident-theme-toggle glass-panel" id="theme-toggle-btn" type="button" aria-label="Chuyển sang giao diện tối" title="Chuyển sang giao diện tối">
            <span id="sunWrapper" class="theme-icon theme-sun" aria-hidden="true"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" stroke-width="2" /><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41m14.14-14.14-1.41 1.41" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg></span>
            <span id="moonWrapper" class="theme-icon theme-moon" aria-hidden="true"><svg fill="currentColor" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" /></svg></span>
        </button>

        <div class="resident-profile-menu" data-purpose="user-profile-menu">
            <button class="resident-profile-trigger glass-panel" id="profileDropdownBtn" type="button" aria-controls="profilePopover" aria-expanded="false" @onclick="LoadFinanceAsync">
                <span class="resident-avatar-wrap"><span class="resident-avatar"><PropFlow.Web.Client.Features.Authentication.Components.AccountAvatar Initials="@Initials" /></span><i></i></span>
                <span class="resident-profile-copy"><strong>@DisplayName</strong><small>@ProfileContext.ApartmentLabel • @ProfileContext.RelationshipLabel</small></span>
                <svg id="dropdownArrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="m19 9-7 7-7-7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg>
            </button>

            <div class="resident-profile-popover glass-panel" id="profilePopover" hidden>
                <div class="profile-finance">
                    <div title="Ví dịch vụ chưa được tích hợp">
                        <span><small>Số dư ví dịch vụ</small><strong aria-label="Chưa có dữ liệu ví dịch vụ">—</strong></span>
                        <button type="button" disabled title="Chưa hỗ trợ nạp ví dịch vụ">Nạp tiền</button>
                    </div>
                    <div class="profile-fee" aria-busy="@financeLoading">
                        <span><small>Phí quản lý cần thanh toán</small><strong title="@financeError" aria-live="polite">@(financeLoading ? "Đang tải…" : serviceOutstanding is { } amount ? PropFlowMoneyText.Format(amount) + " đ" : "—")</strong></span>
                        <a href="/resident/billing" onclick="window.propFlowResident.closeProfileMenu()">Thanh toán ngay</a>
                    </div>
                </div>
                <div class="profile-actions">
                    <a href="/resident/profile" onclick="window.propFlowResident.closeProfileMenu()"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Zm-4 7a7 7 0 0 0-7 7h14a7 7 0 0 0-7-7Z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg>Hồ sơ cá nhân</a>
                    <button class="profile-logout" type="button" @onclick="LogoutAsync" disabled="@logoutBusy"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="m17 16 4-4m0 0-4-4m4 4H7m6 4v1a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3h4a3 3 0 0 1 3 3v1" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg>@(logoutBusy ? "Đang đăng xuất…" : "Đăng xuất khỏi thiết bị")</button>
                </div>
            </div>
        </div>
        <PropFlow.Web.Client.Features.Communication.Components.NotificationBell />
    </div>
</header>

@code {
    [CascadingParameter] private ResidentPortalProfileContext ProfileContext { get; set; } = ResidentPortalProfileContext.Loading;
    private string DisplayName => ProfileContext.Profile?.FullName ?? Session.User?.DisplayName ?? "Cư dân";
    private decimal? serviceOutstanding;
    private string? financeError, financeUnit;
    private bool financeLoading, logoutBusy, disposed;
    protected override void OnParametersSet()
    {
        if (financeUnit == ProfileContext.CurrentUnitNumber) return;
        financeUnit = ProfileContext.CurrentUnitNumber;
        serviceOutstanding = null; financeError = null;
    }
    private async Task LoadFinanceAsync()
    {
        if (financeLoading || disposed || ProfileContext.CurrentUnitNumber is not { } unit) return;
        financeLoading = true; financeError = null;
        try
        {
            var result = await Finance.GetAsync<HouseholdInvoice[]>("api/v1/resident/billing/invoices");
            if (disposed || ProfileContext.CurrentUnitNumber != unit) return;
            serviceOutstanding = result.IsSuccess ? (result.Data ?? []).Where(x => x.Apartment == unit && x.InvoiceType != "MONTHLY_RENTAL").Sum(x => x.Outstanding) : null;
            financeError = result.IsSuccess ? null : result.Message;
        }
        finally { if (!disposed) financeLoading = false; }
    }
    private async Task LogoutAsync()
    {
        if (logoutBusy) return;
        logoutBusy = true;
        try { await Session.LogoutAsync(); if (!disposed) Navigation.NavigateTo("/login"); }
        finally { if (!disposed) logoutBusy = false; }
    }
    public void Dispose() => disposed = true;
    private string Initials
    {
        get
        {
            var words = DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return words.Length switch
            {
                0 => "CD", 1 => words[0][..1].ToUpperInvariant(),
                _ => string.Concat(words[^2][0], words[^1][0]).ToUpperInvariant()
            };
        }
    }
}
