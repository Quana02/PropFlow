@inject PropFlow.Web.Client.Services.Authentication.AuthSession Session
@inject NavigationManager Navigation
@using PropFlow.Web.Client.Features.Resident.Portal.Models

<header class="resident-header" data-purpose="top-navigation">
    <NavLink class="resident-brand glass-panel" href="/resident" Match="NavLinkMatch.All" aria-label="Về trang chủ cư dân">
        <span class="resident-brand-mark">P</span>
        <span class="resident-brand-content">
            <span class="resident-brand-title"><strong>PropFlow</strong><small>Resident</small></span>
            <span class="resident-apartment">@ProfileContext.ApartmentLabel</span>
        </span>
    </NavLink>

    <div class="resident-header-actions">
        <div class="resident-weather glass-panel" data-purpose="weather-widget">
            <svg class="weather-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364-.707-.707M6.343 6.343l-.707-.707m12.728 0-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg>
            <span><strong>26°C</strong><small>• Trời quang</small><em>TP. Hồ Chí Minh</em></span>
        </div>

        <button class="resident-theme-toggle glass-panel" id="theme-toggle-btn" type="button" aria-label="Chuyển sang giao diện tối" title="Chuyển sang giao diện tối">
            <span id="sunWrapper" class="theme-icon theme-sun" aria-hidden="true"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" stroke-width="2" /><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41m14.14-14.14-1.41 1.41" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg></span>
            <span id="moonWrapper" class="theme-icon theme-moon" aria-hidden="true"><svg fill="currentColor" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" /></svg></span>
        </button>

        <div class="resident-profile-menu" data-purpose="user-profile-menu">
            <button class="resident-profile-trigger glass-panel" id="profileDropdownBtn" type="button" aria-expanded="false">
                <span class="resident-avatar-wrap"><span class="resident-avatar">@Initials</span><i></i></span>
                <span class="resident-profile-copy"><strong>@DisplayName</strong><small>@ProfileContext.ApartmentLabel • @ProfileContext.RelationshipLabel</small></span>
                <svg id="dropdownArrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="m19 9-7 7-7-7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg>
            </button>

            <div class="resident-profile-popover glass-panel" id="profilePopover" hidden>
                <div class="profile-popover-heading">
                    <span class="resident-avatar resident-avatar-large">@Initials</span>
                    <span><strong>@DisplayName</strong><small>@ProfileContext.ApartmentLabel</small><em>@ResidentStatusLabel</em></span>
                </div>
                <div class="profile-finance">
                    <div><span><small>Số dư ví dịch vụ</small><strong>12.500.000 đ</strong></span><button type="button">Nạp tiền</button></div>
                    <div class="profile-fee"><span><small>Phí quản lý cần thanh toán</small><strong>1.850.000 đ</strong></span><button type="button">Thanh toán ngay</button></div>
                </div>
                <div class="profile-actions">
                    <button type="button" onclick="window.propFlowResident.openProfile()"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Zm-4 7a7 7 0 0 0-7 7h14a7 7 0 0 0-7-7Z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg>Hồ sơ cá nhân &amp; Xe đăng ký</button>
                    <button type="button" @onclick="OpenAccount"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 15v2m-6 4h12a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2Zm10-11V7a4 4 0 0 0-8 0v3h8Z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg>Tài khoản &amp; bảo mật</button>
                    <button class="profile-logout" type="button" @onclick="LogoutAsync"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="m17 16 4-4m0 0-4-4m4 4H7m6 4v1a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3h4a3 3 0 0 1 3 3v1" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg>Đăng xuất khỏi thiết bị</button>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="resident-modal" id="profileModal" hidden>
    <button class="resident-modal-backdrop" type="button" aria-label="Đóng" onclick="window.propFlowResident.closeProfile()"></button>
    <section class="profile-modal-card glass-panel" role="dialog" aria-modal="true" aria-labelledby="profile-modal-title">
        <header><span><h3 id="profile-modal-title">Cập nhật hồ sơ cư dân</h3><p>@ProfileContext.ApartmentLabel</p></span><button type="button" aria-label="Đóng" onclick="window.propFlowResident.closeProfile()">×</button></header>
        <form onsubmit="event.preventDefault(); window.propFlowResident.closeProfile();">
            <div class="profile-avatar-edit"><span class="resident-avatar resident-avatar-xlarge">@Initials</span><span><button type="button">Thay đổi ảnh đại diện</button><small>Định dạng PNG, JPG tối đa 5MB</small></span></div>
            <label>Họ và tên chủ hộ<input type="text" value="@DisplayName" /></label>
            <div class="profile-form-grid"><label>Số điện thoại liên lạc<input type="tel" value="@PhoneNumber" /></label><label>Email nhận hóa đơn<input type="email" value="@Email" /></label></div>
            <label>Biển số xe đã đăng ký (Ô tô / Xe máy)<input type="text" value="30K-888.99 (Ô tô), 29B1-992.88 (Xe máy)" /></label>
            <footer><button type="button" onclick="window.propFlowResident.closeProfile()">Hủy bỏ</button><button class="profile-save" type="submit">Lưu thay đổi</button></footer>
        </form>
    </section>
</div>

@code {
    [CascadingParameter]
    private ResidentPortalProfileContext ProfileContext { get; set; } = ResidentPortalProfileContext.Loading;

    private string DisplayName => ProfileContext.Profile?.FullName ?? Session.User?.DisplayName ?? "Cư dân";
    private string PhoneNumber => ProfileContext.Profile?.PhoneNumber ?? string.Empty;
    private string Email => ProfileContext.Profile?.Email ?? string.Empty;
    private string ResidentStatusLabel => ProfileContext.Profile?.Status switch
    {
        "ACTIVE" => "Cư dân đang hoạt động",
        "MOVED_OUT" => "Cư dân đã chuyển đi",
        "INACTIVE" => "Cư dân ngừng hoạt động",
        _ => "Chưa tải trạng thái cư dân"
    };

    private string Initials
    {
        get
        {
            var words = DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return words.Length switch
            {
                0 => "CD",
                1 => words[0][..1].ToUpperInvariant(),
                _ => string.Concat(words[^2][0], words[^1][0]).ToUpperInvariant()
            };
        }
    }

    private void OpenAccount() => Navigation.NavigateTo("/account");

    private async Task LogoutAsync()
    {
        await Session.LogoutAsync();
        Navigation.NavigateTo("/login");
    }
}
