@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject PropFlow.Web.Client.Features.Resident.Portal.Services.ResidentFinanceNoticeState FinanceNotices
@inject IJSRuntime JSRuntime
@inject PropFlow.Web.Client.Features.Resident.Shared.Services.IResidentApiClient Residents
@using PropFlow.Web.Client.Features.Resident.Portal.Models

<HeadContent>
    <link rel="stylesheet" href="css/resident-portal.css?v=20261010-3" />
</HeadContent>

<div class="resident-portal">
    <ResidentBackground />

    <CascadingValue Value="_profileContext">
        <div class="resident-page-frame">
            <ResidentHeader />

            @if (!string.IsNullOrWhiteSpace(_profileContext.Error))
            {
                <div class="resident-profile-alert" role="alert">
                    <span>@_profileContext.Error</span>
                    <button type="button" @onclick="LoadProfileAsync">Thử lại</button>
                </div>
            }

            <main class="resident-main">
                @Body
            </main>

            <footer class="resident-footer">
                <p>© 2026 PropFlow Resident Portal • Hệ thống quản trị và kết nối căn hộ thông minh chuẩn quốc tế.</p>
            </footer>

            <ResidentNavigation />
        </div>
    </CascadingValue>
</div>

@code {
    private ResidentPortalProfileContext _profileContext = ResidentPortalProfileContext.Loading;

    private readonly CancellationTokenSource _noticeCancellation = new();
    private Task? _noticeRefresh;
    protected override async Task OnInitializedAsync()
    {
        FinanceNotices.Reset();
        await Task.WhenAll(LoadProfileAsync(), FinanceNotices.ReloadAsync());
        _noticeRefresh = RefreshNoticesAsync(_noticeCancellation.Token);
    }
    private async Task RefreshNoticesAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try { while (await timer.WaitForNextTickAsync(ct)) await InvokeAsync(FinanceNotices.ReloadAsync); }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
    }
    public async ValueTask DisposeAsync()
    {
        _noticeCancellation.Cancel();
        if (_noticeRefresh is not null) await _noticeRefresh;
        FinanceNotices.Reset();
        _noticeCancellation.Dispose();
    }

    private async Task LoadProfileAsync()
    {
        _profileContext = ResidentPortalProfileContext.Loading;

        try
        {
            var result = await Residents.MeAsync();
            _profileContext = result.IsSuccess && result.Data is not null
                ? new ResidentPortalProfileContext(result.Data, false, null)
                : new ResidentPortalProfileContext(null, false, result.Message ?? "Không thể tải hồ sơ cư dân.");
        }
        catch
        {
            _profileContext = new ResidentPortalProfileContext(null, false, "Không thể kết nối máy chủ để tải hồ sơ cư dân.");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("propFlowResident.init");
        }
    }
}
