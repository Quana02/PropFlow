@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject PropFlow.Web.Client.Features.Resident.Shared.Services.IResidentApiClient Residents
@using PropFlow.Web.Client.Features.Resident.Portal.Models

<HeadContent>
    <link rel="stylesheet" href="css/resident-portal.css?v=20261105-1" />
</HeadContent>

<div class="resident-portal">
    <ResidentBackground />

    <CascadingValue Value="_profileContext">
        <div class="resident-page-frame">
            <ResidentHeader />

            @if (!string.IsNullOrWhiteSpace(_profileContext.Error))
            {
                <div class="resident-profile-alert" role="alert">
                    <span>@_profileContext.Error</span>
                    <button type="button" @onclick="LoadProfileAsync">Thử lại</button>
                </div>
            }

            <main class="resident-main">
                @Body
            </main>

            <footer class="resident-footer">
                <p>© 2026 PropFlow Resident Portal • Hệ thống quản trị và kết nối căn hộ thông minh chuẩn quốc tế.</p>
            </footer>

            <ResidentNavigation />
            @if (!Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath.StartsWith("/resident/contact-management", StringComparison.OrdinalIgnoreCase))
            { <PropFlow.Web.Client.Features.AiChatbot.Components.ResidentChatWidget /> }
        </div>
    </CascadingValue>
</div>

@code {
    private ResidentPortalProfileContext _profileContext = ResidentPortalProfileContext.Loading;

    protected override Task OnInitializedAsync()
    {
        Navigation.LocationChanged += ContactLocationChanged;
        return LoadProfileAsync();
    }
    public void Dispose() => Navigation.LocationChanged -= ContactLocationChanged;
    private void ContactLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);

    private async Task LoadProfileAsync()
    {
        _profileContext = ResidentPortalProfileContext.Loading;

        try
        {
            var result = await Residents.MeAsync();
            _profileContext = result.IsSuccess && result.Data is not null
                ? new ResidentPortalProfileContext(result.Data, false, null)
                : new ResidentPortalProfileContext(null, false, result.Message ?? "Không thể tải hồ sơ cư dân.");
        }
        catch
        {
            _profileContext = new ResidentPortalProfileContext(null, false, "Không thể kết nối máy chủ để tải hồ sơ cư dân.");
        }
    }

    protected override Task OnAfterRenderAsync(bool firstRender) =>
        firstRender ? JSRuntime.InvokeVoidAsync("propFlowResident.init").AsTask() : Task.CompletedTask;
}
