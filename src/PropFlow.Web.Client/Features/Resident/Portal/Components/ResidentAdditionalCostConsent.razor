@using PropFlow.Modules.ServiceRequests.Contracts
@using PropFlow.Web.Client.Services.Api
@using PropFlow.Web.Client.Shared.Feedback
@inject AuthenticatedApiClient Api

@if (Consent is { Status: not "AWAITING_MANAGER" } proposal)
{
    <div class="cost-consent">
        <PropFlowNotice Title="@(proposal.Status switch { "PENDING" => "Chi phí phát sinh cần xác nhận", "ACCEPTED" => "Bạn đã chấp thuận báo giá", _ => "Yêu cầu dịch vụ đã hủy" })"
            Tone="@(proposal.Status switch { "PENDING" => NoticeTone.Warning, "ACCEPTED" => NoticeTone.Success, _ => NoticeTone.Danger })"
            Message="@(proposal.Status switch { "PENDING" => "Ban Quản lý đã kiểm tra báo giá. Công việc đang chờ bạn đồng ý; từ chối sẽ tự động kết thúc yêu cầu dịch vụ.", "ACCEPTED" => "Bạn đã đồng ý chi phí phát sinh. Bộ phận xử lý được tiếp tục công việc.", _ => "Bạn đã từ chối chi phí phát sinh. Yêu cầu dịch vụ đã được tự động từ chối." })">
            <ChildContent>
                <dl class="cost-consent-totals">
                    @if (BaseCost > 0) { <div><dt>Chi phí ban đầu</dt><dd>@Money(BaseCost)</dd></div> }
                    <div><dt>Phí phát sinh</dt><dd>@Money(proposal.Amount)</dd></div>
                    <div class="cost-consent-total"><dt>Tổng dự kiến</dt><dd>@Money(BaseCost + proposal.Amount)</dd></div>
                </dl>
                <div class="cost-consent-reason"><span>Lý do phát sinh</span><p>@proposal.Note</p></div>
            </ChildContent>
            <Actions>
                @if (proposal.Status == "PENDING")
                {
                    <button type="button" class="pf-notice-action--primary" disabled="@busy" @onclick="() => Ask(true)"><span class="material-symbols-outlined" aria-hidden="true">check_circle</span>Đồng ý chi phí và tiếp tục</button>
                    <button type="button" class="pf-notice-action--danger" disabled="@busy" @onclick="() => Ask(false)">Từ chối dịch vụ</button>
                }
            </Actions>
        </PropFlowNotice>
    </div>
}
@if (error is not null)
{
    <div class="cost-consent-error">
        <PropFlowNotice Title="Chưa thể xác nhận chi phí" Message="@error" Tone="NoticeTone.Danger">
            <Actions><button type="button" disabled="@busy" @onclick="() => Changed.InvokeAsync()">Tải lại đề xuất</button></Actions>
        </PropFlowNotice>
    </div>
}
@if (pending is not null && decision.HasValue)
{
    <PropFlowConfirmationDialog Title="@(decision.Value ? "Đồng ý chi phí phát sinh?" : "Từ chối yêu cầu dịch vụ?")"
        Message="@(decision.Value ? $"Bạn đồng ý phí phát sinh {Money(pending.Amount)} để tiếp tục xử lý yêu cầu." : "Yêu cầu sẽ bị từ chối và bộ phận xử lý sẽ dừng công việc.")"
        ConfirmText="Xác nhận" CancelText="Quay lại" Tone="@(decision.Value ? DialogTone.Confirm : DialogTone.Danger)" Busy="busy" OnConfirm="Submit" OnCancel="Cancel" />
}

@code {
    [Parameter] public Guid RequestId { get; set; }
    [Parameter] public decimal BaseCost { get; set; }
    [Parameter] public AdditionalCostConsentView? Consent { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    private AdditionalCostConsentView? pending;
    private bool? decision;
    private bool busy;
    private string? error;
    private void Ask(bool accepted) { if (busy || Consent?.Status != "PENDING") return; pending = Consent; decision = accepted; error = null; }
    private void Cancel() { if (!busy) { pending = null; decision = null; } }
    private async Task Submit()
    {
        if (busy || pending is null || decision is null) return;
        busy = true;
        try
        {
            var response = await Api.SendAsync<AdditionalCostConsentView>(HttpMethod.Post,
                $"api/v1/resident/service-requests/{RequestId}/additional-cost/response", new RespondAdditionalCostRequest(pending.ProposalId, decision.Value));
            pending = null; decision = null;
            if (response.IsSuccess) await Changed.InvokeAsync();
            else error = response.Message ?? "Chưa thể xác nhận chi phí. Vui lòng tải lại đề xuất.";
        }
        finally { busy = false; }
    }
    private static string Money(decimal amount) => amount.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) + " đ";
}
