@inject PropFlow.Web.Client.Services.Api.AuthenticatedApiClient Files
@using PropFlow.Web.Client.Shared.Feedback
@inject PropFlow.Web.Client.Shared.Feedback.ToastService Toasts
@using PropFlow.Modules.ServiceRequests.Contracts
@using PropFlow.Modules.Payments.Contracts
@using PropFlow.Web.Client.Features.Resident.Portal.Services
@inject IResidentServiceRequestApiClient Api
@implements IDisposable

@if (_open)
{
    <div class="resident-portal-modal service-modal">
        <button class="resident-portal-modal-backdrop" type="button" aria-label="Đóng chi tiết" @onclick="Close"></button>
        <section class="service-modal-card request-detail-modal glass-panel" role="dialog" aria-modal="true" aria-labelledby="requestDetailTitle">
            <header class="service-modal-header">
                <div>
                    <div class="service-modal-title-row"><span class="service-modal-icon" aria-hidden="true">📋</span><h2 id="requestDetailTitle">Chi tiết yêu cầu</h2></div>
                    @if (_request is not null)
                    {
                        <div class="service-modal-meta"><span>#@_request.RequestNumber</span><small>@StatusLabel(_request.Status)</small></div>
                    }
                </div>
                <button class="service-modal-close" type="button" aria-label="Đóng popup" @onclick="Close">×</button>
            </header>

            <div class="request-detail-body">
                @if (_loading)
                {
                    <div class="resident-request-state" role="status">Đang tải chi tiết yêu cầu…</div>
                }
                else if (!string.IsNullOrWhiteSpace(_loadError))
                {
                    <div class="resident-request-state error" role="alert">
                        <p>@_loadError</p>
                        <button class="resident-muted-action" type="button" @onclick="LoadAsync">Thử lại</button>
                    </div>
                }
                else if (_request is not null)
                {
                    <section class="request-detail-summary">
                        <h3>@_request.Title</h3>
                        <p class="request-detail-description">@_request.Description</p>
                        <dl>
                            <div><dt>Trạng thái</dt><dd>@StatusLabel(_request.Status)</dd></div>
                            <div><dt>Loại dịch vụ</dt><dd>@(_request.CategoryName ?? _request.CategoryCode ?? "Chưa xác định")</dd></div>
                            <div><dt>Khu vực</dt><dd>@(_request.FacilityName ?? AreaLabel(_request.ServiceAreaCode))</dd></div>
                            <div><dt>Mức ưu tiên</dt><dd>@PriorityLabel(_request.PriorityCode)</dd></div>
                            <div><dt>Ngày gửi</dt><dd>@FormatDateTime(_request.SubmittedAt)</dd></div>
                            <div><dt>Lịch mong muốn</dt><dd>@PreferredSchedule(_request)</dd></div>
                        </dl>
                    </section>

                    <section class="request-activity-section" aria-labelledby="requestActivityTitle">
                        <div class="request-activity-heading">
                            <span><small>Tiến độ xử lý</small><h3 id="requestActivityTitle">Lịch sử yêu cầu</h3></span>
                            <em>@_request.Activities.Count cập nhật</em>
                        </div>
                        @if (_request.Activities.Count == 0)
                        {
                            <div class="resident-request-state">Chưa có cập nhật xử lý.</div>
                        }
                        else
                        {
                            <ol class="request-activity-timeline">
                                @foreach (var activity in _request.Activities.OrderByDescending(item => item.CreatedAt))
                                {
                                    <li>
                                        <i aria-hidden="true"></i>
                                        <div>
                                            <span><strong>@activity.Title</strong><time datetime="@activity.CreatedAt.ToString("O")">@FormatDateTime(activity.CreatedAt)</time></span>
                                            <p>@activity.Description</p>
                                            @if (!string.IsNullOrWhiteSpace(activity.ToStatus))
                                            {
                                                <small>@StatusTransition(activity.FromStatus, activity.ToStatus)</small>
                                            }
                                        </div>
                                    </li>
                                }
                            </ol>
                        }
                    </section>

                    <ResidentAdditionalCostConsent RequestId="_requestId" BaseCost="_request.BaseServiceCost" Consent="_request.AdditionalCostConsent" Changed="LoadAsync" />
                    @if (HasCharge && _request.Status != "CANCELLED")
                    {
                        <ResidentServiceRequestPaymentCard @key="_requestId" RequestId="_requestId" Completed="IsCompleted" Changed="PaymentChanged" />
                    }

                    @if (_request.Evidence is { Count: > 0 })
                    {
                        <section class="request-feedback-section">
                            <h3>Ảnh kết quả xử lý</h3>
                            <p>Xem ảnh kết quả trước khi nghiệm thu và đánh giá.</p>
                            @foreach (var evidence in _request.Evidence)
                            {
                                <button class="resident-muted-action" type="button" @onclick="() => PreviewAsync(evidence)">
                                    @if (thumbnails.TryGetValue(evidence.Id, out var source)) { <img src="@source" alt="@evidence.FileName" width="120" height="90" style="object-fit:cover;border-radius:8px" /> }
                                    @evidence.FileName · @FormatDateTime(evidence.UploadedAt) · Xem ảnh
                                </button>
                            }
                        </section>
                    }
                    @if (_request.Status == "RESOLVED")
                    {
                        <section class="request-feedback-section">
                            <h3>Xác nhận kết quả xử lý</h3>
                            <p>Xem ảnh và kiểm tra kết quả trước khi xác nhận. Nếu chưa đạt, bạn có thể yêu cầu làm lại trên chính yêu cầu này.</p>
                            @if (!CanDecide) { <p>Vui lòng thanh toán đầy đủ chi phí đã duyệt trước khi phản hồi kết quả.</p> }
                            <button class="service-submit-button" type="button" disabled="@(_saving || !CanDecide)" @onclick="() => DecideAsync(true)">Xác nhận hoàn thành</button>
                            <label for="reworkReason">Lý do yêu cầu làm lại (bắt buộc)</label>
                            <textarea id="reworkReason" maxlength="1000" @bind="reworkReason" @bind:event="oninput" disabled="@_saving"></textarea>
                            <button class="resident-muted-action" type="button" disabled="@(_saving || !CanDecide || reworkReason.Trim().Length < 3)" @onclick="() => DecideAsync(false)">Yêu cầu làm lại</button>
                            @if (completionError is not null) { <p role="alert" class="request-feedback-error">@completionError</p> }
                        </section>
                    }
                    @if (CanRate)
                    {
                        <section class="request-feedback-section">
                            <span class="request-feedback-eyebrow">Đánh giá dịch vụ</span>
                            <h3>Bạn hài lòng với kết quả xử lý?</h3>
                            <div class="request-rating" role="radiogroup" aria-label="Chọn số sao đánh giá">
                                @for (var star = 1; star <= 5; star++)
                                {
                                    var value = star;
                                    <button class="@(value <= _rating ? "active" : null)" type="button" role="radio" aria-checked="@(value == _rating)" aria-label="@value sao" disabled="@_saving" @onclick="() => _rating = value">★</button>
                                }
                            </div>
                            <label for="residentFeedbackComment">Nhận xét của bạn</label>
                            <textarea id="residentFeedbackComment" maxlength="1000" placeholder="Chia sẻ chất lượng phục vụ và kết quả xử lý..." disabled="@_saving" @bind="_comment"></textarea>
                            @if (!string.IsNullOrWhiteSpace(_feedbackError)) { <p class="request-feedback-error" role="alert">@_feedbackError</p> }
                            <button class="service-submit-button" type="button" disabled="@(_saving || _rating == 0 || string.IsNullOrWhiteSpace(_comment))" @onclick="SaveAsync">@(_saving ? "Đang lưu..." : _request.Rating.HasValue ? "Cập nhật đánh giá" : "Gửi đánh giá")</button>
                        </section>
                    }
                    else
                    {
                        <div class="resident-request-state">@(IsCompleted && HasCharge ? "Bạn có thể đánh giá sau khi hóa đơn được ghi nhận thanh toán đầy đủ." : "Bạn có thể đánh giá sau khi xác nhận hoàn thành.")</div>
                    }
                }
            </div>
        </section>
    </div>
}

@if (previewOpen)
{
    <PropFlowConfirmationDialog Title="Ảnh kết quả xử lý" Message="@previewName" Tone="DialogTone.Info" Wide OnCancel="() => previewOpen = false">
        <ChildContent>
            @if (previewSource is not null) { <img src="@previewSource" alt="@previewName" style="max-width:100%;max-height:70vh;object-fit:contain" /> }
            else { <p role="status">@previewMessage</p> }
        </ChildContent>
    </PropFlowConfirmationDialog>
}

@code {
    private readonly Dictionary<Guid, string> thumbnails = new();
    private bool previewOpen;
    private string? previewName, previewSource, previewMessage;
    private async Task PreviewAsync(ResidentServiceRequestEvidenceItem evidence)
    {
        previewOpen = true; previewName = evidence.FileName; previewSource = null; previewMessage = "Đang tải ảnh…";
        var result = await Files.GetFileAsync(evidence.Url.TrimStart('/'));
        if (result.IsSuccess && result.Data is { } file) previewSource = $"data:{file.ContentType};base64,{Convert.ToBase64String(file.Bytes)}";
        else previewMessage = result.Message ?? "Không thể tải ảnh. Vui lòng thử lại.";
    }

    private readonly PropFlow.Web.Client.Shared.Feedback.ToastLifetime toastLifetime = new();

    [Parameter] public EventCallback FeedbackSaved { get; set; }

    private Guid _requestId;
    private ResidentServiceRequestDetailResponse? _request;
    private bool _open;
    private bool _loading;
    private string? _loadError;
    private int _rating;
    private string _comment = string.Empty;
    private string? _feedbackError;
    private bool _saving;
    private PropFlow.Web.Client.Features.ServiceRequests.Services.RealtimeRefreshQueue? _refreshQueue;
    private bool IsCompleted => _request?.Status is "RESOLVED" or "CLOSED";
    private bool HasCharge => (_request?.BaseServiceCost ?? 0) + (_request?.ApprovedAdditionalCost ?? 0) > 0;
    private bool CanRate => _request?.Status == "CLOSED" && (!HasCharge || _request?.Settlement?.OutstandingAmount == 0);

    private string reworkReason = "";
    private string? completionError;
    private bool CanDecide => _request?.Status == "RESOLVED" && (!HasCharge || _request.Settlement?.OutstandingAmount == 0);
    private async Task DecideAsync(bool accepted)
    {
        if (_saving || !CanDecide || _request?.ResolvedAt is not { } resolvedAt) return;
        _saving = true; completionError = null;
        try
        {
            var result = await Api.CompleteAsync(_requestId, new(resolvedAt, accepted, accepted ? null : reworkReason.Trim()));
            if (!result.IsSuccess) { completionError = result.Message ?? "Không thể lưu phản hồi."; return; }
            reworkReason = "";
            await LoadAsync();
            await FeedbackSaved.InvokeAsync();
            Toasts.Success(accepted ? "Đã xác nhận hoàn thành. Bạn có thể đánh giá dịch vụ." : "Đã gửi yêu cầu làm lại để Ban quản lý tiếp nhận và phân công lại.");
        }
        finally { _saving = false; }
    }

    protected override void OnInitialized() =>
        _refreshQueue = new(
            () => InvokeAsync(LoadCoreAsync),
            afterRefresh: () => InvokeAsync(StateHasChanged));

    public async Task OpenAsync(Guid requestId)
    {
        _requestId = requestId;
        reworkReason = ""; completionError = null; thumbnails.Clear();
        _request = null;
        _open = true;
        await LoadAsync();
    }

    public Task RefreshIfOpenAsync(Guid requestId) =>
        !_open || requestId != Guid.Empty && requestId != _requestId
            ? Task.CompletedTask
            : _refreshQueue?.RequestAsync() ?? Task.CompletedTask;

    private Task LoadAsync() => _refreshQueue?.RefreshNowAsync() ?? LoadCoreAsync();

    private async Task LoadCoreAsync()
    {
        _loading = true;
        _loadError = null;
        StateHasChanged();
        try
        {
            var result = await Api.GetAsync(_requestId);
            if (!result.IsSuccess || result.Data is null)
            {
                _loadError = result.Message ?? "Không thể tải chi tiết yêu cầu.";
                return;
            }

            _request = result.Data;
            _rating = _request.Rating ?? 0;
            _comment = _request.FeedbackComment ?? string.Empty;
            _feedbackError = null;
            foreach (var evidence in _request.Evidence ?? [])
            {
                if (thumbnails.ContainsKey(evidence.Id)) continue;
                var image = await Files.GetFileAsync(evidence.Url.TrimStart('/'));
                if (image.IsSuccess && image.Data is { } file) thumbnails[evidence.Id] = $"data:{file.ContentType};base64,{Convert.ToBase64String(file.Bytes)}";
            }
        }
        catch
        {
            _loadError = "Không thể kết nối máy chủ để tải chi tiết yêu cầu.";
        }
        finally { _loading = false; }
    }

    private async Task SaveAsync()
    {
        var operationFeedback = Toasts.BeginOperation(toastLifetime);

        if (_request is null) return;
        _saving = true;
        _feedbackError = null;
        try
        {
            var result = await Api.RateAsync(_request.Id, new(_rating, _comment));
            if (!result.IsSuccess || result.Data is null)
            {
                if (result.ValidationErrors?.Count > 0) _feedbackError = result.Message ?? "Không thể lưu đánh giá."; else operationFeedback.Publish(() => Toasts.Error(result.Message ?? "Không thể lưu đánh giá."));
                return;
            }

            _request = _request with
            {
                Rating = result.Data.Rating,
                FeedbackComment = result.Data.Comment,
                FeedbackSubmittedAt = result.Data.SubmittedAt
            };
            await LoadAsync();
            operationFeedback.Publish(() => Toasts.Success("Đã lưu đánh giá của bạn."));
            { if (operationFeedback.IsCurrent) await FeedbackSaved.InvokeAsync(); }
        }
        finally { _saving = false; }
    }

    private async Task PaymentChanged(ResidentServiceRequestPaymentView payment)
    {
        var changed = _request?.Settlement?.ConfirmedPaidAmount != payment.ConfirmedPaidAmount;
        if (_request is not null && _request.Id == payment.ServiceRequestId)
            _request = _request with { Settlement = new(payment.InvoiceId, payment.InvoiceNumber, payment.TotalAmount,
                payment.ConfirmedPaidAmount, payment.OutstandingAmount, payment.SettlementStatus) };
        if (changed) await LoadAsync();
    }

    private void Close()
    {
        if (!_saving) _open = false;
    }

    public void Dispose() { toastLifetime.Dispose(); _refreshQueue?.Dispose(); }

    private static string FormatDateTime(DateTimeOffset value) => value.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
    private static string PreferredSchedule(ResidentServiceRequestDetailResponse request) => request.PreferredDate is null
        ? "Không yêu cầu"
        : $"{request.PreferredDate:dd/MM/yyyy} · {TimeLabel(request.PreferredTimeCode)}";
    private static string TimeLabel(string? code) => code switch
    {
        "MORNING" => "Buổi sáng", "AFTERNOON" => "Buổi chiều", "EVENING" => "Buổi tối", "ANYTIME" => "Cả ngày", _ => "Chưa chọn"
    };
    private static string AreaLabel(string? code) => PropFlow.Web.Client.Features.ServiceRequests.Models.ServiceRequestAreaText.Label(code);
    private static string PriorityLabel(string? code) => code switch
    {
        "URGENT" => "Khẩn cấp", "HIGH" => "Cao", "LOW" => "Thấp",
        "NORMAL" => "Bình thường", _ => "Chưa xác định"
    };
    private static string StatusTransition(string? from, string? to) => string.IsNullOrWhiteSpace(from)
        ? StatusLabel(to ?? string.Empty)
        : $"{StatusLabel(from)} → {StatusLabel(to ?? string.Empty)}";
    private static string StatusLabel(string status) => status switch
    {
        "SUBMITTED" => "Chờ tiếp nhận", "UNDER_REVIEW" => "Đang xem xét", "ASSIGNED" => "Đã phân công",
        "IN_PROGRESS" => "Đang xử lý", "RESOLVED" => "Đã xử lý", "CLOSED" => "Đã hoàn tất",
        "CANCELLED" => "Đã hủy", _ => "Chưa xác định"
    };
}
