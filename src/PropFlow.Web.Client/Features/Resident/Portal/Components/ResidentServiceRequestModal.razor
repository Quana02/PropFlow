@using PropFlow.Modules.ServiceRequests.Contracts
@using PropFlow.Web.Client.Features.Resident.Portal.Models
@using PropFlow.Web.Client.Features.Resident.Portal.Services
@using PropFlow.Web.Client.Services.Api
@inject IResidentServiceRequestApiClient Api

@if (_open)
{
    <div class="resident-modal service-modal" id="serviceModal">
        <button class="resident-modal-backdrop" type="button" aria-label="Đóng" @onclick="Close"></button>
        <section class="service-modal-card glass-panel" role="dialog" aria-modal="true" aria-labelledby="serviceModalTitle">
            <header>
                <span>
                    <h2 id="serviceModalTitle">@(_created is null ? "Đăng Ký & Yêu Cầu Dịch Vụ Căn Hộ" : "Đã gửi yêu cầu thành công")</h2>
                    <p>Tiếp nhận và chuyển trực tiếp tới Ban Quản Lý</p>
                </span>
                <button type="button" aria-label="Đóng" @onclick="Close">×</button>
            </header>

            @if (_created is not null)
            {
                <div class="service-submit-success" role="status">
                    <span aria-hidden="true">✓</span>
                    <h3>Yêu cầu đã được ghi nhận</h3>
                    <p>Mã yêu cầu <strong>#@_created.RequestNumber</strong> đang ở trạng thái chờ tiếp nhận.</p>
                    <button class="resident-primary-action" type="button" @onclick="Close">Hoàn tất</button>
                </div>
            }
            else
            {
                <div class="service-types" aria-label="Chọn loại dịch vụ">
                    @foreach (var type in ServiceTypes)
                    {
                        <button class="@(_form.CategoryCode == type.Code ? "active" : null)" type="button"
                                @onclick="() => SelectType(type)">@type.Icon @type.ShortName</button>
                    }
                </div>

                <EditForm Model="_form" OnValidSubmit="SubmitAsync" class="service-registration-form">
                    <DataAnnotationsValidator />

                    @if (_result is { IsSuccess: false })
                    {
                        <div class="service-submit-error" role="alert">@_result.Message</div>
                    }

                    <div class="field-group">
                        <label for="service-title">Tên yêu cầu</label>
                        <InputText id="service-title" @bind-Value="_form.Title" />
                        <ValidationMessage For="@(() => _form.Title)" />
                    </div>

                    <div class="service-form-grid">
                        <label>
                            Khu vực hỗ trợ
                            <PropFlowSelect @bind-Value="_form.ServiceAreaCode" Options="ServiceAreaOptions"
                                            AriaLabel="Khu vực cần hỗ trợ" Disabled="_submitting" />
                            <ValidationMessage For="@(() => _form.ServiceAreaCode)" />
                        </label>
                        <label>
                            Mức độ ưu tiên
                            <InputRadioGroup @bind-Value="_form.PriorityCode" class="priority-options">
                                <span><InputRadio Value="@NormalPriority" /> Bình thường</span>
                                <span><InputRadio Value="@UrgentPriority" /> Khẩn cấp 🔥</span>
                            </InputRadioGroup>
                        </label>
                    </div>

                    <label>
                        Mô tả chi tiết sự cố / nhu cầu
                        <InputTextArea @bind-Value="_form.Description" rows="4"
                                       placeholder="Mô tả hiện tượng, vị trí và thông tin cần thiết..." />
                        <ValidationMessage For="@(() => _form.Description)" />
                    </label>

                    <div class="service-form-grid">
                        <label>
                            Ngày hẹn mong muốn
                            <InputDate @bind-Value="_form.PreferredDate" min="@MinimumDate" />
                        </label>
                        <label>
                            Khung giờ thuận tiện
                            <PropFlowSelect @bind-Value="_form.PreferredTimeCode" Options="ServiceTimeOptions"
                                            AriaLabel="Khung giờ thuận tiện" Disabled="_submitting" />
                        </label>
                    </div>

                    <footer>
                        <small><i></i>BQL cam kết phản hồi sau ≤ 15 phút</small>
                        <span>
                            <button type="button" disabled="@_submitting" @onclick="Close">Hủy bỏ</button>
                            <button class="resident-primary-action" type="submit" disabled="@_submitting">
                                @(_submitting ? "Đang gửi..." : "Gửi Yêu Cầu Tới BQL")
                            </button>
                        </span>
                    </footer>
                </EditForm>
            }
        </section>
    </div>
}

@code {
    private const string NormalPriority = "NORMAL";
    private const string UrgentPriority = "URGENT";
    private readonly SubmitServiceRequestForm _form = new();
    private ApiResult<ResidentServiceRequestCreatedResponse>? _result;
    private ResidentServiceRequestCreatedResponse? _created;
    private bool _open;
    private bool _submitting;
    private string MinimumDate => DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");

    private sealed record ServiceType(string Code, string Icon, string ShortName, string Title);

    private static readonly IReadOnlyList<ServiceType> ServiceTypes =
    [
        new("REPAIR", "🔧", "Sửa chữa", "Sửa chữa kỹ thuật"),
        new("CLEANING", "🧹", "Vệ sinh", "Vệ sinh định kỳ"),
        new("VISITOR", "🛡️", "Khách thăm", "Khách thăm căn hộ"),
        new("VEHICLE", "🚗", "Thẻ xe", "Đăng ký thẻ xe"),
        new("MOVING", "📦", "Chuyển đồ", "Chuyển đồ / Chuyển nhà"),
        new("CONSTRUCTION", "🔨", "Thi công", "Đăng ký thi công nội thất"),
        new("BILLING", "💳", "Hóa đơn", "Hóa đơn và thanh toán"),
        new("OTHER", "💬", "Khác", "Yêu cầu dịch vụ khác")
    ];

    private static readonly IReadOnlyList<PropFlowSelectOption> ServiceAreaOptions =
    [
        new("LIVING_ROOM", "Phòng khách & Ban công"),
        new("MASTER_BATHROOM", "Phòng tắm Master"),
        new("BEDROOM", "Phòng ngủ chính"),
        new("KITCHEN", "Bếp & Khu giặt phơi"),
        new("COMMON_AREA", "Khu vực chung / Khác")
    ];

    private static readonly IReadOnlyList<PropFlowSelectOption> ServiceTimeOptions =
    [
        new("MORNING", "Sáng: 08:30 - 11:30"),
        new("AFTERNOON", "Chiều: 14:00 - 17:30"),
        new("EVENING", "Tối: 18:00 - 20:00")
    ];

    public void Open(string categoryCode, string title)
    {
        _result = null;
        _created = null;
        _form.CategoryCode = categoryCode;
        _form.Title = title;
        _form.Description = string.Empty;
        _form.ServiceAreaCode = "MASTER_BATHROOM";
        _form.PriorityCode = NormalPriority;
        _form.PreferredDate = DateOnly.FromDateTime(DateTime.Today.AddDays(1));
        _form.PreferredTimeCode = "MORNING";
        _open = true;
        StateHasChanged();
    }

    private void SelectType(ServiceType type)
    {
        _form.CategoryCode = type.Code;
        _form.Title = type.Title;
    }

    private async Task SubmitAsync()
    {
        if (_form.PreferredDate is { } date && date < DateOnly.FromDateTime(DateTime.Today))
        {
            _result = new(false, Message: "Ngày hẹn không thể nằm trong quá khứ.");
            return;
        }

        _submitting = true;
        _result = null;
        try
        {
            _result = await Api.CreateAsync(new CreateResidentServiceRequestRequest(
                _form.CategoryCode,
                _form.Title,
                _form.Description,
                _form.ServiceAreaCode,
                _form.PriorityCode,
                _form.PreferredDate,
                _form.PreferredTimeCode));
            if (_result.IsSuccess)
            {
                _created = _result.Data;
            }
        }
        finally
        {
            _submitting = false;
        }
    }

    private void Close()
    {
        if (_submitting) return;
        _open = false;
        _result = null;
        _created = null;
    }
}
