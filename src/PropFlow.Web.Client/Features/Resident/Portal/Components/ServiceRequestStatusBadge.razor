@using PropFlow.Web.Client.Features.Resident.Portal.Models

<span class="request-status @CssClass">@Label</span>

@code {
    [Parameter, EditorRequired] public string Status { get; set; } = string.Empty;

    private string Label => Status switch
    {
        ServiceRequestStatuses.Submitted => "Đã gửi",
        ServiceRequestStatuses.UnderReview => "Đang xem xét",
        ServiceRequestStatuses.Assigned => "Đã phân công",
        ServiceRequestStatuses.InProgress => "Đang xử lý",
        ServiceRequestStatuses.Resolved => "Đã xử lý",
        ServiceRequestStatuses.Closed => "Đã đóng",
        ServiceRequestStatuses.Cancelled => "Đã hủy",
        _ => "Không xác định"
    };

    private string CssClass => Status switch
    {
        ServiceRequestStatuses.Submitted => "status-blue",
        ServiceRequestStatuses.UnderReview => "status-violet",
        ServiceRequestStatuses.Assigned => "status-indigo",
        ServiceRequestStatuses.InProgress => "status-amber",
        ServiceRequestStatuses.Resolved => "status-emerald",
        ServiceRequestStatuses.Closed => "status-slate",
        ServiceRequestStatuses.Cancelled => "status-rose",
        _ => "status-slate"
    };
}
