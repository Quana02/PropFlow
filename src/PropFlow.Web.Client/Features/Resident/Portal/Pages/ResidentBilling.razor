@page "/resident/billing"
@attribute [Authorize(Roles = "RESIDENT")]
@layout PropFlow.Web.Client.Features.Resident.Portal.Components.ResidentPortalLayout
@using PropFlow.Web.Client.Features.Finance.Services
@using PropFlow.Web.Client.Features.Finance.Components
@using PropFlow.Web.Client.Features.Resident.Portal.Components
@inject FinanceCycleApi Api
<PageTitle>Hóa đơn và phiếu thu của tôi — PropFlow</PageTitle>
<section class="glass-panel resident-billing">
    <h1>Hóa đơn và thanh toán</h1><p>Chủ sở hữu chịu phí dịch vụ; chủ hộ thuê căn hộ chưa có chủ sở hữu chịu thêm tiền thuê theo cấu hình. Chỉ khoản đã được kế toán xác nhận mới làm giảm dư nợ.</p>
    <button @onclick="Load" disabled="@loading">Tải lại</button>
    @if (error is not null) { <p role="alert">@error</p> }
    @if (!loading && invoices.Length == 0 && error is null) { <p>Chưa có hóa đơn được gửi cho bạn.</p> }
    @foreach (var i in invoices) { <article class="glass-inner" id="@($"invoice-{i.Id}")">
        <h2>@i.Number · Căn hộ @i.Apartment · @(i.InvoiceType == "MONTHLY_RENTAL" ? "Tiền thuê tháng" : "Phí dịch vụ")</h2>
        <p>Kỳ: @i.Period.ToString("MM/yyyy") · Hạn: @i.DueDate?.ToString("dd/MM/yyyy")</p>
        <p>Phí dịch vụ: @i.ServiceTotal.ToString("N0") đ @if(i.Capacity == "RENTAL") { <span>· Tiền thuê: @i.RentalTotal.ToString("N0") đ</span> }</p>
        <p>Tổng: <strong>@i.Total.ToString("N0") đ</strong> · Đã nhận: @i.Paid.ToString("N0") đ · Còn nợ: <strong>@i.Outstanding.ToString("N0") đ</strong></p>
        <FinanceDocumentButton Path="@($"api/v1/resident/billing/invoices/{i.Id}/print")" Label="In hóa đơn" />
        <FinanceDocumentButton Path="@($"api/v1/resident/billing/invoices/{i.Id}/print")" Label="Tải hóa đơn" Print="false" />
        @foreach (var p in payments.Where(x => x.InvoiceId == i.Id)) { <div class="payment-row">
            <p>@p.Number · @p.Amount.ToString("N0") đ · @Status(p.Status)</p>
            @if (p.Status == "CONFIRMED") { <FinanceDocumentButton Path="@($"api/v1/resident/billing/payments/{p.Id}/receipt")" Label="In phiếu xác nhận" /> <FinanceDocumentButton Path="@($"api/v1/resident/billing/payments/{p.Id}/receipt")" Label="Tải phiếu xác nhận" Print="false" /> }
            @if (p.Status == "REJECTED") { <p>Lý do: @p.RejectionReason</p> }
        </div> }
    </article> }
</section>
<ResidentFinanceNotifications />
@code {
    private HouseholdInvoice[] invoices = []; private ResidentPayment[] payments = [];
    private bool loading; private string? error;
    protected override Task OnInitializedAsync() => Load();
    private async Task Load() { loading = true; try {
        var i = await Api.GetAsync<HouseholdInvoice[]>("api/v1/resident/billing/invoices");
        var p = await Api.GetAsync<ResidentPayment[]>("api/v1/resident/billing/payments");
        invoices = i.Data ?? []; payments = p.Data ?? []; error = i.IsSuccess && p.IsSuccess ? null : i.Message ?? p.Message;
    } finally { loading = false; } }
    private static string Status(string value) => value switch { "CONFIRMED" => "Đã xác nhận", "PENDING" => "Chờ xác minh", "REJECTED" => "Bị từ chối", _ => value };
}

