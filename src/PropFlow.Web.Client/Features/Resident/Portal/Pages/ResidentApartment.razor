@code {
    [CascadingParameter] private ResidentPortalProfileContext ProfileContext { get; set; } = ResidentPortalProfileContext.Loading;
    private bool loading = true;
    private string? error;
    private IReadOnlyList<ResidentApartmentSelfItem> items = [];
    private string Heading => items.Count == 1 ? $"Chi tiết căn hộ {items[0].UnitNumber}" : "Căn hộ của tôi";

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        loading = true;
        error = null;
        try
        {
            var result = await Apartments.MeAsync();
            if (result.IsSuccess) items = result.Data ?? [];
            else error = result.Message ?? "Không thể tải thông tin căn hộ. Vui lòng thử lại.";
        }
        catch { error = "Không thể kết nối máy chủ để tải thông tin căn hộ."; }
        finally { loading = false; }
    }

    private static bool IsActive(ResidentApartmentSelfItem item) => string.Equals(item.Status, "ACTIVE", StringComparison.OrdinalIgnoreCase);
    private static string StatusLabel(string status) => status.ToUpperInvariant() switch { "ACTIVE" => "Đang hoạt động", "INACTIVE" => "Ngừng hoạt động", _ => status };
    private static string DisplayCount(int? count) => count?.ToString() ?? "Chưa cập nhật";
    private static string DisplayDate(DateOnly? date) => date?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật";
    private static string DisplayText(string? value) => string.IsNullOrWhiteSpace(value) ? "Chưa cập nhật" : value;
    private static string RegistryId(ResidentApartmentSelfItem item) => $"PF-{item.Id.ToString("N")[..8].ToUpperInvariant()}";

    private static string RoomSummary(ResidentApartmentSelfItem item)
    {
        var parts = new List<string>();
        if (item.BedroomCount.HasValue) parts.Add($"{item.BedroomCount} phòng ngủ");
        if (item.BathroomCount.HasValue) parts.Add($"{item.BathroomCount} phòng tắm");
        return parts.Count == 0 ? "Chưa cập nhật số phòng" : string.Join(" • ", parts);
    }

    private string Initials
    {
        get
        {
            var words = (ProfileContext.Profile?.FullName ?? "Cư dân").Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return words.Length switch { 0 => "CD", 1 => words[0][..1].ToUpperInvariant(), _ => string.Concat(words[^2][0], words[^1][0]).ToUpperInvariant() };
        }
    }

    private string ResidentStatusLabel => ProfileContext.Profile?.Status?.ToUpperInvariant() switch { "ACTIVE" => "Đang hoạt động", "MOVED_OUT" => "Đã chuyển đi", "INACTIVE" => "Ngừng hoạt động", _ => "Chưa xác định" };

    private string MaskedIdentity
    {
        get
        {
            var identity = ProfileContext.Profile?.IdentityNumber;
            if (string.IsNullOrWhiteSpace(identity)) return "Chưa cập nhật";
            return identity.Length <= 4 ? identity : $"••••••••{identity[^4..]}";
        }
    }

    private string RelationshipLabel(Guid apartmentId)
    {
        var residency = ProfileContext.Profile?.Residencies.FirstOrDefault(x => x.ApartmentUnitId == apartmentId && x.EndDate is null);
        if (residency is not null) return residency.HouseholdRole?.ToUpperInvariant() switch { "HOUSEHOLD_HEAD" => "Chủ hộ", "HOUSEHOLD_MEMBER" => "Thành viên hộ", _ => "Cư dân" };
        return ProfileContext.Profile?.Ownerships.Any(x => x.ApartmentUnitId == apartmentId && x.EndDate is null) == true ? "Chủ sở hữu" : "Đã liên kết";
    }

    private string ResidencyPeriod(Guid apartmentId)
    {
        var residency = ProfileContext.Profile?.Residencies.FirstOrDefault(x => x.ApartmentUnitId == apartmentId && x.EndDate is null);
        if (residency is not null) return $"Từ ngày {residency.StartDate:dd/MM/yyyy}";
        var ownership = ProfileContext.Profile?.Ownerships.FirstOrDefault(x => x.ApartmentUnitId == apartmentId && x.EndDate is null);
        return ownership is null ? "Quan hệ đang hiệu lực" : $"Từ ngày {ownership.StartDate:dd/MM/yyyy}";
    }

    private void Back() => Navigation.NavigateTo("/resident");
}
