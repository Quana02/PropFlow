@page "/resident/apartment"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "RESIDENT")]
@layout PropFlow.Web.Client.Features.Resident.Portal.Components.ResidentPortalLayout
@using PropFlow.Web.Client.Features.Apartment.Models
@using PropFlow.Web.Client.Features.Apartment.Services
@using PropFlow.Web.Client.Features.Resident.Portal.Models
@inject IApartmentApiClient Apartments
@inject NavigationManager Navigation

<PageTitle>Căn hộ của tôi - PropFlow</PageTitle>

<main class="resident-apartment-page">
    <section class="apartment-page-heading">
        <div>
            <button class="apartment-back" type="button" @onclick="Back"><span class="material-symbols-outlined">arrow_back</span>Trang cư dân</button>
            <nav aria-label="Đường dẫn"><span>Resident Portal</span><i>/</i><strong>Căn hộ của tôi</strong></nav>
            <h1>@Heading</h1>
            <p>Thông số căn hộ và hồ sơ cư trú được đồng bộ từ hệ thống quản lý PropFlow.</p>
        </div>
        <button class="apartment-refresh glass-panel" type="button" @onclick="Load" disabled="@loading" title="Tải lại dữ liệu">
            <span class="material-symbols-outlined @(loading ? "spin" : null)">refresh</span><span>Tải lại</span>
        </button>
    </section>

    @if (loading)
    {
        <section class="apartment-state glass-panel" aria-live="polite"><span class="material-symbols-outlined spin">progress_activity</span><strong>Đang tải thông tin căn hộ…</strong><p>PropFlow đang kiểm tra quan hệ cư trú đang hiệu lực của bạn.</p></section>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <section class="apartment-state apartment-state-error glass-panel" role="alert"><span class="material-symbols-outlined">error</span><strong>Không thể tải thông tin căn hộ</strong><p>@error</p><button type="button" @onclick="Load">Thử lại</button></section>
    }
    else if (items.Count == 0)
    {
        <section class="apartment-state glass-panel"><span class="material-symbols-outlined">meeting_room</span><strong>Chưa có căn hộ đang cư trú</strong><p>Khi quan hệ cư trú có hiệu lực, căn hộ sẽ xuất hiện tại đây.</p></section>
    }
    else
    {
        @foreach (var item in items)
        {
            <section class="apartment-overview">
                <div class="apartment-title-row">
                    <div>
                        <span class="apartment-kicker">Thông tin căn hộ</span>
                        <div class="apartment-title-line">
                            <h2>Căn hộ @item.UnitNumber</h2>
                            <span class="apartment-status @(IsActive(item) ? "is-active" : "is-inactive")"><i></i>@StatusLabel(item.Status)</span>
                            <span class="apartment-floor-badge">Tầng @item.FloorNumber • @item.UnitType</span>
                        </div>
                    </div>
                    <div class="apartment-registry glass-panel"><span class="material-symbols-outlined">verified_user</span><span><small>Mã đăng ký</small><strong>@RegistryId(item)</strong></span></div>
                </div>

                <article class="apartment-section glass-panel">
                    <header class="apartment-section-header">
                        <span class="apartment-section-icon"><span class="material-symbols-outlined">apartment</span></span>
                        <span><h3>Thông số căn hộ</h3><p>Thông tin kiến trúc và trạng thái đang được ghi nhận trên hệ thống</p></span>
                        <span class="read-only-pill"><span class="material-symbols-outlined">lock</span>Chỉ xem</span>
                    </header>
                    <dl class="apartment-spec-grid">
                        <div class="glass-inner"><dt>Số căn hộ</dt><dd>@item.UnitNumber</dd><small>Mã căn hộ trên hệ thống</small></div>
                        <div class="glass-inner"><dt>Tầng</dt><dd>Tầng @item.FloorNumber</dd><small>Vị trí tầng của căn hộ</small></div>
                        <div class="glass-inner"><dt>Loại căn hộ</dt><dd>@item.UnitType</dd><small>Phân loại mặt bằng</small></div>
                        <div class="glass-inner"><dt>Diện tích sử dụng</dt><dd>@item.UsableAreaM2.ToString("0.##") <em>m²</em></dd><small>@RoomSummary(item)</small></div>
                        <div class="glass-inner"><dt>Trạng thái căn hộ</dt><dd><span class="inline-status @(IsActive(item) ? "is-active" : "is-inactive")"><i></i>@StatusLabel(item.Status)</span></dd><small>Trạng thái quản lý hiện tại</small></div>
                        <div class="glass-inner"><dt>Phòng ngủ</dt><dd>@DisplayCount(item.BedroomCount)</dd><small>Số phòng ngủ đã khai báo</small></div>
                        <div class="glass-inner"><dt>Phòng tắm</dt><dd>@DisplayCount(item.BathroomCount)</dd><small>Số phòng tắm đã khai báo</small></div>
                        <div class="glass-inner"><dt>Ngày bàn giao</dt><dd>@DisplayDate(item.HandoverDate)</dd><small>Ngày bàn giao được ghi nhận</small></div>
                    </dl>
                </article>

                <article class="apartment-section glass-panel resident-link-section">
                    <header class="apartment-section-header">
                        <span class="apartment-section-icon resident-icon"><span class="material-symbols-outlined">badge</span></span>
                        <span><h3>Hồ sơ cư dân liên kết</h3><p>Thông tin của tài khoản đang truy cập căn hộ này</p></span>
                    </header>
                    @if (ProfileContext.IsLoading)
                    {
                        <div class="profile-inline-state"><span class="material-symbols-outlined spin">progress_activity</span>Đang tải hồ sơ cư dân…</div>
                    }
                    else if (ProfileContext.Profile is null)
                    {
                        <div class="profile-inline-state profile-inline-error"><span class="material-symbols-outlined">person_off</span>Chưa tải được hồ sơ cư dân liên kết.</div>
                    }
                    else
                    {
                        <div class="resident-link-grid">
                            <div class="resident-highlight glass-inner">
                                <span class="apartment-resident-avatar">@Initials</span>
                                <span class="resident-highlight-copy"><h4>@ProfileContext.Profile.FullName</h4><span class="resident-badges"><strong>@RelationshipLabel(item.Id)</strong><em><i></i>@ResidentStatusLabel</em></span><small>Mã cư dân: @ProfileContext.Profile.ResidentCode</small></span>
                            </div>
                            <dl class="resident-contact-grid">
                                <div class="glass-inner"><dt>Số điện thoại</dt><dd>@DisplayText(ProfileContext.Profile.PhoneNumber)</dd><small>Kênh liên hệ chính</small></div>
                                <div class="glass-inner"><dt>Email</dt><dd>@DisplayText(ProfileContext.Profile.Email)</dd><small>Kênh nhận thông báo</small></div>
                                <div class="glass-inner"><dt>Giấy tờ định danh</dt><dd>@MaskedIdentity</dd><small>@DisplayText(ProfileContext.Profile.IdentityType)</small></div>
                                <div class="glass-inner"><dt>Quan hệ căn hộ</dt><dd>@RelationshipLabel(item.Id)</dd><small>@ResidencyPeriod(item.Id)</small></div>
                            </dl>
                        </div>
                        <div class="apartment-readonly-note"><span class="material-symbols-outlined">info</span><span>Thông tin căn hộ và quan hệ cư trú do Ban quản lý xác minh. Vui lòng liên hệ Ban quản lý nếu dữ liệu chưa chính xác.</span><strong>Hồ sơ chỉ đọc</strong></div>
                    }
                </article>
            </section>
        }
    }
</main>

