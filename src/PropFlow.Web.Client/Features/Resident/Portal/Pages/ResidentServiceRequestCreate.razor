@page "/resident/service-requests/new"
@attribute [Authorize(Roles = "RESIDENT")]
@layout PropFlow.Web.Client.Features.Resident.Portal.Components.ResidentPortalLayout
@using PropFlow.Web.Client.Features.Resident.Portal.Components
@using PropFlow.Modules.ServiceRequests.Contracts
@inject NavigationManager Navigation

<PageTitle>Tạo yêu cầu dịch vụ - PropFlow</PageTitle>

<div class="page-heading">
    <div>
        <a href="/resident/service-requests" class="back-link">← Yêu cầu của tôi</a>
        <p class="eyebrow">Gửi yêu cầu</p>
        <h1>Tạo yêu cầu dịch vụ</h1>
        <p>Mô tả vấn đề cần hỗ trợ để Ban quản lý tiếp nhận và điều phối.</p>
        <button type="button" class="resident-primary-action" @onclick="OpenForm">Tạo yêu cầu</button>
    </div>
</div>

<ResidentServiceRequestDialog @ref="dialog" RequestCreated="RequestCreated" />

@code {
    private ResidentServiceRequestDialog? dialog;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) OpenForm();
    }

    private void OpenForm() => dialog?.Open("OTHER", "Yêu cầu dịch vụ");

    private void RequestCreated(ResidentServiceRequestCreatedResponse request) =>
        Navigation.NavigateTo($"/resident/service-requests/{request.Id}");
}
