@page "/resident"
@attribute [Authorize(Roles = "RESIDENT")]
@layout PropFlow.Web.Client.Features.Resident.Portal.Components.ResidentPortalLayout
@inject PropFlow.Web.Client.Services.Authentication.AuthSession Session
@using PropFlow.Web.Client.Features.Resident.Portal.Components
@using PropFlow.Web.Client.Features.Resident.Portal.Models

<PageTitle>PropFlow Resident Portal - Cổng Dịch Vụ Cư Dân</PageTitle>

<section class="resident-hero" data-purpose="hero-center-area">
    <div class="resident-greeting glass-panel"><span>👋</span><strong>Xin chào buổi sáng, @DisplayName</strong><i></i></div>
    <div class="resident-clock" data-purpose="digital-clock"><span id="clockTime">--:--</span><small id="clockPeriod">--</small></div>
    <p id="clockDate" class="resident-date">Đang cập nhật ngày giờ…</p>
    <div class="resident-search-wrap">
        <label class="resident-search glass-panel">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="m21 21-6-6m2-5a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg>
            <span class="sr-only">Tìm kiếm</span>
            <input id="residentSearch" type="search" placeholder="Tìm kiếm dịch vụ, tiện ích, hóa đơn, thông báo ban quản lý... (Ctrl + K)" />
            <kbd>Ctrl K</kbd>
        </label>
    </div>
</section>

<section class="resident-tabs" data-purpose="tab-content-container">
    <div class="resident-tab-panel active" id="tabHomeContent">
        <div class="resident-card-grid">
            <article class="resident-dashboard-card glass-panel" data-purpose="request-status-card">
                <div>
                    <header class="card-heading"><span><h2>Tiến độ xử lý yêu cầu</h2><small>Cập nhật thời gian thực</small></span><em class="badge badge-sky">Đã xong 2 / 5</em></header>
                    <div class="request-progress"><span></span></div>
                    <div class="resident-card-list">
                        <button class="glass-inner request-list-item" type="button"><span><strong>Sửa cấp nước phòng tắm Master</strong><small>KTV: Lê Minh Tuấn</small></span><span><em class="badge badge-amber">Đang xử lý</em><small>10:30 Hôm nay</small></span></button>
                        <button class="glass-inner request-list-item" type="button"><span><strong>Kiểm tra aptomat &amp; nguồn phòng khách</strong><small>Mã phiếu: #YC-8942</small></span><span><em class="badge badge-blue">Chờ tiếp nhận</em><small>08:15 Sáng nay</small></span></button>
                        <button class="glass-inner request-list-item" type="button"><span><strong>Hỗ trợ vệ sinh công nghiệp căn hộ</strong><small>Đội Vệ Sinh Tầng 18</small></span><span><em class="badge badge-green">Đã xong ★ 5.0</em><small>Hôm qua</small></span></button>
                    </div>
                </div>
                <footer class="card-actions"><button class="resident-text-action" type="button" onclick="window.propFlowResident.switchTab('processing')">Xem tất cả 5 yêu cầu <span>›</span></button><button class="resident-primary-action" type="button" @onclick='() => OpenService("OTHER", "Yêu cầu hỗ trợ mới")'>+ Tạo yêu cầu mới</button></footer>
            </article>

            <article class="resident-dashboard-card glass-panel" data-purpose="services-catalog-card">
                <div>
                    <header class="card-heading"><span><h2>Danh mục dịch vụ căn hộ</h2><small>Tiện ích cư dân 1 chạm</small></span><em class="badge badge-neutral">8 Dịch vụ</em></header>
                    <div class="resident-service-grid">
                        <button class="service-btn glass-inner" type="button" @onclick='() => OpenService("REPAIR", "Sửa chữa kỹ thuật")'><span class="service-icon sky">🔧</span><strong>Sửa chữa</strong></button>
                        <button class="service-btn glass-inner" type="button" @onclick='() => OpenService("CLEANING", "Vệ sinh định kỳ")'><span class="service-icon green">🧹</span><strong>Vệ sinh</strong></button>
                        <button class="service-btn glass-inner" type="button" @onclick='() => OpenService("VISITOR", "Khách thăm căn hộ")'><span class="service-icon indigo">🛡️</span><strong>Khách thăm</strong></button>
                        <button class="service-btn glass-inner" type="button" @onclick='() => OpenService("VEHICLE", "Đăng ký thẻ xe")'><span class="service-icon amber">🚗</span><strong>Đăng ký xe</strong></button>
                        <button class="service-btn glass-inner" type="button" @onclick='() => OpenService("MOVING", "Chuyển đồ / Chuyển nhà")'><span class="service-icon purple">📦</span><strong>Chuyển đồ</strong></button>
                        <button class="service-btn glass-inner" type="button" @onclick='() => OpenService("CONSTRUCTION", "Đăng ký thi công nội thất")'><span class="service-icon rose">🔨</span><strong>Thi công</strong></button>
                        <button class="service-btn glass-inner" type="button" @onclick='() => OpenService("BILLING", "Hóa đơn và thanh toán")'><span class="service-icon teal">💳</span><strong>Hóa đơn</strong></button>
                        <button class="service-btn glass-inner" type="button" @onclick='() => OpenService("OTHER", "Yêu cầu hỗ trợ Ban Quản Lý")'><span class="service-icon cyan">💬</span><strong>Hotline BQL</strong></button>
                    </div>
                </div>
                <footer class="service-card-footer"><span><i></i>Tổng đài hỗ trợ trực tuyến 24/7</span><strong>1900 8899</strong></footer>
            </article>

            <article class="resident-dashboard-card glass-panel" data-purpose="announcements-card">
                <div>
                    <header class="card-heading"><span><h2>Thông báo ban quản lý</h2><small>Bản tin cư dân tòa nhà</small></span><em class="badge badge-rose">3 tin mới</em></header>
                    <div class="resident-card-list notice-list">
                        <button class="glass-inner notice-list-item" type="button"><span><em class="notice-kind important"><i></i>[Quan trọng]</em><small>20 phút trước</small></span><strong>Bảo trì hệ thống thang máy Tháp B 13:00 – 15:00</strong><p>Kính đề nghị cư dân sử dụng thang hàng hoặc thang Tháp A...</p></button>
                        <button class="glass-inner notice-list-item" type="button"><span><em class="notice-kind finance"><i></i>[Tài chính]</em><small>2 giờ trước</small></span><strong>Nhắc nhở quyết toán phí dịch vụ tháng 10/2024</strong><p>Hạn chót thanh toán ngày 30/10 để đảm bảo các dịch vụ tiện ích...</p></button>
                        <button class="glass-inner notice-list-item" type="button"><span><em class="notice-kind"><i></i>[Kế hoạch]</em><small>Hôm qua</small></span><strong>Kiểm tra định kỳ chuông báo cháy tầng 15 – 20</strong><p>Thời gian diễn tập thử nghiệm diễn ra trong khoảng 15 phút.</p></button>
                    </div>
                </div>
                <footer class="card-actions"><button class="resident-text-action" type="button" onclick="window.propFlowResident.switchTab('notifications')">Mở bảng tin thông báo chi tiết <span>›</span></button><button class="resident-muted-action" type="button">Đánh dấu đã đọc</button></footer>
            </article>
        </div>
    </div>

    <div class="resident-tab-panel" id="tabProcessingContent" hidden>
        <article class="resident-detail-panel glass-panel">
            <header class="detail-heading"><span><h2>📋 Chi tiết yêu cầu dịch vụ kỹ thuật &amp; tiện ích</h2><p>Theo dõi tiến độ, phân công nhân sự và phản hồi đánh giá trực tiếp</p></span><button class="resident-primary-action" type="button" @onclick='() => OpenService("OTHER", "Đăng ký hỗ trợ mới")'>+ Đăng ký hỗ trợ mới</button></header>
            <div class="filter-chips"><button class="active" type="button">Tất cả (5)</button><button type="button">Chờ xử lý (1)</button><button type="button">Đang thi công (2)</button><button type="button">Đã hoàn tất (2)</button></div>
            <div class="detail-list">
                <div class="glass-inner detail-row"><span class="detail-symbol amber">🔧</span><span class="detail-copy"><span><em>#YC-8945</em><strong>Sửa chữa hệ thống cấp nước phòng tắm Master</strong></span><p>Hiện tượng rò rỉ van nước cấp tự động bồn tắm, cần thay gioăng cao su chịu nhiệt.</p><small>Kỹ thuật viên: <b>Lê Minh Tuấn (0988.xxx.112)</b> • Hẹn: 10:30 Hôm nay</small></span><em class="badge badge-amber">Đang xử lý</em></div>
                <div class="glass-inner detail-row"><span class="detail-symbol blue">⚡</span><span class="detail-copy"><span><em>#YC-8942</em><strong>Kiểm tra hệ thống điện &amp; aptomat phòng khách</strong></span><p>Aptomat tầng lạnh tự ngắt khi bật hệ thống đèn chùm công suất lớn.</p><small>Trạng thái: <b>Đang điều phối kỹ thuật điện</b> • Tiếp nhận lúc: 08:15</small></span><em class="badge badge-blue">Chờ tiếp nhận</em></div>
                <div class="glass-inner detail-row"><span class="detail-symbol green">✨</span><span class="detail-copy"><span><em>#YC-8910</em><strong>Hỗ trợ vệ sinh công nghiệp sau tân gia</strong></span><p>Dịch vụ hút bụi sàn gỗ, lau kính ban công tràn viền và khử mùi ozone.</p><small>Đánh giá cư dân: <b class="stars">★★★★★ (5/5)</b> • Hoàn tất: 23/10/2024</small></span><em class="badge badge-green">Đã hoàn thành</em></div>
            </div>
        </article>
    </div>

    <div class="resident-tab-panel" id="tabNotificationsContent" hidden>
        <article class="resident-detail-panel glass-panel">
            <header class="detail-heading"><span><h2>🔔 Bản tin thông báo &amp; Hoạt động cư dân</h2><p>Thông tin vận hành chính thức từ Ban Quản Lý Vinhomes / PropFlow</p></span><button class="resident-muted-action" type="button">Đánh dấu tất cả là đã đọc</button></header>
            <div class="announcement-grid">
                <article class="glass-inner announcement rose"><em>Khẩn cấp • Vận hành</em><h3>Bảo trì hệ thống thang máy Tháp B</h3><p>Để đảm bảo an toàn tuyệt đối, đội ngũ Schindler sẽ tiến hành bảo dưỡng định kỳ hệ thống cáp tải từ 13:00 - 15:00 ngày 25/10/2024.</p><footer><span>Người gửi: Kỹ sư trưởng BQL</span><span>20 phút trước</span></footer></article>
                <article class="glass-inner announcement sky"><em>Tài chính • Phí dịch vụ</em><h3>Thông báo quyết toán phí quản lý tháng 10/2024</h3><p>Hệ thống đã phát hành bảng kê phí dịch vụ cho <strong>@ProfileContext.ApartmentLabel</strong>.</p><footer><span>Ban Kế toán Tòa nhà</span><span>2 giờ trước</span></footer></article>
                <article class="glass-inner announcement amber"><em>An toàn • PCCC</em><h3>Kiểm tra định kỳ hệ thống PCCC tầng 15 - 20</h3><p>Ban Quản lý phối hợp kiểm tra áp lực nước đầu phun sprinkler và chuông báo động tầng 18 vào 09:30 ngày 26/10.</p><footer><span>Ban An ninh Tòa nhà</span><span>Hôm qua</span></footer></article>
                <article class="glass-inner announcement purple"><em>Cộng đồng • Tiện ích</em><h3>Mở đăng ký khu tiệc nướng BBQ ngoài trời</h3><p>Khu vườn nướng Sky BBQ tầng thượng tháp Landmark đã hoàn tất nâng cấp và mở lịch đặt trước 48 giờ.</p><footer><span>Ban Tiện ích Cư dân</span><span>2 ngày trước</span></footer></article>
            </div>
        </article>
    </div>
</section>

<ResidentServiceRequestDialog @ref="_serviceRequestModal" />

<div class="resident-ai-widget" id="aiWidget">
    <section class="ai-chat-window glass-panel" id="aiChatWindow">
        <header><span class="ai-logo">⚡</span><span><strong>PropFlow Copilot <em>AI 24/7</em></strong><small>Trợ lý ảo • @ProfileContext.ApartmentLabel</small></span><button type="button" aria-label="Thu nhỏ" onclick="window.propFlowResident.toggleAssistant()">⌄</button></header>
        <div class="ai-quick-actions"><button type="button">🔧 Báo hỏng điện nước</button><button type="button">🧾 Tra cứu hóa đơn T09</button><button type="button">🚗 Thẻ xe cư dân</button></div>
        <div class="ai-thread"><div class="ai-message"><span>AI</span><p>Xin chào <strong>@DisplayName</strong>! Em là trợ lý AI PropFlow đồng hành cùng hồ sơ <strong>@ProfileContext.ApartmentLabel</strong>. Anh/chị cần hỗ trợ việc gì hôm nay?</p></div><div class="ai-message user"><p>Kiểm tra giúp tôi hóa đơn tháng 9 đã thanh toán chưa?</p><span>@Initials</span></div><div class="ai-message"><span>AI</span><p>Vui lòng mở mục hóa đơn để xem trạng thái authoritative mới nhất.</p></div></div>
        <footer><input id="chatInputBox" type="text" placeholder="Hỏi bất kỳ điều gì hoặc gửi yêu cầu cho BQL..." /><button type="button">➤</button></footer>
    </section>
    <button class="ai-toggle" type="button" aria-label="Mở trợ lý ảo PropFlow Copilot" title="PropFlow AI Copilot 24/7" onclick="window.propFlowResident.toggleAssistant()"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-5l-5 5v-5Z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg><i></i></button>
</div>

@code {
    [CascadingParameter]
    private ResidentPortalProfileContext ProfileContext { get; set; } = ResidentPortalProfileContext.Loading;

    private ResidentServiceRequestDialog? _serviceRequestModal;
    private void OpenService(string categoryCode, string title) =>
        _serviceRequestModal?.Open(categoryCode, title);
    private string DisplayName => ProfileContext.Profile?.FullName ?? Session.User?.DisplayName ?? "Cư dân";
    private string Initials => string.Concat(DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(x => x[0])).ToUpperInvariant();
}
