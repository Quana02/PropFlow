<article class="summary" aria-label="@Title">
    <header><h3>@Title</h3><strong>@Total</strong></header>
    <dl>
        <div class="active"><dt>Đang hoạt động</dt><dd>@Active</dd></div>
        <div class="maintenance"><dt>Đang bảo trì</dt><dd>@UnderMaintenance</dd></div>
        <div class="inactive"><dt>Ngưng hoạt động</dt><dd>@Inactive</dd></div>
        @if (Unavailable.HasValue) { <div class="neutral"><dt>Không khả dụng</dt><dd>@Unavailable</dd></div> }
        <div class="unavailable"><dt>Hết phục vụ</dt><dd>@OutOfService</dd></div>
    </dl>
</article>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public int Total { get; set; }
    [Parameter] public int Active { get; set; }
    [Parameter] public int UnderMaintenance { get; set; }
    [Parameter] public int Inactive { get; set; }
    [Parameter] public int? Unavailable { get; set; }
    [Parameter] public int OutOfService { get; set; }
}
