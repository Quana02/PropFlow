@using PropFlow.Web.Client.Features.Facility.Models
@using PropFlow.Web.Client.Features.Facility.Services
@inject IFacilityApiClient FacilityApiClient
@inject IEquipmentApiClient EquipmentApiClient

@if (IsOpen && Building != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
            <div class="modal-content shadow-lg border-0" style="border-radius: 1.5rem;">
                <div class="modal-header bg-dark text-white px-4 py-3" style="border-top-left-radius: 1.5rem; border-top-right-radius: 1.5rem;">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-building me-2 text-info"></i> Chi Tiết Hồ Sơ Tòa Nhà
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Close" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    @if (AssetError != null) { <p class="alert alert-danger" role="alert">@AssetError</p> }
                    <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary me-3 fs-3" style="border-radius: 1.25rem;">
                            <i class="bi bi-buildings"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-1">@Building.Name</h4>
                            <span class="badge bg-secondary me-2">Mã: @Building.Code</span>
                            @if (Building.Status == MasterDataStatus.ACTIVE)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                    <i class="bi bi-check-circle-fill me-1"></i> Đang hoạt động
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1">
                                    <i class="bi bi-pause-circle-fill me-1"></i> Ngưng hoạt động
                                </span>
                            }
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="p-3 bg-light" style="border-radius: 1rem;">
                                <span class="text-muted d-block small">Địa chỉ tòa nhà</span>
                                <strong class="fs-6 text-dark"><i class="bi bi-geo-alt-fill text-danger me-1"></i> @Building.Address</strong>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light" style="border-radius: 1rem;">
                                <span class="text-muted d-block small">Múi giờ vận hành</span>
                                <strong class="fs-6 text-dark"><i class="bi bi-clock-fill text-warning me-1"></i> @Building.TimeZoneId</strong>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light" style="border-radius: 1rem;">
                                <span class="text-muted d-block small">Số tầng</span>
                                <strong class="fs-6 text-dark"><i class="bi bi-layers-fill text-primary me-1"></i> @(Building.NumberOfFloors.HasValue ? $"{Building.NumberOfFloors} tầng" : "Chưa cập nhật")</strong>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light" style="border-radius: 1rem;">
                                <span class="text-muted d-block small">Mã định danh hệ thống (ID)</span>
                                <code class="small text-break">@Building.Id</code>
                            </div>
                        </div>
                        @if (Building is BuildingDetailModel detail)
                        {
                            <div class="col-md-6">
                                <div class="p-3 bg-info bg-opacity-10 border border-info-subtle" style="border-radius: 1rem;">
                                    <span class="text-info-emphasis d-block small"><i class="bi bi-grid-fill me-1"></i> Tiện ích (Facilities)</span>
                                    <strong class="fs-5 text-dark">@detail.FacilityCount tiện ích</strong> <span class="text-success small">(@detail.ActiveFacilityCount đang hoạt động)</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 bg-warning bg-opacity-10 border border-warning-subtle" style="border-radius: 1rem;">
                                    <span class="text-warning-emphasis d-block small"><i class="bi bi-tools me-1"></i> Thiết bị (Equipment)</span>
                                    <strong class="fs-5 text-dark">@detail.EquipmentCount thiết bị</strong> <span class="text-success small">(@detail.ActiveEquipmentCount đang hoạt động)</span>
                                </div>
                            </div>
                        }
                        <div class="col-12">
                            <div class="p-3 bg-light" style="border-radius: 1rem;">
                                <span class="text-muted d-block small mb-1">Mô tả / Ghi chú</span>
                                <p class="mb-0 text-dark">@(string.IsNullOrWhiteSpace(Building.Description) ? "Không có mô tả bổ sung." : Building.Description)</p>
                            </div>
                        </div>
                    </div>
                </div>

                    <!-- Danh sách tài sản con -->
                    <div class="row g-3 mt-3">
                        <div class="col-12">
                            <ul class="nav nav-tabs" id="assetTabs" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link @(ActiveTab == "facility" ? "active" : "") fw-bold text-info-emphasis" id="facility-tab" @onclick="ShowFacilityTab" type="button" role="tab">
                                        <i class="bi bi-grid-fill me-1"></i> Cơ sở vật chất (@TotalFacilities)
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link @(ActiveTab == "equipment" ? "active" : "") fw-bold text-warning-emphasis" id="equipment-tab" @onclick="ShowEquipmentTab" type="button" role="tab">
                                        <i class="bi bi-tools me-1"></i> Thiết bị (@TotalEquipments)
                                    </button>
                                </li>
                            </ul>
                            <div class="tab-content border border-top-0 rounded-bottom p-3 bg-white" id="assetTabsContent">
                                @if (ActiveTab == "facility")
                                {
                                    <div class="tab-pane fade show active" id="facility-pane" role="tabpanel" tabindex="0">
                                        @if (IsLoadingAssets)
                                        {
                                            <div class="text-center py-3 text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Đang tải dữ liệu...</div>
                                        }
                                        else if (!Facilities.Any())
                                        {
                                            <div class="text-center py-3 text-muted">Không có cơ sở vật chất nào.</div>
                                        }
                                        else
                                        {
                                            <div class="table-responsive" style="max-height: 250px;">
                                                <table class="table table-sm table-hover align-middle mb-0">
                                                    <thead class="table-light text-muted small sticky-top">
                                                        <tr>
                                                            <th>Mã</th>
                                                            <th>Tên CSVT</th>
                                                            <th>Loại</th>
                                                            <th>Trạng thái</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody class="small">
                                                        @foreach (var f in Facilities)
                                                        {
                                                            <tr>
                                                                <td><span class="badge bg-light text-dark border">@f.Code</span></td>
                                                                <td class="fw-semibold">@f.Name</td>
                                                                <td>@f.FacilityType</td>
                                                                <td>
                                                                <span class="badge @GetStatusBadgeClass(f.Status)">@GetStatusText(f.Status)</span>
                                                                </td>
                                                            </tr>
                                                        }
                                                        @if (TotalFacilities > Facilities.Count)
                                                        {
                                                            <tr>
                                                                <td colspan="4" class="text-center text-muted small py-2">
                                                                    <i class="bi bi-info-circle me-1"></i>
                                                                    Hiển thị @Facilities.Count trên @TotalFacilities cơ sở vật chất
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                    </div>
                                    @if (TotalFacilities > PageSize)
                                    {
                                        <div class="d-flex align-items-center justify-content-between mt-2 small">
                                            <button class="btn btn-sm btn-outline-secondary" disabled="@(FacilityPage == 1 || IsLoadingAssets)" @onclick="() => ChangeFacilityPage(-1)">Trước</button>
                                            <span>Trang @FacilityPage / @((TotalFacilities + PageSize - 1) / PageSize)</span>
                                            <button class="btn btn-sm btn-outline-secondary" disabled="@(FacilityPage * PageSize >= TotalFacilities || IsLoadingAssets)" @onclick="() => ChangeFacilityPage(1)">Sau</button>
                                        </div>
                                    }
                                }
                                else if (ActiveTab == "equipment")
                                {
                                    <div class="tab-pane fade show active" id="equipment-pane" role="tabpanel" tabindex="0">
                                        @if (IsLoadingAssets)
                                        {
                                            <div class="text-center py-3 text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Đang tải dữ liệu...</div>
                                        }
                                        else if (!Equipments.Any())
                                        {
                                            <div class="text-center py-3 text-muted">Không có thiết bị nào.</div>
                                        }
                                        else
                                        {
                                            <div class="table-responsive" style="max-height: 250px;">
                                                <table class="table table-sm table-hover align-middle mb-0">
                                                    <thead class="table-light text-muted small sticky-top">
                                                        <tr>
                                                            <th>Mã</th>
                                                            <th>Tên thiết bị</th>
                                                            <th>Nằm tại (CSVT)</th>
                                                            <th>Trạng thái</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody class="small">
                                                        @foreach (var e in Equipments)
                                                        {
                                                            <tr>
                                                                <td><span class="badge bg-light text-dark border">@e.Code</span></td>
                                                                <td class="fw-semibold">@e.Name</td>
                                                                <td>@(string.IsNullOrEmpty(e.FacilityName) ? "-" : e.FacilityName)</td>
                                                                <td>
                                                                <span class="badge @GetEqStatusBadgeClass(e.Status)">@GetEqStatusText(e.Status)</span>
                                                                </td>
                                                            </tr>
                                                        }
                                                        @if (TotalEquipments > Equipments.Count)
                                                        {
                                                            <tr>
                                                                <td colspan="4" class="text-center text-muted small py-2">
                                                                    <i class="bi bi-info-circle me-1"></i>
                                                                    Hiển thị @Equipments.Count trên @TotalEquipments thiết bị
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                    </div>
                                    @if (TotalEquipments > PageSize)
                                    {
                                        <div class="d-flex align-items-center justify-content-between mt-2 small">
                                            <button class="btn btn-sm btn-outline-secondary" disabled="@(EquipmentPage == 1 || IsLoadingAssets)" @onclick="() => ChangeEquipmentPage(-1)">Trước</button>
                                            <span>Trang @EquipmentPage / @((TotalEquipments + PageSize - 1) / PageSize)</span>
                                            <button class="btn btn-sm btn-outline-secondary" disabled="@(EquipmentPage * PageSize >= TotalEquipments || IsLoadingAssets)" @onclick="() => ChangeEquipmentPage(1)">Sau</button>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mt-2 pt-3 border-top text-muted small">
                        <div class="col-md-6">
                            <i class="bi bi-calendar-plus me-1"></i> Ngày khởi tạo: @Building.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")
                        </div>
                        <div class="col-md-6 text-md-end">
                            <i class="bi bi-calendar-check me-1"></i> Cập nhật gần nhất: @Building.UpdatedAt.ToString("dd/MM/yyyy HH:mm:ss")
                        </div>
                    </div>
            </div>
                
        </div>
    </div>
      
    
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public BuildingModel? Building { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private List<FacilityModel> Facilities { get; set; } = new();
    private List<EquipmentModel> Equipments { get; set; } = new();
    private int TotalFacilities { get; set; }
    private int TotalEquipments { get; set; }
    private const int PageSize = 20;
    private int FacilityPage = 1;
    private int EquipmentPage = 1;
    private bool IsLoadingAssets { get; set; }
    private string? AssetError { get; set; }
    private Guid? LoadedBuildingId { get; set; }
    private string ActiveTab { get; set; } = "facility";

    protected override async Task OnParametersSetAsync()
    {
        if (!IsOpen) { LoadedBuildingId = null; return; }
        if (Building != null && LoadedBuildingId != Building.Id)
        {
            LoadedBuildingId = Building.Id;
            FacilityPage = 1;
            EquipmentPage = 1;
            IsLoadingAssets = true;
            AssetError = null;

            try
            {
                var fResult = await FacilityApiClient.GetFacilitiesAsync(new FacilityFilterModel { BuildingId = Building.Id, PageIndex = FacilityPage, PageSize = PageSize });
                if (fResult.IsSuccess && fResult.Data != null) { Facilities = fResult.Data.Items?.ToList() ?? new(); TotalFacilities = fResult.Data.TotalCount; }
                else AssetError = fResult.Message ?? "Không thể tải cơ sở vật chất.";

                var eResult = await EquipmentApiClient.GetEquipmentsAsync(new EquipmentFilterModel { BuildingId = Building.Id, PageIndex = EquipmentPage, PageSize = PageSize });
                if (eResult.IsSuccess && eResult.Data != null) { Equipments = eResult.Data.Items?.ToList() ?? new(); TotalEquipments = eResult.Data.TotalCount; }
                else AssetError = eResult.Message ?? "Không thể tải thiết bị.";
            }
            finally
            {
                IsLoadingAssets = false;
            }
        }
    }

    private async Task ChangeFacilityPage(int delta)
    {
        if (Building == null) return;
        var next = FacilityPage + delta;
        if (next < 1 || (next - 1) * PageSize >= TotalFacilities) return;
        IsLoadingAssets = true;
        try
        {
            var result = await FacilityApiClient.GetFacilitiesAsync(new FacilityFilterModel { BuildingId = Building.Id, PageIndex = next, PageSize = PageSize });
            if (!result.IsSuccess || result.Data == null) { AssetError = result.Message ?? "Không thể tải cơ sở vật chất."; return; }
            Facilities = result.Data.Items?.ToList() ?? new();
            TotalFacilities = result.Data.TotalCount;
            FacilityPage = next;
        }
        finally { IsLoadingAssets = false; }
    }

    private async Task ChangeEquipmentPage(int delta)
    {
        if (Building == null) return;
        var next = EquipmentPage + delta;
        if (next < 1 || (next - 1) * PageSize >= TotalEquipments) return;
        IsLoadingAssets = true;
        try
        {
            var result = await EquipmentApiClient.GetEquipmentsAsync(new EquipmentFilterModel { BuildingId = Building.Id, PageIndex = next, PageSize = PageSize });
            if (!result.IsSuccess || result.Data == null) { AssetError = result.Message ?? "Không thể tải thiết bị."; return; }
            Equipments = result.Data.Items?.ToList() ?? new();
            TotalEquipments = result.Data.TotalCount;
            EquipmentPage = next;
        }
        finally { IsLoadingAssets = false; }
    }

    private async Task Close()
    {
        IsOpen = false;
        await OnClose.InvokeAsync();
    }

    private void ShowFacilityTab()
    {
        ActiveTab = "facility";
    }

    private void ShowEquipmentTab()
    {
        ActiveTab = "equipment";
    }

    private string GetStatusText(MasterDataStatus status) => status switch
    {
        MasterDataStatus.ACTIVE => "Đang hoạt động",
        MasterDataStatus.INACTIVE => "Ngưng hoạt động",
        MasterDataStatus.UNDER_MAINTENANCE => "Đang bảo trì",
        MasterDataStatus.UNAVAILABLE => "Không khả dụng",
        MasterDataStatus.OUT_OF_SERVICE => "Hỏng hóc",
        _ => status.ToString()
    };

    private string GetStatusBadgeClass(MasterDataStatus status) => status switch
    {
        MasterDataStatus.ACTIVE => "bg-success",
        MasterDataStatus.INACTIVE => "bg-danger",
        MasterDataStatus.UNDER_MAINTENANCE => "bg-warning text-dark",
        MasterDataStatus.UNAVAILABLE => "bg-secondary",
        MasterDataStatus.OUT_OF_SERVICE => "bg-danger",
        _ => "bg-secondary"
    };

    private string GetEqStatusText(EquipmentStatus status) => status switch
    {
        EquipmentStatus.ACTIVE => "Đang hoạt động",
        EquipmentStatus.INACTIVE => "Ngưng hoạt động",
        EquipmentStatus.UNDER_MAINTENANCE => "Đang bảo trì",
        EquipmentStatus.OUT_OF_SERVICE => "Hỏng hóc",
        _ => status.ToString()
    };

    private string GetEqStatusBadgeClass(EquipmentStatus status) => status switch
    {
        EquipmentStatus.ACTIVE => "bg-success",
        EquipmentStatus.INACTIVE => "bg-danger",
        EquipmentStatus.UNDER_MAINTENANCE => "bg-warning text-dark",
        EquipmentStatus.OUT_OF_SERVICE => "bg-danger",
        _ => "bg-secondary"
    };
}
