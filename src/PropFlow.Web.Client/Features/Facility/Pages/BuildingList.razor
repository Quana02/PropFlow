@page "/buildings"
@layout PropFlow.Web.Client.Layout.MainLayout
@attribute [Authorize(Roles = "MANAGER")]
@using PropFlow.Web.Client.Features.Facility.Models
@using PropFlow.Web.Client.Features.Facility.Services
@using PropFlow.Web.Client.Features.Facility.Components
@inject IBuildingApiClient BuildingApiClient

<PageTitle>Quản Lý Tòa Nhà - PropFlow</PageTitle>

<div class="min-h-screen bg-[#f8f9fc] font-sans text-slate-800 antialiased">

    <!-- ===== PAGE HEADER ===== -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs mb-6">
        <div class="flex items-start gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center shadow-xs mt-0.5">
                <span class="material-symbols-outlined text-2xl">apartment</span>
            </div>
            <div>
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">Danh Mục Tòa Nhà</h1>
                <p class="text-xs text-slate-500 mt-1 max-w-2xl">
                    Quản lý định danh các Tòa nhà, phân bổ số tầng, múi giờ vận hành và giám sát trạng thái hoạt động.
                </p>
            </div>
        </div>
        <div class="flex items-center gap-2.5 flex-wrap">
            
            <button type="button"
                    class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-bold text-white bg-sky-600 hover:bg-sky-700 rounded-xl shadow-sm shadow-sky-600/20 transition-colors"
                    @onclick="OpenCreateDialog">
                <span class="material-symbols-outlined text-[17px]">add_circle</span>
                <span>Thêm Tòa Nhà Mới</span>
            </button>
        </div>
    </div>

    <!-- ===== KPI STAT CARDS ===== -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/80 shadow-stitch-card flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[26px]">corporate_fare</span>
            </div>
            <div>
                <span class="text-xs text-slate-500 font-medium block">Tổng số căn hộ</span>
                <span class="text-2xl font-bold font-display text-slate-900">@PagedResult.TotalCount</span>
            </div>
        </div>
        <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/80 shadow-stitch-card flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[26px]">check_circle</span>
            </div>
            <div>
                <span class="text-xs text-slate-500 font-medium block">Đang hoạt động</span>
                <span class="text-2xl font-bold font-display text-emerald-600">
                    @(PagedResult.Items?.Count(x => x.Status == MasterDataStatus.ACTIVE) ?? 0)
                </span>
            </div>
        </div>
        <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/80 shadow-stitch-card flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[26px]">layers</span>
            </div>
            <div>
                <span class="text-xs text-slate-500 font-medium block">Trang hiện tại</span>
                <span class="text-2xl font-bold font-display text-slate-900">@PagedResult.PageIndex / @PagedResult.TotalPages</span>
            </div>
        </div>
        <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/80 shadow-stitch-card flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[26px]">pause_circle</span>
            </div>
            <div>
                <span class="text-xs text-slate-500 font-medium block">Ngưng hoạt động</span>
                <span class="text-2xl font-bold font-display text-rose-600">
                    @(PagedResult.Items?.Count(x => x.Status != MasterDataStatus.ACTIVE) ?? 0)
                </span>
            </div>
        </div>
    </div>

    <!-- ===== ALERT NOTIFICATIONS ===== -->
    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="flex items-center gap-3 px-4 py-3 mb-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-medium shadow-sm">
            <span class="material-symbols-outlined text-emerald-500 text-[20px]">check_circle</span>
            <span>@SuccessMessage</span>
            <button class="ml-auto text-emerald-500 hover:text-emerald-700 transition-stitch" @onclick="() => SuccessMessage = null">
                <span class="material-symbols-outlined text-[18px]">close</span>
            </button>
        </div>
    }
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="flex items-center gap-3 px-4 py-3 mb-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm font-medium shadow-sm">
            <span class="material-symbols-outlined text-rose-500 text-[20px]">error</span>
            <span>@ErrorMessage</span>
            <button class="ml-auto text-rose-500 hover:text-rose-700 transition-stitch" @onclick="() => ErrorMessage = null">
                <span class="material-symbols-outlined text-[18px]">close</span>
            </button>
        </div>
    }

    <!-- ===== SEARCH & FILTER TOOLBAR ===== -->
    <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/80 shadow-stitch-card flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
        <div class="flex-1 flex flex-col sm:flex-row items-center gap-3">
            <!-- Search -->
            <div class="relative w-full sm:w-80">
                <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-[20px]">search</span>
                <input type="text"
                       placeholder="Tìm theo mã, tên tòa, địa chỉ..."
                       class="w-full bg-slate-50 border border-slate-200 rounded-xl py-2.5 pl-10 pr-4 text-xs sm:text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 transition-stitch"
                       @bind="Filter.SearchKeyword" @bind:event="oninput" @onkeyup="HandleSearchKeyUp" />
            </div>
            <!-- Status Filter -->
            <div class="relative w-full sm:w-56">
                <PropFlowSelect @bind-Value="StatusFilterString" Options="BuildingStatusOptions" Variant="Filter" AriaLabel="Lọc trạng thái tòa nhà" />
            </div>
            <!-- Filter Buttons -->
            <div class="flex items-center gap-2 w-full sm:w-auto">
                <button type="button"
                        class="flex-1 sm:flex-none flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl bg-sky-50 hover:bg-sky-100 text-sky-700 border border-sky-200 text-xs sm:text-sm font-semibold transition-stitch"
                        @onclick="ApplyFilter">
                    <span class="material-symbols-outlined text-[18px]">filter_alt</span>
                    <span>Lọc</span>
                </button>
                <button type="button"
                        class="flex-1 sm:flex-none flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 text-xs sm:text-sm font-medium transition-stitch"
                        @onclick="ResetFilter">
                    <span class="material-symbols-outlined text-[18px]">restart_alt</span>
                    <span>Đặt lại</span>
                </button>
            </div>
        </div>
        
    </div>

    <!-- ===== DATA TABLE ===== -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-stitch-card overflow-hidden">
        @if (IsLoading)
        {
            <div class="flex flex-col items-center justify-center py-20 gap-4">
                <div class="w-12 h-12 rounded-full border-4 border-sky-200 border-t-sky-600 animate-spin"></div>
                <p class="text-sm text-slate-500 font-medium">Đang tải danh sách Căn Hộ...</p>
            </div>
        }
        else if (PagedResult.Items == null || !PagedResult.Items.Any())
        {
            <div class="flex flex-col items-center justify-center py-20 gap-4 text-center px-4">
                <span class="material-symbols-outlined text-[64px] text-slate-300">domain_disabled</span>
                <h5 class="text-lg font-bold font-display text-slate-700">Chưa có dữ liệu tòa nhà nào</h5>
                <p class="text-sm text-slate-400 max-w-sm">Không tìm thấy thông tin tòa nhà khớp với tiêu chí tìm kiếm của bạn.</p>
                <button class="flex items-center gap-2 px-5 py-2.5 rounded-xl bg-sky-600 hover:bg-sky-700 text-white text-sm font-semibold shadow-md transition-stitch"
                        @onclick="OpenCreateDialog">
                    <span class="material-symbols-outlined text-[18px]">add_circle</span>
                    <span>Thêm tòa nhà ngay</span>
                </button>
            </div>
        }
        else
        {
            <div class="overflow-x-auto w-full">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50/80 border-b border-slate-200 text-[11px] font-semibold uppercase tracking-wider text-slate-500 font-display">
                            <th class="py-3.5 px-4 sm:px-6">Mã Tòa Nhà</th>
                            <th class="py-3.5 px-4">Tên Tòa Nhà</th>
                            <th class="py-3.5 px-4">Địa Chỉ</th>
                            <th class="py-3.5 px-4 text-center">Số Tầng</th>
                            <th class="py-3.5 px-4 text-center">Múi Giờ</th>
                            <th class="py-3.5 px-4 text-center">Trạng Thái</th>
                            <th class="py-3.5 px-4 sm:px-6 text-right">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-xs sm:text-sm text-slate-700">
                        @foreach (var item in PagedResult.Items)
                        {
                            <tr class="hover:bg-sky-50/40 transition-stitch group">
                                <td class="py-4 px-4 sm:px-6 font-semibold text-sky-700 font-display">
                                    <div class="flex items-center gap-2">
                                        <div class="w-2 h-2 rounded-full @(item.Status == MasterDataStatus.ACTIVE ? "bg-emerald-500" : "bg-rose-500")"></div>
                                        <span class="px-2 py-0.5 @(item.Status == MasterDataStatus.ACTIVE ? "bg-sky-50 border-sky-200" : "bg-slate-100 border-slate-200") rounded-md border text-xs">@item.Code</span>
                                    </div>
                                </td>
                                <td class="py-4 px-4">
                                    <div class="font-bold text-slate-900 group-hover:text-sky-600 transition-colors">@item.Name</div>
                                </td>
                                <td class="py-4 px-4 max-w-xs text-slate-600" title="@item.Address">
                                    <div class="flex items-center gap-1.5 truncate">
                                        <span class="material-symbols-outlined text-[16px] text-slate-400 flex-shrink-0">pin_drop</span>
                                        <span class="truncate">@item.Address</span>
                                    </div>
                                </td>
                                <td class="py-4 px-4 text-center font-display font-semibold">
                                    <span class="px-2.5 py-1 rounded-lg bg-slate-100 text-slate-800">
                                        @(item.NumberOfFloors.HasValue ? $"{item.NumberOfFloors} Tầng" : "-")
                                    </span>
                                </td>
                                <td class="py-4 px-4 text-center text-slate-500 text-xs">
                                    <span class="inline-flex items-center gap-1">
                                        <span class="material-symbols-outlined text-[14px]">schedule</span>
                                        <span>@(string.IsNullOrEmpty(item.TimeZoneId) ? "-" : item.TimeZoneId)</span>
                                    </span>
                                </td>
                                <td class="py-4 px-4 text-center">
                                    @if (item.Status == MasterDataStatus.ACTIVE)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 shadow-sm">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                            <span>Đang hoạt động</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200 shadow-sm">
                                            <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                                            <span>Ngưng hoạt động</span>
                                        </span>
                                    }
                                </td>
                                <td class="py-4 px-4 sm:px-6 text-right">
                                    <div class="flex items-center justify-end gap-1 text-slate-500">
                                        <button type="button"
                                                class="p-1.5 rounded-lg hover:bg-sky-100 hover:text-sky-700 transition-stitch"
                                                title="Xem chi tiết"
                                                @onclick="() => OpenDetailDialog(item)">
                                            <span class="material-symbols-outlined text-[18px]">visibility</span>
                                        </button>
                                        <button type="button"
                                                class="p-1.5 rounded-lg hover:bg-amber-100 hover:text-amber-700 transition-stitch"
                                                title="Chỉnh sửa hồ sơ"
                                                @onclick="() => OpenEditDialog(item)">
                                            <span class="material-symbols-outlined text-[18px]">edit</span>
                                        </button>
                                        @if (item.Status == MasterDataStatus.ACTIVE)
                                        {
                                            <button type="button"
                                                    class="p-1.5 rounded-lg hover:bg-rose-100 hover:text-rose-700 transition-stitch"
                                                    title="Vô hiệu hóa"
                                                    @onclick="() => ToggleStatus(item, MasterDataStatus.INACTIVE)">
                                                <span class="material-symbols-outlined text-[18px]">power_settings_new</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="p-1.5 rounded-lg hover:bg-emerald-100 hover:text-emerald-700 transition-stitch"
                                                    title="Kích hoạt lại"
                                                    @onclick="() => ToggleStatus(item, MasterDataStatus.ACTIVE)">
                                                <span class="material-symbols-outlined text-[18px]">check_circle</span>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- PAGINATION -->
            <div class="p-4 sm:px-6 border-t border-slate-200/80 bg-slate-50/50 flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs text-slate-600">
                <div>
                    Bản ghi <strong class="text-slate-800">@(((PagedResult.PageIndex - 1) * PagedResult.PageSize) + 1)</strong> -
                    <strong class="text-slate-800">@(Math.Min(PagedResult.PageIndex * PagedResult.PageSize, PagedResult.TotalCount))</strong>
                    trong tổng số <strong class="text-slate-800">@PagedResult.TotalCount</strong>
                </div>
                <div class="flex items-center gap-1.5 self-center sm:self-auto">
                    <button class="p-1.5 rounded-lg bg-white border border-slate-200 text-slate-400 hover:text-slate-700 hover:bg-slate-50 transition-stitch disabled:opacity-40"
                            disabled="@(!PagedResult.HasPreviousPage)"
                            @onclick="() => ChangePage(1)">
                        <span class="material-symbols-outlined text-[18px]">first_page</span>
                    </button>
                    <button class="p-1.5 rounded-lg bg-white border border-slate-200 text-slate-400 hover:text-slate-700 hover:bg-slate-50 transition-stitch disabled:opacity-40"
                            disabled="@(!PagedResult.HasPreviousPage)"
                            @onclick="() => ChangePage(PagedResult.PageIndex - 1)">
                        <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                    </button>

                    @for (int i = 1; i <= PagedResult.TotalPages; i++)
                    {
                        var pageNum = i;
                        @if (pageNum == PagedResult.PageIndex)
                        {
                            <button class="w-8 h-8 rounded-lg bg-sky-600 text-white font-bold text-xs shadow-sm flex items-center justify-center">@pageNum</button>
                        }
                        else
                        {
                            <button class="w-8 h-8 rounded-lg bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 font-medium text-xs transition-stitch flex items-center justify-center"
                                    @onclick="() => ChangePage(pageNum)">@pageNum</button>
                        }
                    }

                    <button class="p-1.5 rounded-lg bg-white border border-slate-200 text-slate-600 hover:text-slate-900 hover:bg-slate-50 transition-stitch disabled:opacity-40"
                            disabled="@(!PagedResult.HasNextPage)"
                            @onclick="() => ChangePage(PagedResult.PageIndex + 1)">
                        <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                    </button>
                    <button class="p-1.5 rounded-lg bg-white border border-slate-200 text-slate-600 hover:text-slate-900 hover:bg-slate-50 transition-stitch disabled:opacity-40"
                            disabled="@(!PagedResult.HasNextPage)"
                            @onclick="() => ChangePage(PagedResult.TotalPages)">
                        <span class="material-symbols-outlined text-[18px]">last_page</span>
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<!-- Form Modal -->
<BuildingFormDialog IsOpen="IsFormOpen" BuildingToEdit="SelectedBuildingToEdit" OnSaved="LoadData" OnClose="() => IsFormOpen = false" />

<!-- Detail Modal -->
<BuildingDetailDialog IsOpen="IsDetailOpen" Building="SelectedBuildingToView" OnClose="() => IsDetailOpen = false" />

@code {
    private static readonly PropFlowSelectOption[] BuildingStatusOptions = [new("", "Tất cả trạng thái"), new("ACTIVE", "Đang hoạt động"), new("INACTIVE", "Ngưng hoạt động")];
    private PagedResult<BuildingModel> PagedResult { get; set; } = new();
    private BuildingFilterModel Filter { get; set; } = new();
    private bool IsLoading { get; set; } = true;
    private string? SuccessMessage { get; set; }
    private string? ErrorMessage { get; set; }

    // Modal Control
    private bool IsFormOpen { get; set; }
    private bool IsDetailOpen { get; set; }
    private BuildingModel? SelectedBuildingToEdit { get; set; }
    private BuildingModel? SelectedBuildingToView { get; set; }

    private string StatusFilterString
    {
        get => Filter.Status?.ToString() ?? "";
        set
        {
            if (Enum.TryParse<MasterDataStatus>(value, out var status))
            {
                Filter.Status = status;
            }
            else
            {
                Filter.Status = null;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            var result = await BuildingApiClient.GetBuildingsAsync(Filter);
            if (result.IsSuccess && result.Data != null) PagedResult = result.Data;
            else ErrorMessage = result.Message ?? "Không thể tải danh sách tòa nhà.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ApplyFilter();
        }
    }

    private async Task ApplyFilter()
    {
        Filter.PageIndex = 1;
        await LoadData();
    }

    private async Task ResetFilter()
    {
        Filter = new BuildingFilterModel();
        await LoadData();
    }

    private async Task ChangePage(int newPageIndex)
    {
        if (newPageIndex >= 1 && newPageIndex <= PagedResult.TotalPages)
        {
            Filter.PageIndex = newPageIndex;
            await LoadData();
        }
    }

    private void OpenCreateDialog()
    {
        SelectedBuildingToEdit = null;
        IsFormOpen = true;
    }

    private void OpenEditDialog(BuildingModel item)
    {
        SelectedBuildingToEdit = item;
        IsFormOpen = true;
    }

    private async Task OpenDetailDialog(BuildingModel item)
    {
        var result = await BuildingApiClient.GetBuildingDetailByIdAsync(item.Id);
        if (!result.IsSuccess || result.Data == null)
        {
            ErrorMessage = result.Message ?? "Không thể tải chi tiết tòa nhà.";
            return;
        }
        SelectedBuildingToView = result.Data;
        IsDetailOpen = true;
    }

    private async Task ToggleStatus(BuildingModel item, MasterDataStatus targetStatus)
    {
        ErrorMessage = null;
        SuccessMessage = null;
        var actionText = targetStatus == MasterDataStatus.ACTIVE ? "kích hoạt" : "vô hiệu hóa";
        var result = await BuildingApiClient.SetBuildingStatusAsync(item.Id, targetStatus);
        if (!result.IsSuccess) { ErrorMessage = result.Message; return; }
        await LoadData();
        if (ErrorMessage == null) SuccessMessage = $"Đã {actionText} thành công tòa nhà '{item.Name}'.";
    }
}
