                                Mô Tả Vị Trí Cụ Thể <span class="text-rose-500">*</span>
                            </label>
                            <input @bind="CreateFormModel.LocationDescription" type="text" placeholder="VD: Tầng 3 - Cánh Tây, Liền kề phòng sinh hoạt cộng đồng" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-white text-sm text-[#0f172a] placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#0284c7]/20 focus:border-[#0284c7] transition-all" />
                        </div>

                        <!-- Field 7: Mô tả chi tiết (Description) -->
                        <div class="sm:col-span-2 space-y-1.5">
                            <label class="block text-xs font-semibold uppercase tracking-wider text-[#0f172a]">
                                Ghi Chú / Mô Tả Kỹ Thuật 
                            </label>
                            <textarea @bind="CreateFormModel.Description" rows="3" placeholder="Nhập thông số kỹ thuật, quy định sử dụng hoặc lịch bảo dưỡng định kỳ..." class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-white text-sm text-[#0f172a] placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#0284c7]/20 focus:border-[#0284c7] transition-all resize-none leading-relaxed"></textarea>
                        </div>
                    }
                    else
                    {
                        <!-- Edit Mode-->
                        <!-- Field 1: Mã CSVT (Readonly) -->
                        <div class="space-y-1.5">
                            <label class="block text-xs font-semibold uppercase tracking-wider text-[#0f172a]">
                                Mã Cơ Sở Vật Chất <span class="text-rose-500">*</span>
                            </label>
                            <div class="relative">
                                <input value="@SelectedFacilityToEdit.Code" disabled class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-sm text-slate-500 placeholder-slate-400 focus:outline-none transition-all font-mono cursor-not-allowed" />
                            </div>
                        </div>

                        <!-- Field 2: Tên CSVT (Required) -->
                        <div class="space-y-1.5">
                            <label class="block text-xs font-semibold uppercase tracking-wider text-[#0f172a]">
                                Tên Cơ Sở Vật Chất <span class="text-rose-500">*</span>
                            </label>
                            <input @bind="UpdateFormModel.Name" type="text" placeholder="VD: Khu vui chơi trẻ em KidZone" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-white text-sm text-[#0f172a] placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#0284c7]/20 focus:border-[#0284c7] transition-all" />
                        </div>

                        <!-- Field 3: Tòa Nhà Dropdown (BuildingId Guid -> BuildingName) -->
                        <div class="space-y-1.5">
                            <label class="block text-xs font-semibold uppercase tracking-wider text-[#0f172a]">
                                Tòa Nhà Trực Thuộc <span class="text-rose-500">*</span>
                            </label>
                            <div class="relative">
                                <PropFlowSelect @bind-Value="UpdateBuildingIdString" Options="BuildingOptions" Placeholder="Chọn tòa nhà" AriaLabel="Tòa nhà trực thuộc" />
                            </div>
                        </div>

                        <!-- Field 4: Loại CSVT (FacilityType) -->
                        <div class="space-y-1.5">
                            <label class="block text-xs font-semibold uppercase tracking-wider text-[#0f172a]">
                                Phân Loại Tiện Ích <span class="text-rose-500">*</span>
                            </label>
                            <div class="relative">
                                <PropFlowSelect @bind-Value="UpdateFormModel.FacilityType" Options="FacilityTypeOptions" Placeholder="Chọn phân loại" AriaLabel="Phân loại tiện ích" />
                            </div>
                        </div>

                        <!-- Field 5: Trạng thái vận hành (Status Enum) -->
                        <div class="space-y-1.5 sm:col-span-2">
                            <label class="block text-xs font-semibold uppercase tracking-wider text-[#0f172a]">
                                Trạng Thái Vận Hành  <span class="text-rose-500">*</span>
                            </label>
                            <div class="grid grid-cols-2 sm:grid-cols-5 gap-2">
                                @foreach (var (status, label, color, subLabel) in new[]
                                {
                                    (MasterDataStatus.ACTIVE, "Đang hoạt động", "emerald", "Hoạt động tốt"),
                                    (MasterDataStatus.UNDER_MAINTENANCE, "Đang bảo trì", "amber", "Bảo dưỡng kỹ thuật"),
                                    (MasterDataStatus.UNAVAILABLE, "Tạm ngưng / Kín", "indigo", "Kín chỗ/Hạn chế"),
                                    (MasterDataStatus.INACTIVE, "Ngừng kích hoạt", "slate", "Tạm ngưng sử dụng"),
                                    (MasterDataStatus.OUT_OF_SERVICE, "Ngừng phục vụ", "rose", "Hỏng / Thay thế")
                                })
                                {
                                    var s = status;
                                    var isSelected = UpdateFormModel.Status == s;
                                    <button type="button"
                                            class="cursor-pointer border rounded-xl p-2.5 text-center transition-all @(isSelected ? $"bg-{color}-50 border-{color}-500" : $"border-{color}-200 hover:bg-{color}-50")"
                                            @onclick="() => UpdateFormModel.Status = s">
                                        <span class="block text-xs font-bold text-@(color)-700">@label</span>
                                        <span class="text-[10px] text-@(color)-600">@subLabel</span>
                                    </button>
                                }
                            </div>
                        </div>

                        <!-- Field 6: Vị trí cụ thể (LocationDescription) -->
                        <div class="sm:col-span-2 space-y-1.5">
                            <label class="block text-xs font-semibold uppercase tracking-wider text-[#0f172a]">
                                Mô Tả Vị Trí Cụ Thể  <span class="text-rose-500">*</span>
                            </label>
                            <input @bind="UpdateFormModel.LocationDescription" type="text" placeholder="VD: Tầng 3 - Cánh Tây" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-white text-sm text-[#0f172a] placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#0284c7]/20 focus:border-[#0284c7] transition-all" />
                        </div>

                        <!-- Field 7: Mô tả chi tiết (Description) -->
                        <div class="sm:col-span-2 space-y-1.5">
                            <label class="block text-xs font-semibold uppercase tracking-wider text-[#0f172a]">
                                Ghi Chú / Mô Tả Kỹ Thuật 
                            </label>
                            <textarea @bind="UpdateFormModel.Description" rows="3" placeholder="Nhập thông số kỹ thuật, quy định sử dụng hoặc lịch bảo dưỡng định kỳ..." class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-white text-sm text-[#0f172a] placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#0284c7]/20 focus:border-[#0284c7] transition-all resize-none leading-relaxed"></textarea>
                        </div>
                    }

                </div>

                <!-- Modal Footer -->
                <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
                    <button @onclick="CloseDialog" class="px-5 py-2.5 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 text-slate-600 text-sm font-medium transition-all">
                        Hủy Bỏ
                    </button>
                    <button @onclick="SaveFacility" disabled="@IsSaving" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-[#0284c7] hover:bg-[#0369a1] active:scale-[0.99] text-white text-sm font-semibold shadow-sm transition-all disabled:opacity-60">
                        <span class="material-symbols-outlined text-lg">save</span>
                        <span>@(IsSaving ? "Đang lưu..." : "Lưu thông tin")</span>
                    </button>
                </div>

            </div>

        </div>
    </div>
}

<PropFlow.Web.Client.Features.Facility.Components.FacilityDetailDialog IsOpen="IsDetailOpen" Facility="SelectedFacilityToView" OnClose="() => IsDetailOpen = false" />

@code {
    private static readonly PropFlowSelectOption[] FacilityStatusOptions = [new("", "Tất cả trạng thái"), new("ACTIVE", "Đang hoạt động"), new("UNDER_MAINTENANCE", "Đang bảo trì"), new("UNAVAILABLE", "Tạm ngưng / Kín lịch"), new("INACTIVE", "Ngừng kích hoạt"), new("OUT_OF_SERVICE", "Ngừng phục vụ")];
    private static readonly PropFlowSelectOption[] FacilityTypeOptions = [new("", "Chọn phân loại"), new("Thể Thao & Giải Trí", "Thể Thao & Giải Trí"), new("Sức Khỏe & Fitness", "Sức Khỏe & Fitness"), new("Tiện Ích Chung", "Tiện Ích Chung"), new("Hạ Tầng Kỹ Thuật", "Hạ Tầng Kỹ Thuật"), new("An Ninh & PCCC", "An Ninh & PCCC"), new("Cảnh Quan & Môi Trường", "Cảnh Quan & Môi Trường")];
    private IReadOnlyList<PropFlowSelectOption> BuildingOptions => [new("", "Chọn tòa nhà"), .. Buildings.Select(building => new PropFlowSelectOption(building.Id.ToString(), building.Name))];
    private PagedResult<FacilityModel> PagedResult { get; set; } = new();
    private FacilityFilterModel Filter { get; set; } = new();
    private List<BuildingModel> Buildings { get; set; } = new();
    private bool IsLoading { get; set; } = true;
    private bool IsFormOpen { get; set; }
    private bool IsSaving { get; set; }
    private string? SuccessMessage { get; set; }
    private string? ErrorMessage { get; set; }
    private FacilityModel? SelectedFacilityToEdit { get; set; }
    private CreateFacilityModel CreateFormModel { get; set; } = new();
    private UpdateFacilityModel UpdateFormModel { get; set; } = new();
    private Guid? OpenStatusDropdownId { get; set; }
    
    private bool IsDetailOpen { get; set; }
    private FacilityModel? SelectedFacilityToView { get; set; }

    private string StatusFilterString
    {
        get => Filter.Status?.ToString() ?? "";
        set
        {
            Filter.Status = Enum.TryParse<MasterDataStatus>(value, out var s) ? s : null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        var buildingsResult = await BuildingApiClient.GetBuildingsAsync(new BuildingFilterModel { PageSize = 200 });
        if (buildingsResult.IsSuccess) Buildings = buildingsResult.Data?.Items?.ToList() ?? new();
        else ErrorMessage = buildingsResult.Message ?? "Không thể tải danh sách tòa nhà.";
    }

    private async Task LoadData()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            var result = await FacilityApiClient.GetFacilitiesAsync(Filter);
            if (result.IsSuccess && result.Data != null) PagedResult = result.Data;
            else ErrorMessage = result.Message ?? "Không thể tải cơ sở vật chất.";
        }
        finally { IsLoading = false; }
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ApplyFilter();
    }

    private async Task ApplyFilter() { Filter.PageIndex = 1; await LoadData(); }
    private async Task ResetFilter() { Filter = new(); await LoadData(); }
    private async Task ChangePage(int p) { if (p >= 1 && p <= PagedResult.TotalPages) { Filter.PageIndex = p; await LoadData(); } }

    private void OpenCreateDialog()
    {
        SelectedFacilityToEdit = null;
        CreateFormModel = new CreateFacilityModel();
        IsFormOpen = true;
    }

    private void OpenDetailDialog(FacilityModel item)
    {
        SelectedFacilityToView = item;
        IsDetailOpen = true;
    }

    private void OpenEditDialog(FacilityModel item)
    {
        SelectedFacilityToEdit = item;
        UpdateFormModel = new UpdateFacilityModel
        {
            BuildingId = item.BuildingId,
            Name = item.Name,
            FacilityType = item.FacilityType,
            LocationDescription = item.LocationDescription,
            Description = item.Description,
            Status = item.Status
        };
        IsFormOpen = true;
    }

    private void CloseDialog() { IsFormOpen = false; IsSaving = false; }

    private async Task SaveFacility()
    {
        IsSaving = true;
        ErrorMessage = null;
        try
        {
            var result = SelectedFacilityToEdit == null
                ? await FacilityApiClient.CreateFacilityAsync(CreateFormModel)
                : await FacilityApiClient.UpdateFacilityAsync(SelectedFacilityToEdit.Id, UpdateFormModel);
            if (!result.IsSuccess) { ErrorMessage = result.Message ?? "Không thể lưu cơ sở vật chất."; return; }
            var name = SelectedFacilityToEdit == null ? CreateFormModel.Name : UpdateFormModel.Name;
            CloseDialog();
            await LoadData();
            if (ErrorMessage == null) SuccessMessage = $"Đã lưu cơ sở vật chất '{name}' thành công!";
        }
        finally { IsSaving = false; }
    }

    private void ToggleStatusDropdown(Guid id)
    {
        OpenStatusDropdownId = OpenStatusDropdownId == id ? null : id;
    }

    private async Task ChangeStatus(FacilityModel item, MasterDataStatus newStatus)
    {
        OpenStatusDropdownId = null;
        ErrorMessage = null; SuccessMessage = null;
        var result = await FacilityApiClient.SetFacilityStatusAsync(item.Id, newStatus);
        if (!result.IsSuccess) { ErrorMessage = result.Message; return; }
        await LoadData();
        if (ErrorMessage == null) SuccessMessage = $"Đã đổi trạng thái thành công '{item.Name}'.";
    }

    private async Task ToggleStatus(FacilityModel item, MasterDataStatus targetStatus)
    {
        ErrorMessage = null; SuccessMessage = null;
        var actionText = targetStatus == MasterDataStatus.ACTIVE ? "kích hoạt" : "vô hiệu hóa";
        var result = await FacilityApiClient.SetFacilityStatusAsync(item.Id, targetStatus);
        if (!result.IsSuccess) { ErrorMessage = result.Message; return; }
        await LoadData();
        if (ErrorMessage == null) SuccessMessage = $"Đã {actionText} thành công '{item.Name}'.";
    }
    private string BuildingIdString
{
    get => CreateFormModel.BuildingId == Guid.Empty ? "" : CreateFormModel.BuildingId.ToString();
    set => CreateFormModel.BuildingId = Guid.TryParse(value, out var g) ? g : Guid.Empty;
}

private string UpdateBuildingIdString
{
    get => UpdateFormModel.BuildingId == Guid.Empty ? "" : UpdateFormModel.BuildingId.ToString();
    set => UpdateFormModel.BuildingId = Guid.TryParse(value, out var g) ? g : Guid.Empty;
}
}
