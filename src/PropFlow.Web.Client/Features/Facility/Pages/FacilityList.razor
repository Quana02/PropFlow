@using PropFlow.Web.Client.Shared.Management
@inject PropFlow.Web.Client.Shared.Feedback.ToastService Toasts
@page "/facilities"
@layout PropFlow.Web.Client.Layout.MainLayout
@attribute [Authorize(Roles = "MANAGER,STAFF", Policy = AssetPermissions.ViewPolicy)]
@using PropFlow.Web.Client.Features.Facility.Models
@using PropFlow.Web.Client.Features.Facility.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.SignalR.Client
@using PropFlow.Web.Client.Features.Maintenance.Services
@using System.ComponentModel.DataAnnotations
@inject IFacilityApiClient FacilityApiClient
@inject IBuildingApiClient BuildingApiClient
@inject NavigationManager Navigation
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject MaintenanceHubConnectionFactory MaintenanceHubConnectionFactory
@using PropFlow.Web.Client.Shared.Forms
@using PropFlow.Web.Client.Shared.Feedback
@implements IAsyncDisposable

<PageTitle>Quản Lý Cơ Sở Vật Chất - PropFlow</PageTitle>
@if (!IsManager)
{
    <p class="text-sm text-slate-600" role="note">Chỉ đọc · Thông tin và số lượng tài sản trong phạm vi công việc đang được phân công.</p>
}

<div class="fe04-page font-sans text-slate-800 antialiased"
     aria-hidden="@(IsFacilityTypeDialogOpen ? "true" : null)"
     inert="@(IsFacilityTypeDialogOpen ? "inert" : null)">

    <ManagementPageHeader Icon="pool"
                          Title="Danh mục cơ sở vật chất"
                          Description="Quản lý danh sách, vòng đời sử dụng và trạng thái vận hành của các tiện ích công cộng chung cư.">
        <Actions>
            @if (IsManager)
            {
                <button type="button" class="pf-management-primary" @onclick="OpenCreateDialog">
                    <span class="material-symbols-outlined" aria-hidden="true">add</span>
                    Thêm Cơ Sở Vật Chất
                </button>
            }
        </Actions>
    </ManagementPageHeader>

    <section class="pf-management-metrics" aria-label="Tổng quan">
        <ManagementKpi Icon="domain" Label="Tổng CSVT" Value="@((FacilitySummary?.Total ?? 0).ToString())" />
        <ManagementKpi Icon="check_circle" Label="Đang hoạt động" Value="@((FacilitySummary?.Active ?? 0).ToString())" Tone="success" />
        <ManagementKpi Icon="engineering" Label="Đang bảo trì" Value="@((FacilitySummary?.UnderMaintenance ?? 0).ToString())" Tone="warning" />
        <ManagementKpi Icon="do_not_disturb_on" Label="Tạm ngưng" Value="@((FacilitySummary?.Unavailable ?? 0).ToString())" Tone="neutral" />
        <ManagementKpi Icon="cancel" Label="Ngừng phục vụ" Value="@((FacilitySummary?.OutOfService ?? 0).ToString())" Tone="danger" />
    </section>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="flex items-center gap-3 px-4 py-3 mb-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm font-medium shadow-sm">
            <span class="material-symbols-outlined text-rose-500 text-[20px]">error</span>
            <span>@ErrorMessage</span>
            <button class="ml-auto text-rose-500 hover:text-rose-700 transition-stitch" @onclick="() => ErrorMessage = null">
                <span class="material-symbols-outlined text-[18px]">close</span>
            </button>
        </div>
    }

    <!-- Main Table Container Card -->
    <div class="fe04-panel pf-list-panel pf-management-list" aria-busy="@IsLoading">

        <!-- Table Toolbar (Search, Filter, Actions) -->
        <div class="pf-list-toolbar pf-management-toolbar">

            <!-- Left: Search Box & Status quick filter -->
            <div class="pf-management-tools">
                <label class="pf-list-search pf-management-search">
                    <span class="material-symbols-outlined" aria-hidden="true">search</span>
                    <input type="search" aria-label="Tìm cơ sở vật chất"
                           placeholder="Tìm theo Mã CSVT, Tên cơ sở vật chất, Vị trí..."
                           @bind="Filter.SearchKeyword" @bind:event="oninput" @onkeyup="HandleSearchKeyUp" />
                </label>

                <PropFlowFilterPopover ActiveCount="@ActiveFilterCount" Disabled="@IsLoading" OnOpen="OpenFilters"
                                     OnReset="ResetDraft" OnApply="ApplyDraft">
                    <label>Trạng thái<PropFlowSelect Options="StatusOptions" @bind-Value="StatusFilterString" Variant="Filter" AriaLabel="Trạng thái" /></label>
                    <label>Loại cơ sở vật chất<PropFlowSelect Options="FacilityTypeFilterOptions" @bind-Value="FacilityTypeFilterString" Variant="Filter" AriaLabel="Loại cơ sở vật chất" /></label>
                </PropFlowFilterPopover>
            </div>

            <!-- Right: Filter actions & View counts -->
            <div class="pf-management-tools pf-management-toolbar-end">
                <span class="pf-management-count">Hiển thị <b class="text-[#0f172a]">@(PagedResult.Items?.Count ?? 0)</b> / @PagedResult.TotalCount hạng mục</span>
                <PropFlowListRefresh OnRefresh="() => Task.WhenAll(LoadData(), LoadSummaryAsync())" Busy="@IsLoading" />
            </div>

        </div>

        <!-- Loading State Overlay -->
        @if (IsLoading)
        {
            <div class="pf-management-empty" role="status">
                <div class="w-8 h-8 border-3 border-sky-200 border-t-[#0284c7] rounded-full animate-spin"></div>
                <p class="text-xs font-semibold text-[#0284c7]">Đang tải dữ liệu Cơ sở vật chất...</p>
            </div>
        }
        else if (PagedResult.Items is null || (!PagedResult.Items.Any() &&
                 (PagedResult.TotalCount == 0 || PagedResult.PageIndex <= PagedResult.TotalPages)))
        {
            <div class="pf-management-empty">
                <span class="material-symbols-outlined" aria-hidden="true">domain_disabled</span>
                <p class="text-sm text-slate-500">Không có cơ sở vật chất nào</p>
                @if (IsManager)
                {
                    <button class="flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#0284c7] hover:bg-[#0369a1] text-white text-sm font-semibold shadow-sm transition-all" @onclick="OpenCreateDialog">
                        <span class="material-symbols-outlined text-lg">add_circle</span>
                        <span>Thêm mới ngay</span>
                    </button>
                }
            </div>
        }
        else
        {
            <!-- Data Table -->
            <div class="fe04-table-scroll overflow-x-auto @(OpenStatusDropdownId.HasValue ? "status-menu-open" : string.Empty)">
                <table class="pf-list-table w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-100 bg-slate-50/70 text-[11px] font-bold uppercase tracking-wider text-[#64748b]">
                            <th class="py-3.5 px-5">Mã CSVT</th>
                            <th class="py-3.5 px-4">Tên Cơ Sở Vật Chất</th>
                            <th class="py-3.5 px-4">Phân Loại</th>
                            <th class="py-3.5 px-4">Vị Trí Cụ Thể</th>
                            <th class="py-3.5 px-4 text-center">Trạng Thái </th>
                            <th class="py-3.5 px-5 text-right">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var item in PagedResult.Items)
                        {
                            <tr class="hover:bg-sky-50/40 transition-colors group @(OpenStatusDropdownId == item.Id ? "status-dropdown-row-open" : null)">
                                <td class="py-4 px-5">
                                    <span class="pf-management-identifier">
                                        @item.Code
                                    </span>
                                </td>
                                <td class="py-4 px-4">
                                    <div class="font-semibold text-[#0f172a] group-hover:text-[#0284c7] transition-colors">
                                        @item.Name
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        <div class="pf-management-cell-detail line-clamp-1">@item.Description</div>
                                    }
                                </td>
                                <td class="py-4 px-4">
                                    <span class="font-medium text-slate-600 bg-blue-50/70 text-blue-700 px-2 py-0.5 rounded border border-blue-100">
                                        @(string.IsNullOrEmpty(item.FacilityType) ? "-" : item.FacilityType)
                                    </span>
                                </td>
                                <td class="py-4 px-4 text-slate-600">
                                    <div class="flex items-center gap-1">
                                        <span class="material-symbols-outlined text-xs text-slate-400">pin_drop</span>
                                        @(string.IsNullOrEmpty(item.LocationDescription) ? "-" : item.LocationDescription)
                                    </div>
                                </td>
                                <td class="py-4 px-4 text-center">
                                    @switch (item.Status)
                                    {
                                        case MasterDataStatus.ACTIVE:
                                            <span class="pf-management-status" data-tone="success">
                                                Đang hoạt động
                                            </span>
                                            break;
                                        case MasterDataStatus.INACTIVE:
                                            <span class="pf-management-status" data-tone="neutral">
                                                Ngừng kích hoạt
                                            </span>
                                            break;
                                        case MasterDataStatus.UNDER_MAINTENANCE:
                                            <span class="pf-management-status" data-tone="warning">
                                                Đang bảo trì
                                            </span>
                                            break;
                                        case MasterDataStatus.UNAVAILABLE:
                                            <span class="pf-management-status" data-tone="neutral">
                                                Tạm ngưng
                                            </span>
                                            break;
                                        case MasterDataStatus.OUT_OF_SERVICE:
                                            <span class="pf-management-status" data-tone="danger">
                                                Ngừng phục vụ
                                            </span>
                                            break;
                                    }
                                </td>
                                <td class="py-4 px-5 text-right">
                                    <div class="inline-flex items-center gap-1.5 justify-end">
                                        <!-- Xem chi tiết -->
                                        <button @onclick="() => OpenDetailDialog(item)" class="pf-management-row-action" title="Xem chi tiết" aria-label="Xem chi tiết">
                                            <span class="material-symbols-outlined text-lg">visibility</span>
                                        </button>
                                        @if (IsManager)
                                        {
                                            <!-- Sửa -->
                                            <button @onclick="() => OpenEditDialog(item)" class="pf-management-row-action" data-tone="warning" title="Chỉnh sửa" aria-label="Chỉnh sửa">
                                                <span class="material-symbols-outlined text-lg">edit</span>
                                            </button>
                                            <!-- Đổi trạng thái Dropdown -->
                                            <div class="relative inline-block text-left status-dropdown-container @(OpenStatusDropdownId == item.Id ? "is-open" : null)">
                                            <button @onclick="() => ToggleStatusDropdown(item.Id)"
                                                    class="pf-management-row-action"
                                                    title="Đổi trạng thái" aria-label="Đổi trạng thái"
                                                    aria-haspopup="menu"
                                                    aria-expanded="@(OpenStatusDropdownId == item.Id)">
                                                <span class="material-symbols-outlined text-lg">sync_saved_locally</span>
                                            </button>
                                            @if (OpenStatusDropdownId == item.Id)
                                            {
                                                <div class="status-dropdown-menu absolute right-0 mt-1 w-52 bg-white rounded-xl shadow-xl border border-slate-200 py-1.5 text-left text-xs divide-y divide-slate-100 animate-in fade-in zoom-in-95 duration-150"
                                                     role="menu">
                                                    <div class="px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-slate-400">Chọn trạng thái mới</div>
                                                    <div class="py-1">
                                                        <button @onclick="() => ChangeStatus(item, MasterDataStatus.ACTIVE)" class="w-full flex items-center gap-2 px-3 py-1.5 hover:bg-emerald-50 text-emerald-700 font-medium transition-colors">
                                                            <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Đang hoạt động
                                                        </button>
                                                        <button @onclick="() => ChangeStatus(item, MasterDataStatus.UNAVAILABLE)" class="w-full flex items-center gap-2 px-3 py-1.5 hover:bg-slate-50 text-slate-700 font-medium transition-colors">
                                                            <span class="w-2 h-2 rounded-full bg-indigo-500"></span> Tạm ngưng
                                                        </button>
                                                        <button @onclick="() => ChangeStatus(item, MasterDataStatus.INACTIVE)" class="w-full flex items-center gap-2 px-3 py-1.5 hover:bg-slate-100 text-slate-700 font-medium transition-colors">
                                                            <span class="w-2 h-2 rounded-full bg-slate-400"></span> Ngừng kích hoạt
                                                        </button>
                                                        <button @onclick="() => ChangeStatus(item, MasterDataStatus.OUT_OF_SERVICE)" class="w-full flex items-center gap-2 px-3 py-1.5 hover:bg-rose-50 text-rose-700 font-medium transition-colors">
                                                            <span class="w-2 h-2 rounded-full bg-rose-500"></span> Ngừng phục vụ
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <TablePagination Page="PagedResult.PageIndex" TotalPages="PagedResult.TotalPages" Busy="IsLoading" Label="Phân trang cơ sở vật chất"
                PageChanged="ChangePage">
                <span>Bản ghi @(((PagedResult.PageIndex - 1) * PagedResult.PageSize) + 1)–@(Math.Min(PagedResult.PageIndex * PagedResult.PageSize, PagedResult.TotalCount)) / @PagedResult.TotalCount</span>
            </TablePagination>
                    }
    </div>

    <!-- Quick Legend for Status Colors -->
    <div class="fe04-legend bg-white rounded-2xl p-5 border border-slate-200/80 shadow-2xs flex flex-wrap items-center justify-between gap-4 mt-6">
        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-slate-400 text-lg">palette</span>
            <span class="text-xs font-bold font-display uppercase tracking-wider text-[#64748b]">Quy chuẩn nhãn trạng thái:</span>
        </div>
        <div class="flex flex-wrap items-center gap-3 text-xs font-medium">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Đang hoạt động
            </span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-50 text-amber-700 border border-amber-200">
                <span class="w-2 h-2 rounded-full bg-amber-500"></span> Đang bảo trì
            </span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200">
                <span class="w-2 h-2 rounded-full bg-indigo-500"></span> Tạm ngưng
            </span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 border border-slate-200">
                <span class="w-2 h-2 rounded-full bg-slate-400"></span> Ngừng kích hoạt
            </span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-rose-50 text-rose-700 border border-rose-200">
                <span class="w-2 h-2 rounded-full bg-rose-500"></span> Ngừng phục vụ
            </span>
        </div>
    </div>
</div>

@if (IsManager && IsFormOpen)
{
    <div class="fe04-modal-backdrop fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 bg-slate-900/60 backdrop-blur-sm transition-opacity">
        <div class="fe04-modal relative w-full max-w-2xl bg-white rounded-2xl shadow-2xl border border-slate-200/80 overflow-hidden font-sans text-[#0f172a] animate-in fade-in zoom-in duration-200"
             role="dialog"
             aria-modal="@(!IsFacilityTypeDialogOpen)"
             aria-hidden="@(IsFacilityTypeDialogOpen ? "true" : null)"
             inert="@(IsFacilityTypeDialogOpen ? "inert" : null)">

            <!-- Modal Header -->
            <div class="px-6 py-4.5 border-b border-slate-100 flex items-center justify-between bg-slate-50/70">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-sky-100/70 text-[#0284c7] flex items-center justify-center shadow-2xs">
                        <span class="material-symbols-outlined text-2xl">edit_square</span>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold font-display tracking-tight text-[#0f172a]">
                            @(SelectedFacilityToEdit == null ? "Thêm Cơ Sở Vật Chất Mới" : "Cập Nhật Cơ Sở Vật Chất")
                        </h3>
                        <p class="text-xs text-[#64748b]">Cấu hình hạ tầng tiện ích và phân bổ tòa nhà </p>
                    </div>
                </div>

            </div>

            <!-- Modal Body (Form Grid) -->
            <div class="p-6 space-y-4 max-h-[75vh] overflow-y-auto">
                @if (ErrorMessage != null) { <p class="text-rose-700 bg-rose-50 p-3 rounded-lg" role="alert">@ErrorMessage</p> }
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

                    @if (SelectedFacilityToEdit == null)
                    {
                        <div class="sm:col-span-2 rounded-lg border border-sky-100 bg-sky-50 px-3 py-2 text-xs text-sky-800">Mã sẽ được hệ thống tự động tạo khi lưu.</div>
                        <!-- Field 1: Tên CSVT (Required) -->
                        <div class="space-y-1.5">
                            <label class="block text-xs font-semibold uppercase tracking-wider text-[#0f172a]">
                                Tên Cơ Sở Vật Chất <span class="text-rose-500">*</span>
                            </label>
                            <input @bind="CreateFormModel.Name" type="text" placeholder="VD: Khu vui chơi trẻ em KidZone" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-white text-sm text-[#0f172a] placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#0284c7]/20 focus:border-[#0284c7] transition-all" />
                        </div>

                        <!-- Field 2: Loại CSVT (FacilityType) -->
                        <div class="space-y-1.5">
                            <label class="block text-xs font-semibold uppercase tracking-wider text-[#0f172a]">
                                Loại Cơ Sở Vật Chất
                            </label>
                            <div class="flex gap-2">
                                <div class="flex-1 fe04-light-select"><PropFlowSelect Options="FacilityTypeCreateOptions" @bind-Value="CreateFacilityTypeId" /></div>
                                <button type="button" class="px-3 rounded-xl border border-sky-300 text-sky-700 text-xs font-bold" @ref="FacilityTypeTrigger" @onclick="OpenFacilityTypeDialog">+ Thêm loại</button>
                            </div>
                        </div>

                        <!-- Field 3: Vị trí -->
                        <div class="space-y-1.5">
                            <label class="block text-xs font-semibold uppercase tracking-wider text-[#0f172a]">
                                Vị trí <span class="text-rose-500">*</span>
                            </label>
                            <input @bind="CreateFormModel.LocationDescription" type="text" placeholder="VD: Tầng 1, khu vực A" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-white text-sm text-[#0f172a] placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#0284c7]/20 focus:border-[#0284c7] transition-all" />
                        </div>

                        <!-- Field 5: Mô tả -->
                        <div class="space-y-1.5 sm:col-span-2">
                            <label class="block text-xs font-semibold uppercase tracking-wider text-[#0f172a]">
                                Mô tả
                            </label>
                            <textarea @bind="CreateFormModel.Description" rows="3" placeholder="Mô tả chi tiết về cơ sở vật chất" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-white text-sm text-[#0f172a] placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#0284c7]/20 focus:border-[#0284c7] transition-all resize-none"></textarea>
                        </div>
                    }
                    else
                    {
                        <!-- Edit Mode-->
                        <!-- Field 1: Mã CSVT (Readonly) -->
                        <div class="space-y-1.5">
                            <label class="block text-xs font-semibold uppercase tracking-wider text-[#0f172a]">
                                Mã Cơ Sở Vật Chất <span class="text-rose-500">*</span>
                            </label>
                            <div class="relative">
                                <input value="@SelectedFacilityToEdit.Code" disabled class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-sm text-slate-500 placeholder-slate-400 focus:outline-none transition-all font-mono cursor-not-allowed" />
                            </div>
                        </div>

                        <!-- Field 2: Tên CSVT (Required) -->
                        <div class="space-y-1.5">
                            <label class="block text-xs font-semibold uppercase tracking-wider text-[#0f172a]">
                                Tên Cơ Sở Vật Chất <span class="text-rose-500">*</span>
                            </label>
                            <input @bind="UpdateFormModel.Name" type="text" placeholder="VD: Khu vui chơi trẻ em KidZone" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-white text-sm text-[#0f172a] placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#0284c7]/20 focus:border-[#0284c7] transition-all" />
                        </div>

                        <!-- Field 3: Loại CSVT (FacilityType) -->
                        <div class="space-y-1.5">
                            <label class="block text-xs font-semibold uppercase tracking-wider text-[#0f172a]">
                                Loại Cơ Sở Vật Chất
                            </label>
                            <div class="flex gap-2">
                                <div class="flex-1 fe04-light-select"><PropFlowSelect Options="FacilityTypeCreateOptions" @bind-Value="UpdateFacilityTypeId" /></div>
                                <button type="button" class="px-3 rounded-xl border border-sky-300 text-sky-700 text-xs font-bold" @ref="FacilityTypeTrigger" @onclick="OpenFacilityTypeDialog">+ Thêm loại</button>
                            </div>
                        </div>

                        <!-- Field 4: Vị trí -->
                        <div class="space-y-1.5">
                            <label class="block text-xs font-semibold uppercase tracking-wider text-[#0f172a]">
                                Vị trí
                            </label>
                            <input @bind="UpdateFormModel.LocationDescription" type="text" placeholder="VD: Tầng 1, khu vực A" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-white text-sm text-[#0f172a] placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#0284c7]/20 focus:border-[#0284c7] transition-all" />
                        </div>

                        <!-- Field 5: Mô tả -->
                        <div class="space-y-1.5 sm:col-span-2">
                            <label class="block text-xs font-semibold uppercase tracking-wider text-[#0f172a]">
                                Mô tả
                            </label>
                            <textarea @bind="UpdateFormModel.Description" rows="3" placeholder="Mô tả chi tiết về cơ sở vật chất" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-white text-sm text-[#0f172a] placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#0284c7]/20 focus:border-[#0284c7] transition-all resize-none"></textarea>
                        </div>
                    }

                </div>

                <!-- Modal Footer -->
                <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
                    <button @onclick="CancelEditFeedbackCloseDialog" class="px-5 py-2.5 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 text-slate-600 text-sm font-medium transition-all">
                        Hủy Bỏ
                    </button>
                    <button @onclick="SaveFacility" disabled="@IsSaving" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-[#0284c7] hover:bg-[#0369a1] active:scale-[0.99] text-white text-sm font-semibold shadow-sm transition-all disabled:opacity-60">
                        <span class="material-symbols-outlined text-lg">save</span>
                        <span>@(IsSaving ? "Đang lưu..." : "Lưu thông tin")</span>
                    </button>
                </div>

            </div>

        </div>
    </div>
}

<PropFlow.Web.Client.Features.Facility.Components.FacilityDetailDialog IsOpen="IsDetailOpen" Facility="SelectedFacilityToView" OnClose="() => IsDetailOpen = false" />
@if (IsManager && IsFacilityTypeDialogOpen)
{
    <div class="fe04-nested-modal-backdrop fixed inset-0 flex items-center justify-center p-4" @onclick="CloseFacilityTypeDialog">
        <section class="fe04-nested-modal w-full max-w-md rounded-2xl bg-white p-6 shadow-2xl"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="facility-type-dialog-title"
                 @onclick:stopPropagation="true"
                 @onkeydown="HandleFacilityTypeDialogKeyDown"
                 @onkeydown:stopPropagation="true">
            <h3 id="facility-type-dialog-title" class="text-lg font-bold">Thêm loại cơ sở vật chất</h3>
            <label class="mt-4 block text-sm font-medium" for="facility-type-name">Tên loại</label>
            <input id="facility-type-name" @ref="FacilityTypeNameInput" class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2" @bind="NewFacilityType.Name" @onkeydown="HandleFacilityTypeNameKeyDown" />
            @if (!string.IsNullOrWhiteSpace(FacilityTypeDialogError)) { <p class="mt-2 text-sm text-rose-700" role="alert">@FacilityTypeDialogError</p> }
            <div class="mt-5 flex justify-end gap-2"><button type="button" class="px-4 py-2" @onclick="CloseFacilityTypeDialog">Hủy</button><button type="button" @ref="FacilityTypeSaveButton" disabled="@IsCreatingFacilityType" class="rounded-xl bg-sky-600 px-4 py-2 text-white" @onclick="CreateFacilityType" @onkeydown="HandleFacilityTypeSaveKeyDown">@(IsCreatingFacilityType ? "Đang lưu..." : "Lưu")</button></div>
        </section>
    </div>
}
@if (IsSaveConfirmationOpen)
{
    <PropFlowConfirmationDialog Title="@(SelectedFacilityToEdit is null ? "Thêm cơ sở vật chất?" : "Cập nhật cơ sở vật chất?")" Message="Thông tin đã nhập sẽ được lưu vào danh mục cơ sở vật chất của chung cư." ConfirmText="Lưu cơ sở vật chất" Busy="@IsSaving" BusyText="Đang lưu…" OnConfirm="ConfirmSaveFacility" OnCancel="CloseSaveConfirmation" />
}

@code {
    private readonly PropFlow.Web.Client.Shared.Feedback.ToastLifetime editFeedback = new();
    private void CancelEditFeedbackCloseDialog() { CloseDialog(); if (!IsFormOpen) editFeedback.Invalidate(); }

    private readonly PropFlow.Web.Client.Shared.Feedback.ToastLifetime toastLifetime = new();

    private static readonly IReadOnlyList<PropFlowSelectOption> StatusOptions = [
        new("", "Tất cả trạng thái"),
        new("ACTIVE", "Đang hoạt động"),
        new("UNDER_MAINTENANCE", "Đang bảo trì"),
        new("UNAVAILABLE", "Tạm ngưng"),
        new("INACTIVE", "Ngừng hoạt động"),
        new("OUT_OF_SERVICE", "Ngừng phục vụ")
    ];

    private IReadOnlyList<PropFlowSelectOption> FacilityTypeFilterOptions => [new("", "Tất cả loại CSVT"), .. FacilityTypes.Select(x => new PropFlowSelectOption(x.Id.ToString(), x.Name))];
    private IReadOnlyList<PropFlowSelectOption> FacilityTypeCreateOptions => [new("", "Chọn loại cơ sở vật chất"), .. FacilityTypes.Where(x => x.IsActive).Select(x => new PropFlowSelectOption(x.Id.ToString(), x.Name))];

    private PagedResult<FacilityModel> PagedResult { get; set; } = new();
    private FacilitySummaryModel? FacilitySummary { get; set; }
    private FacilityFilterModel Filter { get; set; } = new();
    private bool IsLoading { get; set; } = true;
    private bool IsFormOpen { get; set; }
    private bool IsSaving { get; set; }
    private bool IsSaveConfirmationOpen { get; set; }
    private string? FacilityCodeError { get; set; }

    private string? ErrorMessage { get; set; }
    private FacilityModel? SelectedFacilityToEdit { get; set; }
    private CreateFacilityModel CreateFormModel { get; set; } = new();
    private UpdateFacilityModel UpdateFormModel { get; set; } = new();
    private Guid? OpenStatusDropdownId { get; set; }

    private bool IsDetailOpen { get; set; }
    private FacilityModel? SelectedFacilityToView { get; set; }

    private bool IsManager { get; set; }
    private IReadOnlyList<FacilityTypeModel> FacilityTypes { get; set; } = [];
    private bool IsFacilityTypeDialogOpen { get; set; }
    private bool IsCreatingFacilityType { get; set; }
    private string? FacilityTypeDialogError { get; set; }
    private CreateFacilityTypeModel NewFacilityType { get; set; } = new();
    private ElementReference FacilityTypeTrigger;
    private ElementReference FacilityTypeNameInput;
    private ElementReference FacilityTypeSaveButton;
    private bool FocusFacilityTypeNameInput;
    private bool RestoreFacilityTypeTriggerFocus;
    private readonly CancellationTokenSource StatusRefreshCancellation = new();
    private HubConnection? AssetStatusHub;

    private string StatusFilterString
    {
        get => draftFilter.Status?.ToString() ?? "";
        set
        {
            draftFilter.Status = Enum.TryParse<MasterDataStatus>(value, out var s) ? s : null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        IsManager = AssetPermissions.CanManage(user);
        await Task.WhenAll(LoadData(), LoadSummaryAsync(), LoadFacilityTypesAsync());
        _ = ConnectAssetStatusHubAsync();
    }

    private async Task ConnectAssetStatusHubAsync()
    {
        HubConnection? hub = null;
        try
        {
            hub = MaintenanceHubConnectionFactory.Create();
            hub.On("AssetStatusChanged", () => RefreshAssetStatusForRealtimeAsync());
            hub.Reconnected += _ => InvokeAsync(async () =>
            {
                await hub.InvokeAsync("JoinAssetStatus", StatusRefreshCancellation.Token);
                await RefreshAssetStatusForRealtimeAsync();
            });
            await hub.StartAsync(StatusRefreshCancellation.Token);
            await hub.InvokeAsync("JoinAssetStatus", StatusRefreshCancellation.Token);
            AssetStatusHub = hub;
        }
        catch (OperationCanceledException) when (StatusRefreshCancellation.IsCancellationRequested) { }
        catch
        {
            // A realtime outage must not block the FE-04 page.
            if (AssetStatusHub is null && hub is not null) await hub.DisposeAsync();
        }
    }

    private Task RefreshAssetStatusForRealtimeAsync() => InvokeAsync(async () =>
    {
        if (StatusRefreshCancellation.IsCancellationRequested || IsFormOpen || IsSaving || IsLoading) return;
        if (IsDetailOpen)
            await RefreshDetailAsync(StatusRefreshCancellation.Token);
        else
            await Task.WhenAll(LoadData(), LoadSummaryAsync());
        if (!StatusRefreshCancellation.IsCancellationRequested) StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    { toastLifetime.Dispose();
        StatusRefreshCancellation.Cancel();
        if (AssetStatusHub is not null) await AssetStatusHub.DisposeAsync();
        StatusRefreshCancellation.Dispose();
    }

    private async Task RefreshDetailAsync(CancellationToken ct)
    {
        if (SelectedFacilityToView is null) return;
        var id = SelectedFacilityToView.Id;
        var result = await FacilityApiClient.GetFacilityByIdAsync(id, ct);
        // A response for a closed/replaced dialog must not reopen it or overwrite an edit.
        if (ct.IsCancellationRequested || !IsDetailOpen || IsFormOpen || SelectedFacilityToView?.Id != id) return;
        if (result.IsSuccess && result.Data is not null)
        {
            SelectedFacilityToView = result.Data;
        }
        else
        {
            IsDetailOpen = false;
            SelectedFacilityToView = null;
            // Refresh the underlying list too, so revoked assignments disappear there.
            await Task.WhenAll(LoadData(), LoadSummaryAsync());
            ErrorMessage = result.Message ?? "Không thể tải chi tiết tài sản.";
        }
    }

    private int listVersion;
    private async Task LoadData()
    {
        var version = ++listVersion;
        IsLoading = true;
        ErrorMessage = null;
        PagedResult = new();
        try
        {
            var result = await FacilityApiClient.GetFacilitiesAsync(Filter);
            if (version != listVersion) return;
            if (result.IsSuccess && result.Data != null) PagedResult = result.Data;
            else ErrorMessage = result.Message ?? "Không thể tải cơ sở vật chất.";
        }
        finally { if (version == listVersion) IsLoading = false; }
    }

    private async Task LoadSummaryAsync()
    {
        var result = await BuildingApiClient.GetCurrentBuildingOverviewAsync();
        FacilitySummary = result.IsSuccess ? result.Data?.Facilities : null;
    }

    private async Task LoadFacilityTypesAsync()
    {
        var result = await FacilityApiClient.GetFacilityTypesAsync(activeOnly: false);
        if (result.IsSuccess && result.Data is not null) FacilityTypes = result.Data;
        else ErrorMessage ??= result.Message ?? "Không thể tải loại cơ sở vật chất.";
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ApplyFilter();
    }

    private FacilityFilterModel draftFilter = new();
    private int ActiveFilterCount => new[] { Filter.Status is not null, Filter.FacilityTypeId is not null }.Count(active => active);
    private void OpenFilters() => draftFilter = new() { Status = Filter.Status, FacilityTypeId = Filter.FacilityTypeId };
    private void ResetDraft() => draftFilter = new();
    private async Task ApplyDraft()
    {
        if ((Filter.Status, Filter.FacilityTypeId) == (draftFilter.Status, draftFilter.FacilityTypeId)) return;
        (Filter.Status, Filter.FacilityTypeId) = (draftFilter.Status, draftFilter.FacilityTypeId);
        await ApplyFilter();
    }

    private async Task ApplyFilter() { Filter.PageIndex = 1; await LoadData(); }
    private async Task ChangePage(int p) { if (p >= 1 && p <= PagedResult.TotalPages) { Filter.PageIndex = p; await LoadData(); } }

    private void OpenCreateDialog()
    {
        if (!IsManager) return;
        ErrorMessage = null;

        SelectedFacilityToEdit = null;
        CreateFormModel = new CreateFacilityModel();
        IsFormOpen = true;
    }

    private async Task OpenDetailDialog(FacilityModel item)
    {
        IsDetailOpen = false;
        SelectedFacilityToView = null;
        var result = await FacilityApiClient.GetFacilityByIdAsync(item.Id);
        if (!result.IsSuccess || result.Data is null)
        {
            ErrorMessage = result.Message ?? "Không thể tải chi tiết tài sản.";
            return;
        }
        SelectedFacilityToView = result.Data;
        IsDetailOpen = true;
    }

    private void OpenEditDialog(FacilityModel item)
    {
        if (!IsManager) return;
        ErrorMessage = null;

        SelectedFacilityToEdit = item;
        UpdateFormModel = new UpdateFacilityModel
        {
            Name = item.Name,
            FacilityTypeId = item.FacilityTypeId,
            LocationDescription = item.LocationDescription,
            Description = item.Description
        };
        IsFormOpen = true;
    }

    private void CloseDialog() { IsFormOpen = false; IsSaving = false; }

    private void SaveFacility()
    {
        if (!IsManager) return;
        ErrorMessage = null;
        FacilityCodeError = null;
        var formModel = SelectedFacilityToEdit == null ? (object)CreateFormModel : UpdateFormModel;
        if (!TryValidate(formModel, out var validationMessage))
        {
            if (SelectedFacilityToEdit is null && validationMessage?.Contains("Mã cơ sở vật chất", StringComparison.Ordinal) == true)
                FacilityCodeError = validationMessage;
            else
                ErrorMessage = validationMessage;
            return;
        }
        IsSaveConfirmationOpen = true;
    }

    private void CloseSaveConfirmation()
    {
        if (!IsSaving) IsSaveConfirmationOpen = false;
    }

    private async Task ConfirmSaveFacility()
    {
        var operationFeedback = Toasts.BeginOperation(toastLifetime, editFeedback);

        if (!IsManager || !IsSaveConfirmationOpen) return;
        IsSaving = true;
        ErrorMessage = null;
        try
        {
            var result = SelectedFacilityToEdit == null
                ? await FacilityApiClient.CreateFacilityAsync(CreateFormModel)
                : await FacilityApiClient.UpdateFacilityAsync(SelectedFacilityToEdit.Id, UpdateFormModel);
            if (!result.IsSuccess) { if (result.ValidationErrors?.Count > 0) ErrorMessage = result.Message ?? "Không thể lưu cơ sở vật chất."; else operationFeedback.Publish(() => Toasts.Error(result.Message ?? "Không thể lưu cơ sở vật chất.")); return; }
            var name = SelectedFacilityToEdit == null ? CreateFormModel.Name : UpdateFormModel.Name;
            var generatedCode = SelectedFacilityToEdit is null ? result.Data?.Code : null;
            IsSaveConfirmationOpen = false;
            CloseDialog();
            await Task.WhenAll(LoadData(), LoadSummaryAsync());
            if (ErrorMessage == null) operationFeedback.Publish(() => Toasts.Success(generatedCode is null ? $"Đã lưu cơ sở vật chất '{name}' thành công!" : $"Đã tạo cơ sở vật chất '{name}' với mã {generatedCode}."));
        }
        finally { IsSaving = false; }
    }

    private static bool TryValidate(object model, out string? message)
    {
        var results = new List<ValidationResult>();
        var isValid = Validator.TryValidateObject(model, new ValidationContext(model), results, validateAllProperties: true);
        message = isValid ? null : results.FirstOrDefault()?.ErrorMessage ?? "Vui lòng kiểm tra thông tin đã nhập.";
        return isValid;
    }

    private void ToggleStatusDropdown(Guid id)
    {
        OpenStatusDropdownId = OpenStatusDropdownId == id ? null : id;
    }

    private async Task ChangeStatus(FacilityModel item, MasterDataStatus newStatus)
    {
        var operationFeedback = Toasts.BeginOperation(toastLifetime);

        if (!IsManager) return;
        OpenStatusDropdownId = null;
        ErrorMessage = null;
        var result = await FacilityApiClient.SetFacilityStatusAsync(item.Id, newStatus);
        if (!result.IsSuccess) { if (result.ValidationErrors?.Count > 0) ErrorMessage = result.Message; else operationFeedback.Publish(() => Toasts.Error(result.Message)); return; }
        await Task.WhenAll(LoadData(), LoadSummaryAsync());
        if (ErrorMessage == null) operationFeedback.Publish(() => Toasts.Success($"Đã đổi trạng thái thành công '{item.Name}'."));
    }

    private async Task ToggleStatus(FacilityModel item, MasterDataStatus targetStatus)
    {
        var operationFeedback = Toasts.BeginOperation(toastLifetime);

        if (!IsManager) return;
        ErrorMessage = null;
        var actionText = targetStatus == MasterDataStatus.ACTIVE ? "kích hoạt" : "vô hiệu hóa";
        var result = await FacilityApiClient.SetFacilityStatusAsync(item.Id, targetStatus);
        if (!result.IsSuccess) { if (result.ValidationErrors?.Count > 0) ErrorMessage = result.Message; else operationFeedback.Publish(() => Toasts.Error(result.Message)); return; }
        await Task.WhenAll(LoadData(), LoadSummaryAsync());
        if (ErrorMessage == null) operationFeedback.Publish(() => Toasts.Success($"Đã {actionText} thành công '{item.Name}'."));
    }

    private string FacilityTypeFilterString
    {
        get => draftFilter.FacilityTypeId?.ToString() ?? "";
        set => draftFilter.FacilityTypeId = Guid.TryParse(value, out var id) ? id : null;
    }

    private string CreateFacilityTypeId { get => CreateFormModel.FacilityTypeId?.ToString() ?? ""; set => CreateFormModel.FacilityTypeId = Guid.TryParse(value, out var id) ? id : null; }
    private string UpdateFacilityTypeId { get => UpdateFormModel.FacilityTypeId?.ToString() ?? ""; set => UpdateFormModel.FacilityTypeId = Guid.TryParse(value, out var id) ? id : null; }
    private void OpenFacilityTypeDialog()
    {
        if (!IsManager) return;
        NewFacilityType = new();
        FacilityTypeDialogError = null;
        FocusFacilityTypeNameInput = true;
        IsFacilityTypeDialogOpen = true;
    }

    private void CloseFacilityTypeDialog()
    {
        if (IsCreatingFacilityType) return;
        IsFacilityTypeDialogOpen = false;
        RestoreFacilityTypeTriggerFocus = true;
    }

    private Task HandleFacilityTypeDialogKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            CloseFacilityTypeDialog();
        return Task.CompletedTask;
    }

    private async Task HandleFacilityTypeNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Tab" && e.ShiftKey)
            await FacilityTypeSaveButton.FocusAsync();
    }

    private async Task HandleFacilityTypeSaveKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Tab" && !e.ShiftKey)
            await FacilityTypeNameInput.FocusAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (FocusFacilityTypeNameInput && IsFacilityTypeDialogOpen)
        {
            FocusFacilityTypeNameInput = false;
            await FacilityTypeNameInput.FocusAsync();
        }

        if (RestoreFacilityTypeTriggerFocus && !IsFacilityTypeDialogOpen)
        {
            RestoreFacilityTypeTriggerFocus = false;
            await FacilityTypeTrigger.FocusAsync();
        }
    }

    private async Task CreateFacilityType()
    {
        var operationFeedback = Toasts.BeginOperation(toastLifetime);

        if (!IsManager) return;
        if (!TryValidate(NewFacilityType, out var error)) { FacilityTypeDialogError = error; return; }
        IsCreatingFacilityType = true; FacilityTypeDialogError = null;
        try { var result = await FacilityApiClient.CreateFacilityTypeAsync(NewFacilityType); if (!result.IsSuccess || result.Data is null) { if (result.ValidationErrors?.Count > 0) FacilityTypeDialogError = result.Message ?? "Không thể tạo loại cơ sở vật chất."; else operationFeedback.Publish(() => Toasts.Error(result.Message ?? "Không thể tạo loại cơ sở vật chất.")); return; } FacilityTypes = FacilityTypes.Append(result.Data).OrderBy(x => x.Name).ToArray(); if (SelectedFacilityToEdit is null) CreateFormModel.FacilityTypeId = result.Data.Id; else UpdateFormModel.FacilityTypeId = result.Data.Id; IsFacilityTypeDialogOpen = false; RestoreFacilityTypeTriggerFocus = true; operationFeedback.Publish(() => Toasts.Success("Đã tạo loại cơ sở vật chất.")); }
        finally { IsCreatingFacilityType = false; }
    }
}
