@page "/buildings/{Id:guid}"
@using PropFlow.Web.Client.Features.Facility.Models
@using PropFlow.Web.Client.Features.Facility.Services
@using PropFlow.Web.Client.Features.Facility.Components
@inject IBuildingApiClient BuildingApiClient
@inject NavigationManager NavigationManager

<PageTitle>Chi Tiết Tòa Nhà - PropFlow</PageTitle>

<div class="container-fluid py-4 px-4">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
                <a href="buildings" class="text-decoration-none text-primary"><i class="bi bi-buildings me-1"></i> Danh Sách Tòa Nhà</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                @(Building != null ? Building.Name : "Chi Tiết Tòa Nhà")
            </li>
        </ol>
    </nav>

    @if (IsLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Đang tải...</span>
            </div>
            <p class="mt-3 text-muted fw-semibold">Đang tải thông tin chi tiết tòa nhà...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger shadow-sm rounded-4 p-4 text-center">
            <i class="bi bi-exclamation-triangle-fill display-4 text-danger mb-3 d-block"></i>
            <h5 class="fw-bold">Không thể tải dữ liệu tòa nhà</h5>
            <p class="mb-3">@ErrorMessage</p>
            <a href="buildings" class="btn btn-outline-danger px-4 rounded-3"><i class="bi bi-arrow-left me-1"></i> Quay lại danh sách</a>
        </div>
    }
    else if (Building != null)
    {
        <!-- Page Header -->
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <div class="d-flex align-items-center">
                    <div class="rounded-4 bg-primary bg-opacity-10 p-3 text-primary me-3 fs-1">
                        <i class="bi bi-building"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h2 class="fw-bold text-dark mb-0">@Building.Name</h2>
                            <span class="badge bg-secondary">Mã: @Building.Code</span>
                            @if (Building.Status == MasterDataStatus.ACTIVE)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                    <i class="bi bi-check-circle-fill me-1"></i> Đang hoạt động
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1">
                                    <i class="bi bi-pause-circle-fill me-1"></i> Ngưng hoạt động
                                </span>
                            }
                        </div>
                        <p class="text-muted mb-0"><i class="bi bi-geo-alt-fill text-danger me-1"></i> @Building.Address</p>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-outline-primary rounded-3 px-3" @onclick="OpenEditDialog">
                        <i class="bi bi-pencil me-1"></i> Chỉnh Sửa
                    </button>
                    @if (Building.Status == MasterDataStatus.ACTIVE)
                    {
                        <button class="btn btn-outline-danger rounded-3 px-3" @onclick="() => ToggleStatus(MasterDataStatus.INACTIVE)">
                            <i class="bi bi-slash-circle me-1"></i> Vô hiệu hóa
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-outline-success rounded-3 px-3" @onclick="() => ToggleStatus(MasterDataStatus.ACTIVE)">
                            <i class="bi bi-arrow-repeat me-1"></i> Kích hoạt lại
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- Asset Statistics Overview Cards -->
        <div class="row g-4 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                    <div class="d-flex align-items-center">
                        <div class="rounded-3 bg-info bg-opacity-10 p-3 text-info me-3 fs-3">
                            <i class="bi bi-grid-fill"></i>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Tổng Tiện Ích (Facilities)</span>
                            <h3 class="fw-bold mb-0 text-dark">@Building.FacilityCount</h3>
                            <span class="text-success small fw-semibold">@Building.ActiveFacilityCount đang hoạt động</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                    <div class="d-flex align-items-center">
                        <div class="rounded-3 bg-warning bg-opacity-10 p-3 text-warning me-3 fs-3">
                            <i class="bi bi-tools"></i>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Tổng Thiết Bị (Equipment)</span>
                            <h3 class="fw-bold mb-0 text-dark">@Building.EquipmentCount</h3>
                            <span class="text-success small fw-semibold">@Building.ActiveEquipmentCount đang hoạt động</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                    <div class="d-flex align-items-center">
                        <div class="rounded-3 bg-success bg-opacity-10 p-3 text-success me-3 fs-3">
                            <i class="bi bi-layers-fill"></i>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Số Tầng Thiết Kế</span>
                            <h3 class="fw-bold mb-0 text-dark">@(Building.NumberOfFloors.HasValue ? $"{Building.NumberOfFloors}" : "-")</h3>
                            <span class="text-muted small">Tầng nổi & dịch vụ</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                    <div class="d-flex align-items-center">
                        <div class="rounded-3 bg-primary bg-opacity-10 p-3 text-primary me-3 fs-3">
                            <i class="bi bi-clock-fill"></i>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Múi Giờ Vận Hành</span>
                            <h4 class="fw-bold mb-0 text-dark">@Building.TimeZoneId</h4>
                            <span class="text-muted small">Múi giờ chuẩn IANA</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Master Data Details Card -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-info-circle me-2 text-primary"></i> Thông Tin Chi Tiết Hồ Sơ</h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <span class="text-muted d-block small mb-1">Mã Tòa Nhà</span>
                            <strong class="fs-6 text-dark">@Building.Code</strong>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <span class="text-muted d-block small mb-1">Tên Tòa Nhà</span>
                            <strong class="fs-6 text-dark">@Building.Name</strong>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="p-3 bg-light rounded-3">
                            <span class="text-muted d-block small mb-1">Địa Chỉ Đầy Đủ</span>
                            <strong class="fs-6 text-dark">@Building.Address</strong>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="p-3 bg-light rounded-3">
                            <span class="text-muted d-block small mb-1">Mô Tả / Ghi Chú Ban Quản Lý</span>
                            <p class="mb-0 text-dark">@(string.IsNullOrWhiteSpace(Building.Description) ? "Chưa có ghi chú mô tả." : Building.Description)</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <span class="text-muted d-block small mb-1">Thời Gian Khởi Tạo</span>
                            <span class="text-dark"><i class="bi bi-calendar-event me-1"></i> @Building.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <span class="text-muted d-block small mb-1">Thời Gian Cập Nhật Cuối</span>
                            <span class="text-dark"><i class="bi bi-calendar-check me-1"></i> @Building.UpdatedAt.ToString("dd/MM/yyyy HH:mm:ss")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Edit Form Dialog -->
<BuildingFormDialog IsOpen="IsEditFormOpen" BuildingToEdit="Building" OnSaved="LoadDetail" OnClose="() => IsEditFormOpen = false" />

@code {
    [Parameter] public Guid Id { get; set; }

    private BuildingDetailModel? Building { get; set; }
    private bool IsLoading { get; set; } = true;
    private string? ErrorMessage { get; set; }
    private bool IsEditFormOpen { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await LoadDetail();
    }

    private async Task LoadDetail()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            Building = await BuildingApiClient.GetBuildingDetailByIdAsync(Id);
            if (Building == null)
            {
                ErrorMessage = $"Không tìm thấy dữ liệu tòa nhà với ID '{Id}'.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void OpenEditDialog()
    {
        IsEditFormOpen = true;
    }

    private async Task ToggleStatus(MasterDataStatus targetStatus)
    {
        if (Building == null) return;

        try
        {
            await BuildingApiClient.SetBuildingStatusAsync(Building.Id, targetStatus);
            await LoadDetail();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }
}
