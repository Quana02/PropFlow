@code {
    private PagedResult<EquipmentModel> PagedResult { get; set; } = new();
    private EquipmentFilterModel Filter { get; set; } = new();
    private bool IsLoading { get; set; } = true;
    private bool IsFormOpen { get; set; }
    private bool IsDetailOpen { get; set; }
    private bool IsSaving { get; set; }
    private string? SuccessMessage { get; set; }
    private string? ErrorMessage { get; set; }
    private EquipmentModel? SelectedEquipmentToEdit { get; set; }
    private CreateEquipmentModel FormModel { get; set; } = new();
    private Guid? OpenStatusDropdownId { get; set; }

    private List<BuildingModel> BuildingList { get; set; } = new();
    private List<FacilityModel> FacilityList { get; set; } = new();

    private string StatusFilterString
    {
        get => Filter.Status?.ToString() ?? "";
        set
        {
            Filter.Status = Enum.TryParse<EquipmentStatus>(value, out var s) ? s : null;
        }
    }

    private string LocationFilterString
    {
        get => "";
        set
        {
            // TODO: Implement location filter logic
        }
    }

    private string StatusString
    {
        get => FormModel.Status.ToString();
        set
        {
            if (Enum.TryParse<EquipmentStatus>(value, out var s))
            {
                FormModel.Status = s;
            }
        }
    }

    private string BuildingIdString
    {
        get => FormModel.BuildingId == Guid.Empty ? "" : FormModel.BuildingId.ToString();
        set => FormModel.BuildingId = Guid.TryParse(value, out var g) ? g : Guid.Empty;
    }

    private string FacilityIdString
    {
        get => FormModel.FacilityId?.ToString() ?? "";
        set => FormModel.FacilityId = Guid.TryParse(value, out var g) ? g : null;
    }

    protected override async Task OnInitializedAsync()
    {
        var buildingResult = await BuildingApiClient.GetBuildingsAsync(new BuildingFilterModel { PageSize = 1000 });
        BuildingList = buildingResult.Items?.ToList() ?? new List<BuildingModel>();
        
        var facilityResult = await FacilityApiClient.GetFacilitiesAsync(new FacilityFilterModel { PageSize = 1000 });
        FacilityList = facilityResult.Items?.ToList() ?? new List<FacilityModel>();
        
        await LoadData();
    }

    private async Task LoadData()
    {
        IsLoading = true;
        ErrorMessage = null;
        try { PagedResult = await EquipmentApiClient.GetEquipmentsAsync(Filter); }
        catch (Exception ex) { ErrorMessage = $"Không thể tải dữ liệu: {ex.Message}"; }
        finally { IsLoading = false; }
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ApplyFilter();
    }

    private async Task ApplyFilter() { Filter.PageIndex = 1; await LoadData(); }
    private async Task ResetFilter() { Filter = new(); await LoadData(); }
    private async Task ChangePage(int p) { if (p >= 1 && p <= PagedResult.TotalPages) { Filter.PageIndex = p; await LoadData(); } }

    private void OpenCreateDialog()
    {
        SelectedEquipmentToEdit = null;
        FormModel = new CreateEquipmentModel();
        IsFormOpen = true;
    }

    private void OpenDetailDialog(EquipmentModel item)
    {
        SelectedEquipmentToEdit = item;
        IsDetailOpen = true;
    }

    private void OpenEditDialog(EquipmentModel item)
    {
        SelectedEquipmentToEdit = item;
        FormModel = new CreateEquipmentModel
        {
            BuildingId = item.BuildingId,
            Code = item.Code,
            Name = item.Name,
            FacilityId = item.FacilityId,
            EquipmentType = item.EquipmentType,
            Status = item.Status,
            Manufacturer = item.Manufacturer,
            Model = item.Model,
            SerialNumber = item.SerialNumber,
            InstallationDate = item.InstallationDate,
            WarrantyExpiryDate = item.WarrantyExpiryDate,
            LocationDescription = item.LocationDescription,
            Description = item.Description
        };
        IsFormOpen = true;
    }

    private void CloseDialog() { IsFormOpen = false; IsSaving = false; }

    private async Task SaveEquipment()
    {
        IsSaving = true;
        ErrorMessage = null;
        try
        {
            if (SelectedEquipmentToEdit == null)
            {
                await EquipmentApiClient.CreateEquipmentAsync(FormModel);
                SuccessMessage = $"Đã thêm mới thiết bị '{FormModel.Name}' thành công!";
            }
            else
            {
                var updateModel = new UpdateEquipmentModel
                {
                    Name = FormModel.Name,
                    FacilityId = FormModel.FacilityId,
                    EquipmentType = FormModel.EquipmentType,
                    Status = FormModel.Status,
                    Manufacturer = FormModel.Manufacturer,
                    Model = FormModel.Model,
                    SerialNumber = FormModel.SerialNumber,
                    InstallationDate = FormModel.InstallationDate,
                    WarrantyExpiryDate = FormModel.WarrantyExpiryDate,
                    LocationDescription = FormModel.LocationDescription,
                    Description = FormModel.Description
                };
                await EquipmentApiClient.UpdateEquipmentAsync(SelectedEquipmentToEdit.Id, updateModel);
                SuccessMessage = $"Đã cập nhật '{FormModel.Name}' thành công!";
            }
            CloseDialog();
            await LoadData();
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { IsSaving = false; }
    }

    private void ToggleStatusDropdown(Guid id)
    {
        OpenStatusDropdownId = OpenStatusDropdownId == id ? null : id;
    }

    private async Task ChangeStatus(EquipmentModel item, EquipmentStatus newStatus)
    {
        OpenStatusDropdownId = null;
        ErrorMessage = null; SuccessMessage = null;
        try
        {
            await EquipmentApiClient.SetEquipmentStatusAsync(item.Id, newStatus);
            SuccessMessage = $"Đã đổi trạng thái thành công '{item.Name}'.";
            await LoadData();
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
    }
}
