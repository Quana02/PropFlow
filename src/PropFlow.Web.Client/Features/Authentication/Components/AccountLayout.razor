@inherits LayoutComponentBase
@using PropFlow.Web.Client.Layout
@inject AuthSession Session
@inject NavigationManager Navigation

<LayoutView Layout="@WorkspaceLayout">
    <div class="@ContentClass">@Body</div>
</LayoutView>

@code {
    private Type WorkspaceLayout => Session.User?.Role switch
    {
        "ADMIN" => typeof(AdminLayout),
        "ACCOUNTANT" => typeof(AccountantLayout),
        "MANAGER" or "STAFF" => typeof(MainLayout),
        _ => typeof(AuthLayout)
    };
    private string ContentClass => !IsOverview ? "account-content" :
        WorkspaceLayout == typeof(AuthLayout) ? "account-overview public-overview" : "account-overview";
    private bool IsOverview => string.Equals(AccountPath, "account", StringComparison.OrdinalIgnoreCase);
    private string AccountPath => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
}
