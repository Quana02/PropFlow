@page "/account/change-password"
@layout PropFlow.Web.Client.Features.Authentication.Components.AuthLayout
@attribute [Authorize]
@inject AuthenticationService Auth
@inject NavigationManager Navigation
<PageTitle>Đổi mật khẩu — PropFlow</PageTitle><h2>Đổi mật khẩu</h2><p>Sau khi đổi mật khẩu, các phiên sẽ bị thu hồi và bạn cần đăng nhập lại.</p>
<ApiFeedback Result="result" />
<EditForm Model="form" OnValidSubmit="Submit"><DataAnnotationsValidator /><ValidationSummary />
    <label for="current-pass">Mật khẩu hiện tại</label>
    <div class="auth-field auth-field-has-toggle">
        <span class="material-symbols-outlined auth-field-icon" aria-hidden="true">key</span>
        <InputText id="current-pass" type="@(showCurrentPassword ? "text" : "password")" @bind-Value="form.CurrentPassword" autocomplete="current-password" placeholder="Nhập mật khẩu hiện tại" />
        <button type="button" class="auth-toggle-pass" aria-label="@(showCurrentPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")" title="@(showCurrentPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")" @onclick="() => showCurrentPassword = !showCurrentPassword">
            <span class="material-symbols-outlined" aria-hidden="true">@(showCurrentPassword ? "visibility_off" : "visibility")</span>
        </button>
    </div>
    <label for="change-pass">Mật khẩu mới (12–128 ký tự)</label>
    <div class="auth-field auth-field-has-toggle">
        <span class="material-symbols-outlined auth-field-icon" aria-hidden="true">lock</span>
        <InputText id="change-pass" type="@(showNewPassword ? "text" : "password")" @bind-Value="form.Password" autocomplete="new-password" placeholder="Nhập mật khẩu mới" />
        <button type="button" class="auth-toggle-pass" aria-label="@(showNewPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")" title="@(showNewPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")" @onclick="() => showNewPassword = !showNewPassword">
            <span class="material-symbols-outlined" aria-hidden="true">@(showNewPassword ? "visibility_off" : "visibility")</span>
        </button>
    </div>
    <label for="change-confirm">Xác nhận mật khẩu mới</label>
    <div class="auth-field auth-field-has-toggle">
        <span class="material-symbols-outlined auth-field-icon" aria-hidden="true">lock_reset</span>
        <InputText id="change-confirm" type="@(showConfirmPassword ? "text" : "password")" @bind-Value="form.Confirmation" autocomplete="new-password" placeholder="Nhập lại mật khẩu mới" />
        <button type="button" class="auth-toggle-pass" aria-label="@(showConfirmPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")" title="@(showConfirmPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")" @onclick="() => showConfirmPassword = !showConfirmPassword">
            <span class="material-symbols-outlined" aria-hidden="true">@(showConfirmPassword ? "visibility_off" : "visibility")</span>
        </button>
    </div>
    <button type="submit" disabled="@busy">@(busy ? "Đang đổi mật khẩu…" : "Đổi mật khẩu")</button>
</EditForm><nav class="auth-links"><a href="/account">Quay lại tài khoản</a></nav>
@code {
    private readonly ChangePasswordForm form = new(); private ApiResult? result; private bool busy;
    private bool showCurrentPassword; private bool showNewPassword; private bool showConfirmPassword;
    private async Task Submit() { if (busy) return; busy = true; try { result = await Auth.ChangePasswordAsync(new(form.CurrentPassword, form.Password)); if (result.IsSuccess) Navigation.NavigateTo("/login"); } finally { form.CurrentPassword = form.Password = form.Confirmation = ""; busy = false; } }
}
