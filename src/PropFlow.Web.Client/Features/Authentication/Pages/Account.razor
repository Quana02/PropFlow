@page "/account"
@layout PropFlow.Web.Client.Features.Authentication.Components.AccountLayout
@attribute [Authorize]
@inject AuthenticationService Auth
@inject AuthSession Session
@inject NavigationManager Navigation
@inject PropFlow.Web.Client.Shared.Feedback.ToastService Toasts
@implements IDisposable

<PageTitle>Tài khoản của tôi — PropFlow</PageTitle>
<div class="account-page">
    <header class="account-heading">
        <span class="account-eyebrow">CÀI ĐẶT TÀI KHOẢN</span>
        <h1>Tài khoản của tôi</h1>
        <p>Quản lý thông tin cá nhân và bảo mật tài khoản</p>
    </header>

    @if (loading)
    {
        <div class="account-state account-card" role="status" aria-live="polite">
            <span class="account-spinner" aria-hidden="true"></span><p>Đang tải thông tin tài khoản…</p>
        </div>
    }
    else if (account is not null)
    {
        <div class="account-grid">
            <aside class="account-sidebar" aria-label="Tổng quan tài khoản">
                <section class="account-card profile-overview" aria-labelledby="profile-display-name">
                    <div class="profile-avatar" aria-hidden="true">@Initials(account.DisplayName)</div>
                    <h2 id="profile-display-name">@account.DisplayName</h2>
                    <p class="profile-username">@@@account.Username</p>
                    <span class="account-badge role-badge"><span class="material-symbols-outlined" aria-hidden="true">verified_user</span>@RoleName(account.Role)</span>
                    <div class="profile-health">
                        <span class="account-badge @(account.Status == "ACTIVE" ? "positive-badge" : "neutral-badge")"><span class="status-dot" aria-hidden="true"></span>@StatusName(account.Status)</span>
                        <span class="account-badge @(account.EmailVerified ? "positive-badge" : "pending-badge")"><span class="material-symbols-outlined" aria-hidden="true">@(account.EmailVerified ? "check_circle" : "schedule")</span>@(account.EmailVerified ? "Email đã xác minh" : "Email chưa xác minh")</span>
                    </div>
                </section>

                <section class="account-card account-details" aria-labelledby="account-details-title">
                    <div class="card-heading"><span class="section-icon material-symbols-outlined" aria-hidden="true">badge</span><h2 id="account-details-title">Thông tin tài khoản</h2></div>
                    <dl class="account-information">
                        <div><dt>Tên đăng nhập</dt><dd>@account.Username</dd></div>
                        <div><dt>Địa chỉ email</dt><dd>@(account.Email ?? "Chưa cập nhật")</dd></div>
                        <div><dt>Vai trò</dt><dd>@RoleName(account.Role)</dd></div>
                        <div><dt>Trạng thái tài khoản</dt><dd>@StatusName(account.Status)</dd></div>
                        <div><dt>Xác minh email</dt><dd class="@(account.EmailVerified ? "verified-value" : "")">@(account.EmailVerified ? "Đã xác minh" : "Chưa xác minh")</dd></div>
                    </dl>
                    <p class="account-details-note"><span class="material-symbols-outlined" aria-hidden="true">info</span>Thông tin định danh và quyền truy cập của bạn.</p>
                </section>
            </aside>

            <div class="account-main">
                <section class="account-card personal-card" aria-labelledby="personal-title">
                    <header class="card-heading"><span class="section-icon material-symbols-outlined" aria-hidden="true">person</span><div><h2 id="personal-title">Thông tin cá nhân</h2><p>Cập nhật tên hiển thị và thông tin liên hệ của bạn.</p></div></header>
                    <EditForm EditContext="editContext" OnValidSubmit="Save">
                        <DataAnnotationsValidator />
                        <div class="personal-form-body">
                            <fieldset disabled="@busy">
                                <div class="account-field">
                                    <label for="profile-name">Tên hiển thị <span aria-hidden="true">*</span></label>
                                    <input id="profile-name" @bind="form.DisplayName" @bind:event="oninput" @bind:after="() => OnProfileEdited(nameof(ProfileForm.DisplayName))" class="@editContext.FieldCssClass(() => form.DisplayName)" autocomplete="name" aria-required="true" aria-describedby="profile-name-hint" />
                                    <ValidationMessage For="() => form.DisplayName" />
                                    <p id="profile-name-hint" class="field-hint">Tên được hiển thị trong hệ thống PropFlow.</p>
                                </div>
                                <div class="account-field">
                                    <label for="profile-phone">Số điện thoại liên hệ</label>
                                    <input id="profile-phone" type="tel" @bind="form.PhoneNumber" @bind:event="oninput" @bind:after="() => OnProfileEdited(nameof(ProfileForm.PhoneNumber))" class="@editContext.FieldCssClass(() => form.PhoneNumber)" autocomplete="tel" />
                                    <ValidationMessage For="() => form.PhoneNumber" />
                                </div>
                            </fieldset>
                            @if (account.Role == "RESIDENT") { <p class="field-hint resident-note">Thông tin cư dân và quan hệ căn hộ do ban quản lý quản lý, không thay đổi tại đây.</p> }
                        </div>
                        <footer class="form-footer">
                            <p>@(HasValidationErrors ? "Kiểm tra lại thông tin cần lưu." : HasChanges ? "Bạn có thay đổi chưa lưu." : "Chưa có thay đổi cần lưu.")</p>
                            <button type="submit" class="account-button primary-button" disabled="@(!CanSave)">
                                @if (busy) { <span class="account-spinner" aria-hidden="true"></span> }
                                else { <span class="material-symbols-outlined" aria-hidden="true">save</span> }
                                @(busy ? "Đang lưu…" : "Lưu thay đổi")
                            </button>
                        </footer>
                    </EditForm>
                </section>

                <section class="account-card security-card" aria-labelledby="security-title">
                    <header class="card-heading"><span class="section-icon material-symbols-outlined" aria-hidden="true">shield</span><div><h2 id="security-title">Bảo mật tài khoản</h2><p>Quản lý email và mật khẩu truy cập.</p></div></header>
                    <div class="security-action">
                        <span class="action-icon material-symbols-outlined" aria-hidden="true">alternate_email</span>
                        @if (account.Role == "RESIDENT")
                        {
                            <div class="security-copy"><h3>Email tài khoản</h3><p>Để thay đổi email đăng nhập, vui lòng liên hệ Ban quản lý chung cư.</p></div>
                        }
                        else
                        {
                            <div class="security-copy"><h3>Đổi địa chỉ email</h3><p>Xác nhận mật khẩu hiện tại và xác minh email mới để hoàn tất.</p></div>
                            <a class="account-button outline-button" href="/account/change-email">Đổi email<span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></a>
                        }
                    </div>
                    <div class="security-action">
                        <span class="action-icon material-symbols-outlined" aria-hidden="true">lock</span>
                        <div class="security-copy"><h3>Đổi mật khẩu</h3><p>Cập nhật mật khẩu để bảo vệ quyền truy cập tài khoản của bạn.</p></div>
                        <a class="account-button outline-button" href="/account/change-password">Đổi mật khẩu<span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></a>
                    </div>
                </section>
            </div>
        </div>
    }
    else
    {
        <div class="account-card account-state" role="alert">
            <span class="state-icon material-symbols-outlined" aria-hidden="true">cloud_off</span>
            <h2>Chưa tải được thông tin tài khoản</h2>
            <p>Vui lòng thử lại để xem thông tin mới nhất.</p>
            <button type="button" class="account-button outline-button" @onclick="Load"><span class="material-symbols-outlined" aria-hidden="true">refresh</span>Thử tải lại</button>
        </div>
    }

    <footer class="account-session-footer">
        <div><span class="material-symbols-outlined" aria-hidden="true">devices</span><p>Đăng xuất khỏi phiên làm việc trên thiết bị này.</p></div>
        <button type="button" class="account-button logout-button" disabled="@busy" @onclick="Logout"><span class="material-symbols-outlined" aria-hidden="true">logout</span>Đăng xuất</button>
    </footer>
</div>

@code {
    private readonly PropFlow.Web.Client.Shared.Feedback.ToastLifetime toastLifetime = new();

    private readonly ProfileForm form = new();
    private EditContext editContext = default!;
    private ApiValidationMessages serverValidation = default!;
    private AccountResponse? account;
    private bool busy, disposed, loading = true;
    private bool HasChanges => account is not null &&
        (form.DisplayName.Trim() != account.DisplayName.Trim() || (form.PhoneNumber?.Trim() ?? "") != (account.PhoneNumber?.Trim() ?? ""));
    private bool HasValidationErrors => editContext.GetValidationMessages().Any();
    private bool CanSave => !busy && HasChanges && !HasValidationErrors;

    protected override Task OnInitializedAsync()
    {
        editContext = new(form);
        serverValidation = new(editContext, ("DisplayName", nameof(form.DisplayName)), ("PhoneNumber", nameof(form.PhoneNumber)));
        return Load();
    }

    private async Task Load()
    {
        var operationFeedback = Toasts.BeginOperation(toastLifetime);

        loading = true;
        try
        {
            var response = await Auth.MeAsync();
            if (disposed) return;
            account = response.Data;
            if (account is not null) SetForm(account);
            else operationFeedback.Publish(() => Toasts.Show("Chưa tải được tài khoản", response.Message ?? "Vui lòng thử lại sau.", "error"));
        }
        finally { if (!disposed) loading = false; }
    }

    private async Task Save()
    {
        if (!CanSave) return;
        var operationFeedback = Toasts.BeginOperation(toastLifetime);

        busy = true;
        serverValidation.Clear();
        try
        {
            var response = await Auth.UpdateAsync(new(form.DisplayName, form.PhoneNumber));
            if (disposed) return;
            if (response.IsSuccess && response.Data is not null)
            {
                account = response.Data;
                SetForm(account);
                operationFeedback.Publish(() => Toasts.Show("Cập nhật thành công", "Thông tin tài khoản đã được lưu.", "success"));
            }
            else
            {
                serverValidation.Apply(response);
                if (!HasValidationErrors)
                    operationFeedback.Publish(() => Toasts.Show("Chưa lưu được thông tin", response.Message ?? "Vui lòng thử lại sau.", response.StatusCode == 429 ? "warning" : "error"));
            }
        }
        finally { if (!disposed) busy = false; }
    }

    private void SetForm(AccountResponse value) { form.DisplayName = value.DisplayName; form.PhoneNumber = value.PhoneNumber; }
    private void OnProfileEdited(string field)
    {
        editContext.NotifyFieldChanged(new FieldIdentifier(form, field));
    }
    public void Dispose() { toastLifetime.Dispose();  disposed = true; serverValidation.Dispose(); }
    private async Task Logout()
    {
        if (busy) return;
        busy = true;
        try { await Session.LogoutAsync(); Navigation.NavigateTo("/login"); }
        finally { busy = false; }
    }
    private static string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(part => part[0])).ToUpperInvariant();
    private static string RoleName(string role) => role switch { "RESIDENT" => "Cư dân", "STAFF" => "Nhân viên", "ACCOUNTANT" => "Kế toán", "MANAGER" => "Quản lý", "ADMIN" => "Quản trị viên", _ => "Chưa xác định" };
    private static string StatusName(string status) => status switch { "ACTIVE" => "Đang hoạt động", "PENDING" => "Chờ xác minh", "LOCKED" => "Đã khóa", "SUSPENDED" => "Tạm ngưng", "DISABLED" => "Đã vô hiệu hóa", _ => "Chưa xác định" };
}
