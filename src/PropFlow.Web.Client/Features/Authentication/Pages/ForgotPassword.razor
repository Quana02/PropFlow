@page "/forgot-password"
@layout PropFlow.Web.Client.Features.Authentication.Components.AuthLayout
@inject AuthenticationService Auth
@inject OnboardingState State
@inject NavigationManager Navigation
<span class="auth-form-eyebrow">CẤP LẠI MẬT KHẨU</span><h2>Khôi Phục Quyền Truy Cập</h2>
<p class="auth-form-description">Nhập email đã xác minh của tài khoản để nhận mã khôi phục. Nếu chưa có email xác minh, hãy liên hệ quản trị viên.</p>
<ApiFeedback Result="result" />
<EditForm Model="form" OnValidSubmit="Submit"><DataAnnotationsValidator /><ValidationSummary />
    <label for="recovery-email">ĐỊA CHỈ EMAIL ĐĂNG KÝ</label><div class="auth-field"><span class="material-symbols-outlined auth-field-icon" aria-hidden="true">alternate_email</span><InputText id="recovery-email" type="email" @bind-Value="form.Email" autocomplete="email" placeholder="Nhập email của tài khoản" /></div>
    <button type="submit" disabled="@busy">@(busy ? "ĐANG XỬ LÝ…" : "GỬI MÃ XÁC THỰC OTP →")</button>
</EditForm><nav class="auth-links auth-back-link"><a href="/login">← QUAY LẠI ĐĂNG NHẬP</a></nav>
@code {
    private readonly EmailForm form = new(); private ApiResult? result; private bool busy;
    private async Task Submit() { if (busy) return; busy = true; try {
        var response = await Auth.ForgotAsync(new(form.Email)); result = response;
        if (response.IsSuccess) { State.Clear(); State.Recovery = true; State.Challenge = response.Data; Navigation.NavigateTo("/otp"); }
    } finally { busy = false; } }
}
