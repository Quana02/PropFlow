@page "/reset-password"
@layout PropFlow.Web.Client.Features.Authentication.Components.AuthLayout
@inject AuthenticationService Auth
@inject OnboardingState State
@inject NavigationManager Navigation
<PageTitle>Đặt lại mật khẩu — PropFlow</PageTitle>
<span class="auth-form-eyebrow">THIẾT LẬP BẢO MẬT MỚI</span><h2>Tạo Mật Khẩu Mới</h2>
@if (State.ResetProof == null || State.ResetProof.ExpiresAt <= DateTimeOffset.UtcNow)
{
    <p class="feedback">Bạn cần xác minh yêu cầu khôi phục trước khi đặt lại mật khẩu. Quyền đặt lại có thể đã hết hạn hoặc mất sau khi tải lại trang.</p><a href="/forgot-password">Bắt đầu khôi phục</a>
}
else
{
    <p>Chọn mật khẩu mới để bảo vệ tài khoản. Các phiên đăng nhập sẽ bị thu hồi sau khi hoàn tất.</p><ApiFeedback Result="result" />
    <EditForm Model="form" OnValidSubmit="Submit"><DataAnnotationsValidator /><ValidationSummary />
        <label for="reset-pass">MẬT KHẨU MỚI (12–128 KÝ TỰ)</label>
        <div class="password-input-wrap auth-field"><span class="material-symbols-outlined auth-field-icon" aria-hidden="true">key</span><input id="reset-pass" type="@(showPassword ? "text" : "password")" @bind="form.Password" @bind:event="oninput" autocomplete="new-password" placeholder="Nhập mật khẩu mới" /><button type="button" aria-label="@(showPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")" @onclick="() => showPassword = !showPassword">@(showPassword ? "ẨN" : "HIỆN")</button></div>
        <div class="password-strength" aria-live="polite">
            <strong>ĐỘ MẠNH MẬT KHẨU: @Strength/4</strong>
            <div class="strength-bars" aria-hidden="true">@for (var i = 0; i < 4; i++) { <i class="@(i < Strength ? "active" : "")"></i> }</div>
            <div class="strength-rules"><span class="@(HasLength ? "met" : "")">@(HasLength ? "✓" : "○") Tối thiểu 12 ký tự</span><span class="@(HasLetterCase ? "met" : "")">@(HasLetterCase ? "✓" : "○") Chữ hoa & chữ thường</span><span class="@(HasDigit ? "met" : "")">@(HasDigit ? "✓" : "○") Có chữ số</span><span class="@(HasSymbol ? "met" : "")">@(HasSymbol ? "✓" : "○") Có ký tự đặc biệt</span></div>
        </div>
        <label for="reset-confirm">XÁC NHẬN MẬT KHẨU MỚI</label>
        <div class="password-input-wrap auth-field"><span class="material-symbols-outlined auth-field-icon" aria-hidden="true">lock_reset</span><input id="reset-confirm" type="@(showConfirmation ? "text" : "password")" @bind="form.Confirmation" @bind:event="oninput" autocomplete="new-password" placeholder="Nhập lại mật khẩu mới" /><button type="button" aria-label="@(showConfirmation ? "Ẩn mật khẩu xác nhận" : "Hiện mật khẩu xác nhận")" @onclick="() => showConfirmation = !showConfirmation">@(showConfirmation ? "ẨN" : "HIỆN")</button></div>
        <button type="submit" disabled="@busy">@(busy ? "ĐANG CẬP NHẬT…" : "CẬP NHẬT MẬT KHẨU →")</button>
    </EditForm>
    <nav class="auth-links"><a href="/login">← QUAY LẠI ĐĂNG NHẬP</a></nav>
}
@code {
    private readonly PasswordForm form = new(); private bool busy; private bool showPassword; private bool showConfirmation; private ApiResult? result;
    private bool HasLength => form.Password.Length >= 12;
    private bool HasLetterCase => form.Password.Any(char.IsUpper) && form.Password.Any(char.IsLower);
    private bool HasDigit => form.Password.Any(char.IsDigit);
    private bool HasSymbol => form.Password.Any(c => !char.IsLetterOrDigit(c));
    private int Strength => (HasLength ? 1 : 0) + (HasLetterCase ? 1 : 0) + (HasDigit ? 1 : 0) + (HasSymbol ? 1 : 0);
    private async Task Submit() { if (busy || State.ResetProof == null) return; busy = true; try {
        result = await Auth.ResetAsync(new(State.ResetProof.ChallengeId, State.ResetProof.Proof, form.Password));
        if (result.IsSuccess) { State.Clear(); Navigation.NavigateTo("/login"); }
    } finally { form.Password = form.Confirmation = ""; busy = false; } }
}
