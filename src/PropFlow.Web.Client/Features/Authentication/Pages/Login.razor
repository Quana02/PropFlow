@implements IDisposable
@inject PropFlow.Web.Client.Shared.Feedback.ToastService Toasts
@page "/login"
@layout PropFlow.Web.Client.Features.Authentication.Components.AuthLayout
@inject AuthSession Session
@inject NavigationManager Navigation
@using PropFlow.Web.Client.Shared.Feedback
<span class="auth-form-eyebrow">CỔNG THÔNG TIN TÀI KHOẢN</span>
<h2>Đăng Nhập Hệ Thống</h2>
<p class="auth-form-description">Truy cập tài khoản PropFlow của bạn.</p>
@if (Session.Notice != null) { <p class="feedback" role="status">@Session.Notice</p> }

<EditForm Model="form" OnValidSubmit="Submit" OnInvalidSubmit="HandleInvalidSubmit">
    <DataAnnotationsValidator />
    <label for="username">Tên đăng nhập</label>
    <div class="auth-field"><span class="material-symbols-outlined auth-field-icon" aria-hidden="true">badge</span><InputText id="username" @bind-Value="form.Username" autocomplete="username" placeholder="Nhập tên đăng nhập" /></div>
    <div class="auth-password-heading"><label for="password">Mật khẩu truy cập</label><a href="/forgot-password">QUÊN MẬT KHẨU?</a></div>
    <div class="auth-field auth-field-has-toggle">
        <span class="material-symbols-outlined auth-field-icon" aria-hidden="true">lock</span>
        <InputText id="password" type="@(showPassword ? "text" : "password")" @bind-Value="form.Password" autocomplete="current-password" placeholder="Nhập mật khẩu" />
        <button type="button" class="auth-toggle-pass" aria-label="@(showPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")" title="@(showPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")" @onclick="() => showPassword = !showPassword">
            <span class="material-symbols-outlined" aria-hidden="true">@(showPassword ? "visibility_off" : "visibility")</span>
        </button>
    </div>
    <button disabled="@busy" type="submit">@(busy ? "ĐANG ĐĂNG NHẬP…" : "XÁC THỰC & TRUY CẬP →")</button>
</EditForm>
<nav class="auth-links auth-links-login"><span>Chưa có tài khoản?</span><a href="/register">Tạo tài khoản</a><a class="auth-resume" href="/registration/resume">Đã đăng ký? Tiếp tục xác minh</a></nav>
@if (Session.Notice?.Contains("chưa xác nhận") == true) { <button class="secondary" disabled="@busy" @onclick="RetryLogout">Thử thu hồi phiên lại</button> }
@code {
    private readonly PropFlow.Web.Client.Shared.Feedback.ToastLifetime toastLifetime = new();
    public void Dispose() => toastLifetime.Dispose();

    private readonly LoginForm form = new();
    private bool busy;
    private bool showPassword;

    private void HandleInvalidSubmit(EditContext _)
        => ShowToast("Vui lòng nhập đầy đủ tên đăng nhập và mật khẩu.");

    private async Task Submit()
    {
        var operationFeedback = Toasts.BeginOperation(toastLifetime);

        if (busy) return;

        busy = true;
        try
        {
            var result = await Session.LoginAsync(new(form.Username, form.Password));
            if (!operationFeedback.IsCurrent) return;
            if (result.IsSuccess)
            {
                Navigation.NavigateTo(RoleHomeNavigation.Home(Session.User?.Role));
                return;
            }

            operationFeedback.Publish(() => ShowToast(GetErrorMessage(result)));
        }
        finally
        {
            form.Password = "";
            busy = false;
        }
    }

    private async Task RetryLogout()
    {
        var operationFeedback = Toasts.BeginOperation(toastLifetime);

        busy = true;
        try
        {
            var result = await Session.LogoutAsync();
            if (!result.IsSuccess) operationFeedback.Publish(() => ShowToast(GetErrorMessage(result)));
        }
        finally
        {
            busy = false;
        }
    }

    private void ShowToast(string message) => Toasts.Error(message);

    private static string GetErrorMessage(ApiResult result)
    {
        var validationMessages = result.ValidationErrors?.Values
            .SelectMany(messages => messages)
            .Where(message => !string.IsNullOrWhiteSpace(message))
            .Distinct()
            .ToArray();

        return validationMessages is { Length: > 0 }
            ? string.Join(" ", validationMessages)
            : result.Message ?? "Không thể đăng nhập. Vui lòng thử lại.";
    }
}
