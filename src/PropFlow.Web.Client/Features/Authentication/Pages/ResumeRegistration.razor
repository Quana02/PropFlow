@page "/registration/resume"
@layout PropFlow.Web.Client.Features.Authentication.Components.AuthLayout
@inject AuthenticationService Auth
@inject OnboardingState State
@inject NavigationManager Navigation
<PageTitle>Tiếp tục xác minh — PropFlow</PageTitle><h2>Tiếp tục xác minh cư dân</h2>
<p>Nhập thông tin tài khoản đã đăng ký để yêu cầu mã mới. Mã cũ sẽ không còn hiệu lực.</p>
<ApiFeedback Result="result" />
@if (message != null) { <p class="feedback" role="status">@message</p> }
<EditForm Model="form" OnValidSubmit="Submit"><DataAnnotationsValidator /><ValidationSummary />
    <label for="resume-user">Tên đăng nhập</label>
    <div class="auth-field">
        <span class="material-symbols-outlined auth-field-icon" aria-hidden="true">badge</span>
        <InputText id="resume-user" @bind-Value="form.Username" autocomplete="username" placeholder="Nhập tên đăng nhập" />
    </div>
    <label for="resume-pass">Mật khẩu</label>
    <div class="auth-field auth-field-has-toggle">
        <span class="material-symbols-outlined auth-field-icon" aria-hidden="true">lock</span>
        <InputText id="resume-pass" type="@(showPassword ? "text" : "password")" @bind-Value="form.Password" autocomplete="current-password" placeholder="Nhập mật khẩu" />
        <button type="button" class="auth-toggle-pass" aria-label="@(showPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")" title="@(showPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")" @onclick="() => showPassword = !showPassword">
            <span class="material-symbols-outlined" aria-hidden="true">@(showPassword ? "visibility_off" : "visibility")</span>
        </button>
    </div>
    <button type="submit" disabled="@busy">@(busy ? "Đang xử lý…" : "Yêu cầu mã xác minh")</button>
</EditForm><nav class="auth-links"><a href="/login">Quay lại đăng nhập</a></nav>
@code {
    private readonly LoginForm form = new(); private ApiResult? result; private bool busy; private bool showPassword; private string? message;
    private async Task Submit() { if (busy) return; busy = true; try {
        var response = await Auth.ResumeAsync(new(form.Username, form.Password)); result = response;
        if (response.IsSuccess) { State.Clear(); State.Challenge = response.Data; message = response.Data!.Message; if (response.Data.ChallengeId != Guid.Empty) Navigation.NavigateTo("/otp"); }
    } finally { form.Password = ""; busy = false; } }
}
