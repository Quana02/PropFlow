@page "/register"
@layout PropFlow.Web.Client.Features.Authentication.Components.AuthLayout
@inject AuthenticationService Auth
@inject OnboardingState State
@inject NavigationManager Navigation
@using PropFlow.Web.Client.Shared.Feedback

<span class="auth-form-eyebrow">ĐĂNG KÝ TÀI KHOẢN CƯ DÂN</span>
<h2>Khởi Tạo Tài Khoản</h2>
<p>Đối chiếu chính xác thông tin trong hồ sơ cư dân để đăng ký.</p>
@if (!string.IsNullOrWhiteSpace(toastMessage))
{
    <PropFlowToast @key="toastVersion" Message="@toastMessage" Severity="@toastSeverity" DurationMs="5000" OnDismiss="DismissToast" />
}
<EditForm Model="form" OnValidSubmit="Submit" OnInvalidSubmit="HandleInvalidSubmit"><DataAnnotationsValidator />
    <div class="auth-register-grid">
        <div><label for="reg-name">Họ tên hiển thị</label><div class="auth-field"><span class="material-symbols-outlined auth-field-icon" aria-hidden="true">person</span><InputText id="reg-name" @bind-Value="form.DisplayName" autocomplete="name" placeholder="Họ và tên của bạn" /></div><ValidationMessage For="()=>form.DisplayName" /></div>
        <div><label for="reg-phone">Số điện thoại <em>*</em></label><div class="auth-field"><span class="material-symbols-outlined auth-field-icon" aria-hidden="true">phone</span><InputText id="reg-phone" type="tel" @bind-Value="form.PhoneNumber" autocomplete="tel" placeholder="Số điện thoại trong hồ sơ" /></div><ValidationMessage For="()=>form.PhoneNumber" /></div>
        <div><label>Loại giấy tờ <em>*</em></label><PropFlowSelect Options="IdentityTypeOptions" Value="@form.IdentityType" ValueChanged="SetIdentityType" Placeholder="Chọn loại giấy tờ" AriaLabel="Loại giấy tờ" /><ValidationMessage For="()=>form.IdentityType" /></div>
        <div><label for="reg-identity">Số giấy tờ <em>*</em></label><div class="auth-field"><span class="material-symbols-outlined auth-field-icon" aria-hidden="true">id_card</span><InputText id="reg-identity" inputmode="numeric" @bind-Value="form.IdentityNumber" placeholder="Nhập số CCCD/CMND" /></div><ValidationMessage For="()=>form.IdentityNumber" /></div>
        <div><label for="reg-user">Tên đăng nhập</label><div class="auth-field"><span class="material-symbols-outlined auth-field-icon" aria-hidden="true">badge</span><InputText id="reg-user" @bind-Value="form.Username" autocomplete="username" placeholder="Tên dùng để đăng nhập" /></div><ValidationMessage For="()=>form.Username" /></div>
        <div><label for="reg-email">Email <em>*</em></label><div class="auth-field"><span class="material-symbols-outlined auth-field-icon" aria-hidden="true">mail</span><InputText id="reg-email" type="email" @bind-Value="form.Email" autocomplete="email" placeholder="Email trong hồ sơ cư dân" /></div><ValidationMessage For="()=>form.Email" /></div>
        <div><label for="reg-pass">Mật khẩu (12–128 ký tự)</label><div class="auth-field auth-field-has-toggle"><span class="material-symbols-outlined auth-field-icon" aria-hidden="true">lock</span><InputText id="reg-pass" type="@(showPassword ? "text" : "password")" @bind-Value="form.Password" autocomplete="new-password" placeholder="Ít nhất 12 ký tự" /><button type="button" class="auth-toggle-pass" aria-label="@(showPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")" title="@(showPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")" @onclick="() => showPassword = !showPassword"><span class="material-symbols-outlined" aria-hidden="true">@(showPassword ? "visibility_off" : "visibility")</span></button></div><ValidationMessage For="()=>form.Password" /></div>
        <div><label for="reg-confirm">Xác nhận mật khẩu</label><div class="auth-field auth-field-has-toggle"><span class="material-symbols-outlined auth-field-icon" aria-hidden="true">lock_reset</span><InputText id="reg-confirm" type="@(showConfirmation ? "text" : "password")" @bind-Value="form.Confirmation" autocomplete="new-password" placeholder="Nhập lại mật khẩu" /><button type="button" class="auth-toggle-pass" aria-label="@(showConfirmation ? "Ẩn mật khẩu" : "Hiện mật khẩu")" title="@(showConfirmation ? "Ẩn mật khẩu" : "Hiện mật khẩu")" @onclick="() => showConfirmation = !showConfirmation"><span class="material-symbols-outlined" aria-hidden="true">@(showConfirmation ? "visibility_off" : "visibility")</span></button></div><ValidationMessage For="()=>form.Confirmation" /></div>
    </div>
    <button disabled="@busy" type="submit">@(busy ? "Đang đăng ký…" : "Đăng ký")</button>
</EditForm>
<nav class="auth-links auth-links-register"><a href="/login">← Đã có tài khoản? Đăng nhập</a><a class="auth-resume" href="/registration/resume">Tiếp tục xác minh tài khoản đã đăng ký</a></nav>
@code {
    private static readonly IReadOnlyList<PropFlowSelectOption> IdentityTypeOptions=[new("CCCD","CCCD"),new("CMND","CMND")];
    private readonly RegistrationForm form = new();
    private bool busy;
    private bool showPassword;
    private bool showConfirmation;
    private string? toastMessage;
    private string toastSeverity = "info";
    private int toastVersion;

    private Task SetIdentityType(string value){form.IdentityType=value;return Task.CompletedTask;}

    private void HandleInvalidSubmit(EditContext _)
        => ShowToast("Vui lòng kiểm tra các trường được đánh dấu bên dưới.", "error");

    private async Task Submit()
    {
        if (busy) return;

        DismissToast();
        busy = true;
        try
        {
            var response = await Auth.RegisterAsync(new(form.Username, form.DisplayName, form.Email, form.Password, form.PhoneNumber, form.IdentityType, form.IdentityNumber));
            if (response.IsSuccess && response.Data is not null)
            {
                State.Clear();
                State.Challenge = response.Data;
                if (response.Data.ChallengeId != Guid.Empty)
                {
                    Navigation.NavigateTo("/otp");
                    return;
                }

                ShowToast(response.Data.Message, "warning");
                return;
            }

            ShowToast(GetErrorMessage(response), "error");
        }
        finally
        {
            form.Password = form.Confirmation = "";
            busy = false;
        }
    }

    private void ShowToast(string message, string severity)
    {
        toastMessage = message;
        toastSeverity = severity;
        toastVersion++;
    }

    private void DismissToast() => toastMessage = null;

    private static string GetErrorMessage(ApiResult response)
    {
        var validationMessages = response.ValidationErrors?.Values
            .SelectMany(messages => messages)
            .Where(message => !string.IsNullOrWhiteSpace(message))
            .Distinct()
            .ToArray();

        return validationMessages is { Length: > 0 }
            ? string.Join(" ", validationMessages)
            : response.Message ?? "Không thể đăng ký tài khoản. Vui lòng thử lại.";
    }
}
