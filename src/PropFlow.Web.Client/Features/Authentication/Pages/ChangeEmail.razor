@page "/account/change-email"
@layout PropFlow.Web.Client.Features.Authentication.Components.AccountLayout
@attribute [Authorize(Roles = "ADMIN")]
@inject AuthenticationService Auth
@inject AuthSession Session
@inject NavigationManager Navigation
@inject PropFlow.Web.Client.Shared.Feedback.ToastService Toasts
@implements IDisposable

<PageTitle>Đổi email — PropFlow</PageTitle>
<h2>Đổi email</h2>
@if (challenge is null)
{
    <p>Email hiện tại: <strong>@Session.User?.Email</strong></p>
    <p>Nhập mật khẩu hiện tại để gửi mã xác minh đến email mới. Email chỉ thay đổi khi xác minh thành công.</p>
    <EditForm EditContext="formContext" OnValidSubmit="RequestCode">
        <DataAnnotationsValidator />
        <fieldset disabled="@busy">
            <label for="new-email">Email mới</label>
            <InputText id="new-email" type="email" @bind-Value="form.NewEmail" autocomplete="email" />
            <ValidationMessage For="() => form.NewEmail" />
            <label for="email-password">Mật khẩu hiện tại</label>
            <InputText id="email-password" type="password" @bind-Value="form.CurrentPassword" autocomplete="current-password" />
            <ValidationMessage For="() => form.CurrentPassword" />
            <button type="submit">@(busy ? "Đang gửi mã…" : "Gửi mã xác minh")</button>
        </fieldset>
    </EditForm>
}
else
{
    <p>Nhập mã xác minh cho <strong>@pendingEmail</strong>. Mã có hiệu lực trong 5 phút.</p>
    <EditForm EditContext="otpContext" OnValidSubmit="Verify">
        <DataAnnotationsValidator />
        <fieldset disabled="@busy">
            <label for="email-code">Mã xác minh email mới</label>
            <InputText id="email-code" @bind-Value="otp.Code" inputmode="numeric" maxlength="6" autocomplete="one-time-code" />
            <ValidationMessage For="() => otp.Code" />
            <button type="submit">@(busy ? "Đang xác minh…" : "Xác nhận đổi email")</button>
        </fieldset>
    </EditForm>
    <p>Bạn có thể yêu cầu mã mới sau 60 giây; mỗi mã chỉ được sử dụng một lần.</p>
    <button type="button" class="secondary" disabled="@busy" @onclick="StartAgain">Nhập lại email hoặc yêu cầu mã mới</button>
}
<nav class="auth-links"><a href="/account">Quay lại tài khoản</a></nav>

@code {
    private readonly PropFlow.Web.Client.Shared.Feedback.ToastLifetime emailFeedback = new();
    private readonly PropFlow.Web.Client.Shared.Feedback.ToastLifetime toastLifetime = new();

    private readonly ChangeEmailForm form = new();
    private readonly OtpForm otp = new();
    private ChallengeResponse? challenge;
    private EditContext formContext = default!, otpContext = default!;
    private ApiValidationMessages formValidation = default!, otpValidation = default!;
    private string pendingEmail = "";
    private bool busy, disposed;

    protected override void OnInitialized()
    {
        formContext = new(form); otpContext = new(otp);
        formValidation = new(formContext, ("NewEmail", nameof(form.NewEmail)), ("CurrentPassword", nameof(form.CurrentPassword)));
        otpValidation = new(otpContext, ("Code", nameof(otp.Code)));
    }

    private async Task RequestCode()
    {
        var operationFeedback = Toasts.BeginOperation(toastLifetime, emailFeedback);

        if (busy) return;
        busy = true;
        formValidation.Clear();
        try
        {
            var response = await Auth.RequestEmailChangeAsync(new(form.NewEmail, form.CurrentPassword));
            if (disposed) return;
            if (response.IsSuccess)
            {
                pendingEmail = form.NewEmail.Trim();
                challenge = response.Data;
                otp.Code = "";
                operationFeedback.Publish(() => Toasts.Show("Đã gửi mã xác minh", "Vui lòng kiểm tra hộp thư của email mới.", "info"));
            }
            else { formValidation.Apply(response); operationFeedback.Publish(() => ShowError(response)); }
        }
        finally { form.CurrentPassword = ""; if (!disposed) busy = false; }
    }

    private async Task Verify()
    {
        var operationFeedback = Toasts.BeginOperation(toastLifetime, emailFeedback);

        if (busy || challenge is null) return;
        busy = true;
        otpValidation.Clear();
        try
        {
            var response = await Auth.VerifyEmailChangeAsync(new(challenge.ChallengeId, pendingEmail, otp.Code), operationFeedback);
            if (response.IsSuccess && operationFeedback.IsCurrent) Navigation.NavigateTo("/login");
            else if (!disposed) { otpValidation.Apply(response); operationFeedback.Publish(() => ShowError(response)); }
        }
        finally { otp.Code = ""; if (!disposed) busy = false; }
    }

    private void StartAgain()
    {
        emailFeedback.Invalidate();
        challenge = null;
        otp.Code = "";
        formValidation.Clear(); otpValidation.Clear();
    }
    private void ShowError(ApiResult response) => Toasts.Show("Chưa đổi được email", response.Message ?? "Vui lòng thử lại sau.", response.StatusCode == 429 ? "warning" : "error");
    public void Dispose() { toastLifetime.Dispose();  disposed = true; formValidation.Dispose(); otpValidation.Dispose(); }
}
