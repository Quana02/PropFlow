@page "/admin/dashboard"
@layout PropFlow.Web.Client.Layout.AdminLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using PropFlow.Web.Client.Features.Administration
@using PropFlow.Web.Client.Features.Administration.Models
@using PropFlow.Web.Client.Features.Administration.Services
@using PropFlow.Web.Client.Features.Administration.Components
@using PropFlow.Web.Client.Services.Api
@using System.Text.RegularExpressions
@attribute [Authorize(Roles = "ADMIN")]
@inject IAdministrationApiClient AdministrationApi

<PageTitle>Quản trị hệ thống — PropFlow</PageTitle>

<div class="admin-dashboard">
@if (notice is not null)
{
    <div class="admin-feedback @(noticeIsError ? "is-error" : "is-success")" role="@(noticeIsError ? "alert" : "status")" aria-live="polite">
        <span class="material-symbols-outlined" aria-hidden="true">@(noticeIsError ? "error" : "check_circle")</span>
        <span>@notice</span>
        <button type="button" title="Đóng thông báo" aria-label="Đóng thông báo" @onclick="ClearNotice"><span class="material-symbols-outlined" aria-hidden="true">close</span></button>
    </div>
}
@if (Tab == "overview")
{
    <section class="rbac-panel"><header class="rbac-header"><div class="rbac-title"><span class="section-icon">▦</span><div><h1>Tổng quan</h1><p>Chỉ số vận hành toàn hệ thống · chỉ đọc</p></div></div></header>
    @if (overviewLoading) { <p class="empty-state">Đang tải chỉ số…</p> }
    else if (overviewError is not null) { <p class="empty-state" role="alert">@overviewError</p> }
    else if (overview is not null)
    {
        <div class="metrics-grid overview-metrics" aria-label="Chỉ số toàn hệ thống">
            <article class="metric-card metric-accounts"><span class="metric-icon">⌂</span><div class="metric-copy"><span>Tổng số căn hộ</span><strong>@overview.TotalApartments</strong></div></article>
            <article class="metric-card metric-staff"><span class="metric-icon">◇</span><div class="metric-copy"><span>Căn hộ trống</span><strong>@overview.VacantApartments</strong></div></article>
            <article class="metric-card metric-accounts"><span class="metric-icon">♙</span><div class="metric-copy"><span>Tổng số cư dân</span><strong>@overview.TotalResidents</strong></div></article>
            <article class="metric-card metric-restricted"><span class="metric-icon">☷</span><div class="metric-copy"><span>Yêu cầu dịch vụ đang mở</span><strong>@overview.OpenServiceRequests</strong></div></article>
        </div>
        <div class="overview-charts" aria-label="Biểu đồ vận hành toàn hệ thống">
            <ApartmentOccupancyChart Total="overview.TotalApartments" Occupied="overview.OccupiedApartments" Vacant="overview.VacantApartments" />
            <ServiceRequestStatusChart Items="overview.ServiceRequestsByStatus" />
            <ServiceRequestTrendChart Items="overview.ServiceRequestTrend" />
        </div>
    }
    </section>
}
else if (Tab == "activity")
{
    <section class="rbac-panel activity-panel"><header class="rbac-header"><div class="rbac-title"><span class="section-icon"><span class="material-symbols-outlined" aria-hidden="true">history</span></span><div><h1>Nhật ký quản trị</h1><p>Theo dõi các thay đổi tài khoản nội bộ · chỉ đọc</p></div></div></header>
    <div class="activity-tools"><div class="activity-filter"><PropFlowSelect Value="activityAction" ValueChanged="FilterActivityAsync" Options="ActivityActionOptions" Variant="Filter" AriaLabel="Lọc theo hành động" /></div><span>@(activityPage?.Total ?? 0) hoạt động</span></div>
    @if (activityLoading) { <p class="empty-state"><span class="material-symbols-outlined" aria-hidden="true">progress_activity</span>Đang tải nhật ký…</p> }
    else if (activityError is not null) { <p class="empty-state error-state" role="alert"><span class="material-symbols-outlined" aria-hidden="true">error</span>@activityError</p> }
    else if (activities.Length == 0) { <p class="empty-state"><span class="material-symbols-outlined" aria-hidden="true">history_toggle_off</span>Chưa có hoạt động quản trị.</p> }
    else { <div class="role-table-wrap"><table class="role-table activity-table"><thead><tr><th>Thời gian</th><th>Hành động</th><th>Tài khoản</th><th>Thay đổi</th><th><span class="visually-hidden">Hành động</span></th></tr></thead><tbody>@foreach (var item in activities) { <tr><td><time datetime="@item.Timestamp.ToString("O")"><strong>@item.Timestamp.LocalDateTime.ToString("dd/MM/yyyy")</strong><span>@item.Timestamp.LocalDateTime.ToString("HH:mm")</span></time></td><td><span class="activity-badge @ActionTone(item)"><span class="material-symbols-outlined" aria-hidden="true">@ActionIcon(item)</span>@ActionLabel(item)</span></td><td><div class="activity-account"><strong>@(item.TargetUsername ?? "Không xác định")</strong>@if (!string.IsNullOrWhiteSpace(item.TargetRole)) { <span class="activity-value-chip">@item.TargetRole</span> }</div></td><td>@ChangeContent(item)</td><td><button type="button" class="activity-view" title="Xem chi tiết" aria-label="Xem chi tiết hoạt động của @(item.TargetUsername ?? "tài khoản")" @onclick="() => selectedActivity = item"><span class="material-symbols-outlined" aria-hidden="true">visibility</span></button></td></tr> }</tbody></table></div><footer class="table-footer"><span>Hiển thị @activities.Length / @(activityPage?.Total ?? 0) hoạt động</span><nav class="table-pagination" aria-label="Phân trang nhật ký quản trị"><button type="button" disabled="@(activityPageNumber <= 1)" title="Trang trước" aria-label="Trang trước" @onclick="PreviousActivityPageAsync"><span class="material-symbols-outlined" aria-hidden="true">chevron_left</span></button><span class="page-number" aria-current="page">@activityPageNumber</span><button type="button" disabled="@(activityPage is null || activityPageNumber * activityPage.PageSize >= activityPage.Total)" title="Trang sau" aria-label="Trang sau" @onclick="NextActivityPageAsync"><span class="material-symbols-outlined" aria-hidden="true">chevron_right</span></button></nav></footer> }
    </section>
}
else
{
    <section class="metrics-grid" aria-label="Tóm tắt tài khoản nội bộ">
        <article class="metric-card metric-accounts"><span class="metric-icon">♙</span><div class="metric-copy"><span>Tổng tài khoản</span><strong>@(summary?.Total.ToString() ?? "—")</strong></div></article>
        <article class="metric-card metric-staff"><span class="metric-icon">●</span><div class="metric-copy"><span>Đang hoạt động</span><strong>@(summary?.Active.ToString() ?? "—")</strong></div></article>
        <article class="metric-card metric-restricted"><span class="metric-icon">◇</span><div class="metric-copy"><span>Bị vô hiệu hóa</span><strong>@(summary?.Disabled.ToString() ?? "—")</strong></div></article>
        <article class="metric-card metric-restricted"><span class="metric-icon">⌧</span><div class="metric-copy"><span>Đang bị khóa</span><strong>@(summary?.Locked.ToString() ?? "—")</strong></div></article>
    </section>
    <section class="rbac-panel"><header class="rbac-header"><div class="rbac-title"><span class="section-icon">♙</span><div><div class="title-line"><h1>Tài khoản Ban quản lý</h1></div><p>Quản lý tài khoản nội bộ và vai trò của Ban quản lý.</p></div></div><div class="rbac-actions"><button type="button" @onclick="OpenRolesAsync"><span class="material-symbols-outlined" aria-hidden="true">policy</span> Vai trò &amp; quyền</button><button type="button" class="primary" @onclick="OpenCreate"><span class="material-symbols-outlined" aria-hidden="true">person_add</span> Tạo tài khoản</button></div></header>
    @if (error is not null) { <p class="empty-state">@error</p> }
    <div class="policy-strip" aria-label="Lọc theo vai trò"><button type="button" class="role-tab @(role == "ALL" ? "selected" : null)" aria-pressed="@(role == "ALL")" @onclick='() => SelectRoleAsync("ALL")'><span class="material-symbols-outlined" aria-hidden="true">groups</span><span><strong>TẤT CẢ</strong><small>Toàn bộ tài khoản · @(summary?.Total ?? 0)</small></span></button><button type="button" class="role-tab @(role == "MANAGER" ? "selected" : null)" aria-pressed="@(role == "MANAGER")" @onclick='() => SelectRoleAsync("MANAGER")'><span class="material-symbols-outlined" aria-hidden="true">manage_accounts</span><span><strong>MANAGER</strong><small>Trưởng Ban Quản lý · @Count("MANAGER")</small></span></button><button type="button" class="role-tab @(role == "STAFF" ? "selected" : null)" aria-pressed="@(role == "STAFF")" @onclick='() => SelectRoleAsync("STAFF")'><span class="material-symbols-outlined" aria-hidden="true">engineering</span><span><strong>STAFF</strong><small>Nhân viên vận hành · @Count("STAFF")</small></span></button><button type="button" class="role-tab @(role == "ACCOUNTANT" ? "selected" : null)" aria-pressed="@(role == "ACCOUNTANT")" @onclick='() => SelectRoleAsync("ACCOUNTANT")'><span class="material-symbols-outlined" aria-hidden="true">calculate</span><span><strong>ACCOUNTANT</strong><small>Kế toán · @Count("ACCOUNTANT")</small></span></button></div>
    <div class="table-tools"><label class="role-search"><span class="material-symbols-outlined" aria-hidden="true">search</span><input @bind="search" placeholder="Tìm theo tên, username hoặc email" /></label><div class="admin-filter-select"><PropFlowSelect @bind-Value="status" Options="AccountStatusFilterOptions" Variant="Filter" AriaLabel="Lọc theo trạng thái" /></div><button type="button" class="filter-submit" @onclick="SearchAsync"><span class="material-symbols-outlined" aria-hidden="true">filter_alt</span><span>Tìm</span></button></div>
    @if (accountsLoading) { <p class="empty-state">Đang tải tài khoản…</p> } else if (accounts.Length == 0) { <p class="empty-state">@(role == "ALL" ? "Chưa có tài khoản Ban quản lý." : "Chưa có tài khoản thuộc vai trò này.")</p> } else { <div class="role-table-wrap"><table class="role-table"><thead><tr><th>Tên</th><th>Username</th><th>Email</th><th>Vai trò</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach (var account in accounts) { <tr><td>@account.DisplayName</td><td>@account.Username</td><td>@account.Email</td><td>@account.Role</td><td><span class="data-state @StatusTone(account.Status)">@StatusLabel(account.Status)</span></td><td><div class="account-actions"><button type="button" class="row-action access" title="Xem quyền hiệu lực" aria-label="Xem quyền hiệu lực của @account.Username" @onclick="() => OpenAccessAsync(account)"><span class="material-symbols-outlined" aria-hidden="true">shield_person</span><span>Xem quyền</span></button><button type="button" class="row-action role" title="Đổi vai trò" aria-label="Đổi vai trò của @account.Username" @onclick="() => OpenRole(account)"><span class="material-symbols-outlined" aria-hidden="true">manage_accounts</span><span>Đổi vai trò</span></button><button type="button" class="row-action status" title="Cập nhật trạng thái" aria-label="Cập nhật trạng thái của @account.Username" @onclick="() => OpenStatus(account)"><span class="material-symbols-outlined" aria-hidden="true">toggle_on</span><span>Trạng thái</span></button></div></td></tr> }</tbody></table></div> }
    <footer class="table-footer"><span>@(pageData?.Total ?? 0) tài khoản</span><nav class="table-pagination" aria-label="Phân trang tài khoản"><button type="button" disabled="@(page <= 1)" title="Trang trước" aria-label="Trang trước" @onclick="PreviousPageAsync"><span class="material-symbols-outlined" aria-hidden="true">chevron_left</span></button><span class="page-number" aria-current="page">@(page)</span><button type="button" disabled="@(pageData is null || page * 20 >= pageData.Total)" title="Trang sau" aria-label="Trang sau" @onclick="NextPageAsync"><span class="material-symbols-outlined" aria-hidden="true">chevron_right</span></button></nav></footer>
    </section>
}
</div>

@if (showCreate) { <div class="admin-modal" role="dialog" aria-modal="true"><div class="modal-card"><h2>Tạo tài khoản nội bộ</h2>@if (dialogError is not null) { <div class="dialog-message is-error" role="alert"><span class="material-symbols-outlined" aria-hidden="true">error</span><span>@dialogError</span></div> }<input @bind="createUsername" placeholder="Username" /><input @bind="createName" placeholder="Họ và tên" /><input @bind="createEmail" placeholder="Email" /><div class="admin-password-field"><input @bind="createPassword" type="@(showCreatePassword ? "text" : "password")" autocomplete="new-password" aria-label="Mật khẩu" placeholder="Mật khẩu (ít nhất 12 ký tự)" /><button type="button" class="admin-password-toggle" aria-label="@(showCreatePassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")" title="@(showCreatePassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")" aria-pressed="@showCreatePassword" @onclick="() => showCreatePassword = !showCreatePassword"><span class="material-symbols-outlined" aria-hidden="true">@(showCreatePassword ? "visibility_off" : "visibility")</span></button></div><PropFlowSelect @bind-Value="createRole" Options="RoleOptions" AriaLabel="Vai trò tài khoản" /><div class="rbac-actions"><button type="button" @onclick="CloseDialogs">Hủy</button><button type="button" class="primary" disabled="@submitting" @onclick="CreateAsync">@(submitting ? "Đang tạo…" : "Tạo tài khoản")</button></div></div></div> }
@if (selected is not null && action is not null) { <div class="admin-modal" role="dialog" aria-modal="true"><div class="modal-card"><h2>@(action == "role" ? "Đổi vai trò" : "Cập nhật trạng thái")</h2><p>@selected.Username · @selected.Role · @StatusLabel(selected.Status)</p>@if (dialogError is not null) { <div class="dialog-message is-error" role="alert"><span class="material-symbols-outlined" aria-hidden="true">error</span><span>@dialogError</span></div> }@if (action == "role") { <PropFlowSelect @bind-Value="nextRole" Options="AvailableRoleOptions" AriaLabel="Vai trò mới" /><p class="confirmation-note"><span class="material-symbols-outlined" aria-hidden="true">warning</span>Bạn có chắc muốn chuyển tài khoản @selected.Username từ @selected.Role sang @nextRole?</p> } else { <PropFlowSelect @bind-Value="nextStatus" Options="AvailableStatusOptions" AriaLabel="Trạng thái mới" /><p class="confirmation-note"><span class="material-symbols-outlined" aria-hidden="true">warning</span>Bạn có chắc muốn chuyển trạng thái tài khoản @selected.Username sang @StatusLabel(nextStatus)?</p> }<div class="rbac-actions"><button type="button" @onclick="CloseDialogs">Hủy</button><button type="button" class="primary" disabled="@submitting" @onclick="SubmitActionAsync">@(submitting ? "Đang xử lý…" : "Xác nhận")</button></div></div></div> }
@if (showRoles) { <div class="admin-modal" role="dialog" aria-modal="true" aria-labelledby="role-catalog-title"><div class="modal-card access-dialog"><header><div><h2 id="role-catalog-title">Vai trò và quyền cố định</h2><p>Thông tin chỉ đọc. Quyền được cấu hình cố định bởi hệ thống.</p></div><button type="button" class="modal-close" title="Đóng" aria-label="Đóng danh sách vai trò" @onclick="CloseDialogs"><span class="material-symbols-outlined" aria-hidden="true">close</span></button></header>@if (accessLoading) { <p class="empty-state">Đang tải vai trò và quyền…</p> } else { <div class="access-list">@foreach (var item in roleAccess) { <section class="access-role"><div><strong>@item.Code · @item.Name</strong><span class="data-state @(item.IsActive ? "connected" : "disabled")">@(item.IsActive ? "Đang hoạt động" : "Ngừng hoạt động")</span></div>@if (!string.IsNullOrWhiteSpace(item.Description)) { <p>@item.Description</p> }<div class="permission-list">@foreach (var permission in item.Permissions) { <span title="@permission.Description"><small>@permission.Module</small>@permission.Name</span> }</div></section> }</div> }</div></div> }
@if (accountAccess is not null) { <div class="admin-modal" role="dialog" aria-modal="true" aria-labelledby="account-access-title"><div class="modal-card access-dialog"><header><div><h2 id="account-access-title">Quyền hiệu lực</h2><p>@accountAccess.DisplayName · @accountAccess.Username</p></div><button type="button" class="modal-close" title="Đóng" aria-label="Đóng quyền hiệu lực" @onclick="CloseDialogs"><span class="material-symbols-outlined" aria-hidden="true">close</span></button></header><div class="access-summary"><span class="activity-value-chip">@accountAccess.Role</span><span class="data-state @StatusTone(accountAccess.Status)">@StatusLabel(accountAccess.Status)</span></div><div class="permission-list">@foreach (var permission in accountAccess.Permissions) { <span title="@permission.Description"><small>@permission.Module</small>@permission.Name</span> }</div>@if (accountAccess.Permissions.Length == 0) { <p class="empty-state">Vai trò này chưa có quyền hiệu lực.</p> }</div></div> }
@if (selectedActivity is not null) { <div class="admin-modal" role="dialog" aria-modal="true" aria-labelledby="activity-detail-title" @onclick="() => selectedActivity = null"><div class="modal-card activity-detail" @onclick:stopPropagation="true"><header><div><span class="activity-badge @ActionTone(selectedActivity)"><span class="material-symbols-outlined" aria-hidden="true">@ActionIcon(selectedActivity)</span>@ActionLabel(selectedActivity)</span><h2 id="activity-detail-title">Chi tiết hoạt động</h2></div><button type="button" class="modal-close" title="Đóng" aria-label="Đóng chi tiết hoạt động" @onclick="() => selectedActivity = null"><span class="material-symbols-outlined" aria-hidden="true">close</span></button></header><dl><div><dt>Thời gian</dt><dd>@selectedActivity.Timestamp.LocalDateTime.ToString("dd/MM/yyyy · HH:mm")</dd></div><div><dt>Người thực hiện</dt><dd>@ActorDisplay(selectedActivity)@if (selectedActivity.ActorUserId.HasValue) { <small>@selectedActivity.ActorUserId</small> }</dd></div><div><dt>Tài khoản</dt><dd>@(selectedActivity.TargetDisplayName ?? selectedActivity.TargetUsername ?? "Không có dữ liệu danh tính")@if (!string.IsNullOrWhiteSpace(selectedActivity.TargetUsername) && selectedActivity.TargetDisplayName != selectedActivity.TargetUsername) { <small>@selectedActivity.TargetUsername</small> }</dd></div>@if (!string.IsNullOrWhiteSpace(selectedActivity.TargetRole)) { <div><dt>Vai trò</dt><dd><span class="activity-value-chip">@selectedActivity.TargetRole</span></dd></div> }@if (!string.IsNullOrWhiteSpace(selectedActivity.OldRole) || !string.IsNullOrWhiteSpace(selectedActivity.NewRole)) { <div><dt>Thay đổi vai trò</dt><dd>@Transition(selectedActivity.OldRole, selectedActivity.NewRole)</dd></div> }@if (!string.IsNullOrWhiteSpace(selectedActivity.OldStatus) || !string.IsNullOrWhiteSpace(selectedActivity.NewStatus)) { <div><dt>Thay đổi trạng thái</dt><dd>@Transition(selectedActivity.OldStatus, selectedActivity.NewStatus)</dd></div> }<div><dt>Mã tham chiếu</dt><dd class="technical-reference">@(selectedActivity.TargetAccountId?.ToString() ?? selectedActivity.Id.ToString())</dd></div></dl></div></div> }

@code {
    [SupplyParameterFromQuery(Name = "tab")] public string? RequestedTab { get; set; }
    private string Tab => AdminDashboardTabs.Normalize(RequestedTab);
    private InternalAccountSummary? summary; private PagedInternalAccounts? pageData; private PagedAdministrationActivities? activityPage; private InternalAccount[] accounts = []; private AdministrationActivity[] activities = []; private AdministrationOverview? overview; private AdministrationActivity? selectedActivity; private AdministrationRoleAccess[] roleAccess = []; private InternalAccountAccess? accountAccess;
    private string role = "ALL", search = "", status = "", createUsername = "", createName = "", createEmail = "", createPassword = "", createRole = "STAFF", nextRole = "", nextStatus = "ACTIVE";
    private static readonly PropFlowSelectOption[] RoleOptions = [new("MANAGER", "MANAGER"), new("STAFF", "STAFF"), new("ACCOUNTANT", "ACCOUNTANT")];
    private static readonly PropFlowSelectOption[] AccountStatusFilterOptions = [new("", "Tất cả trạng thái"), new("ACTIVE", "Đang hoạt động"), new("DISABLED", "Bị vô hiệu hóa"), new("LOCKED", "Đang bị khóa")];
    private static readonly PropFlowSelectOption[] AccountStatusActionOptions = [new("ACTIVE", "Kích hoạt / mở khóa"), new("DISABLED", "Vô hiệu hóa"), new("LOCKED", "Khóa")];
    private int page = 1, activityPageNumber = 1; private bool accountsLoading, activityLoading, overviewLoading, showCreate, showCreatePassword, showRoles, accessLoading, submitting; private string? error, action, overviewError, activityError, activityAction = "", notice, dialogError; private bool noticeIsError; private InternalAccount? selected;
    private static readonly PropFlowSelectOption[] ActivityActionOptions = [new("", "Tất cả hành động"), new("internal_account_created", "Tạo tài khoản"), new("internal_account_role_changed", "Đổi vai trò"), new("internal_account_status_changed", "Thay đổi trạng thái")];
    protected override async Task OnParametersSetAsync() { if (Tab == "overview") await LoadOverviewAsync(); else if (Tab == "activity") await LoadActivityAsync(); else await LoadAccountsPageAsync(true); }
    private async Task LoadOverviewAsync() { overviewLoading = true; overviewError = null; overview = null; var result = await AdministrationApi.GetOverviewAsync(); if (result.IsSuccess) overview = result.Data; else overviewError = FriendlyError(result, "Không thể tải chỉ số Tổng quan lúc này. Vui lòng thử lại."); overviewLoading = false; }
    private async Task LoadAccountsPageAsync(bool includeSummary = false) { accountsLoading = true; error = null; if (includeSummary) { var s = await AdministrationApi.GetSummaryAsync(); if (s.IsSuccess) summary = s.Data; else error = FriendlyError(s, "Không thể tải thống kê tài khoản Ban quản lý."); } var result = await AdministrationApi.GetAccountsAsync(role, search, status, page); if (result.IsSuccess) { pageData = result.Data; accounts = result.Data!.Items; } else { accounts = []; pageData = null; error = FriendlyError(result, "Không thể tải danh sách tài khoản Ban quản lý."); } accountsLoading = false; }
    private async Task LoadActivityAsync() { activityLoading = true; activityError = null; var result = await AdministrationApi.GetActivityAsync(activityAction, activityPageNumber); if (result.IsSuccess) { activityPage = result.Data; activities = result.Data!.Items; } else { activities = []; activityPage = null; activityError = FriendlyError(result, "Không thể tải nhật ký quản trị lúc này."); } activityLoading = false; }
    private async Task FilterActivityAsync(string value) { activityAction = value; activityPageNumber = 1; await LoadActivityAsync(); }
    private async Task PreviousActivityPageAsync() { if (activityPageNumber > 1) { activityPageNumber--; await LoadActivityAsync(); } }
    private async Task NextActivityPageAsync() { if (activityPage is not null && activityPageNumber * activityPage.PageSize < activityPage.Total) { activityPageNumber++; await LoadActivityAsync(); } }
    private async Task SelectRoleAsync(string value) { role = value; page = 1; await LoadAccountsPageAsync(); }
    private async Task SearchAsync() { page = 1; await LoadAccountsPageAsync(); }
    private async Task PreviousPageAsync() { if (page > 1) { page--; await LoadAccountsPageAsync(); } }
    private async Task NextPageAsync() { if (pageData is not null && page * 20 < pageData.Total) { page++; await LoadAccountsPageAsync(); } }
    private int Count(string code) => summary?.RoleCounts.TryGetValue(code, out var value) == true ? value : 0;
    private PropFlowSelectOption[] AvailableRoleOptions => RoleOptions.Where(x => x.Value != selected?.Role).ToArray();
    private PropFlowSelectOption[] AvailableStatusOptions => AccountStatusActionOptions.Where(x => x.Value != selected?.Status).ToArray();
    private void OpenCreate() { showCreate = true; showCreatePassword = false; error = null; dialogError = null; ClearNotice(); }
    private void OpenRole(InternalAccount item) { selected = item; action = "role"; nextRole = AvailableRoleOptions.First().Value; dialogError = null; ClearNotice(); }
    private void OpenStatus(InternalAccount item) { selected = item; action = "status"; nextStatus = AvailableStatusOptions.First().Value; dialogError = null; ClearNotice(); }
    private async Task OpenRolesAsync() { CloseDialogs(); showRoles = true; accessLoading = true; var result = await AdministrationApi.GetRolesAsync(); accessLoading = false; if (result.IsSuccess) roleAccess = result.Data ?? []; else { showRoles = false; ShowNotice(FriendlyError(result, "Không thể tải danh sách vai trò và quyền."), true); } }
    private async Task OpenAccessAsync(InternalAccount item) { CloseDialogs(); accessLoading = true; var result = await AdministrationApi.GetEffectiveAccessAsync(item.Id); accessLoading = false; if (result.IsSuccess) accountAccess = result.Data; else ShowNotice(FriendlyError(result, $"Không thể tải quyền hiệu lực của {item.Username}."), true); }
    private void CloseDialogs() { showCreate = false; showCreatePassword = false; showRoles = false; selected = null; accountAccess = null; action = null; dialogError = null; }
    private async Task CreateAsync() { dialogError = null; createUsername = createUsername.Trim(); createName = createName.Trim(); createEmail = createEmail.Trim(); if (string.IsNullOrWhiteSpace(createUsername)) { dialogError = "Vui lòng nhập tên đăng nhập."; return; } if (createUsername.Length is < 3 or > 50) { dialogError = "Tên đăng nhập phải có từ 3 đến 50 ký tự."; return; } if (!Regex.IsMatch(createUsername, @"^[a-zA-Z0-9_.-]+$")) { dialogError = "Tên đăng nhập chỉ gồm chữ, số, dấu chấm, gạch dưới hoặc gạch ngang."; return; } if (string.IsNullOrWhiteSpace(createName)) { dialogError = "Vui lòng nhập họ và tên."; return; } if (string.IsNullOrWhiteSpace(createEmail)) { dialogError = "Vui lòng nhập email."; return; } if (!Regex.IsMatch(createEmail, @"^[^\s@]+@[^\s@]+\.[^\s@]+$")) { dialogError = "Email không đúng định dạng."; return; } if (createPassword.Length < 12) { dialogError = "Mật khẩu phải có ít nhất 12 ký tự."; return; } if (createPassword.Length > 128) { dialogError = "Mật khẩu không được vượt quá 128 ký tự."; return; } submitting = true; var result = await AdministrationApi.CreateAsync(new(createUsername, createName, createEmail, createPassword, createRole, null)); submitting = false; if (!result.IsSuccess) { dialogError = FriendlyError(result, "Không thể tạo tài khoản lúc này. Vui lòng thử lại."); return; } var createdUsername = createUsername; CloseDialogs(); page = 1; createUsername = createName = createEmail = createPassword = ""; await LoadAccountsPageAsync(true); ShowNotice($"Đã tạo tài khoản {createdUsername} thành công."); }
    private async Task SubmitActionAsync() { if (selected is null) return; dialogError = null; var username = selected.Username; var currentAction = action; submitting = true; var result = currentAction == "role" ? await AdministrationApi.ChangeRoleAsync(selected.Id, nextRole) : await AdministrationApi.ChangeStatusAsync(selected.Id, nextStatus); submitting = false; if (!result.IsSuccess) { dialogError = FriendlyError(result, currentAction == "role" ? $"Không thể đổi vai trò của {username}." : $"Không thể cập nhật trạng thái của {username}."); return; } var message = currentAction == "role" ? $"Đã đổi vai trò của {username} sang {nextRole}." : $"Đã cập nhật trạng thái của {username} thành {StatusLabel(nextStatus)}."; CloseDialogs(); await LoadAccountsPageAsync(true); ShowNotice(message); }
    private static string StatusLabel(string value) => value switch { "ACTIVE" => "Đang hoạt động", "DISABLED" => "Bị vô hiệu hóa", "LOCKED" => "Đang bị khóa", _ => value };
    private static string StatusTone(string value) => value switch { "ACTIVE" => "connected", "LOCKED" => "locked", _ => "disabled" };
    private void ShowNotice(string message, bool isError = false) { notice = message; noticeIsError = isError; }
    private void ClearNotice() { notice = null; noticeIsError = false; }
    private static string FriendlyError(ApiResult result, string fallback)
    {
        var validationMessage = result.ValidationErrors?.Values.SelectMany(x => x).FirstOrDefault();
        if (!string.IsNullOrWhiteSpace(validationMessage)) return validationMessage;
        if (result.Code is "server_error" or "invalid_response" || string.IsNullOrWhiteSpace(result.Message)) return fallback;
        return result.Message;
    }
    private static string ActionLabel(AdministrationActivity item) => item.Action switch { "internal_account_created" => "Tạo tài khoản", "internal_account_role_changed" => "Đổi vai trò", "internal_account_status_changed" when item.NewStatus == "LOCKED" => "Khóa tài khoản", "internal_account_status_changed" when item.NewStatus == "ACTIVE" => "Kích hoạt tài khoản", "internal_account_status_changed" => "Đổi trạng thái", _ => item.Action };
    private static string ActionIcon(AdministrationActivity item) => item.Action switch { "internal_account_created" => "person_add", "internal_account_role_changed" => "manage_accounts", "internal_account_status_changed" when item.NewStatus == "LOCKED" => "lock", "internal_account_status_changed" when item.NewStatus == "ACTIVE" => "lock_open", "internal_account_status_changed" => "person_off", _ => "history" };
    private static string ActionTone(AdministrationActivity item) => item.Action switch { "internal_account_created" => "activity-created", "internal_account_role_changed" => "activity-role", "internal_account_status_changed" when item.NewStatus == "ACTIVE" => "activity-enabled", _ => "activity-status" };
    private static string ChangeContent(AdministrationActivity item) => item.Action switch { "internal_account_created" => "Tài khoản nội bộ được tạo", "internal_account_role_changed" => Transition(item.OldRole, item.NewRole), "internal_account_status_changed" => Transition(item.OldStatus, item.NewStatus), _ => "Hoạt động quản trị" };
    private static string Transition(string? oldValue, string? newValue) => oldValue is not null && newValue is not null ? $"{oldValue} → {newValue}" : newValue ?? oldValue ?? "Không có dữ liệu thay đổi";
    private static string ActorDisplay(AdministrationActivity item) => item.ActorDisplayName ?? item.ActorUsername ?? "Không có dữ liệu danh tính";
}
