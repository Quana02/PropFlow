@using System.Globalization
@using PropFlow.Web.Client.Features.Administration.Models

<article class="chart-card trend-chart-card" aria-labelledby="trend-chart-title">
    <header><div><h2 id="trend-chart-title">Yêu cầu dịch vụ mới theo ngày</h2><p>30 ngày gần nhất · Tính theo ngày tạo yêu cầu</p></div></header>
    @if (Items.Length == 0 || Items.All(item => item.Count == 0))
    {
        <p class="chart-empty">Không có yêu cầu mới trong 30 ngày gần nhất.</p>
    }
    else
    {
        <div class="trend-summary" aria-label="Tóm tắt yêu cầu mới">
            <span><strong>@Items.Sum(item => item.Count)</strong> yêu cầu mới</span>
            <span><strong>@Items.Count(item => item.Count > 0)</strong> ngày có yêu cầu</span>
            <span>Cao nhất <strong>@Maximum</strong> yêu cầu/ngày</span>
        </div>
        <p class="axis-caption">Số yêu cầu mới</p>
        <div class="trend-frame" role="region" aria-label="Biểu đồ cột yêu cầu mới theo ngày">
            <div class="trend-plot">
                <div class="y-axis" aria-hidden="true"><span>@ScaleMaximum</span><span>@(ScaleMaximum / 2)</span><span>0</span></div>
                <div class="daily-columns" style="grid-template-columns:repeat(@Items.Length,minmax(0,1fr))">
                    @for (var index = 0; index < Items.Length; index++)
                    {
                        var item = Items[index];
                        <div class="day-column @(item.Count == 0 ? "is-zero" : "")" tabindex="0" aria-label="@DayLabel(item)">
                            <div class="bar-track">
                                @if (item.Count > 0)
                                {
                                    <span class="bar" style="height:@Height(item.Count)%"><span class="bar-value">@item.Count</span></span>
                                }
                                else
                                {
                                    <span class="zero-mark" aria-hidden="true"></span>
                                }
                                <span class="day-tooltip" aria-hidden="true">@DayLabel(item)</span>
                            </div>
                            <div class="date-slot"><span class="date-label @(index % 10 == 0 ? "major-date" : null)" aria-hidden="true">@(ShowDate(index) ? item.Date.ToString("dd/MM") : "")</span></div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <p class="chart-help">Mỗi cột là một ngày · Rê chuột hoặc dùng phím Tab để xem ngày và số lượng chính xác.</p>
    }
</article>

@code {
    [Parameter] public AdministrationOverviewTrend[] Items { get; set; } = [];
    private int Maximum => Items.Select(item => item.Count).DefaultIfEmpty().Max();
    private double ScaleMaximum => Math.Max(2, Math.Ceiling(Maximum / 2d) * 2);
    private string Height(int count) => (count * 100d / ScaleMaximum).ToString("0.###", CultureInfo.InvariantCulture);
    private bool ShowDate(int index) => index == 0 || index == Items.Length - 1 || (index % 5 == 0 && index < Items.Length - 2);
    private static string DayLabel(AdministrationOverviewTrend item) => $"{item.Date:dd/MM/yyyy}: {item.Count} yêu cầu mới";
}
