@inject PropFlow.Web.Client.Shared.Feedback.ToastService Toasts
@implements IDisposable
@page "/finance/invoices/unpaid"
@layout PropFlow.Web.Client.Layout.AccountantLayout
@attribute [Authorize(Roles = "ACCOUNTANT", Policy = "finance.manage")]
@using PropFlow.Web.Client.Features.Finance.Models
@using PropFlow.Web.Client.Features.Finance.Services
@inject IFinanceApiClient Finance

<PageTitle>Hóa đơn chưa thanh toán — PropFlow</PageTitle>

<div class="unpaid-page">
    <header class="unpaid-heading pf-management-header pf-management-existing-header">
        <div class="pf-management-heading">
            <span class="pf-management-icon material-symbols-outlined" aria-hidden="true">receipt_long</span>
            <div>
                <nav class="unpaid-breadcrumb" aria-label="Đường dẫn trang"><NavLink href="/finance/dashboard">Tài chính &amp; Sổ cái</NavLink><span aria-hidden="true">›</span><span aria-current="page">Hóa đơn &amp; Công nợ</span></nav>
                <div class="title-row"><h1>Hóa đơn chưa thanh toán</h1>@if (NearestDueDate is not null) { <span class="due-badge">Hạn gần nhất @NearestDueDate.Value.ToString("dd/MM/yyyy")</span> }</div>
                <p>Theo dõi hóa đơn còn hạn thanh toán, bao gồm hóa đơn chưa thanh toán và thanh toán một phần. Hóa đơn qua hạn được theo dõi tại <a href="/finance/payments/overdue">Nợ quá hạn</a>.</p>
            </div>
        </div>
        <div class="unpaid-actions">
            <span title="Chưa khả dụng: chưa có dịch vụ xuất danh sách hóa đơn"><button type="button" disabled><span class="material-symbols-outlined">description</span> Xuất danh sách (Excel)</button></span>
            <FinanceReminderButton InvoiceIds="@(FilteredItems.Select(x => x.Id).ToArray())" />
        </div>
    </header>

    <section class="unpaid-summary pf-management-metric-group" aria-label="Tổng quan hóa đơn chưa thanh toán">
        <article class="unpaid-card"><div class="card-label"><span>TỔNG CĂN CHƯA ĐÓNG</span><span class="material-symbols-outlined">apartment</span></div><strong>@ApartmentCount <small>căn hộ</small></strong><p>Dữ liệu từ các hóa đơn đang hiển thị</p></article>
        <article class="unpaid-card amount"><div class="card-label"><span>TỔNG TIỀN CHƯA THU</span><span class="material-symbols-outlined">payments</span></div><strong>@Money(OutstandingTotal)</strong><p>Tổng dư nợ của các bản ghi đang hiển thị</p></article>
        <article class="unpaid-card due-soon"><div class="card-label"><span>SẮP ĐẾN HẠN (≤ 3 NGÀY)</span><span class="material-symbols-outlined">schedule</span></div><strong>@DueSoonCount <small>hóa đơn</small></strong><p>Dựa trên hạn thanh toán trong hệ thống</p></article>
        <article class="unpaid-card partial"><div class="card-label"><span>THANH TOÁN MỘT PHẦN</span><span class="material-symbols-outlined">pie_chart</span></div><strong>@PartialCount <small>hóa đơn</small></strong><p>Còn lại @Money(PartialOutstanding)</p></article>
    </section>

    <section class="unpaid-table-card pf-list-panel pf-management-list" aria-labelledby="unpaid-list-title">
        <h2 class="visually-hidden" id="unpaid-list-title">Danh sách hóa đơn chưa thanh toán</h2>
        <div class="unpaid-filters pf-list-toolbar pf-management-toolbar" role="group" aria-label="Bộ lọc hóa đơn">
            <label class="unpaid-search pf-list-search pf-management-search"><span class="material-symbols-outlined">search</span><span class="visually-hidden">Tìm hóa đơn</span><input type="search" placeholder="Tìm theo mã hóa đơn..." @bind="search" @bind:event="oninput" @bind:after="SearchChanged" /></label>
            <button class="unpaid-field" type="button" disabled title="Chưa có API lọc kỳ hóa đơn"><span class="material-symbols-outlined">calendar_month</span>Kỳ hóa đơn hiện tại<span class="material-symbols-outlined">expand_more</span></button>
            <button class="unpaid-field" type="button" disabled title="Dữ liệu thuộc phạm vi được phân quyền">Tất cả phạm vi<span class="material-symbols-outlined">expand_more</span></button>
            <span class="pf-management-count">@(data?.Total ?? 0) hóa đơn</span>
            <PropFlowListRefresh OnRefresh="ReloadAsync" Busy="@loading" />
        </div>
        <div class="status-filters" aria-label="Lọc trạng thái hóa đơn">
            <button class="@(filter == "ALL" ? "active" : null)" type="button" @onclick='() => SetFilter("ALL")'>Tất cả (@(data?.Counts?.GetValueOrDefault("ALL") ?? data?.Total ?? 0))</button>
            <button class="@(filter == "UNPAID" ? "active" : null)" type="button" @onclick='() => SetFilter("UNPAID")'>Chưa thanh toán (@(data?.Counts?.GetValueOrDefault("UNPAID") ?? 0))</button>
            <button class="@(filter == "DUE_SOON" ? "active due" : "due")" type="button" @onclick='() => SetFilter("DUE_SOON")'>Sắp tới hạn 3 ngày (@(data?.Counts?.GetValueOrDefault("DUE_SOON") ?? 0))</button>
            <button class="@(filter == "PARTIAL" ? "active partial" : "partial")" type="button" @onclick='() => SetFilter("PARTIAL")'>Thanh toán một phần (@(data?.Counts?.GetValueOrDefault("PARTIAL") ?? 0))</button>
            <span title="Chưa có API liên kết giao dịch chờ xác nhận"><button type="button" disabled>Chờ xác nhận giao dịch (—)</button></span>
        </div>
        <div class="unpaid-table-scroll"><table class="pf-list-table"><thead><tr><th><input type="checkbox" disabled aria-label="Chọn tất cả" /></th><th>MÃ HĐ &amp; NGÀY PHÁT<br />HÀNH</th><th>CĂN HỘ</th><th>CHI TIẾT KHOẢN PHÍ</th><th>TỔNG TIỀN CẦN THU</th><th>HẠN THANH TOÁN</th><th>TRẠNG THÁI</th><th>THAO TÁC</th></tr></thead><tbody>
            @if (loading) { <tr><td colspan="8"><FinanceUnavailableState Title="Đang tải dữ liệu…" Message="Vui lòng chờ trong giây lát." Icon="progress_activity" /></td></tr> }
            else if (!string.IsNullOrWhiteSpace(error)) { <tr><td colspan="8"><FinanceUnavailableState Title="Không thể tải dữ liệu" Message="@error" Icon="error" /><button class="retry-button" @onclick="ReloadAsync">Thử lại</button></td></tr> }
            else if (FilteredItems.Count == 0) { <tr><td colspan="8"><FinanceUnavailableState Title="Không có hóa đơn phù hợp" Message="Hãy thay đổi từ khóa hoặc bộ lọc trạng thái." Icon="inbox" /></td></tr> }
            else { @foreach (var item in FilteredItems) { <tr @key="item.Id"><td><input type="checkbox" disabled aria-label="Chọn hóa đơn @item.InvoiceNumber" /></td><td><strong><a href="@($"/finance/invoices/{item.Id}")" aria-label="Chi tiết hóa đơn @item.InvoiceNumber">@item.InvoiceNumber</a></strong><small>@Date(item.IssueDate)</small></td><td><strong>Căn hộ @(item.ApartmentNumber ?? ShortId(item.ApartmentUnitId))</strong><small>@(item.ResidentName ?? "Chưa có người nhận")</small></td><td><strong>@(item.InvoiceType == "MONTHLY_RENTAL" ? "Tiền thuê tháng" : "Phí dịch vụ") @item.BillingPeriodStart.ToString("MM/yyyy")</strong><small>@item.BillingPeriodStart.ToString("dd/MM/yyyy") – @item.BillingPeriodEnd.ToString("dd/MM/yyyy")</small></td><td class="amount-cell"><strong>@Money(item.OutstandingAmount)</strong>@if (item.ConfirmedPaidAmount > 0) { <small>Đã thu @Money(item.ConfirmedPaidAmount)</small> } else { <small>Chưa ghi nhận khoản thu</small> }</td><td class="@DueClass(item)"><strong>@Date(item.DueDate)</strong><small>@DueText(item)</small></td><td><span class="invoice-status @StatusClass(item)">@StatusName(item)</span></td><td><FinanceTableActions><button class="collect-button" type="button" @onclick="() => collecting = item"><span aria-hidden="true">＋</span> Thu tiền</button><FinanceSendInvoiceButton @key="item.Id" InvoiceId="item.Id" /></FinanceTableActions></td></tr> } }
        </tbody></table></div>
        @if (!loading && string.IsNullOrWhiteSpace(error) && data is not null && data.Total > 0) { <TablePagination Page="page" TotalPages="TotalPages" Label="Phân trang"
            PageChanged="ChangePageAsync">
            <span>Hiển thị @FilteredItems.Count / @data.Total hóa đơn chưa thanh toán</span>
        </TablePagination> }
    </section>
</div>

@if (collecting is not null) { <CollectPaymentDialog @key="collecting.Id" Invoice="collecting" Saved="CollectionSaved" Closed="() => collecting = null" /> }
@code {
    private readonly PropFlow.Web.Client.Shared.Feedback.ToastLifetime toastLifetime = new();


    private InvoiceBalance? collecting;
    private async Task CollectionSaved() {
        var operationFeedback = Toasts.BeginOperation(toastLifetime);
 collecting = null; await ReloadAsync(); operationFeedback.Publish(() => Toasts.Success("Đã ghi nhận khoản thu vào tổng thu. Hóa đơn còn dư nợ tiếp tục nằm trong danh sách chưa thu hoặc nợ quá hạn.")); }
    private PagedFinanceResult<InvoiceBalance>? data;
    private bool loading;
    private string? error;
    private string search = string.Empty;
    private string filter = "ALL";
    private int page = 1;
    private const int PageSize = 20;
    private DateOnly Today => DateOnly.FromDateTime(DateTime.Today);
    private IReadOnlyList<InvoiceBalance> FilteredItems => data?.Items ?? [];
    private int ApartmentCount => data?.Items.Select(x => x.ApartmentUnitId).Distinct().Count() ?? 0;
    private decimal OutstandingTotal => data?.Items.Sum(x => x.OutstandingAmount) ?? 0;
    private int UnpaidCount => data?.Items.Count(x => x.ConfirmedPaidAmount <= 0) ?? 0;
    private int PartialCount => data?.Items.Count(IsPartial) ?? 0;
    private decimal PartialOutstanding => data?.Items.Where(IsPartial).Sum(x => x.OutstandingAmount) ?? 0;
    private int DueSoonCount => data?.Items.Count(IsDueSoon) ?? 0;
    private DateOnly? NearestDueDate => data?.Items.Where(x => x.DueDate is not null).Select(x => x.DueDate!.Value).OrderBy(x => Math.Abs(x.DayNumber - Today.DayNumber)).FirstOrDefault();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling((data?.Total ?? 0) / (double)PageSize));

    protected override Task OnInitializedAsync() => LoadAsync(1);
    private readonly LatestRequest requests = new();
    private async Task LoadAsync(int target, int delayMs = 0)
    {
        page = Math.Max(1, target); loading = true; error = null;
        await requests.RunAsync(ct => Finance.GetUnpaidInvoicesAsync(page, search, ct, filter), result =>
        {
            data = result.IsSuccess ? result.Data : null;
            page = data?.Page ?? 1;
            error = result.IsSuccess ? null : result.Message;
            loading = false;
        }, delayMs);
    }
    private Task SearchChanged() => LoadAsync(1, 350);
    public void Dispose() { toastLifetime.Dispose(); requests.Dispose(); }
    private Task ReloadAsync() => LoadAsync(page);
    private Task ChangePageAsync(int target) => LoadAsync(target);
    private async Task SetFilter(string value) { filter = value; await LoadAsync(1); }
    private bool MatchesFilter(InvoiceBalance item) => filter switch { "UNPAID" => item.ConfirmedPaidAmount <= 0, "DUE_SOON" => IsDueSoon(item), "PARTIAL" => IsPartial(item), _ => true };
    private bool IsDueSoon(InvoiceBalance item) => item.DueDate is { } due && due.DayNumber >= Today.DayNumber && due.DayNumber - Today.DayNumber <= 3;
    private static bool IsPartial(InvoiceBalance item) => item.ConfirmedPaidAmount > 0 && item.OutstandingAmount > 0;
    private string DueText(InvoiceBalance item)
    {
        if (item.DueDate is not { } due)
        {
            return "Chưa có hạn";
        }

        var days = due.DayNumber - Today.DayNumber;
        if (days < 0)
        {
            return $"Quá hạn {-days} ngày";
        }

        return days == 0 ? "Đến hạn hôm nay" : $"Còn {days} ngày";
    }
    private string DueClass(InvoiceBalance item) => item.DueDate is { } due && due.CompareTo(Today) == -1 ? "due-cell overdue" : "due-cell";
    private static string StatusName(InvoiceBalance item) => IsPartial(item) ? "Đóng một phần" : "Chưa nộp";
    private static string StatusClass(InvoiceBalance item) => IsPartial(item) ? "status-partial" : "status-unpaid";
    private static string Money(decimal value) => PropFlowMoneyText.Format(value) + " ₫";
    private static string Date(DateOnly? value) => value?.ToString("dd/MM/yyyy") ?? "—";
    private static string ShortId(Guid id) => id.ToString("N")[..8].ToUpperInvariant();
}
