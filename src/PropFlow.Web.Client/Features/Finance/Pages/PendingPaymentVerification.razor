@page "/finance/payments/pending"
@layout PropFlow.Web.Client.Layout.AccountantLayout
@attribute [Authorize(Roles = "ACCOUNTANT")]
@using PropFlow.Web.Client.Features.Finance.Models
@using PropFlow.Web.Client.Features.Finance.Services
@inject IFinanceApiClient Finance

<PageTitle>Thanh toán chờ xác minh — PropFlow</PageTitle>

<div class="pending-page">
    <header class="pending-heading">
        <div>
            <nav class="pending-breadcrumb" aria-label="Đường dẫn trang"><NavLink href="/finance/dashboard">Tài chính &amp; Sổ cái</NavLink><span aria-hidden="true">›</span><span aria-current="page">Đối soát ngân hàng</span></nav>
            <div class="title-row"><h1>Các khoản thanh toán chờ xác minh</h1><span class="realtime-badge"><i></i> Đối soát thời gian thực 24/7</span></div>
            <p>Đối soát các giao dịch chuyển khoản, VietQR và tiền mặt trước khi xác nhận giảm công nợ.</p>
        </div>
        <div class="pending-actions">
            <span title="Chưa khả dụng: chưa có dịch vụ xuất danh sách"><button type="button" disabled><span class="material-symbols-outlined">description</span> Xuất danh sách (Excel)</button></span>
            <span title="Chưa khả dụng: chưa có dịch vụ AI matching"><button type="button" disabled><span class="material-symbols-outlined">auto_awesome</span> Khớp nhanh AI</button></span>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(notice)) { <div class="pending-notice" role="status"><span class="material-symbols-outlined">check_circle</span>@notice</div> }

    <section class="pending-summary" aria-label="Tổng quan thanh toán chờ xác minh">
        <article class="pending-card"><div class="pending-card-label"><span>TỔNG GIAO DỊCH CHỜ</span><span class="material-symbols-outlined">receipt_long</span></div><strong>@Value(data?.Total) <small>giao dịch</small></strong><p>Giao dịch đang chờ kế toán xử lý</p></article>
        <article class="pending-card pending-amount"><div class="pending-card-label"><span>TỔNG SỐ TIỀN TREO</span><span class="material-symbols-outlined">payments</span></div><strong>@Money(PendingAmount)</strong><p>Tổng tiền của các bản ghi đang hiển thị</p></article>
        <article class="pending-card ai-card"><div class="pending-card-label"><span>AI MATCH CHÍNH XÁC</span><span class="material-symbols-outlined">auto_awesome</span></div><strong>—</strong><p>Chưa tích hợp dịch vụ AI matching</p></article>
        <article class="pending-card manual-card"><div class="pending-card-label"><span>CẦN RÀ SOÁT THỦ CÔNG</span><span class="material-symbols-outlined">priority_high</span></div><strong>@CurrentPageCount <small>giao dịch</small></strong><p>Các bản ghi chờ quyết định trên trang</p></article>
    </section>

    <section class="pending-toolbar" aria-label="Bộ lọc giao dịch chờ">
        <div class="pending-filters">
            <label class="pending-search"><span class="material-symbols-outlined">search</span><span class="visually-hidden">Tìm giao dịch</span><input type="search" placeholder="Tìm theo mã giao dịch hoặc số tham chiếu..." @bind="search" @bind:event="oninput" @onkeyup="HandleSearchKey" /></label>
            <button class="pending-field" type="button" disabled title="Chưa có API lọc khoảng thời gian"><span class="material-symbols-outlined">calendar_month</span>Khoảng thời gian<span class="material-symbols-outlined">expand_more</span></button>
            <div class="pending-status-filters" aria-label="Trạng thái đối soát">
                <button class="active" type="button">Tất cả (@(data?.Total ?? 0))</button>
                <span title="Chưa có dữ liệu AI matching"><button type="button" disabled>Gợi ý AI &gt; 90% (—)</button></span>
                <span title="Chưa có dữ liệu sai lệch giao dịch"><button type="button" disabled>Lệch số tiền (—)</button></span>
            </div>
        </div>
    </section>

    <section class="pending-table-card" aria-labelledby="pending-list-title">
        <h2 class="visually-hidden" id="pending-list-title">Danh sách thanh toán chờ xác minh</h2>
        <div class="pending-table-scroll"><table><thead><tr><th><input type="checkbox" disabled aria-label="Chọn tất cả" /></th><th>MÃ GD &amp; THỜI GIAN</th><th>NỘI DUNG CHUYỂN KHOẢN</th><th>SỐ TIỀN NHẬN</th><th>HÓA ĐƠN LIÊN KẾT</th><th>TRẠNG THÁI ĐỐI SOÁT</th><th>THAO TÁC</th></tr></thead><tbody>
            @if (loading) { <tr><td colspan="7"><FinanceUnavailableState Title="Đang tải dữ liệu…" Message="Vui lòng chờ trong giây lát." Icon="progress_activity" /></td></tr> }
            else if (!string.IsNullOrWhiteSpace(error)) { <tr><td colspan="7"><FinanceUnavailableState Title="Không thể tải dữ liệu" Message="@error" Icon="error" /><button class="retry-button" @onclick="ReloadAsync">Thử lại</button></td></tr> }
            else if (data is null || data.Items.Length == 0) { <tr><td colspan="7"><FinanceUnavailableState Title="Không có giao dịch chờ xác minh" Message="Không tìm thấy giao dịch phù hợp với từ khóa hiện tại." Icon="inbox" /></td></tr> }
            else { @foreach (var item in data.Items) { <tr class="@(processing == item.Id ? "processing" : null)"><td><input type="checkbox" disabled aria-label="Chọn giao dịch @item.PaymentNumber" /></td><td><strong>@item.PaymentNumber</strong><small>@item.PaymentDate.ToLocalTime().ToString("dd/MM/yyyy · HH:mm")</small></td><td><strong>@(item.Note ?? "Không có nội dung")</strong><small>Tham chiếu: @(item.ReferenceNumber ?? "—")</small></td><td class="money-cell"><strong>+@Money(item.Amount)</strong><small>@Method(item.PaymentMethodCode)</small></td><td><strong>@ShortId(item.InvoiceId)</strong><small>Hóa đơn liên kết</small></td><td><span class="pending-status"><i></i>Chờ xác minh</span></td><td class="action-cell"><button class="confirm-button" disabled="@(processing == item.Id)" @onclick="() => ConfirmAsync(item.Id)">@(processing == item.Id ? "Đang xử lý…" : "Xác nhận")</button><button class="review-button" disabled="@(processing == item.Id)" @onclick="() => BeginReject(item.Id)">Rà soát</button></td></tr>@if (rejecting == item.Id) { <tr class="reject-row"><td colspan="7"><div class="reject-box"><label for="@($"reject-{item.Id}")">Lý do từ chối giao dịch @item.PaymentNumber</label><input id="@($"reject-{item.Id}")" placeholder="Nhập lý do từ chối" @bind="rejectReason" /><button class="cancel-reject" type="button" @onclick="CancelReject">Hủy</button><button class="submit-reject" type="button" disabled="@(string.IsNullOrWhiteSpace(rejectReason) || processing == item.Id)" @onclick="() => RejectAsync(item.Id)">Từ chối giao dịch</button></div></td></tr> } } }
        </tbody></table></div>
        @if (!loading && string.IsNullOrWhiteSpace(error) && data is not null && data.Total > 0) { <div class="pending-pagination"><span>Hiển thị @data.Items.Length bản ghi trên trang; tổng cộng @data.Total giao dịch chờ xác minh</span><div><button disabled="@(page <= 1)" @onclick="PreviousPage">‹</button><strong>@(page)</strong><span>/ @TotalPages</span><button disabled="@(page >= TotalPages)" @onclick="NextPage">›</button></div></div> }
    </section>
</div>

@code {
    private PagedFinanceResult<PaymentRow>? data;
    private bool loading;
    private string? error;
    private string? notice;
    private string search = string.Empty;
    private int page = 1;
    private Guid? processing;
    private Guid? rejecting;
    private string rejectReason = string.Empty;
    private const int PageSize = 20;
    private decimal PendingAmount => data?.Items.Sum(x => x.Amount) ?? 0;
    private int CurrentPageCount => data?.Items.Length ?? 0;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling((data?.Total ?? 0) / (double)PageSize));

    protected override Task OnInitializedAsync() => LoadAsync(1);
    private async Task LoadAsync(int target) { page = target; loading = true; error = null; var result = await Finance.GetPendingPaymentsAsync(page, search); data = result.Data; if (!result.IsSuccess) error = result.Message; loading = false; }
    private Task ReloadAsync() => LoadAsync(page);
    private Task PreviousPage() => LoadAsync(page - 1);
    private Task NextPage() => LoadAsync(page + 1);
    private async Task HandleSearchKey(KeyboardEventArgs args) { if (args.Key == "Enter") await LoadAsync(1); }
    private async Task ConfirmAsync(Guid id) { processing = id; notice = null; error = null; var result = await Finance.ConfirmPaymentAsync(id, Guid.NewGuid().ToString("N")); if (result.IsSuccess) { notice = "Đã xác nhận khoản thanh toán."; await LoadAsync(page); } else error = result.Message; processing = null; }
    private void BeginReject(Guid id) { rejecting = id; rejectReason = string.Empty; notice = null; }
    private void CancelReject() { rejecting = null; rejectReason = string.Empty; }
    private async Task RejectAsync(Guid id) { processing = id; notice = null; error = null; var result = await Finance.RejectPaymentAsync(id, rejectReason, Guid.NewGuid().ToString("N")); if (result.IsSuccess) { notice = "Đã từ chối khoản thanh toán."; rejecting = null; await LoadAsync(page); } else error = result.Message; processing = null; }
    private static string Value(int? value) => value?.ToString("N0") ?? "…";
    private static string Money(decimal value) => value.ToString("N0") + " ₫";
    private static string ShortId(Guid id) => id.ToString("N")[..8].ToUpperInvariant();
    private static string Method(string value) => value switch { "BANK_TRANSFER" => "Chuyển khoản", "CASH" => "Tiền mặt", "VIETQR" => "VietQR", "POS" => "POS", _ => value };
}
