@inject PropFlow.Web.Client.Shared.Feedback.ToastService Toasts
@implements IDisposable
@page "/finance/payments/pending"
@layout PropFlow.Web.Client.Layout.AccountantLayout
@attribute [Authorize(Roles = "ACCOUNTANT", Policy = "finance.manage")]
@using PropFlow.Web.Client.Features.Finance.Models
@using PropFlow.Web.Client.Features.Finance.Services
@using PropFlow.Web.Client.Shared.Feedback
@inject IFinanceApiClient Finance

<PageTitle>Thanh toán chờ xác minh — PropFlow</PageTitle>

<div class="pending-page">
    <header class="pending-heading pf-management-header pf-management-existing-header">
        <div class="pf-management-heading">
            <span class="pf-management-icon material-symbols-outlined" aria-hidden="true">payments</span>
            <div>
                <nav class="pending-breadcrumb" aria-label="Đường dẫn trang"><NavLink href="/finance/dashboard">Tài chính &amp; Sổ cái</NavLink><span aria-hidden="true">›</span><span aria-current="page">Đối soát ngân hàng</span></nav>
                <div class="title-row"><h1>Các khoản thanh toán chờ xác minh</h1><span class="realtime-badge"><i></i> Đối soát thời gian thực 24/7</span></div>
                <p>Các khoản cư dân báo đã thanh toán tự động xuất hiện tại đây để kế toán kiểm tra. Chỉ sau khi xác nhận, số tiền mới được tính vào tổng thu và giảm công nợ; hóa đơn còn thiếu tiền vẫn tiếp tục được theo dõi.</p>
            </div>
        </div>
        <div class="pending-actions">
            <a href="/finance/payments/bank-transfers">Giao dịch SePay cần xử lý →</a>
            <span title="Chưa khả dụng: chưa có dịch vụ xuất danh sách"><button type="button" disabled><span class="material-symbols-outlined">description</span> Xuất danh sách (Excel)</button></span>
            <span title="Chưa khả dụng: chưa có dịch vụ AI matching"><button type="button" disabled><span class="material-symbols-outlined">auto_awesome</span> Khớp nhanh AI</button></span>
        </div>
    </header>

    <section class="pending-summary pf-management-metric-group" aria-label="Tổng quan thanh toán chờ xác minh">
        <article class="pending-card"><div class="pending-card-label"><span>TỔNG GIAO DỊCH CHỜ</span><span class="material-symbols-outlined">receipt_long</span></div><strong>@Value(data?.Total) <small>giao dịch</small></strong><p>Giao dịch đang chờ kế toán xử lý</p></article>
        <article class="pending-card pending-amount"><div class="pending-card-label"><span>TỔNG SỐ TIỀN TREO</span><span class="material-symbols-outlined">payments</span></div><strong>@Money(PendingAmount)</strong><p>Tổng tiền của các bản ghi đang hiển thị</p></article>
        <article class="pending-card ai-card"><div class="pending-card-label"><span>AI MATCH CHÍNH XÁC</span><span class="material-symbols-outlined">auto_awesome</span></div><strong>—</strong><p>Chưa tích hợp dịch vụ AI matching</p></article>
        <article class="pending-card manual-card"><div class="pending-card-label"><span>CẦN RÀ SOÁT THỦ CÔNG</span><span class="material-symbols-outlined">priority_high</span></div><strong>@CurrentPageCount <small>giao dịch</small></strong><p>Các bản ghi chờ quyết định trên trang</p></article>
    </section>

    <section class="pending-table-card pf-list-panel pf-management-list" aria-labelledby="pending-list-title">
        <h2 class="visually-hidden" id="pending-list-title">Danh sách thanh toán chờ xác minh</h2>
        <div class="pending-filters pf-list-toolbar pf-management-toolbar" role="group" aria-label="Bộ lọc giao dịch chờ">
            <label class="pending-search pf-list-search pf-management-search"><span class="material-symbols-outlined">search</span><span class="visually-hidden">Tìm giao dịch</span><input type="search" placeholder="Mã giao dịch, hóa đơn, chủ hóa đơn, căn hộ…" @bind="search" @bind:event="oninput" @bind:after="SearchChanged" /></label>
            <button class="pending-field" type="button" disabled title="Chưa có API lọc khoảng thời gian"><span class="material-symbols-outlined">calendar_month</span>Khoảng thời gian<span class="material-symbols-outlined">expand_more</span></button>
            <div class="pending-status-filters" aria-label="Trạng thái đối soát">
                <button class="active" type="button">Tất cả (@(data?.Total ?? 0))</button>
                <span title="Chưa có dữ liệu AI matching"><button type="button" disabled>Gợi ý AI &gt; 90% (—)</button></span>
                <span title="Chưa có dữ liệu sai lệch giao dịch"><button type="button" disabled>Lệch số tiền (—)</button></span>
            </div>
            <span class="pf-management-count">@(data?.Total ?? 0) giao dịch</span>
            <PropFlowListRefresh OnRefresh="ReloadAsync" Busy="@loading" />
        </div>
        <div class="pending-table-scroll"><table class="pf-list-table"><thead><tr><th><input type="checkbox" disabled aria-label="Chọn tất cả" /></th><th>MÃ GD &amp; THỜI GIAN</th><th>NỘI DUNG CHUYỂN KHOẢN</th><th>SỐ TIỀN NHẬN</th><th>HÓA ĐƠN LIÊN KẾT</th><th>TRẠNG THÁI ĐỐI SOÁT</th><th>THAO TÁC</th></tr></thead><tbody>
            @if (loading) { <tr><td colspan="7"><FinanceUnavailableState Title="Đang tải dữ liệu…" Message="Vui lòng chờ trong giây lát." Icon="progress_activity" /></td></tr> }
            else if (!string.IsNullOrWhiteSpace(error)) { <tr><td colspan="7"><FinanceUnavailableState Title="Không thể tải dữ liệu" Message="@error" Icon="error" /><button class="retry-button" @onclick="ReloadAsync">Thử lại</button></td></tr> }
            else if (data is null || data.Items.Length == 0) { <tr><td colspan="7"><FinanceUnavailableState Title="Không có giao dịch chờ xác minh" Message="Không tìm thấy giao dịch phù hợp với từ khóa hiện tại." Icon="inbox" /></td></tr> }
            else { @foreach (var item in data.Items) { <tr @key="item.Id" class="@(processing == item.Id ? "processing" : null)"><td><input type="checkbox" disabled aria-label="Chọn giao dịch @item.PaymentNumber" /></td><td><strong>@item.PaymentNumber</strong><small>@item.PaymentDate.ToLocalTime().ToString("dd/MM/yyyy · HH:mm")</small></td><td><strong>@(item.Note ?? "Không có nội dung")</strong><small>Tham chiếu: @(item.ReferenceNumber ?? "—")</small></td><td class="money-cell"><strong>+@Money(item.Amount)</strong><small>@Method(item.PaymentMethodCode)</small></td><td><strong><a href="@($"/finance/invoices/{item.InvoiceId}")">@(item.InvoiceNumber ?? ShortId(item.InvoiceId))</a></strong><small>@(item.ResidentName ?? "Chưa có tên chủ hóa đơn")</small><small>Căn hộ @(item.ApartmentNumber ?? "Chưa xác định")</small></td><td><span class="pending-status"><i></i>Chờ xác minh</span></td><td><FinanceTableActions><FinanceSendInvoiceButton InvoiceId="item.InvoiceId" /><button class="confirm-button" type="button" disabled="@(processing == item.Id)" @onclick="() => confirming = item">@(processing == item.Id ? "Đang xử lý…" : "Xác nhận")</button><button class="review-button" type="button" disabled="@(processing == item.Id)" @onclick="() => BeginReject(item.Id)">Rà soát</button></FinanceTableActions></td></tr> } }
        </tbody></table></div>
        @if (!loading && string.IsNullOrWhiteSpace(error) && data is not null && data.Total > 0) { <TablePagination Page="page" TotalPages="TotalPages" Label="Phân trang"
            PageChanged="ChangePageAsync">
            <span>Hiển thị @data.Items.Length / @data.Total giao dịch chờ xác minh</span>
        </TablePagination> }
    </section>
</div>

@if (confirming is not null) { <PropFlowConfirmationDialog Title="Xác nhận khoản thanh toán?" Message="@($"Khi đã thực nhận khoản tiền của {confirming.PaymentNumber}, hãy xác nhận để ghi nhận khoản thu và thông báo cho cư dân.")" ConfirmText="Xác nhận khoản thu" Busy="@(processing is not null)" OnConfirm="ConfirmSelected" OnCancel="() => confirming = null" /> }
@if (rejecting is { } rejectedId && data?.Items.FirstOrDefault(item => item.Id == rejectedId) is { } rejected)
{
    <PropFlowConfirmationDialog Title="Từ chối giao dịch?" Tone="DialogTone.Danger"
        Message="@($"Khoản thanh toán {rejected.PaymentNumber} sẽ bị từ chối và không được ghi nhận vào khoản thu.")"
        ConfirmText="Từ chối giao dịch" Busy="@(processing == rejectedId)"
        ConfirmDisabled="@string.IsNullOrWhiteSpace(rejectReason)" OnConfirm="() => RejectAsync(rejectedId)"
        OnCancel="CancelRejectFeedbackCancelReject">
        <ChildContent>
            <label class="reject-reason">Lý do từ chối
                <input placeholder="Nhập lý do từ chối" @bind="rejectReason" @bind:event="oninput" />
            </label>
        </ChildContent>
    </PropFlowConfirmationDialog>
}
@code {
    private readonly PropFlow.Web.Client.Shared.Feedback.ToastLifetime rejectFeedback = new();
    private void CancelRejectFeedbackCancelReject() { CancelReject(); if (rejecting is null) rejectFeedback.Invalidate(); }

    private readonly PropFlow.Web.Client.Shared.Feedback.ToastLifetime toastLifetime = new();

    private PaymentRow? confirming;
    private async Task ConfirmSelected() { if (confirming is null || processing is not null) return; await ConfirmAsync(confirming.Id); confirming = null; }
    private PagedFinanceResult<PaymentRow>? data;
    private bool loading;
    private string? error;

    private string search = string.Empty;
    private int page = 1;
    private Guid? processing;
    private Guid? rejecting;
    private string rejectReason = string.Empty;
    private const int PageSize = 20;
    private decimal PendingAmount => data?.Items.Sum(x => x.Amount) ?? 0;
    private int CurrentPageCount => data?.Items.Length ?? 0;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling((data?.Total ?? 0) / (double)PageSize));

    protected override Task OnInitializedAsync() => LoadAsync(1);
    private readonly LatestRequest requests = new();
    private async Task LoadAsync(int target, int delayMs = 0)
    {
        page = Math.Max(1, target); loading = true; error = null;
        await requests.RunAsync(ct => Finance.GetPendingPaymentsAsync(page, search, ct), result =>
        {
            data = result.IsSuccess ? result.Data : null;
            page = data?.Page ?? 1;
            error = result.IsSuccess ? null : result.Message;
            loading = false;
        }, delayMs);
    }
    private Task SearchChanged() => LoadAsync(1, 350);
    public void Dispose() { toastLifetime.Dispose(); requests.Dispose(); }
    private Task ReloadAsync() => LoadAsync(page);
    private Task ChangePageAsync(int target) => LoadAsync(target);
    private async Task ConfirmAsync(Guid id) {
        var operationFeedback = Toasts.BeginOperation(toastLifetime);
 processing = id;  error = null; var result = await Finance.ConfirmPaymentAsync(id, Guid.NewGuid().ToString("N")); if (result.IsSuccess) { operationFeedback.Publish(() => Toasts.Success("Đã xác nhận khoản thanh toán."));  await LoadAsync(page); } else operationFeedback.Publish(() => Toasts.Error(result.Message)); processing = null; }
    private void BeginReject(Guid id) { rejecting = id; rejectReason = string.Empty;  }
    private void CancelReject() { rejecting = null; rejectReason = string.Empty; }
    private async Task RejectAsync(Guid id) {
        var operationFeedback = Toasts.BeginOperation(toastLifetime, rejectFeedback);
 processing = id;  error = null; var result = await Finance.RejectPaymentAsync(id, rejectReason, Guid.NewGuid().ToString("N")); if (result.IsSuccess) { operationFeedback.Publish(() => Toasts.Success("Đã từ chối khoản thanh toán.")); rejecting = null; await LoadAsync(page); } else operationFeedback.Publish(() => Toasts.Error(result.Message)); processing = null; }
    private static string Value(int? value) => value?.ToString("N0") ?? "…";
    private static string Money(decimal value) => PropFlowMoneyText.Format(value) + " ₫";
    private static string ShortId(Guid id) => id.ToString("N")[..8].ToUpperInvariant();
    private static string Method(string value) => value switch { "BANK_TRANSFER" => "Chuyển khoản", "CASH" => "Tiền mặt", "VIETQR" => "VietQR", "POS" => "POS", _ => value };
}
