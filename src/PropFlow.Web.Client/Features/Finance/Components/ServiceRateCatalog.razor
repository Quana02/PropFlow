@inject FinanceCycleApi Api
<section class="billing-workspace">
    <h1>Đơn giá dịch vụ, nước và điện</h1><p>Dịch vụ theo m² đã gồm giữ xe. Nước theo m³ và điện theo kWh tháng trước do manager nhập tại danh sách căn hộ. Đơn giá do manager quy định; hạn thanh toán ngày 10.</p>
    @if (error is not null) { <p role="alert">@error</p> }
    <table><thead><tr><th>Hiệu lực từ</th><th>Dịch vụ VND/m²/tháng</th><th>Đơn giá nước</th><th>Điện VND/kWh</th></tr></thead><tbody>@foreach(var r in rates) { <tr><td>@r.EffectiveFrom.ToString("MM/yyyy")</td><td>@r.UnitRate.ToString("N0") đ</td><td>@(r.WaterM3UnitRate is { } waterM3 ? waterM3.ToString("N0") + " đ/m³" : r.WaterUnitRate is { } water ? water.ToString("N0") + " đ/người/tháng (phiên bản cũ)" : "Chưa cấu hình")</td><td>@(r.ElectricityUnitRate is { } electric ? electric.ToString("N0") + " đ" : "Chưa cấu hình")</td></tr> }</tbody></table>
    @if(rates.Length == 0 && error is null) { <p>Manager chưa cấu hình đơn giá.</p> }
</section>
@code {
    private ServiceRateRow[] rates = []; private string? error;
    protected override async Task OnInitializedAsync() { var r = await Api.GetAsync<ServiceRateRow[]>("api/v1/billing/cycle/rates"); rates = r.Data ?? []; error = r.IsSuccess ? null : r.Message; }
}
