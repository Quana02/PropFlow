@implements IDisposable
@inject PropFlow.Web.Client.Shared.Feedback.ToastService Toasts
@inject FinanceCycleApi Api
<FinancePricingDialog Title="@($"Chỉ số điện và nước · {UnitNumber}")" Busy="busy" OnClose="Closed">
    <p>Nhập chỉ số công tơ hiện tại. Sản lượng được tính từ chỉ số đã ghi gần nhất trước tháng này.</p>
    <label>Tháng sử dụng<input type="month" value="@month" max="@DateTime.Today.ToString("yyyy-MM")" @onchange="ChangeMonth" disabled="@busy" aria-invalid="@(monthError is not null)" aria-describedby="electricity-month-error" />@if (monthError is not null) { <small id="electricity-month-error" role="alert">@monthError</small> }</label>
    @if (error is not null) { <p role="alert">@error</p> }

    @if (busy) { <p role="status">Đang xử lý…</p> }
    @if (data is not null)
    {
        <form @onsubmit="Save" @onsubmit:preventDefault novalidate>
            <label>Chỉ số điện trước (kWh)<input readonly value="@Format(data.PreviousElectricityReading)" /></label>
            <FinanceNumberField Label="Chỉ số điện hiện tại (kWh)" Placeholder="Nhập chỉ số công tơ điện" Required="false"
                Min="data.PreviousElectricityReading" ValidChanged="value => kwhValid = value" @bind-Value="kwh" DecimalPlaces="3" ShowErrors="validate" Disabled="@(busy || data.IsLocked)" />
            <p>Điện đã sử dụng: @Preview(kwh, data.PreviousElectricityReading, data.Kwh, data.CurrentElectricityReading, kwhValid) kWh</p>
            <label>Chỉ số nước trước (m³)<input readonly value="@Format(data.PreviousWaterReading)" /></label>
            <FinanceNumberField Label="Chỉ số nước hiện tại (m³)" Placeholder="Nhập chỉ số công tơ nước" Required="false"
                Min="data.PreviousWaterReading" ValidChanged="value => waterValid = value" @bind-Value="waterM3" DecimalPlaces="3" ShowErrors="validate" Disabled="@(busy || data.IsLocked)" />
            <p>Nước đã sử dụng: @Preview(waterM3, data.PreviousWaterReading, data.WaterM3, data.CurrentWaterReading, waterValid) m³</p>
            <p>Thu trên hóa đơn tháng @data.UsageMonth.AddMonths(1).ToString("MM/yyyy"). Chỉ nhập chỉ số của công tơ đã kiểm tra.</p>
            @if (data.IsLocked) { <p role="status">Đã có hóa đơn cho kỳ thu này. Số điện được khóa để giữ nguyên chứng từ.</p> }
            else { <button type="submit" disabled="@busy">Lưu điện và nước</button> }
            @if (data.UpdatedAt is { } at) { <small>Lần lưu gần nhất: @at.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small> }
        </form>
    }
</FinancePricingDialog>
@code {
    private readonly PropFlow.Web.Client.Shared.Feedback.ToastLifetime toastLifetime = new();
    public void Dispose() => toastLifetime.Dispose();

    [Parameter] public Guid ApartmentId { get; set; }
    [Parameter] public string UnitNumber { get; set; } = "";
    [Parameter] public EventCallback Closed { get; set; }
    private string month = DateTime.Today.ToString("yyyy-MM");
    private decimal? kwh, waterM3;
    private ElectricityUsageView? data;
    private bool busy, validate;
    private bool kwhValid = true, waterValid = true;
    private string? error, monthError;
    protected override Task OnInitializedAsync() => Load();
    private async Task ChangeMonth(ChangeEventArgs args) { month = args.Value?.ToString() ?? "";  validate = false; await Load(); }
    private bool TryMonth(out DateOnly date) => DateOnly.TryParseExact(month + "-01", "yyyy-MM-dd", out date);
    private static string Format(decimal? value) => value?.ToString("0.###") ?? "—";
    private static string Preview(decimal? current, decimal previous, decimal? saved, decimal? savedReading, bool valid) =>
        valid ? Format(current is null && savedReading is null ? saved : current - previous) : "—";
    private async Task Load()
    {
        data = null; kwh = waterM3 = null; kwhValid = waterValid = true; error = monthError = null;
        if (!TryMonth(out var date)) { monthError = "Vui lòng chọn tháng sử dụng điện hợp lệ."; return; }
        if (date > new DateOnly(DateTime.Today.Year, DateTime.Today.Month, 1)) { monthError = "Không được nhập số điện cho tháng tương lai."; return; }
        busy = true;
        try { var result = await Api.GetAsync<ElectricityUsageView>($"api/v1/billing/cycle/apartments/{ApartmentId}/electricity?usageMonth={date:yyyy-MM-dd}");
            if (result.IsSuccess) { data = result.Data; kwh = data?.CurrentElectricityReading; waterM3 = data?.CurrentWaterReading; } else error = result.Message;
        } finally { busy = false; }
    }
    private async Task Save()
    {
        var operationFeedback = Toasts.BeginOperation(toastLifetime);

        if (busy || data is null || data.IsLocked) return;
        validate = true; error = null;
        if (!TryMonth(out var date) || !kwhValid || !waterValid || kwh is null && waterM3 is null) { error = "Nhập ít nhất một chỉ số hợp lệ, bằng hoặc lớn hơn chỉ số trước."; return; }
        busy = true; error = null;
        try { var result = await Api.PutAsync<object>($"api/v1/billing/cycle/apartments/{ApartmentId}/utilities", new UtilityUsageInput(date, kwh, waterM3));
            if (result.IsSuccess) { await Load(); operationFeedback.Publish(() => Toasts.Success("Đã lưu điện và nước. Sản lượng tháng này được thu trên hóa đơn tháng sau theo đơn giá đã cấu hình.")); }
            else { if (result.ValidationErrors?.Count > 0) error = string.Join(" ", result.ValidationErrors.Values.SelectMany(value => value)); else operationFeedback.Publish(() => Toasts.Error(result.Message)); }
        } finally { busy = false; }
    }
}
