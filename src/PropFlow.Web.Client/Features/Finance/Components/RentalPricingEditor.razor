@using PropFlow.Web.Client.Features.Finance.Services
@inject FinanceCycleApi Api
<section class="rental-pricing">
    <h2>Đơn giá thuê căn hộ</h2>
    <p>Các căn cùng loại dùng chung đơn giá. Giá tháng và giá ngày được lưu riêng; hóa đơn thuê tháng dùng giá tháng. Tiền thuê chỉ áp dụng cho chủ hộ đang thuê căn chưa có chủ sở hữu. Số ngày lấy từ ngày bắt đầu đến ngày kết thúc cư trú, gồm cả hai ngày; tháng lẻ chia đơn giá tháng theo số ngày trong tháng. Phí dịch vụ vẫn được tính riêng.</p>
    <form @onsubmit="Save" @onsubmit:preventDefault>
        <label>Loại căn hộ<select required @bind="apartmentId" @bind:after="LoadVersions"><option value="@Guid.Empty">Chọn loại căn hộ</option>@foreach(var a in apartmentTypes) { <option value="@a.Id">@a.Name</option> }</select></label>
        <label>Cơ sở tính thuê<select required @bind="basis" @bind:after="SelectBasis"><option value="">Chọn cơ sở tính</option><option value="MONTHLY">Theo tháng</option><option value="DAILY">Theo ngày</option></select></label>
        <label>Đơn giá VND<input type="number" required min="0" step="1" @bind="amount" /></label>
        <label>Ngày hiệu lực<input type="date" required @bind="effectiveFrom" /></label>
        <button type="submit" disabled="@busy">Lưu đơn giá thuê</button>
    </form>
    @if(message is not null) { <p role="status">@message</p> }
    <table><thead><tr><th>Cơ sở tính</th><th>Đơn giá</th><th>Từ ngày</th><th>Đến ngày</th><th></th></tr></thead><tbody>
    @foreach(var v in versions) { <tr><td>@(v.Basis == "DAILY" ? "Theo ngày" : "Theo tháng")</td><td>@v.UnitRate.ToString("N0") đ</td><td>@v.EffectiveFrom.ToString("dd/MM/yyyy")</td><td>@v.EffectiveTo?.ToString("dd/MM/yyyy")</td><td><button type="button" @onclick="() => Edit(v)">Chọn phiên bản</button></td></tr> }
    </tbody></table>
</section>
@code {
    private ApartmentType[] apartmentTypes = []; private Version[] versions = [];
    private Guid apartmentId; private string basis = ""; private decimal amount;
    private DateTime effectiveFrom = DateTime.Today; private bool busy; private string? message;
    protected override async Task OnInitializedAsync() { var r = await Api.GetAsync<Apartment[]>("api/v1/billing/rental-pricing/apartments"); apartmentTypes = (r.Data ?? []).Where(x => x.ApartmentTypeId != null).Select(x => new ApartmentType(x.ApartmentTypeId!.Value, x.ApartmentTypeName ?? "Loại căn hộ")).DistinctBy(x => x.Id).OrderBy(x => x.Name).ToArray(); if(!r.IsSuccess) message = r.Message; }
    private async Task LoadVersions() {
        versions = []; basis = ""; amount = 0; effectiveFrom = DateTime.Today;
        if(apartmentId == Guid.Empty) return;
        var r = await Api.GetAsync<Version[]>($"api/v1/billing/rental-pricing?apartmentTypeId={apartmentId}");
        versions = r.Data ?? []; if(!r.IsSuccess) message = r.Message;
        var today = DateOnly.FromDateTime(DateTime.Today);
        var current = versions.OrderBy(x => x.Basis == "MONTHLY" ? 0 : 1).FirstOrDefault(x => x.EffectiveFrom <= today && (x.EffectiveTo == null || x.EffectiveTo >= today));
        if(current is not null) Edit(current);
    }
    private void SelectBasis() {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var current = versions.FirstOrDefault(x => x.Basis == basis && x.EffectiveFrom <= today && (x.EffectiveTo == null || x.EffectiveTo >= today));
        if (current is not null) Edit(current); else amount = 0;
    }
    private void Edit(Version v) { basis = v.Basis; amount = v.UnitRate; effectiveFrom = v.EffectiveFrom.ToDateTime(TimeOnly.MinValue); }
    private async Task Save() { if(busy) return; busy = true; try {
        var r = await Api.PostAsync<object>("api/v1/billing/rental-pricing", new { apartmentUnitId = Guid.Empty, apartmentTypeId = apartmentId, basis, unitRate = amount, effectiveFrom = DateOnly.FromDateTime(effectiveFrom) });
        message = r.IsSuccess ? "Đã lưu đơn giá thuê. Hóa đơn đã phát hành được giữ nguyên." : r.Message;
        if(r.IsSuccess) await LoadVersions();
    } finally { busy = false; } }
    private sealed record Apartment(Guid Id, string UnitNumber, Guid? ApartmentTypeId, string? ApartmentTypeName);
    private sealed record ApartmentType(Guid Id, string Name);
    private sealed record Version(Guid Id, Guid ApartmentUnitId, string Basis, decimal UnitRate, DateOnly EffectiveFrom, DateOnly? EffectiveTo);
}
