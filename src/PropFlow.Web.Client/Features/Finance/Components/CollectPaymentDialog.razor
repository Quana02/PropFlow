@using PropFlow.Web.Client.Features.Finance.Models
@using PropFlow.Web.Client.Features.Finance.Services
@using PropFlow.Web.Client.Shared.Feedback
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject FinanceCycleApi Api
<div class="collection-backdrop" popover="manual">
<section @ref="dialog" class="collection-dialog" role="dialog" aria-modal="true" aria-labelledby="collect-title" tabindex="-1">
    <h2 id="collect-title">@ActionLabel — @Invoice.InvoiceNumber</h2>
    <p>Còn phải thu: <strong>@Invoice.OutstandingAmount.ToString("N0", Vi) đ</strong></p>
    <form @onsubmit="Save" @onsubmit:preventDefault>
        <label>Số tiền (VND)<input @ref="moneyInput" type="text" inputmode="numeric" maxlength="25" placeholder="Nhập số tiền thu" @bind:get="amountText" @bind:set="SetAmount" @bind:event="oninput" aria-invalid="@(amountError is not null)" aria-describedby="collection-amount-error" disabled="@busy" /><PropFlowMoneyBehavior Input="@(() => moneyInput)" /></label>
        @if (amountError is not null) { <p id="collection-amount-error" role="alert">@amountError</p> }
        <label>Phương thức<PropFlowSelect @bind-Value="method" Options="PaymentMethodOptions" AriaLabel="Phương thức thanh toán" Disabled="busy" /></label>
        <label>Mã tham chiếu<input maxlength="100" @bind="reference" disabled="@busy" /></label>
        <label>Ghi chú<input maxlength="1000" @bind="note" disabled="@busy" /></label>
        <label><input type="checkbox" @bind="verified" disabled="@busy" /> Tôi đã kiểm tra và thực nhận khoản tiền này.</label>
        @if (error is not null) { <p role="alert">@error</p> }
        <button type="submit" disabled="@(busy || !verified)">@(busy ? "Đang ghi nhận…" : "Xác nhận thu tiền")</button>
        <button type="button" disabled="@busy" @onclick="() => Closed.InvokeAsync()">Đóng</button>
    </form>
</section>
</div>
@if (confirming)
{
    <PropFlowConfirmationDialog Title="Xác nhận thu tiền?" Message="@($"Bạn có muốn ghi nhận thu {amount.ToString("N0", Vi)} đ cho hóa đơn {Invoice.InvoiceNumber} không?")" ConfirmText="Có" CancelText="Không" Destructive="false" Busy="@busy" OnConfirm="ConfirmSave" OnCancel="() => confirming = false" />
}
@code {
    private ElementReference dialog;
    private ElementReference moneyInput;
    private IJSObjectReference? module;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        module = await JS.InvokeAsync<IJSObjectReference>("import", "./Shared/Feedback/PropFlowConfirmationDialog.razor.js?v=20261015.2");
        await module.InvokeVoidAsync("open", dialog);
    }
    public async ValueTask DisposeAsync()
    {
        if (module is null) return;
        try { await module.InvokeVoidAsync("close", dialog); await module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
    [Parameter, EditorRequired] public InvoiceBalance Invoice { get; set; } = default!;
    [Parameter] public string ActionLabel { get; set; } = "Thu tiền";
    [Parameter] public EventCallback Saved { get; set; }
    [Parameter] public EventCallback Closed { get; set; }
    private static readonly IReadOnlyList<PropFlowSelectOption> PaymentMethodOptions =
    [
        new("CASH", "Tiền mặt"),
        new("BANK_TRANSFER", "Chuyển khoản")
    ];
    private decimal amount; private string method = "CASH", reference = "", note = "";
    private string? error; private bool verified, busy, confirming; private string key = Guid.NewGuid().ToString(), lastPayload = "";
    private string amountText = "";
    private string? amountError;
    private static readonly System.Globalization.NumberFormatInfo Vi = new() { NumberGroupSeparator = ".", NumberDecimalSeparator = "," };
    protected override void OnInitialized() { amount = Invoice.OutstandingAmount; amountText = PropFlowMoneyText.Format(amount); }
    private void SetAmount(string? text) => AmountChanged(new ChangeEventArgs { Value = text });
    private void AmountChanged(ChangeEventArgs args)
    {
        var raw = args.Value?.ToString() ?? "";
        if (raw.Any(c => !char.IsAsciiDigit(c) && c != '.')) { amountError = "Chỉ nhập số tiền VND nguyên, ví dụ 10.000."; amountText = raw; amount = 0; return; }
        var digits = PropFlowMoneyText.NormalizeEdit(amountText, raw);
        if (!decimal.TryParse(digits, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out amount)) {
            amountText = raw; amountError = "Vui lòng nhập số tiền hợp lệ."; return;
        }
        amountText = PropFlowMoneyText.Format(amount);
        amountError = amount <= 0 ? "Số tiền phải lớn hơn 0 đ." : amount > Invoice.OutstandingAmount
            ? $"Số tiền không được vượt quá số còn phải thu {Invoice.OutstandingAmount.ToString("N0", Vi)} đ." : null;
        error = null;
    }
    private Task Save() {
        if (busy || !verified) return Task.CompletedTask;
        if (amountError is not null) return Task.CompletedTask;
        if (amount <= 0 || amount > Invoice.OutstandingAmount || amount != decimal.Round(amount, 0)) { error = "Số tiền phải là VND nguyên và không vượt dư nợ."; return Task.CompletedTask; }
        confirming = true;
        return Task.CompletedTask;
    }
    private async Task ConfirmSave() {
        if (busy || !verified) return;
        if (amountError is not null) { confirming = false; return; }
        if (amount <= 0 || amount > Invoice.OutstandingAmount || amount != decimal.Round(amount, 0)) { error = "Số tiền phải là VND nguyên và không vượt dư nợ."; return; }
        var input = new CollectionInput(Invoice.Id, amount, method, reference, note);
        var payload = System.Text.Json.JsonSerializer.Serialize(input);
        if (payload != lastPayload) { key = Guid.NewGuid().ToString(); lastPayload = payload; }
        busy = true; error = null;
        try { var result = await Api.CollectAsync(input, key); if (result.IsSuccess) await Saved.InvokeAsync(); else error = result.Message; }
        finally { busy = false; confirming = false; }
    }
}
