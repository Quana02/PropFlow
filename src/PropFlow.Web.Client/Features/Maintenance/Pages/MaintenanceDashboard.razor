    private bool ValidateManualTask()
    {
        ClearTaskValidationErrors();
        if (TaskEditor.FacilityId is not { } facilityId || facilityId == Guid.Empty) TaskFacilityError = "Vui lòng chọn cơ sở vật chất.";
        if (TaskEditor.PlannedStartAt is null) TaskPlannedStartError = "Vui lòng chọn thời điểm dự kiến.";
        if (TaskEditor.DueAt is null) TaskDueError = "Vui lòng chọn hạn hoàn thành.";
        else if (TaskEditor.PlannedStartAt is { } plannedStart && TaskEditor.DueAt <= plannedStart) TaskDueError = "Hạn hoàn thành phải sau thời điểm dự kiến.";
        return TaskFacilityError is null && TaskPlannedStartError is null && TaskDueError is null;
    }
