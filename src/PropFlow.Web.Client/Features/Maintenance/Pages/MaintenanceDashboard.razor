    private async Task ReviewResult(string decision)
    {
        if (ProgressMonitor?.LatestResult is null) return;
        IsReviewSaving = true;
        ErrorMessage = null;
        var result = await MaintenanceApi.ReviewResultAsync(ProgressMonitor.Id, ProgressMonitor.LatestResult.Id,
            new ReviewMaintenanceResultModel { Decision = decision, ReviewNote = ReviewEditor.ReviewNote }, cts.Token);
        IsReviewSaving = false;
        if (!result.IsSuccess || result.Data is null) { ErrorMessage = result.Message ?? "Không thể lưu kết quả review."; return; }
        ProgressMonitor = result.Data;
        ReviewEditor = new();
        SuccessMessage = decision == "approve" ? "Đã chấp nhận kết quả và đóng công việc." : "Đã yêu cầu tiếp tục xử lý công việc.";
        if (!IsScheduleWorkspace && !IsHistoryWorkspace) await LoadTasks();
    }
