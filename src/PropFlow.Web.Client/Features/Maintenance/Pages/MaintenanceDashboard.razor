    private IReadOnlyList<ScheduleModel> DaySchedules(DateOnly day) => Schedules.Items
        .Where(item => DateOnly.FromDateTime(InCurrentTimeZone(item.PlannedStartAt).DateTime) == day)
        .OrderBy(item => item.PlannedStartAt)
        .ToList();
    private DateTimeOffset InCurrentTimeZone(DateTimeOffset value) => TimeZoneInfo.ConvertTime(value, CurrentZone());
    private DateOnly DatePart(DateTimeOffset value) => DateOnly.FromDateTime(InCurrentTimeZone(value).DateTime);
    private TimeOnly TimePart(DateTimeOffset value) => TimeOnly.FromDateTime(InCurrentTimeZone(value).DateTime);
    private DateTimeOffset CombineLocalDateTime(DateOnly date, TimeOnly time)
    {
        var local = date.ToDateTime(time);
        return new DateTimeOffset(local, CurrentZone().GetUtcOffset(local));
    }
    private static bool TryParseTime(string? value, out TimeOnly time) => TimeOnly.TryParse(value, out time);
    private DateTimeOffset StartOfLocalDay(DateOnly date)
    {
        var local = date.ToDateTime(TimeOnly.MinValue);
        return new DateTimeOffset(local, CurrentZone().GetUtcOffset(local)).ToUniversalTime();
    }
    private DateTimeOffset EndOfLocalDay(DateOnly date) => StartOfLocalDay(date.AddDays(1)).AddTicks(-1);
    private TimeZoneInfo CurrentZone()
    {
        try { return TimeZoneInfo.FindSystemTimeZoneById(TimeZoneId); }
        catch (TimeZoneNotFoundException) { return TimeZoneInfo.Local; }
        catch (InvalidTimeZoneException) { return TimeZoneInfo.Local; }
    }
    private static DateOnly StartOfWeek(DateOnly date) => date.AddDays(-((int)date.DayOfWeek + 6) % 7);
    private static string DayLabel(DateOnly date) => date.DayOfWeek switch
    {
        DayOfWeek.Monday => "THỨ 2",
        DayOfWeek.Tuesday => "THỨ 3",
        DayOfWeek.Wednesday => "THỨ 4",
        DayOfWeek.Thursday => "THỨ 5",
        DayOfWeek.Friday => "THỨ 6",
        DayOfWeek.Saturday => "THỨ 7",
        _ => "CHỦ NHẬT"
    };

    private string AssetFor(ScheduleModel s)
    {
        var asset = Assets.FirstOrDefault(a => a.Id == s.EquipmentId) ?? Assets.FirstOrDefault(a => a.Id == s.FacilityId);
        return asset is null ? "—" : AssetLabel(asset);
    }
    private string AssetName(Guid id) => Assets.FirstOrDefault(asset => asset.Id == id) is { } asset ? AssetLabel(asset) : "Đang tải thông tin tài sản";
    private string HistoryAssetContext(MaintenanceHistoryItemModel item)
    {
        var facility = item.FacilityId is { } facilityId ? AssetName(facilityId) : null;
        var equipment = item.EquipmentId is { } equipmentId ? AssetName(equipmentId) : null;
        return facility is null && equipment is null ? "Chưa gắn tài sản" : string.Join(" · ", new[] { facility, equipment }.Where(value => value is not null));
    }
    private AssetModel? AssetById(Guid? id) => id is { } value ? Assets.FirstOrDefault(asset => asset.Id == value) : null;
    private AssetModel? HistoryPrimaryAsset(MaintenanceHistoryItemModel item) => AssetById(item.EquipmentId) ?? AssetById(item.FacilityId);
    private string HistoryPrimaryAssetName(MaintenanceHistoryItemModel item) => HistoryPrimaryAsset(item)?.Name ?? "Chưa gắn tài sản";
    private string HistoryPrimaryAssetCode(MaintenanceHistoryItemModel item) => HistoryPrimaryAsset(item)?.Code ?? "—";
    private string HistoryAssetLocation(MaintenanceHistoryItemModel item) => HistoryPrimaryAsset(item)?.LocationDescription ?? AssetById(item.FacilityId)?.LocationDescription ?? "—";
    private string HistoryFacilityName(MaintenanceHistoryItemModel item) => AssetById(item.FacilityId)?.Name ?? "Chưa gắn cơ sở vật chất";
    private string HistoryEquipmentName(MaintenanceHistoryItemModel item) => AssetById(item.EquipmentId)?.Name ?? "Chưa gắn thiết bị";
    private string HistoryFacilityMetadata(MaintenanceHistoryItemModel item) => AssetMetadata(AssetById(item.FacilityId));
    private string HistoryEquipmentMetadata(MaintenanceHistoryItemModel item) => AssetMetadata(AssetById(item.EquipmentId));
    private static string AssetMetadata(AssetModel? asset) => asset is null ? "—" : string.Join(" · ", new[] { asset.Code, asset.LocationDescription }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private static string HistoryTypeLabel(MaintenanceHistoryItemModel item) => item.SourceScheduleCode is null ? "Công việc trực tiếp" : "Theo lịch";
    private static string HistorySourceLabel(MaintenanceHistoryItemModel item) => item.SourceScheduleCode is null
        ? "Công việc trực tiếp"
        : string.IsNullOrWhiteSpace(item.SourceScheduleTitle) ? item.SourceScheduleCode : $"{item.SourceScheduleCode} · {item.SourceScheduleTitle}";
    private string FormatHistoryDateTime(DateTimeOffset value) => InCurrentTimeZone(value).ToString("dd/MM/yyyy HH:mm");
    private static string CompletionTimelinessLabel(MaintenanceHistoryItemModel item) => item.CompletedAt is { } completed && item.DueAt is { } due
        ? completed <= due ? "Đúng hạn" : "Hoàn thành muộn"
        : "Đã hoàn thành";
    private string HistoryCompletionContext(MaintenanceHistoryItemModel item) => item.ClosedAt is { } closed
        ? $"Đã đóng · {FormatHistoryDateTime(closed)}"
        : item.CompletedAt is { } completed ? $"Đã hoàn thành · {FormatHistoryDateTime(completed)}" : "Chưa có thời điểm hoàn thành";
    private static string HistoryParticipantsLabel(MaintenanceHistoryItemModel item) => item.Participants.Count switch
    {
        0 => "Chưa có nhân viên tham gia",
        1 => HistoryStaffLabel(item.Participants[0].DisplayName, item.Participants[0].Username),
        _ => $"{HistoryStaffLabel(item.Participants[^1].DisplayName, item.Participants[^1].Username)} · {item.Participants.Count - 1} nhân viên trước"
    };
    private static string HistoryStaffLabel(string? displayName, string? username) => string.IsNullOrWhiteSpace(displayName)
        ? "Không tìm thấy thông tin nhân viên"
        : string.IsNullOrWhiteSpace(username) ? displayName : $"{displayName} ({username})";
    private string TaskAssetContext(MaintenanceTaskModel task)
    {
        var facility = task.FacilityId is { } facilityId ? AssetName(facilityId) : null;
        var equipment = task.EquipmentId is { } equipmentId ? AssetName(equipmentId) : null;
        return facility is null && equipment is null ? "Chưa gắn tài sản" : string.Join(" · ", new[] { facility, equipment }.Where(value => value is not null));
    }
    private static string AssigneeLabel(MaintenanceTaskModel task) => task.AssignedStaffUserId is null
        ? "Chưa phân công"
        : string.IsNullOrWhiteSpace(task.AssignedStaffDisplayName)
            ? "Nhân viên không còn hoạt động"
            : string.IsNullOrWhiteSpace(task.AssignedStaffUsername)
                ? task.AssignedStaffDisplayName
                : $"{task.AssignedStaffDisplayName} ({task.AssignedStaffUsername})";
    private IReadOnlyList<AssignableMaintenanceStaffModel> SelectableStaff => TaskForAssignment?.AssignedStaffUserId is { } current
        ? AssignableStaff.Where(staff => staff.UserId != current).ToArray()
        : AssignableStaff;
    private string FormatDateTime(DateTimeOffset value) => InCurrentTimeZone(value).ToString("dd/MM/yyyy HH:mm");
    private string OptionalDateTime(DateTimeOffset? value) => value is { } timestamp ? FormatDateTime(timestamp) : "Chưa xác định";
    private string ProgressUpdateLabel(MaintenanceTaskModel task) => task.LastProgressAt is { } at
        ? $"{ActivityLabel(task.LastProgressActivityType)} · {FormatDateTime(at)}"
        : "Chưa có cập nhật tiến độ";
    private string LastActivityLabel(MaintenanceTaskModel task) => task.LastActivityAt is { } at
        ? $"{ActivityLabel(task.LastActivityType)} · {FormatDateTime(at)}"
        : "Chưa có hoạt động nào";
    private static string DeadlineLabel(MaintenanceTaskModel task) => task.DueAt is null
        ? "Chưa xác định hạn hoàn thành"
        : task.IsOverdue ? "Quá hạn" : "Đúng hạn";
    private static string ActivityLabel(MaintenanceActivityType? type) => type switch
    {
        MaintenanceActivityType.ASSIGNED => "Đã phân công",
        MaintenanceActivityType.REASSIGNED => "Đã phân công lại",
        MaintenanceActivityType.STATUS_CHANGED => "Đã cập nhật trạng thái",
        MaintenanceActivityType.PROGRESS_UPDATED => "Đã cập nhật tiến độ",
        MaintenanceActivityType.WORK_LOG_ADDED => "Đã ghi nhận công việc",
        MaintenanceActivityType.COMPLETED => "Đã hoàn thành công việc",
        _ => "Đã cập nhật"
    };
    private static string AssignmentStatusLabel(MaintenanceAssignmentStatus status) => status switch
    {
        MaintenanceAssignmentStatus.ASSIGNED => "Đã phân công",
        MaintenanceAssignmentStatus.IN_PROGRESS => "Đang thực hiện",
        MaintenanceAssignmentStatus.COMPLETED => "Đã hoàn thành",
        MaintenanceAssignmentStatus.REASSIGNED => "Đã phân công lại",
        MaintenanceAssignmentStatus.CANCELLED => "Đã hủy",
        _ => status.ToString()
    };
    private static string TimelineLabel(MaintenanceHistoryTimelineEventModel entry)
    {
        if (entry.Kind == "TASK_CREATED") return "Tạo công việc bảo trì";
        if (entry.Kind == "RESULT_SUBMITTED") return "Gửi kết quả thực hiện";
        if (entry.ActivityType == MaintenanceActivityType.MANAGER_REVIEWED && entry.FromStatus == MaintenanceTaskStatus.COMPLETED && entry.ToStatus == MaintenanceTaskStatus.ASSIGNED) return "Manager yêu cầu tiếp tục xử lý";
        if (entry.ActivityType == MaintenanceActivityType.MANAGER_REVIEWED) return "Manager review kết quả";
        if (entry.ActivityType == MaintenanceActivityType.CLOSED) return "Đóng công việc";
        return ActivityLabel(entry.ActivityType);
    }
    private static readonly (int Index, string Label)[] ProgressSteps =
    [
        (1, "Đã phân công"), (2, "Bắt đầu xử lý"), (3, "Đang thực hiện"),
        (4, "Chờ nghiệm thu"), (5, "Đóng công việc")
    ];
    private static string ProgressStepClass(int index, int current) => index < current ? "is-complete" : index == current ? "is-current" : string.Empty;
    private string ScheduleTimeRange(ScheduleModel schedule) => schedule.PlannedEndAt is { } end
        ? $"{InCurrentTimeZone(schedule.PlannedStartAt):dd/MM/yyyy HH:mm} → {InCurrentTimeZone(end):dd/MM/yyyy HH:mm}"
        : $"Bắt đầu {InCurrentTimeZone(schedule.PlannedStartAt):dd/MM/yyyy HH:mm}";
    private static string TaskStatusLabel(MaintenanceTaskStatus status) => status switch
    {
        MaintenanceTaskStatus.OPEN => "Mở", MaintenanceTaskStatus.ASSIGNED => "Đã giao", MaintenanceTaskStatus.IN_PROGRESS => "Đang thực hiện", MaintenanceTaskStatus.COMPLETED => "Hoàn thành", MaintenanceTaskStatus.CLOSED => "Đã đóng", MaintenanceTaskStatus.CANCELLED => "Đã hủy", _ => status.ToString()
    };
    private static string TaskStatusClass(MaintenanceTaskStatus status) => status switch
    {
        MaintenanceTaskStatus.OPEN => "is-active", MaintenanceTaskStatus.COMPLETED or MaintenanceTaskStatus.CLOSED => "is-completed", MaintenanceTaskStatus.CANCELLED => "is-cancelled", _ => string.Empty
    };
    private static string AssetLabel(AssetModel asset) =>
        string.IsNullOrWhiteSpace(asset.LocationDescription)
            ? $"{asset.Code} · {asset.Name}"
            : $"{asset.Code} · {asset.Name} ({asset.LocationDescription})";
    private string AgendaTimeRange(ScheduleModel s)
    {
        var start = InCurrentTimeZone(s.PlannedStartAt);
        if (s.PlannedEndAt is null) return $"Từ {start:HH:mm}";
        return $"{start:HH:mm} – {InCurrentTimeZone(s.PlannedEndAt.Value):HH:mm}";
    }
    private string FormatDurationShort(ScheduleModel s)
    {
        var start = InCurrentTimeZone(s.PlannedStartAt);
        if (s.PlannedEndAt is null) return $"Bắt đầu {start:dd/MM HH:mm}";
        return $"{start:HH:mm} – {InCurrentTimeZone(s.PlannedEndAt.Value):HH:mm}";
    }
    private static string StatusLabel(MaintenanceScheduleStatus status) => status switch
    {
        MaintenanceScheduleStatus.ACTIVE => "Đang hoạt động",
        MaintenanceScheduleStatus.COMPLETED => "Đã hoàn tất",
        MaintenanceScheduleStatus.CANCELLED => "Đã hủy",
        _ => status.ToString()
    };
    private static string ResultStatusLabel(MaintenanceResultStatus status) => status switch
    {
        MaintenanceResultStatus.SUBMITTED => "Chờ review",
        MaintenanceResultStatus.APPROVED => "Đã chấp nhận",
        MaintenanceResultStatus.REVISION_REQUIRED => "Yêu cầu xử lý thêm",
        _ => status.ToString()
    };
    private static string ResultStatusClass(MaintenanceResultStatus status) => status switch
    {
        MaintenanceResultStatus.APPROVED => "is-completed",
        MaintenanceResultStatus.REVISION_REQUIRED => "is-cancelled",
        _ => "is-active"
    };
    private static string StatusClass(MaintenanceScheduleStatus status) => status switch
    {
        MaintenanceScheduleStatus.ACTIVE => "is-active",
        MaintenanceScheduleStatus.COMPLETED => "is-completed",
        MaintenanceScheduleStatus.CANCELLED => "is-cancelled",
        _ => string.Empty
    };
    public void Dispose() => cts.Dispose();
}
