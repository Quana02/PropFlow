    private async Task SaveSchedule()
    {
        if (Editor.PlannedEndAt is not null && Editor.PlannedEndAt < Editor.PlannedStartAt)
        {
            ErrorMessage = "Thời điểm kết thúc phải sau thời điểm bắt đầu.";
            return;
        }
        IsSaving = true;
        var result = EditingSchedule is null
            ? await MaintenanceApi.CreateScheduleAsync(Editor, cts.Token)
            : await MaintenanceApi.UpdateScheduleAsync(EditingSchedule.Id, new UpdateScheduleModel
            {
                Title = Editor.Title,
                PlannedStartAt = Editor.PlannedStartAt,
                PlannedEndAt = Editor.PlannedEndAt,
                FacilityId = Editor.FacilityId,
                EquipmentId = Editor.EquipmentId,
                Description = Editor.Description
            }, cts.Token);
        IsSaving = false;
        if (!result.IsSuccess) { ErrorMessage = result.Message ?? "Không thể lưu lịch bảo trì."; return; }
        SuccessMessage = EditingSchedule is null ? "Đã tạo lịch bảo trì." : "Đã cập nhật lịch bảo trì.";
        IsDialogOpen = false;
        await LoadSchedules();
    }

