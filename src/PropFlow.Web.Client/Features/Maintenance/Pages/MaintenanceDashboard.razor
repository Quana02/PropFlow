@page "/maintenance"
@layout PropFlow.Web.Client.Layout.MainLayout
@attribute [Authorize(Roles = "MANAGER")]
@using Microsoft.AspNetCore.Authorization
@using System.Globalization
@using PropFlow.Web.Client.Features.Facility.Services
@using PropFlow.Web.Client.Features.Maintenance.Models
@using PropFlow.Web.Client.Features.Maintenance.Services
@using PropFlow.Web.Client.Features.ServiceRequests.Services
@using PropFlow.Modules.ServiceRequests.Contracts
@using PropFlow.Web.Client.Shared.Forms
@using PropFlow.Web.Client.Shared.Feedback
@using Microsoft.AspNetCore.SignalR.Client
@inject NavigationManager Navigation
@inject IMaintenanceApiClient MaintenanceApi
@inject MaintenanceHubConnectionFactory MaintenanceHubConnectionFactory
@inject IManagerServiceRequestApiClient ServiceRequestApi
@inject IBuildingApiClient BuildingApi
@implements IAsyncDisposable

<PageTitle>Quản lý lịch bảo trì - PropFlow</PageTitle>

<div class="fe07-page">

    @* ── TOP BAR ── *@
    <div class="fe07-topbar">
        <div class="fe07-topbar-row">
            <div class="fe07-topbar-actions">
                <div class="fe07-workspace-tabs" role="tablist" aria-label="Không gian bảo trì">
                    <button type="button" role="tab" aria-selected="@IsScheduleWorkspace" class="@(IsScheduleWorkspace ? "is-selected" : null)" @onclick="ShowSchedulesWorkspace">
                        <span class="material-symbols-outlined" aria-hidden="true">calendar_month</span>Lịch bảo trì
                    </button>
                    <button type="button" role="tab" aria-selected="@(!IsScheduleWorkspace && !IsHistoryWorkspace)" class="@(!IsScheduleWorkspace && !IsHistoryWorkspace ? "is-selected" : null)" @onclick="ShowTasksWorkspace">
                        <span class="material-symbols-outlined" aria-hidden="true">build</span>Công việc bảo trì
                    </button>
                    <button type="button" role="tab" aria-selected="@IsHistoryWorkspace" class="@(IsHistoryWorkspace ? "is-selected" : null)" @onclick="ShowHistoryWorkspace">
                        <span class="material-symbols-outlined" aria-hidden="true">history</span>Lịch sử bảo trì
                    </button>
                </div>
                @if (IsScheduleWorkspace)
                {
                    <button class="fe07-primary-action" type="button" @onclick="OpenCreateDialog"><span class="material-symbols-outlined" aria-hidden="true">add</span>Tạo lịch bảo trì</button>
                }
                else if (!IsHistoryWorkspace)
                {
                    <button class="fe07-primary-action" type="button" @onclick="OpenManualTask"><span class="material-symbols-outlined" aria-hidden="true">add</span>Tạo bảo trì khẩn cấp</button>
                }
                else
                {
                    <span class="fe07-primary-action fe07-primary-action-placeholder" aria-hidden="true">Tạo lịch bảo trì</span>
                }
            </div>
        </div>
        <div class="fe07-summary-chips">
            <span>Lịch trong tuần: <b>@WeekSchedules.Count</b></span>
            <span>@UpcomingSummary</span>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="fe07-alert fe07-alert-success" role="status">
            <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
            <span>@SuccessMessage</span>
            <button type="button" @onclick="() => SuccessMessage = null" aria-label="Đóng thông báo">close</button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="fe07-alert fe07-alert-error" role="alert">
            <span class="material-symbols-outlined" aria-hidden="true">error</span>
            <span>@ErrorMessage</span>
            <button type="button" @onclick="() => ErrorMessage = null" aria-label="Đóng thông báo">close</button>
        </div>
    }

    @* ── WORKSPACE ── *@
    @if (IsScheduleWorkspace)
    {
    <section class="fe07-workspace" aria-labelledby="schedule-workspace-title">

        @* Week nav + view switcher *@
        <div class="fe07-workspace-head">
            <div class="fe07-week-nav">
                <button type="button" aria-label="Tuần trước" @onclick="PreviousWeek">
                    <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
                </button>
                <strong>@WeekNavLabel</strong>
                <button type="button" aria-label="Tuần sau" @onclick="NextWeek">
                    <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
                </button>
                <button class="fe07-today-button" type="button" @onclick="GoToToday">Hôm nay</button>
            </div>
            <div class="fe07-workspace-head-right">
                <div class="fe07-view-switcher">
                    <button type="button" class="is-selected" aria-current="page">Lưới Giờ</button>
                </div>
                <button class="fe07-icon-button" type="button" title="Đặt lại bộ lọc" aria-label="Đặt lại bộ lọc" @onclick="ResetFilter">
                    <span class="material-symbols-outlined" aria-hidden="true">refresh</span>
                </button>
            </div>
        </div>

        @* Day strip *@
        <div class="fe07-day-strip" role="list" aria-label="Chọn ngày trong tuần">
            @foreach (var day in WeekDays)
            {
                <button type="button" role="listitem"
                        class="@(day == SelectedDate ? "is-selected" : null) @(day == Today ? "is-today" : null)"
                        @onclick="() => SelectDay(day)">
                    <span>@DayLabel(day)</span>
                    <strong>@day.Day</strong>
                    @if (DaySchedules(day).Count > 0)
                    {
                        <i>@DaySchedules(day).Count</i>
                    }
                </button>
            }
        </div>

        @* Filter / search toolbar *@
        <div class="fe07-filter-row">
            <div class="fe07-search-inline">
                <span class="material-symbols-outlined" aria-hidden="true">search</span>
                <input @bind="Filter.SearchKeyword" @bind:event="oninput" @onkeyup="OnSearchKeyUp"
                       placeholder="Tìm theo mã hoặc tên lịch…" aria-label="Tìm lịch bảo trì" />
            </div>
            <button class="fe07-filter-apply" type="button" @onclick="ToggleScheduleFilters" aria-expanded="@IsScheduleFilterPanelOpen" aria-controls="schedule-filter-panel">
                <span class="material-symbols-outlined" aria-hidden="true">filter_alt</span>Lọc@(ScheduleActiveFilterCount > 0 ? $" ({ScheduleActiveFilterCount})" : string.Empty)
            </button>
        </div>
        @if (IsScheduleFilterPanelOpen)
        {
            <section id="schedule-filter-panel" class="fe07-filter-panel" aria-label="Bộ lọc lịch bảo trì">
                <div class="fe07-filter-panel-head"><h2>Bộ lọc lịch bảo trì</h2></div>
                <div class="fe07-filter-panel-grid">
                    <div class="fe07-field"><label>Trạng thái</label><PropFlowSelect Options="ScheduleStatusOptions" @bind-Value="StatusFilter" Variant="Filter" AriaLabel="Trạng thái lịch" /></div>
                    <div class="fe07-field"><label>Cơ sở vật chất</label><PropFlowSelect Options="ScheduleFacilityFilterOptions" @bind-Value="FacilityFilter" Variant="Filter" AriaLabel="Cơ sở vật chất" Searchable="true" /></div>
                    <div class="fe07-field"><label>Thiết bị</label><PropFlowSelect Options="ScheduleEquipmentFilterOptions" @bind-Value="EquipmentFilter" Variant="Filter" AriaLabel="Thiết bị" Searchable="true" /></div>
                </div>
                <div class="fe07-filter-panel-actions"><button class="fe07-secondary" type="button" @onclick="ResetFilter">Đặt lại</button><button class="fe07-primary" type="button" @onclick="ApplyFilter">Áp dụng</button></div>
            </section>
        }

        @* Content *@
        @if (IsLoading)
        {
            <div class="fe07-empty" role="status">
                <span class="fe07-spinner"></span>
                <p>Đang tải lịch bảo trì…</p>
            </div>
        }
        else if (!Schedules.Items.Any())
        {
            <div class="fe07-empty">
                <span class="material-symbols-outlined" aria-hidden="true">event_busy</span>
                <h2>Chưa có lịch bảo trì</h2>
                <p>Không có lịch nào được tìm thấy.</p>
                <button class="fe07-primary-action" type="button" @onclick="OpenCreateForSelectedDay">
                    <span class="material-symbols-outlined" aria-hidden="true">add</span>Tạo lịch bảo trì
                </button>
            </div>
        }
        else
        {
            @if (ViewMode == "timeline")
            {
                <div class="fe07-agenda">
                    @if (!SelectedDaySchedules.Any())
                    {
                        <div class="fe07-agenda-empty-row">
                            <div class="fe07-agenda-time">
                                <strong>—</strong>
                            </div>
                            <p class="fe07-agenda-empty-msg">Không có lịch bảo trì trong ngày đã chọn.</p>
                            <button type="button" class="fe07-agenda-add-btn" @onclick="OpenCreateForSelectedDay">
                                <span class="material-symbols-outlined" aria-hidden="true">add</span>Tạo lịch bảo trì
                            </button>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in SelectedDaySchedules)
                        {
                            <article class="fe07-agenda-row">
                                <div class="fe07-agenda-time">
                                    <strong>@InCurrentTimeZone(item.PlannedStartAt).ToString("HH:mm")</strong>
                                    <span>@AgendaTimeRange(item)</span>
                                </div>
                                <div class="fe07-agenda-card">
                                    <div class="fe07-agenda-card-main">
                                        <div class="fe07-agenda-title-row">
                                            <span class="fe07-agenda-title">@item.Title</span>
                                            <span class="fe07-status @StatusClass(item.Status)"><i></i>@StatusLabel(item.Status)</span>
                                            <span class="fe07-code">@item.ScheduleCode</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <p class="fe07-agenda-desc">@item.Description</p>
                                        }
                                        <div class="fe07-agenda-meta">
                                            @if (AssetFor(item) != "—")
                                            {
                                                <span><i class="material-symbols-outlined" aria-hidden="true">apartment</i>@AssetFor(item)</span>
                                            }
                                            <span><i class="material-symbols-outlined" aria-hidden="true">schedule</i>@FormatDurationShort(item)</span>
                                        </div>
                                    </div>
                                    <div class="fe07-agenda-actions">
                                        @if (item.Status == MaintenanceScheduleStatus.ACTIVE)
                                        {
                                            <button type="button" class="fe07-row-action" title="Tạo công việc từ lịch" @onclick="() => OpenTaskForSchedule(item)"><span class="material-symbols-outlined" aria-hidden="true">build</span></button>
                                            <button type="button" class="fe07-row-action" title="Sửa lịch" aria-label="Sửa lịch" @onclick="() => OpenEditDialog(item)"><span class="material-symbols-outlined" aria-hidden="true">edit</span></button>
                                            @if (CanExtendSchedule(item)) { <button type="button" class="fe07-row-action" title="Gia hạn bảo trì" aria-label="Gia hạn bảo trì" @onclick="() => OpenExtendSchedule(item)"><span class="material-symbols-outlined" aria-hidden="true">more_time</span></button> }
                                            <button type="button" class="fe07-row-action is-cancel" title="Hủy lịch" aria-label="Hủy lịch" @onclick="() => CancelSchedule(item)">
                                                <span class="material-symbols-outlined" aria-hidden="true">event_busy</span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </article>
                        }
                    }
                </div>
            }
            else
            {
                <div class="fe07-agenda">
                    @if (!SelectedDaySchedules.Any())
                    {
                        <div class="fe07-agenda-empty-row">
                            <div class="fe07-agenda-time"><strong>—</strong></div>
                            <p class="fe07-agenda-empty-msg">Không có lịch bảo trì trong ngày đã chọn.</p>
                            <button type="button" class="fe07-agenda-add-btn" @onclick="OpenCreateForSelectedDay"><span class="material-symbols-outlined" aria-hidden="true">add</span>Tạo lịch bảo trì</button>
                        </div>
                    }
                    else foreach (var item in SelectedDaySchedules)
                    {
                        <article class="fe07-agenda-row">
                            <div class="fe07-agenda-time">
                                <strong>@InCurrentTimeZone(item.PlannedStartAt).ToString("HH:mm")</strong>
                                <span>@AgendaTimeRange(item)</span>
                            </div>
                            <div class="fe07-agenda-card">
                                <div class="fe07-agenda-card-main">
                                    <div class="fe07-agenda-title-row">
                                        <span class="fe07-agenda-title">@item.Title</span>
                                        <span class="fe07-status @StatusClass(item.Status)"><i></i>@StatusLabel(item.Status)</span>
                                        <span class="fe07-code">@item.ScheduleCode</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(item.Description)) { <p class="fe07-agenda-desc">@item.Description</p> }
                                    <div class="fe07-agenda-meta">
                                        @if (AssetFor(item) != "—") { <span><i class="material-symbols-outlined" aria-hidden="true">apartment</i>@AssetFor(item)</span> }
                                        <span><i class="material-symbols-outlined" aria-hidden="true">schedule</i>@FormatDurationShort(item)</span>
                                    </div>
                                </div>
                                <div class="fe07-agenda-actions">
                                    @if (item.Status == MaintenanceScheduleStatus.ACTIVE)
                                    {
                                        <button type="button" class="fe07-row-action" title="Tạo công việc từ lịch" @onclick="() => OpenTaskForSchedule(item)"><span class="material-symbols-outlined" aria-hidden="true">build</span></button>
                                        <button type="button" class="fe07-row-action" title="Sửa lịch" aria-label="Sửa lịch" @onclick="() => OpenEditDialog(item)"><span class="material-symbols-outlined" aria-hidden="true">edit</span></button>
                                        @if (CanExtendSchedule(item)) { <button type="button" class="fe07-row-action" title="Gia hạn bảo trì" aria-label="Gia hạn bảo trì" @onclick="() => OpenExtendSchedule(item)"><span class="material-symbols-outlined" aria-hidden="true">more_time</span></button> }
                                        <button type="button" class="fe07-row-action is-cancel" title="Hủy lịch" aria-label="Hủy lịch" @onclick="() => CancelSchedule(item)"><span class="material-symbols-outlined" aria-hidden="true">event_busy</span></button>
                                    }
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }

            <footer class="fe07-pagination">
                <span>Trang @Schedules.PageIndex / @TotalPages</span>
                <div>
                    <button type="button" disabled="@(Schedules.PageIndex <= 1)" @onclick="() => ChangePage(Schedules.PageIndex - 1)">
                        <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>Trước
                    </button>
                    <button type="button" disabled="@(Schedules.PageIndex >= TotalPages)" @onclick="() => ChangePage(Schedules.PageIndex + 1)">
                        Sau<span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
                    </button>
                </div>
            </footer>
        }
    </section>
    }
    else if (IsHistoryWorkspace)
    {
        <section class="fe07-workspace" aria-labelledby="history-workspace-title">
            <div class="fe07-workspace-head">
                <strong id="history-workspace-title">Lịch sử bảo trì</strong>
                <div class="fe07-workspace-head-right">
                    <PropFlowSelect Options="HistorySortOptions" @bind-Value="HistorySort" Variant="Filter" AriaLabel="Sắp xếp lịch sử" />
                    <button class="fe07-icon-button" type="button" title="Đặt lại bộ lọc" aria-label="Đặt lại bộ lọc" @onclick="ResetHistoryFilter"><span class="material-symbols-outlined" aria-hidden="true">refresh</span></button>
                </div>
            </div>
            <div class="fe07-filter-row">
                <div class="fe07-search-inline"><span class="material-symbols-outlined" aria-hidden="true">search</span><input @bind="HistoryFilter.SearchKeyword" @bind:event="oninput" @onkeyup="OnHistorySearchKeyUp" placeholder="Tìm theo mã hoặc tên công việc..." aria-label="Tìm lịch sử bảo trì" /></div>
                <button class="fe07-filter-apply" type="button" @onclick="ToggleHistoryFilters" aria-expanded="@IsHistoryFilterPanelOpen" aria-controls="history-filter-panel"><span class="material-symbols-outlined" aria-hidden="true">filter_alt</span>Lọc@(HistoryActiveFilterCount > 0 ? $" ({HistoryActiveFilterCount})" : string.Empty)</button>
            </div>
            @if (IsHistoryFilterPanelOpen)
            {
                <section id="history-filter-panel" class="fe07-filter-panel" aria-label="Bộ lọc lịch sử bảo trì">
                    <div class="fe07-filter-panel-head"><h2>Bộ lọc lịch sử bảo trì</h2></div>
                    <div class="fe07-filter-panel-grid">
                        <div class="fe07-field"><label>Trạng thái</label><PropFlowSelect Options="TaskStatusOptions" @bind-Value="HistoryStatusFilter" Variant="Filter" AriaLabel="Trạng thái lịch sử" /></div>
                        <div class="fe07-field"><label>Cơ sở vật chất</label><PropFlowSelect Options="HistoryFacilityFilterOptions" @bind-Value="HistoryFacilityFilter" Variant="Filter" AriaLabel="Cơ sở vật chất" Searchable="true" /></div>
                        <div class="fe07-field"><label>Thiết bị</label><PropFlowSelect Options="HistoryEquipmentFilterOptions" @bind-Value="HistoryEquipmentFilter" Variant="Filter" AriaLabel="Thiết bị" Searchable="true" /></div>
                        <div class="fe07-field"><label>Nhân viên từng tham gia</label><PropFlowSelect Options="HistoryStaffOptions" @bind-Value="HistoryStaffFilter" Variant="Filter" AriaLabel="Nhân viên từng tham gia" Disabled="@IsHistoryStaffLoading" Searchable="true" /></div>
                        <div class="fe07-field fe07-date-range-field"><label>Khoảng thời gian</label><PropFlowDateRangePicker Start="HistoryFromDate" End="HistoryToDate" StartChanged="OnHistoryFromDateChanged" EndChanged="OnHistoryToDateChanged" AriaLabel="Khoảng thời gian lịch sử bảo trì" /></div>
                    </div>
                    <div class="fe07-filter-panel-actions"><button class="fe07-secondary" type="button" @onclick="ResetHistoryFilter">Đặt lại</button><button class="fe07-primary" type="button" @onclick="ApplyHistoryFilter">Áp dụng</button></div>
                </section>
            }
            @if (IsHistoryLoading)
            {
                <div class="fe07-empty" role="status"><span class="fe07-spinner"></span><p>Đang tải lịch sử bảo trì…</p></div>
            }
            else if (History is null || !History.Page.Items.Any())
            {
                <div class="fe07-empty"><span class="material-symbols-outlined" aria-hidden="true">history</span><h2>Chưa có lịch sử bảo trì</h2><p>Không có công việc nào phù hợp bộ lọc hiện tại.</p></div>
            }
            else
            {
                <div class="fe07-history-summary" aria-label="Tóm tắt lịch sử bảo trì">
                    <span>Tổng <b>@History.Summary.Total</b></span><span>Đã đóng <b>@History.Summary.Closed</b></span><span>Hoàn thành <b>@History.Summary.Completed</b></span><span>Đang xử lý <b>@(History.Summary.Assigned + History.Summary.InProgress)</b></span>
                </div>
                <div class="fe07-history-table-wrap" tabindex="0" aria-label="Bảng lịch sử bảo trì">
                    <table class="fe07-history-table">
                        <thead><tr><th>Mã &amp; công việc</th><th>Tài sản &amp; vị trí</th><th>Loại bảo trì</th><th>Ưu tiên</th><th>Người thực hiện</th><th>Ngày thi công</th><th>Hoàn thành</th><th>Kết quả bảo trì</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
                        <tbody>
                        @foreach (var item in History.Page.Items)
                        {
                            <tr>
                                <td class="fe07-history-task-cell"><strong>@item.TaskNumber</strong><span>@item.Title</span><small>@HistorySourceLabel(item)</small></td>
                                <td class="fe07-history-asset-cell"><strong>@HistoryPrimaryAssetName(item)</strong><span>@HistoryPrimaryAssetCode(item)</span><small>@HistoryAssetLocation(item)</small></td>
                                <td><span class="fe07-history-source-badge">@HistoryTypeLabel(item)</span></td>
                                <td>@if (string.IsNullOrWhiteSpace(item.PriorityCode)) { <span class="fe07-history-empty">—</span> } else { <span class="fe07-code">@MaintenancePriority.DisplayName(item.PriorityCode)</span> }</td>
                                <td class="fe07-history-staff-cell">@HistoryParticipantsLabel(item)</td>
                                <td>@if (item.StartedAt is { } startedAt) { <time>@FormatHistoryDateTime(startedAt)</time> } else if (item.PlannedStartAt is { } plannedAt) { <time>@FormatHistoryDateTime(plannedAt)<small>Dự kiến</small></time> } else { <span class="fe07-history-empty">—</span> }</td>
                                <td>@if (item.CompletedAt is { } completedAt) { <time>@FormatHistoryDateTime(completedAt)<small>@CompletionTimelinessLabel(item)</small></time> } else { <span class="fe07-history-empty">—</span> }</td>
                                <td class="fe07-history-result-cell">@if (string.IsNullOrWhiteSpace(item.ResultSummary)) { <span class="fe07-history-empty">Chưa có kết quả</span> } else { <strong>@(item.ResultStatus is { } resultStatus ? ResultStatusLabel(resultStatus) : "Kết quả thực hiện")</strong><span title="@item.ResultSummary">@item.ResultSummary</span> }</td>
                                <td><span class="fe07-status @TaskStatusClass(item.Status)"><i></i>@TaskStatusLabel(item.Status)</span></td>
                                <td><button type="button" class="fe07-row-action" title="Xem chi tiết lịch sử" aria-label="Xem chi tiết lịch sử" @onclick="() => OpenHistoryDetail(item.TaskId)"><span class="material-symbols-outlined" aria-hidden="true">visibility</span></button></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <footer class="fe07-pagination"><span>Hiển thị @History.Page.Items.Count trong @History.Page.TotalCount bản ghi</span><div><button type="button" disabled="@(History.Page.PageIndex <= 1)" @onclick="() => ChangeHistoryPage(History.Page.PageIndex - 1)"><span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>Trước</button><button type="button" disabled="@(History.Page.PageIndex >= HistoryTotalPages)" @onclick="() => ChangeHistoryPage(History.Page.PageIndex + 1)">Sau<span class="material-symbols-outlined" aria-hidden="true">chevron_right</span></button></div></footer>
            }
        </section>
    }
    else
    {
        <section class="fe07-workspace" aria-labelledby="task-workspace-title">
            <div class="fe07-workspace-head">
                <strong id="task-workspace-title">Công việc bảo trì</strong>
                <button class="fe07-icon-button" type="button" title="Đặt lại bộ lọc" aria-label="Đặt lại bộ lọc" @onclick="ResetTaskFilter">
                    <span class="material-symbols-outlined" aria-hidden="true">refresh</span>
                </button>
            </div>
            <div class="fe07-filter-row">
                <div class="fe07-search-inline">
                    <span class="material-symbols-outlined" aria-hidden="true">search</span>
                    <input type="text" @bind="TaskFilter.SearchKeyword" @bind:event="oninput" @onkeyup="OnTaskSearchKeyUp" placeholder="Tìm theo mã hoặc tên công việc..." aria-label="Tìm công việc bảo trì" />
                </div>
                <PropFlowSelect Options="TaskStatusOptions" @bind-Value="TaskStatusFilter" Variant="Filter" AriaLabel="Lọc trạng thái công việc" />
                <button class="fe07-filter-apply" type="button" @onclick="ToggleTaskFilters" aria-expanded="@IsTaskFilterPanelOpen" aria-controls="task-filter-panel"><span class="material-symbols-outlined" aria-hidden="true">filter_alt</span>Lọc@(TaskActiveFilterCount > 0 ? $" ({TaskActiveFilterCount})" : string.Empty)</button>
            </div>
            @if (IsTaskFilterPanelOpen)
            {
                <section id="task-filter-panel" class="fe07-filter-panel" aria-label="Bộ lọc công việc bảo trì">
                    <div class="fe07-filter-panel-head"><h2>Bộ lọc công việc</h2></div>
                    <div class="fe07-filter-panel-grid">
                        <div class="fe07-field fe07-date-range-field"><label>Khoảng thời gian</label><PropFlowDateRangePicker Start="TaskFromDate" End="TaskToDate" StartChanged="OnTaskFromDateChanged" EndChanged="OnTaskToDateChanged" AriaLabel="Khoảng thời gian công việc bảo trì" /></div>
                        <div class="fe07-field"><label>Cơ sở vật chất</label><PropFlowSelect Options="TaskFacilityFilterOptions" @bind-Value="TaskFacilityFilter" Variant="Filter" AriaLabel="Cơ sở vật chất" Searchable="true" /></div>
                        <div class="fe07-field"><label>Thiết bị</label><PropFlowSelect Options="TaskEquipmentFilterOptions" @bind-Value="TaskEquipmentFilter" Variant="Filter" AriaLabel="Thiết bị" Searchable="true" /></div>
                        <div class="fe07-field"><label>Nhân viên phụ trách</label><PropFlowSelect Options="AssignableStaffOptions" @bind-Value="TaskAssignedStaffFilter" Variant="Filter" AriaLabel="Nhân viên phụ trách" Disabled="@IsTaskFilterStaffLoading" Searchable="true" /></div>
                    </div>
                    <div class="fe07-filter-panel-actions"><button class="fe07-secondary" type="button" @onclick="ResetTaskFilter">Đặt lại</button><button class="fe07-primary" type="button" @onclick="ApplyTaskFilter">Áp dụng</button></div>
                </section>
            }
            @if (IsTasksLoading)
            {
                <div class="fe07-empty" role="status"><span class="fe07-spinner"></span><p>Đang tải công việc bảo trì…</p></div>
            }
            else if (!Tasks.Items.Any())
            {
                <div class="fe07-empty"><span class="material-symbols-outlined" aria-hidden="true">assignment</span><h2>Chưa có công việc bảo trì</h2><p>Hãy tạo công việc mới để bắt đầu theo dõi.</p><button class="fe07-primary-action" type="button" @onclick="OpenManualTask"><span class="material-symbols-outlined" aria-hidden="true">add</span>Tạo công việc</button></div>
            }
            else
            {
                <div class="fe07-task-list">
                    @foreach (var task in Tasks.Items)
                    {
                        <article class="fe07-task-row-link" role="link" tabindex="0" @onclick="() => NavigateToTask(task.Id)" @onkeydown="args => NavigateTaskOnKey(args, task.Id)">
                            <time>@(task.PlannedStartAt is { } start ? InCurrentTimeZone(start).ToString("dd/MM HH:mm") : "—")</time>
                            <div>
                                <strong>@task.TaskNumber · @task.Title</strong>
                                <span>@TaskAssetContext(task)</span>
                                <span>@(task.ScheduleId is null ? "Công việc trực tiếp" : $"Nguồn: {task.SourceScheduleCode ?? task.ScheduleId.ToString()}")</span>
                                <span>Nhân viên: @AssigneeLabel(task)</span>
                                @if (task.DueAt is { } due) { <span>Hạn: @InCurrentTimeZone(due).ToString("dd/MM HH:mm")</span> }
                            </div>
                            <div class="fe07-task-statuses"><span class="fe07-status @TaskStatusClass(task.Status)"><i></i>@TaskStatusLabel(task.Status)</span>@if (task.IsOverdue) { <span class="fe07-status is-overdue"><i></i>Quá hạn</span> }</div>
                            <div class="fe07-task-row-actions">
                                <span class="fe07-row-action" aria-hidden="true"><span class="material-symbols-outlined">arrow_forward</span></span>
                            </div>
                        </article>
                    }
                </div>
                <footer class="fe07-pagination"><span>Trang @Tasks.PageIndex / @TaskTotalPages</span><div><button type="button" disabled="@(Tasks.PageIndex <= 1)" @onclick="() => ChangeTaskPage(Tasks.PageIndex - 1)"><span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>Trước</button><button type="button" disabled="@(Tasks.PageIndex >= TaskTotalPages)" @onclick="() => ChangeTaskPage(Tasks.PageIndex + 1)">Sau<span class="material-symbols-outlined" aria-hidden="true">chevron_right</span></button></div></footer>
            }
        </section>
    }
</div>

@if (PendingConfirmation is not null)
{
    <PropFlowConfirmationDialog Title="Xác nhận thao tác" Message="@ConfirmationMessage" ConfirmText="Có" CancelText="Không" Busy="@IsConfirmationBusy" BusyText="Đang xử lý…" OnConfirm="ConfirmPendingAction" OnCancel="CancelPendingAction" />
}

@if (IsDialogOpen)
{
    <div class="fe07-dialog-backdrop" role="presentation">
        <section class="fe07-dialog" role="dialog" aria-modal="true" aria-labelledby="schedule-dialog-title">
            <header>
                <div>
                    <h2 id="schedule-dialog-title">@(EditingSchedule is null ? "Tạo lịch bảo trì" : "Cập nhật lịch bảo trì")</h2>
                    <p>Thông tin lịch được áp dụng cho chung cư hiện hành.</p>
                </div>
                <button class="fe07-close-button" type="button" @onclick="CloseDialog" disabled="@IsSaving" aria-label="Đóng">×</button>
            </header>
            <EditForm Model="Editor" OnValidSubmit="SaveSchedule">
                <DataAnnotationsValidator />
                <div class="fe07-form-grid">
                    <div class="fe07-field fe07-wide">
                        <label>Tên lịch bảo trì <b>*</b></label>
                        <InputText @bind-Value="Editor.Title" placeholder="VD: Bảo trì hệ thống bơm nước" />
                        <ValidationMessage For="() => Editor.Title" />
                    </div>
                    <div class="fe07-field">
                        <label>Thời điểm bắt đầu <b>*</b></label>
                        <div class="fe07-date-time-controls">
                            <PropFlowDatePicker Value="ScheduleStartDate" ValueChanged="OnScheduleStartDateChanged" AriaLabel="Ngày bắt đầu lịch bảo trì" />
                            <input type="time" value="@ScheduleStartTimeString" @onchange="OnScheduleStartTimeChanged" aria-label="Giờ bắt đầu lịch bảo trì" />
                        </div>
                        <ValidationMessage For="() => Editor.PlannedStartAt" />
                    </div>
                    <div class="fe07-field">
                        <label>Thời điểm kết thúc <b>*</b></label>
                        <div class="fe07-date-time-controls">
                            <PropFlowDatePicker Value="ScheduleEndDate" ValueChanged="OnScheduleEndDateChanged" AriaLabel="Ngày kết thúc lịch bảo trì" />
                            <input type="time" value="@ScheduleEndTimeString" @onchange="OnScheduleEndTimeChanged" aria-label="Giờ kết thúc lịch bảo trì" />
                        </div>
                        <ValidationMessage For="() => Editor.PlannedEndAt" />
                    </div>
                    <div class="fe07-field">
                        <label>Cơ sở vật chất</label>
                        <PropFlowSelect Options="ScheduleFacilityOptions" @bind-Value="EditorFacilityIdString" AriaLabel="Cơ sở vật chất bảo trì" Searchable="true" />
                        <ValidationMessage For="() => Editor.FacilityId" />
                    </div>
                    <div class="fe07-field">
                        <label>Thiết bị</label>
                        <PropFlowSelect Options="ScheduleEquipmentOptions" @bind-Value="EditorEquipmentIdString" AriaLabel="Thiết bị bảo trì" Searchable="true" />
                    </div>
                    <div class="fe07-field fe07-wide">
                        <label>Mô tả <b>*</b></label>
                        <InputTextArea @bind-Value="Editor.Description" rows="4" placeholder="Mô tả phạm vi hoặc lưu ý bảo trì" />
                        <ValidationMessage For="() => Editor.Description" />
                    </div>
                    @if (!string.IsNullOrWhiteSpace(ScheduleTimeError))
                    {
                        <div class="fe07-field fe07-wide"><span class="validation-message" role="alert">@ScheduleTimeError</span></div>
                    }
                </div>
                <footer>
                    <button type="button" class="fe07-secondary" @onclick="CloseDialog" disabled="@IsSaving">Hủy</button>
                    <button type="submit" class="fe07-primary" disabled="@IsSaving">@(IsSaving ? "Đang lưu..." : "Lưu lịch")</button>
                </footer>
            </EditForm>
        </section>
    </div>
}

@if (IsExtendScheduleDialogOpen && ScheduleToExtend is not null)
{
    <div class="fe07-dialog-backdrop" role="presentation">
        <section class="fe07-dialog" role="dialog" aria-modal="true" aria-labelledby="extend-schedule-dialog-title">
            <header><div><h2 id="extend-schedule-dialog-title">Gia hạn bảo trì</h2><p><b>@ScheduleToExtend.ScheduleCode</b> · Kết thúc hiện tại: @(ScheduleToExtend.PlannedEndAt is { } end ? InCurrentTimeZone(end).ToString("dd/MM/yyyy HH:mm") : "Chưa xác định")</p></div><button class="fe07-close-button" type="button" @onclick="CloseExtendSchedule" disabled="@IsExtendingSchedule" aria-label="Đóng">×</button></header>
            <EditForm Model="ExtendScheduleEditor" OnValidSubmit="SaveScheduleExtension"><DataAnnotationsValidator />
                <div class="fe07-form-grid"><div class="fe07-field"><label>Thời lượng gia hạn <b>*</b></label><InputNumber @bind-Value="ExtendScheduleEditor.Amount" /><ValidationMessage For="() => ExtendScheduleEditor.Amount" /></div><div class="fe07-field"><label>Đơn vị <b>*</b></label><PropFlowSelect Options="ExtensionUnitOptions" @bind-Value="ExtendScheduleEditor.Unit" AriaLabel="Đơn vị gia hạn" /><ValidationMessage For="() => ExtendScheduleEditor.Unit" /></div></div>
                <footer><button type="button" class="fe07-secondary" @onclick="CloseExtendSchedule" disabled="@IsExtendingSchedule">Hủy</button><button type="submit" class="fe07-primary" disabled="@IsExtendingSchedule">@(IsExtendingSchedule ? "Đang gia hạn..." : "Gia hạn bảo trì")</button></footer>
            </EditForm>
        </section>
    </div>
}

@if (IsTaskDialogOpen)
{
    <div class="fe07-dialog-backdrop" role="presentation">
      <section class="fe07-dialog" role="dialog" aria-modal="true" aria-labelledby="task-dialog-title">
        <header>
          <div>
            <h2 id="task-dialog-title">Tạo công việc bảo trì</h2>
            <p>@(TaskEditor.ScheduleId is null ? "Tạo công việc độc lập." : $"Nguồn lịch: {TaskSourceLabel}")</p>
            @if (TaskSourceSchedule is not null && (TaskSourceSchedule.FacilityId is not null || TaskSourceSchedule.EquipmentId is not null))
            {
                <p class="fe07-task-source-assets">
                    @if (TaskSourceSchedule.FacilityId is { } facilityId)
                    {
                        <span>Cơ sở: @AssetName(facilityId)</span>
                    }
                    @if (TaskSourceSchedule.EquipmentId is { } equipmentId)
                    {
                        <span>Thiết bị: @AssetName(equipmentId)</span>
                    }
                </p>
            }
          </div>
            <button class="fe07-close-button" type="button" @onclick="CloseTaskDialog" disabled="@IsTaskSaving" aria-label="Đóng">×</button>
        </header>
        <EditForm Model="TaskEditor" OnValidSubmit="SaveTask"><DataAnnotationsValidator />
          <div class="fe07-form-grid">
            <div class="fe07-field fe07-wide"><p class="fe07-field-hint">Mã sẽ được hệ thống tự động tạo khi lưu.</p></div>
            <div class="fe07-field">
              <label>Tiêu đề <b>*</b></label><InputText @bind-Value="TaskEditor.Title" /><ValidationMessage For="() => TaskEditor.Title" />
            </div>
            <div class="fe07-field"><label>Ưu tiên <b>*</b></label><PropFlowSelect Options="TaskPriorityOptions" @bind-Value="TaskEditor.PriorityCode" AriaLabel="Mức ưu tiên công việc bảo trì" /><ValidationMessage For="() => TaskEditor.PriorityCode" /></div>
            <div class="fe07-field fe07-wide">
              <label>Mô tả <b>*</b></label><InputTextArea @bind-Value="TaskEditor.Description" rows="3" disabled="@(TaskSourceSchedule is not null)" /><ValidationMessage For="() => TaskEditor.Description" />
            </div>
            @if (MaintenanceFeatureFlags.ServiceRequestLinkingEnabled)
            {
            <div class="fe07-field wide fe07-service-request-picker">
                <label>Yêu cầu dịch vụ liên quan</label>
                @if (SelectedCreateServiceRequest is { } request)
                {
                    <div class="fe07-linked-request"><strong>@request.RequestNumber</strong><span>@request.Title</span><small>@ServiceRequestStatusLabel(request.Status)</small><button type="button" class="fe07-secondary" @onclick="ClearCreateServiceRequest">Bỏ chọn</button></div>
                }
                else
                {
                    <p>Không bắt buộc. Chỉ liên kết yêu cầu còn đủ điều kiện xử lý.</p>
                    <button type="button" class="fe07-secondary" @onclick="OpenCreateServiceRequestPicker">Chọn yêu cầu dịch vụ</button>
                }
            </div>
            }
            @if (TaskSourceSchedule is null)
            {
                <div class="fe07-field"><label>Cơ sở vật chất <b>*</b></label><PropFlowSelect Options="MaintenanceFacilityOptions" @bind-Value="TaskFacilityIdString" AriaLabel="Cơ sở vật chất bảo trì" Searchable="true" />@if (TaskFacilityError is not null) { <span class="validation-message" role="alert">@TaskFacilityError</span> }</div>
                <div class="fe07-field"><label>Thiết bị</label><PropFlowSelect Options="ManualTaskEquipmentOptions" @bind-Value="TaskEquipmentIdString" AriaLabel="Thiết bị bảo trì" Searchable="true" /></div>
                <div class="fe07-field"><label>Thời điểm dự kiến <b>*</b></label><div class="fe07-date-time-controls"><PropFlowDatePicker Value="TaskStartDate" ValueChanged="OnTaskStartDateChanged" AriaLabel="Ngày dự kiến thực hiện" /><input type="time" value="@TaskStartTimeString" @onchange="OnTaskStartTimeChanged" disabled="@(TaskStartDate is null)" aria-label="Giờ dự kiến thực hiện" /></div>@if (TaskPlannedStartError is not null) { <span class="validation-message" role="alert">@TaskPlannedStartError</span> }</div>
                <div class="fe07-field"><label>Hạn hoàn thành <b>*</b></label><div class="fe07-date-time-controls"><PropFlowDatePicker Value="TaskDueDate" ValueChanged="OnTaskDueDateChanged" AriaLabel="Ngày hạn hoàn thành" /><input type="time" value="@TaskDueTimeString" @onchange="OnTaskDueTimeChanged" disabled="@(TaskDueDate is null)" aria-label="Giờ hạn hoàn thành" /></div>@if (TaskDueError is not null) { <span class="validation-message" role="alert">@TaskDueError</span> }</div>
            }
            else
            {
                <div class="fe07-field wide fe07-readonly-context"><label>Thời gian theo lịch</label><span>@ScheduleTimeRange(TaskSourceSchedule)</span></div>
            }
          </div>
           <footer>
             <button type="button" class="fe07-secondary-action" @onclick="CloseTaskDialog" disabled="@IsTaskSaving">Hủy</button><button type="submit" class="fe07-primary-action" disabled="@IsTaskSaving">@(IsTaskSaving ? "Đang tạo..." : "Tạo công việc")</button>
           </footer>
        </EditForm>
      </section>
    </div>
}

@if (IsAssetAssociationDialogOpen && TaskForAssetAssociation is not null)
{
    <div class="fe07-dialog-backdrop" role="presentation">
        <section class="fe07-dialog" role="dialog" aria-modal="true" aria-labelledby="asset-association-dialog-title">
            <header>
                <div>
                    <h2 id="asset-association-dialog-title">Gắn cơ sở vật chất hoặc thiết bị</h2>
                    <p><b>@TaskForAssetAssociation.TaskNumber</b> · @TaskForAssetAssociation.Title</p>
                </div>
                <button class="fe07-close-button" type="button" @onclick="CloseAssetAssociationDialog" disabled="@IsAssetAssociationSaving" aria-label="Đóng">×</button>
            </header>
            @if (IsAssetsLoading)
            {
                <p class="fe07-dialog-note" role="status">Đang tải danh sách cơ sở vật chất và thiết bị…</p>
            }
            else if (!Facilities.Any() && !Equipment.Any())
            {
                <p class="fe07-dialog-note">Chưa có cơ sở vật chất hoặc thiết bị để gắn với công việc này.</p>
            }
            else
            {
            <EditForm Model="AssetAssociationEditor" OnValidSubmit="SaveAssetAssociation">
                <div class="fe07-form-grid">
                    <div class="fe07-field">
                        <label>Cơ sở vật chất</label>
                        <PropFlowSelect Options="AllFacilityOptions" @bind-Value="AssociationFacilityIdString" AriaLabel="Cơ sở vật chất" />
                    </div>
                    <div class="fe07-field">
                        <label>Thiết bị</label>
                        <PropFlowSelect Options="AssociationEquipmentOptions" @bind-Value="AssociationEquipmentIdString" AriaLabel="Thiết bị" />
                    </div>
                </div>
                <p class="fe07-dialog-note">Chọn ít nhất một cơ sở vật chất hoặc thiết bị. Thiết bị thuộc cơ sở khác sẽ không thể lưu.</p>
                <footer>
                    <button type="button" class="fe07-secondary-action" @onclick="CloseAssetAssociationDialog" disabled="@IsAssetAssociationSaving">Hủy</button>
                    <button type="submit" class="fe07-primary-action" disabled="@IsAssetAssociationSaving">@(IsAssetAssociationSaving ? "Đang lưu..." : "Lưu liên kết")</button>
                </footer>
            </EditForm>
            }
        </section>
    </div>
}

@if (IsAssignmentDialogOpen && TaskForAssignment is not null)
{
    <div class="fe07-dialog-backdrop" role="presentation">
        <section class="fe07-dialog" role="dialog" aria-modal="true" aria-labelledby="assignment-dialog-title">
            <header>
                <div>
                    <h2 id="assignment-dialog-title">@(HasCurrentAssignees(TaskForAssignment) ? "Phân công lại" : "Phân công công việc")</h2>
                    <p><b>@TaskForAssignment.TaskNumber</b> · @TaskForAssignment.Title</p>
                </div>
                <button class="fe07-close-button" type="button" @onclick="CloseAssignmentDialog" disabled="@IsAssignmentSaving" aria-label="Đóng">×</button>
            </header>
            <div class="fe07-form-grid">
                @if (!string.IsNullOrWhiteSpace(TaskForAssignment.PriorityCode)) { <div class="fe07-field"><label>Ưu tiên</label><input value="@MaintenancePriority.DisplayName(TaskForAssignment.PriorityCode)" disabled /></div> }
                <div class="fe07-field"><label>Đối tượng</label><input value="@TaskAssetContext(TaskForAssignment)" disabled /></div>
                @if (TaskForAssignment.DueAt is { } due) { <div class="fe07-field"><label>Hạn hoàn thành</label><input value="@FormatDateTime(due)" disabled /></div> }
                @if (HasCurrentAssignees(TaskForAssignment)) { <div class="fe07-field fe07-wide"><label>Nhân viên hiện tại</label><input value="@AssigneeLabel(TaskForAssignment)" disabled /></div> }
            </div>
            @if (IsStaffLoading)
            {
                <p class="fe07-dialog-note" role="status">Đang tải danh sách nhân viên…</p>
            }
            else if (SelectableStaff.Count == 0)
            {
                <p class="fe07-dialog-note">Chưa có nhân viên đang hoạt động để phân công.</p>
            }
            else
            {
                <EditForm Model="AssignmentEditor" OnValidSubmit="SaveAssignment">
                    <DataAnnotationsValidator />
                    <div class="fe07-form-grid">
                        <div class="fe07-field fe07-wide">
                            <label>Nhân viên xử lý <b>*</b></label>
                            <p class="fe07-assignment-guidance">Nhiều nhân viên cùng thực hiện một công việc và chia sẻ trạng thái, tiến độ, nghiệm thu chung. Nếu cần theo dõi riêng từng đầu việc, hãy tạo các công việc bảo trì riêng biệt.</p>
                            <div class="fe07-assignee-picker" role="group" aria-label="Chọn nhân viên xử lý">
                                @foreach (var staff in SelectableStaff)
                                {
                                    <label class="fe07-assignee-option">
                                        <input type="checkbox" checked="@AssignmentEditor.StaffUserIds.Contains(staff.UserId)" @onchange="args => SetAssignmentStaff(staff.UserId, args.Value is true)" />
                                        <span>@staff.DisplayName <small>(@staff.Username)</small></span>
                                    </label>
                                }
                            </div>
                            <ValidationMessage For="@(() => AssignmentEditor.StaffUserIds)" />
                        </div>
                    </div>
                    <footer>
                        <button type="button" class="fe07-secondary" @onclick="CloseAssignmentDialog" disabled="@IsAssignmentSaving">Hủy</button>
                        <button type="submit" class="fe07-primary" disabled="@(IsAssignmentSaving || SelectableStaff.Count == 0)">@(IsAssignmentSaving ? "Đang lưu..." : HasCurrentAssignees(TaskForAssignment) ? "Phân công lại" : "Phân công")</button>
                    </footer>
                </EditForm>
            }
        </section>
    </div>
}

@if (IsProgressMonitorOpen)
{
    <div class="fe07-dialog-backdrop" role="presentation">
        <section class="fe07-dialog fe07-progress-dialog" role="dialog" aria-modal="true" aria-labelledby="progress-monitor-title">
            <header>
                <div><h2 id="progress-monitor-title">Theo dõi tiến độ công việc bảo trì</h2><p>@(ProgressMonitor?.TaskNumber ?? "Đang tải công việc…")</p></div>
                <button class="fe07-close-button" type="button" @onclick="CloseProgressMonitor" disabled="@IsProgressMonitorLoading" aria-label="Đóng">×</button>
            </header>
            @if (IsProgressMonitorLoading)
            {
                <div class="fe07-empty" role="status"><span class="fe07-spinner"></span><p>Đang tải thông tin theo dõi…</p></div>
            }
            else if (ProgressMonitor is not null)
            {
                var lifecycle = MaintenanceProgressLifecycleMapper.Map(ProgressMonitor);
                <div class="fe07-progress-layout">
                    <div class="fe07-progress-column">
                        <section class="fe07-progress-section">
                            <div class="fe07-progress-section-head"><h3>Tổng quan tiến độ</h3><span class="fe07-status @TaskStatusClass(ProgressMonitor.Status)"><i></i>@TaskStatusLabel(ProgressMonitor.Status)</span></div>
                            @if (lifecycle.IsCancelled)
                            {
                                <p class="fe07-dialog-note">Công việc đã hủy; tiến trình xử lý không tiếp tục.</p>
                            }
                            else
                            {
                                <div class="fe07-stepper" role="list" aria-label="Tiến trình công việc bảo trì">
                                    @foreach (var step in ProgressSteps)
                                    {
                                        <div role="listitem" class="@ProgressStepClass(step.Index, lifecycle)"><span>@if (lifecycle.IsStepCompleted(step.Index)) { <i class="material-symbols-outlined" aria-hidden="true">check</i> } else { @step.Index }</span><strong>@step.Label</strong></div>
                                    }
                                </div>
                            }
                            <div class="fe07-progress-milestones">
                                <div><span>Bắt đầu dự kiến</span><strong>@OptionalDateTime(ProgressMonitor.PlannedStartAt)</strong></div>
                                <div><span>Phân công lúc</span><strong>@OptionalDateTime(ProgressMonitor.AssignedAt)</strong></div>
                                <div><span>Cập nhật tiến độ</span><strong>@ProgressUpdateLabel(ProgressMonitor)</strong></div>
                                <div><span>Hạn hoàn thành</span><strong>@OptionalDateTime(ProgressMonitor.DueAt)</strong></div>
                            </div>
                            @if (ProgressMonitor.IsOverdue) { <span class="fe07-status is-overdue"><i></i>Quá hạn</span> }
                        </section>
                        <section class="fe07-progress-section">
                            <div class="fe07-progress-section-head"><h3>Hoạt động gần nhất</h3><span class="material-symbols-outlined" aria-hidden="true">history</span></div>
                            <p class="fe07-progress-activity">@LastActivityLabel(ProgressMonitor)</p>
                            @if (!string.IsNullOrWhiteSpace(ProgressMonitor.LastProgressContent)) { <p class="fe07-progress-activity">@ProgressMonitor.LastProgressContent</p> }
                        </section>
                    </div>
                    <div class="fe07-progress-column">
                        <section class="fe07-progress-section">
                            <div class="fe07-progress-section-head"><h3>Tóm tắt công việc</h3><span class="material-symbols-outlined" aria-hidden="true">assignment</span></div>
                            <dl class="fe07-progress-summary"><dt>Mã công việc</dt><dd>@ProgressMonitor.TaskNumber</dd><dt>Tiêu đề</dt><dd>@ProgressMonitor.Title</dd><dt>Nguồn</dt><dd>@(ProgressMonitor.ScheduleId is null ? "Công việc trực tiếp" : $"{ProgressMonitor.SourceScheduleCode ?? ProgressMonitor.ScheduleId.ToString()} · {ProgressMonitor.SourceScheduleTitle}")</dd><dt>Nhân viên xử lý</dt><dd>@AssigneeLabel(ProgressMonitor)</dd>@if (!string.IsNullOrWhiteSpace(ProgressMonitor.PriorityCode)) { <dt>Ưu tiên</dt><dd>@MaintenancePriority.DisplayName(ProgressMonitor.PriorityCode)</dd> }</dl>
                        </section>
                        <section class="fe07-progress-section">
                            <div class="fe07-progress-section-head"><h3>Thông tin tài sản &amp; vị trí</h3><span class="material-symbols-outlined" aria-hidden="true">domain</span></div>
                            <dl class="fe07-progress-summary"><dt>Cơ sở vật chất</dt><dd>@(ProgressMonitor.FacilityId is { } facilityId ? AssetName(facilityId) : "Chưa gắn")</dd><dt>Thiết bị</dt><dd>@(ProgressMonitor.EquipmentId is { } equipmentId ? AssetName(equipmentId) : "Chưa gắn")</dd></dl>
                        </section>
                    </div>
                </div>
                <div class="fe07-progress-review-area">
                    <section class="fe07-progress-section">
                        <div class="fe07-progress-section-head"><h3>Kết quả thực hiện</h3><span class="material-symbols-outlined" aria-hidden="true">fact_check</span></div>
                        @if (ProgressMonitor.LatestResult is null)
                        {
                            <p class="fe07-progress-activity">Chưa có kết quả thực hiện được gửi để Manager xem xét.</p>
                        }
                        else
                        {
                            <dl class="fe07-result-detail">
                                <dt>Trạng thái kết quả</dt><dd>@ResultStatusLabel(ProgressMonitor.LatestResult.ResultStatus)</dd>
                                <dt>Tóm tắt</dt><dd>@ProgressMonitor.LatestResult.Summary</dd>
                                <dt>Gửi lúc</dt><dd>@InCurrentTimeZone(ProgressMonitor.LatestResult.SubmittedAt).ToString("dd/MM/yyyy HH:mm")</dd>
                                @if (!string.IsNullOrWhiteSpace(ProgressMonitor.LatestResult.WorkPerformed)) { <dt>Công việc đã thực hiện</dt><dd>@ProgressMonitor.LatestResult.WorkPerformed</dd> }
                                @if (!string.IsNullOrWhiteSpace(ProgressMonitor.LatestResult.IssueFound)) { <dt>Thông tin cần xử lý thêm</dt><dd>@ProgressMonitor.LatestResult.IssueFound</dd> }
                                @if (!string.IsNullOrWhiteSpace(ProgressMonitor.LatestResult.Recommendation)) { <dt>Đề xuất</dt><dd>@ProgressMonitor.LatestResult.Recommendation</dd> }
                                @if (!string.IsNullOrWhiteSpace(ProgressMonitor.LatestResult.ReviewNote)) { <dt>Ghi chú Manager</dt><dd>@ProgressMonitor.LatestResult.ReviewNote</dd> }
                            </dl>
                        }
                    </section>
                    @if (ProgressMonitor.LatestResult is { ResultStatus: MaintenanceResultStatus.SUBMITTED } && ProgressMonitor.Status == MaintenanceTaskStatus.COMPLETED)
                    {
                        <section class="fe07-progress-section">
                            <div class="fe07-progress-section-head"><h3>Manager review</h3><span class="material-symbols-outlined" aria-hidden="true">rate_review</span></div>
                            <div class="fe07-field"><label for="maintenance-review-note">Ghi chú review</label><textarea id="maintenance-review-note" @bind="ReviewEditor.ReviewNote" disabled="@IsReviewSaving"></textarea></div>
                            <div class="fe07-review-actions">
                                <button type="button" class="fe07-secondary" @onclick="RequestRevision" disabled="@IsReviewSaving">Yêu cầu xử lý thêm</button>
                                <button type="button" class="fe07-primary" @onclick="ApproveAndClose" disabled="@IsReviewSaving">@(IsReviewSaving ? "Đang lưu…" : "Chấp nhận & đóng công việc")</button>
                            </div>
                        </section>
                    }
                    else if (ProgressMonitor.LatestResult is { ResultStatus: MaintenanceResultStatus.REVISION_REQUIRED } && ProgressMonitor.Status == MaintenanceTaskStatus.ASSIGNED)
                    {
                        <section class="fe07-progress-section">
                            <div class="fe07-progress-section-head"><h3>Cần tiếp tục xử lý</h3><span class="material-symbols-outlined" aria-hidden="true">restart_alt</span></div>
                            <p class="fe07-progress-activity">Công việc đã được mở lại để tiếp tục xử lý. Toàn bộ kết quả, hoạt động và phân công trước đó được giữ nguyên.</p>
                            <div class="fe07-review-actions"><button type="button" class="fe07-secondary" @onclick="ReassignFromProgressMonitor">Phân công lại</button></div>
                        </section>
                    }
                </div>
                <footer><button type="button" class="fe07-secondary" @onclick="CloseProgressMonitor">Đóng</button></footer>
            }
        </section>
    </div>
}

@if (IsHistoryDetailOpen)
{
    <div class="fe07-dialog-backdrop" role="presentation">
        <section class="fe07-dialog fe07-history-detail-dialog" role="dialog" aria-modal="true" aria-labelledby="history-detail-title">
            <header class="fe07-history-detail-header"><div><p class="fe07-history-eyebrow">Hồ sơ lịch sử · chỉ đọc</p><span class="fe07-code">@(HistoryDetail?.Task.TaskNumber ?? "Đang tải…")</span><h2 id="history-detail-title">@(HistoryDetail?.Task.Title ?? "Chi tiết lịch sử bảo trì")</h2>@if (HistoryDetail is not null) { <p class="fe07-history-header-context"><span class="fe07-status @TaskStatusClass(HistoryDetail.Task.Status)"><i></i>@TaskStatusLabel(HistoryDetail.Task.Status)</span>@HistoryCompletionContext(HistoryDetail.Task)</p> }</div><button class="fe07-close-button" type="button" @onclick="CloseHistoryDetail" disabled="@IsHistoryDetailLoading" aria-label="Đóng">×</button></header>
            @if (IsHistoryDetailLoading)
            {
                <div class="fe07-empty" role="status"><span class="fe07-spinner"></span><p>Đang tải lịch sử bảo trì…</p></div>
            }
            else if (HistoryDetail is not null)
            {
                <div class="fe07-history-detail">
                    <section class="fe07-history-detail-section fe07-history-asset-hierarchy"><div class="fe07-history-section-title"><span class="material-symbols-outlined" aria-hidden="true">account_tree</span><h3>Phân cấp tài sản hệ thống</h3></div>
                        @if (HistoryDetail.Task.FacilityId is not null && HistoryDetail.Task.EquipmentId is not null)
                        {
                            <div class="fe07-history-asset-flow"><div><span>Cơ sở vật chất</span><strong>@HistoryFacilityName(HistoryDetail.Task)</strong><small>@HistoryFacilityMetadata(HistoryDetail.Task)</small></div><span class="material-symbols-outlined fe07-history-asset-arrow" aria-hidden="true">arrow_forward</span><div><span>Thiết bị</span><strong>@HistoryEquipmentName(HistoryDetail.Task)</strong><small>@HistoryEquipmentMetadata(HistoryDetail.Task)</small></div></div>
                        }
                        else if (HistoryDetail.Task.FacilityId is not null)
                        {
                            <div class="fe07-history-asset-single"><span>Cơ sở vật chất</span><strong>@HistoryFacilityName(HistoryDetail.Task)</strong><small>@HistoryFacilityMetadata(HistoryDetail.Task)</small></div>
                        }
                        else if (HistoryDetail.Task.EquipmentId is not null)
                        {
                            <div class="fe07-history-asset-single"><span>Thiết bị</span><strong>@HistoryEquipmentName(HistoryDetail.Task)</strong><small>@HistoryEquipmentMetadata(HistoryDetail.Task)</small></div>
                        }
                        else
                        {
                            <p class="fe07-history-asset-empty">Chưa gắn tài sản</p>
                        }
                    </section>
                    <div class="fe07-history-context-grid">
                        <section class="fe07-history-detail-section"><div class="fe07-history-section-title"><span class="material-symbols-outlined" aria-hidden="true">source</span><h3>Nguồn gốc phát sinh</h3></div><strong>@HistoryTypeLabel(HistoryDetail.Task)</strong><p>@HistorySourceLabel(HistoryDetail.Task)</p></section>
                        <section class="fe07-history-detail-section"><div class="fe07-history-section-title"><span class="material-symbols-outlined" aria-hidden="true">groups</span><h3>Người thực hiện</h3></div>@if (!HistoryDetail.Assignments.Any()) { <p class="fe07-progress-activity">Chưa có nhân viên tham gia.</p> } else { <div class="fe07-history-staff-path">@foreach (var assignment in HistoryDetail.Assignments) { <div><strong>@HistoryStaffLabel(assignment.StaffDisplayName, assignment.StaffUsername)</strong><span>@AssignmentStatusLabel(assignment.Status) · @FormatDateTime(assignment.AssignedAt)</span></div> }</div> }</section>
                    </div>
                    <section class="fe07-history-detail-section fe07-history-results"><div class="fe07-history-section-title"><span class="material-symbols-outlined" aria-hidden="true">fact_check</span><h3>Kết quả bảo trì</h3></div>@if (!HistoryDetail.Results.Any()) { <p class="fe07-progress-activity">Chưa có kết quả thực hiện.</p> } else { <div class="fe07-history-result-cards">@foreach (var result in HistoryDetail.Results) { <article><div><span class="fe07-status @ResultStatusClass(result.ResultStatus)"><i></i>@ResultStatusLabel(result.ResultStatus)</span><time>@FormatDateTime(result.SubmittedAt)</time></div><strong>@result.Summary</strong>@if (!string.IsNullOrWhiteSpace(result.WorkPerformed)) { <p>@result.WorkPerformed</p> }@if (!string.IsNullOrWhiteSpace(result.IssueFound)) { <p><b>Vấn đề ghi nhận:</b> @result.IssueFound</p> }@if (!string.IsNullOrWhiteSpace(result.ReviewNote) || result.ReviewedAt is not null) { <section class="fe07-history-review"><span class="material-symbols-outlined" aria-hidden="true">rate_review</span><div><strong>Đánh giá của quản lý · @ResultStatusLabel(result.ResultStatus)</strong>@if (!string.IsNullOrWhiteSpace(result.ReviewNote)) { <p>@result.ReviewNote</p> }@if (result.ReviewedAt is { } reviewedAt) { <small>@FormatDateTime(reviewedAt)</small> }</div></section> }</article>}</div>}</section>
                    <section class="fe07-history-detail-section"><div class="fe07-history-section-title"><span class="material-symbols-outlined" aria-hidden="true">timeline</span><h3>Nhật ký vận hành / dòng thời gian</h3></div><div class="fe07-history-timeline">@foreach (var entry in HistoryDetail.Timeline.Where(entry => MaintenanceFeatureFlags.ServiceRequestLinkingEnabled || entry.ActivityType != MaintenanceActivityType.SERVICE_REQUEST_LINKED)) { <div><time>@FormatDateTime(entry.OccurredAt)</time><p><strong>@TimelineLabel(entry)</strong>@if (!string.IsNullOrWhiteSpace(entry.Detail)) { <span>@entry.Detail</span> }</p></div>}</div></section>
                </div>
                <footer><button type="button" class="fe07-secondary" @onclick="CloseHistoryDetail">Đóng</button></footer>
            }
        </section>
    </div>
}

@if (IsTaskDetailOpen)
{
    <div class="fe07-dialog-backdrop" role="presentation">
        <section class="fe07-dialog" role="dialog" aria-modal="true" aria-labelledby="task-detail-title">
            <header>
                <div><h2 id="task-detail-title">Chi tiết công việc bảo trì</h2><p>@(TaskDetail?.TaskNumber ?? "Đang tải công việc…")</p></div>
                <button class="fe07-close-button" type="button" @onclick="CloseTaskDetail" disabled="@IsTaskDetailLoading" aria-label="Đóng">×</button>
            </header>
            @if (IsTaskDetailLoading)
            {
                <div class="fe07-empty" role="status"><span class="fe07-spinner"></span><p>Đang tải chi tiết công việc…</p></div>
            }
            else if (TaskDetail is not null)
            {
                <div class="fe07-task-detail">
                    <div><span>Tiêu đề</span><strong>@TaskDetail.Title</strong></div>
                    <div><span>Trạng thái</span><strong>@TaskStatusLabel(TaskDetail.Status)</strong></div>
                    <div><span>Cơ sở vật chất</span><strong>@(TaskDetail.FacilityId is { } facilityId ? AssetName(facilityId) : "Chưa gắn")</strong></div>
                    <div><span>Thiết bị</span><strong>@(TaskDetail.EquipmentId is { } equipmentId ? AssetName(equipmentId) : "Chưa gắn")</strong></div>
                    <div><span>Nguồn lịch</span><strong>@(TaskDetail.ScheduleId is null ? "Công việc trực tiếp" : $"{TaskDetail.SourceScheduleCode ?? TaskDetail.ScheduleId.ToString()} · {TaskDetail.SourceScheduleTitle}")</strong></div>
                    <div><span>Thời gian dự kiến</span><strong>@(TaskDetail.PlannedStartAt is { } start ? InCurrentTimeZone(start).ToString("dd/MM/yyyy HH:mm") : "Chưa xác định")</strong></div>
                    <div><span>Hạn hoàn thành</span><strong>@(TaskDetail.DueAt is { } due ? InCurrentTimeZone(due).ToString("dd/MM/yyyy HH:mm") : "Chưa xác định")</strong></div>
                    @if (!string.IsNullOrWhiteSpace(TaskDetail.PriorityCode)) { <div><span>Ưu tiên</span><strong>@MaintenancePriority.DisplayName(TaskDetail.PriorityCode)</strong></div> }
                    <div class="wide fe07-assignment-detail"><span>Phân công</span><strong>@AssigneeLabel(TaskDetail)</strong>@if (TaskDetail.AssignedAt is { } assignedAt) { <small>Phân công lúc @InCurrentTimeZone(assignedAt).ToString("dd/MM/yyyy HH:mm")</small> }@if (TaskDetail.Status != MaintenanceTaskStatus.CLOSED) { <button type="button" class="fe07-secondary" @onclick="() => OpenAssignment(TaskDetail, true)">@(HasCurrentAssignees(TaskDetail) ? "Phân công lại" : "Phân công")</button> }</div>
                    @if (MaintenanceFeatureFlags.ServiceRequestLinkingEnabled)
                    {
                    <div class="wide fe07-service-request-detail"><span>Yêu cầu dịch vụ liên quan</span>
                        @if (TaskDetail.RelatedServiceRequest is { } request)
                        {
                            <strong>@request.RequestNumber · @request.Title</strong><small>Trạng thái: @ServiceRequestStatusLabel(request.Status)</small><small>Vị trí phát sinh: @(request.LocationDescription ?? "Chưa xác định")</small><small>Vị trí thực hiện bảo trì: @TaskAssetContext(TaskDetail)</small>@if (!string.IsNullOrWhiteSpace(request.ContextWarning)) { <p class="fe07-service-request-context is-warning">@request.ContextWarning</p> } else if (request.ContextMatch == "MATCHED") { <p class="fe07-service-request-context">Bối cảnh tài sản phù hợp.</p> } else if (request.ContextMatch == "INSUFFICIENT_DATA") { <p class="fe07-service-request-context">Chưa đủ dữ liệu để xác định sự phù hợp giữa yêu cầu dịch vụ và công việc bảo trì.</p> }<a class="fe07-secondary" href="@($"/manager/service-requests/{request.Id}")">Xem yêu cầu</a>
                        }
                        else if (TaskDetail.SourceServiceRequestId is not null)
                        {
                            <strong>Không thể tải thông tin yêu cầu dịch vụ liên quan.</strong><small>Mã tham chiếu: @TaskDetail.SourceServiceRequestId</small>
                        }
                        else
                        {
                            <strong>Chưa liên kết yêu cầu dịch vụ.</strong><button type="button" class="fe07-secondary" @onclick="() => OpenTaskServiceRequestPicker(TaskDetail.Id)">Liên kết yêu cầu</button>
                        }
                    </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(TaskDetail.Description)) { <div class="wide"><span>Mô tả</span><strong>@TaskDetail.Description</strong></div> }
                </div>
                <footer><button type="button" class="fe07-secondary" @onclick="CloseTaskDetail">Đóng</button>@if (TaskDetail.Status != MaintenanceTaskStatus.CLOSED) { <button type="button" class="fe07-primary" @onclick="EditTaskAssets">Chỉnh sửa đối tượng</button> }</footer>
            }
        </section>
    </div>
}

@if (MaintenanceFeatureFlags.ServiceRequestLinkingEnabled && IsServiceRequestPickerOpen)
{
    <div class="fe07-dialog-backdrop" role="presentation">
        <section class="fe07-dialog fe07-service-request-dialog" role="dialog" aria-modal="true" aria-labelledby="service-request-picker-title">
            <header><div><h2 id="service-request-picker-title">Liên kết yêu cầu dịch vụ</h2><p>Tìm theo mã hoặc tiêu đề yêu cầu dịch vụ.</p></div><button class="fe07-close-button" type="button" @onclick="CloseServiceRequestPicker" disabled="@IsServiceRequestPickerLoading" aria-label="Đóng">×</button></header>
            <div class="fe07-service-request-search"><input type="search" @bind="ServiceRequestSearch" @bind:event="oninput" placeholder="Tìm mã hoặc tiêu đề..." aria-label="Tìm yêu cầu dịch vụ" /><button class="fe07-secondary" type="button" @onclick="LoadServiceRequestCandidatesAsync" disabled="@IsServiceRequestPickerLoading">Tìm</button></div>
            @if (IsServiceRequestPickerLoading) { <p class="fe07-dialog-note" role="status">Đang tải yêu cầu dịch vụ…</p> }
            else if (!string.IsNullOrWhiteSpace(ServiceRequestPickerError)) { <p class="fe07-dialog-note" role="alert">@ServiceRequestPickerError</p> }
            else if (ServiceRequestCandidates.Count == 0) { <p class="fe07-dialog-note">Không có yêu cầu dịch vụ đủ điều kiện liên kết.</p> }
            else { <div class="fe07-service-request-candidates">@foreach (var request in ServiceRequestCandidates) { var context = CandidateContext(request); <button type="button" class="@(SelectedServiceRequestId == request.Id ? "is-selected" : null)" @onclick="() => SelectedServiceRequestId = request.Id" disabled="@(!request.IsLinkable)"><strong>@request.RequestNumber</strong><span>@request.Title</span><small>@ServiceRequestStatusLabel(request.Status)</small><div class="fe07-service-request-context @(context.Match == "DIFFERENT_CONTEXT" ? "is-warning" : null)"><span>Vị trí phát sinh: @RequestLocation(request)</span><span>Vị trí thực hiện: @context.TaskLocation</span><span>@context.Message</span></div>@if (!request.IsLinkable) { <em>Không đủ điều kiện</em> }</button> }</div> }
            <footer><button type="button" class="fe07-secondary" @onclick="CloseServiceRequestPicker" disabled="@IsServiceRequestPickerLoading">Hủy</button><button type="button" class="fe07-primary" @onclick="SelectServiceRequest" disabled="@(SelectedServiceRequestId is null || IsServiceRequestPickerLoading)">Liên kết</button></footer>
        </section>
    </div>
}

