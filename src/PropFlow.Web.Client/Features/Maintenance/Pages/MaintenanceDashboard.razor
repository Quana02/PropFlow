    private async Task SaveTask()
    {
        if (TaskSourceSchedule is null && TaskEditor.DueAt is not null && TaskEditor.PlannedStartAt is not null && TaskEditor.DueAt < TaskEditor.PlannedStartAt) { ErrorMessage = "Hạn hoàn thành phải sau thời điểm dự kiến."; return; }
        IsTaskSaving = true;
        var result = await MaintenanceApi.CreateTaskAsync(TaskEditor, cts.Token);
        IsTaskSaving = false;
        if (!result.IsSuccess) { ErrorMessage = result.Message ?? "Không thể tạo công việc bảo trì."; return; }
        var createdTask = result.Data!;
        SuccessMessage = $"Đã tạo công việc {createdTask.TaskNumber} ở trạng thái {TaskStatusLabel(createdTask.Status)}.";
        IsTaskDialogOpen = false;
        TaskSourceSchedule = null;
        if (createdTask.FacilityId is null && createdTask.EquipmentId is null)
        {
            TaskForAssetAssociation = createdTask;
            OpenAssetAssociationDialog();
        }
        else
        {
            TaskForAssetAssociation = null;
        }
        if (!IsScheduleWorkspace && !IsHistoryWorkspace) await LoadTasks();
    }
