    private HubConnection? _hubConnection;

    protected override async Task OnInitializedAsync()
    {
        if (string.Equals(Workspace, "tasks", StringComparison.OrdinalIgnoreCase))
            IsScheduleWorkspace = false;
        var assetsTask = MaintenanceApi.AssetsAsync(cts.Token);
        var buildingTask = BuildingApi.GetCurrentBuildingOverviewAsync(cts.Token);
        var building = await buildingTask;
        if (building.IsSuccess && building.Data is not null) TimeZoneId = building.Data.TimeZoneId;
        WeekStart = StartOfWeek(Today);
        SelectedDate = Today;
        await LoadSchedules();
        if (!IsScheduleWorkspace && !IsHistoryWorkspace)
            await LoadTasks();
        var assets = await assetsTask;
        if (assets.IsSuccess && assets.Data is not null) Assets = assets.Data;
        else ErrorMessage ??= assets.Message ?? "Không thể tải danh sách tài sản.";
        IsAssetsLoading = false;
        _ = ConnectMaintenanceHubAsync();
    }

    private async Task ConnectMaintenanceHubAsync()
    {
        try
        {
            var hub = MaintenanceHubConnectionFactory.Create();
            hub.On<Guid>("TaskUpdated", taskId =>
            {
                return InvokeAsync(async () =>
                {
                    await RefreshTasksForRealtimeAsync(taskId);
                    StateHasChanged();
                });
            });
            hub.Reconnected += _ => InvokeAsync(async () =>
            {
                await RefreshTasksForRealtimeAsync();
                StateHasChanged();
            });
            await hub.StartAsync(cts.Token);
            _hubConnection = hub;
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
        }
        catch
        {
            // Realtime refresh is optional; a hub outage must never block Maintenance data loading.
        }
    }

    private async Task RefreshTasksForRealtimeAsync(Guid? taskId = null)
    {
        if (IsHistoryWorkspace)
        {
            await LoadHistory();
            return;
        }

        if (IsScheduleWorkspace)
            return;

        await LoadTasks();
        if (taskId is { } id && ((IsProgressMonitorOpen && ProgressMonitor?.Id == id) || (IsTaskDetailOpen && TaskDetail?.Id == id)))
        {
            var result = await MaintenanceApi.TaskAsync(id, cts.Token);
            if (result.IsSuccess && result.Data is not null)
            {
                if (IsProgressMonitorOpen && ProgressMonitor?.Id == id) ProgressMonitor = result.Data;
                if (IsTaskDetailOpen && TaskDetail?.Id == id) TaskDetail = result.Data;
            }
        }
    }

