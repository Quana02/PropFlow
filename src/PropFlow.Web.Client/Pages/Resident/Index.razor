<span class="font-medium text-slate-800 dark:text-slate-200">300.000 đ</span>
</div>
<div class="pt-1 text-[10px] text-amber-600 dark:text-amber-400 flex items-center space-x-1">
<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
<path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
</svg>
<span class="">Hạn chót thanh toán: <strong>05/10/2026</strong></span>
</div>
</div>
<div class="grid grid-cols-2 gap-2 mt-3 pt-2 border-t border-slate-200/60 dark:border-slate-700/60">
<button class="w-full py-1.5 px-2 bg-gradient-to-r from-emerald-500 to-teal-600 text-white rounded-xl text-center font-bold text-[11px] shadow hover:opacity-95 transition-opacity flex items-center justify-center space-x-1" onclick="alert('Mở cổng thanh toán bảo mật VietQR Pay...');">
<span class="">Quét VietQR</span>
</button>
<button class="w-full py-1.5 px-2 bg-slate-100 hover:bg-slate-200/80 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 rounded-xl text-center font-semibold text-[11px] transition-colors flex items-center justify-center space-x-1" onclick="alert('Đang tải file hóa đơn điện tử PDF...');">
<span class="">Tải file PDF</span>
</button>
</div>
</div>
<!-- Assistant suggestion hint -->
<div class="text-[11px] text-slate-500 dark:text-slate-400 flex items-center space-x-1.5 pl-1">
<span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
<span class="">Anh có muốn em kết nối với Kế toán trưởng nếu cần đối soát?</span>
</div>
</div>
</div>
</div>
<!-- Input Area -->
<div class="p-3 bg-white/80 dark:bg-slate-900/90 border-t border-slate-200/60 dark:border-slate-800/80">
<div class="relative flex items-center space-x-2">
<div class="relative flex-1">
<input class="w-full pl-3.5 pr-16 py-2.5 text-xs rounded-2xl glass-inner text-slate-800 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-400/50 border border-slate-200/80 dark:border-slate-700/80 shadow-inner" id="chatInputBox" onkeydown="if(event.key==='Enter'){event.preventDefault();const val=this.value.trim();if(val){const thread=document.getElementById('chatMessageThread');const bubble=document.createElement('div');bubble.className='flex items-start justify-end space-x-2.5 pl-6 animate-float-subtle';bubble.innerHTML='&lt;div class=\'bg-gradient-to-r from-sky-600 to-indigo-600 dark:from-cyan-500 dark:to-sky-600 text-white dark:text-slate-950 p-3 rounded-2xl rounded-tr-none shadow\'&gt;&lt;p&gt;'+val+'&lt;/p&gt;&lt;/div&gt;&lt;div class=\'w-7 h-7 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-bold flex items-center justify-center text-xs flex-shrink-0 mt-0.5\'&gt;HN&lt;/div&gt;';thread.appendChild(bubble);this.value='';thread.scrollTop=thread.scrollHeight;setTimeout(()=&gt;{const ai=document.createElement('div');ai.className='flex items-start space-x-2.5';ai.innerHTML='&lt;div class=\'w-7 h-7 rounded-xl bg-gradient-to-tr from-sky-500 to-emerald-500 flex items-center justify-center text-white text-xs font-bold shadow-sm flex-shrink-0 mt-0.5\'&gt;AI&lt;/div&gt;&lt;div class=\'flex-1 glass-inner p-3 rounded-2xl rounded-tl-none border border-slate-200/60 dark:border-slate-800 text-slate-800 dark:text-slate-100\'&gt;Dạ em đã ghi nhận yêu cầu của Anh Nam! Em đang chuyển dữ liệu xử lý trực tiếp đến Ban Quản Lý tòa nhà.&lt;/div&gt;';thread.appendChild(ai);thread.scrollTop=thread.scrollHeight;},600);}}" placeholder="Hỏi bất kỳ điều gì hoặc gửi yêu cầu cho BQL..." type="text">
<div class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center space-x-1 text-slate-400">
<button class="p-1 hover:text-sky-600 dark:hover:text-cyan-400 rounded-lg transition-colors" title="Đính kèm ảnh hiện trường" type="button">
<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
<path d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
</svg>
</button>
<button class="p-1 hover:text-emerald-600 dark:hover:text-emerald-400 rounded-lg transition-colors" title="Thu âm giọng nói" type="button">
<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
<path d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
</svg>
</button>
</div>
</div>
<!-- Send Button -->
<button class="w-9 h-9 rounded-2xl bg-gradient-to-tr from-emerald-500 to-sky-600 text-white flex items-center justify-center shadow-md shadow-emerald-500/25 hover:opacity-90 active:scale-95 transition-all flex-shrink-0" onclick="const inp=document.getElementById('chatInputBox');const val=inp.value.trim();if(val){const ev=new KeyboardEvent('keydown',{'key':'Enter'});inp.dispatchEvent(ev);}" type="button">
<svg class="w-4 h-4 transform rotate-90 translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
<path d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
</svg>
</button>
</div>
</div>
</div>
<!-- Floating AI Assistant Trigger Toggle Button -->
<button aria-label="Mở trợ lý ảo PropFlow Copilot" class="group relative flex items-center justify-center w-14 h-14 rounded-full bg-gradient-to-r from-emerald-500 via-teal-500 to-sky-600 text-white shadow-2xl shadow-emerald-500/35 hover:shadow-emerald-500/50 hover:scale-105 active:scale-95 transition-all duration-300 ring-2 ring-white/60 dark:ring-cyan-400/40 border border-emerald-300/40" id="toggleAiAssistantBtn" onclick="document.getElementById('aiChatWindow').classList.toggle('hidden');" title="PropFlow AI Copilot 24/7" type="button">
<div class="relative flex items-center justify-center">
<svg class="w-6 h-6 text-white animate-pulse group-hover:rotate-12 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
<path d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
</svg>
<span class="absolute -top-1 -right-1 w-3 h-3 bg-emerald-300 rounded-full animate-ping"></span>
<span class="absolute -top-1 -right-1 w-3 h-3 bg-emerald-400 border-2 border-white dark:border-slate-900 rounded-full"></span>
</div>
</button>
</div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("initResidentPortal");
        }
    }
}
