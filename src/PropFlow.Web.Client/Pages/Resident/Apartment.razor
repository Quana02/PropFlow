@page "/resident/apartment"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "RESIDENT")]
@layout PropFlow.Web.Client.Layout.LandingLayout
@using PropFlow.Web.Client.Features.Apartment.Models
@using PropFlow.Web.Client.Features.Apartment.Services
@inject IApartmentApiClient Apartments
@inject NavigationManager Navigation

<PageTitle>Căn hộ của tôi - PropFlow</PageTitle>

<main class="resident-apartment-page">
    <button class="back" @onclick="Back"><span class="material-symbols-outlined">arrow_back</span>Trang cư dân</button>
    <header>
        <div class="title-icon"><span class="material-symbols-outlined">apartment</span></div>
        <div><span class="eyebrow">MY APARTMENTS</span><h1>Căn hộ của tôi</h1><p>Thông tin căn hộ được xác định từ quan hệ cư trú đang hiệu lực của bạn.</p></div>
        <button class="refresh" @onclick="Load" title="Tải lại"><span class="material-symbols-outlined">refresh</span></button>
    </header>

    @if (loading)
    {
        <section class="state"><span class="material-symbols-outlined spin">progress_activity</span><strong>Đang tải thông tin căn hộ…</strong></section>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <section class="state error"><span class="material-symbols-outlined">error</span><strong>@error</strong><button @onclick="Load">Thử lại</button></section>
    }
    else if (items.Count == 0)
    {
        <section class="state"><span class="material-symbols-outlined">meeting_room</span><strong>Chưa có căn hộ đang cư trú</strong><p>Khi quan hệ cư trú có hiệu lực, căn hộ sẽ xuất hiện tại đây.</p></section>
    }
    else
    {
        <section class="apartment-grid">
            @foreach (var item in items)
            {
                <article>
                    <div class="card-head"><span class="material-symbols-outlined">domain</span><div><small>CĂN HỘ</small><h2>@item.UnitNumber</h2></div><span class="status @(item.Status == "ACTIVE" ? "active" : "inactive")">@(item.Status == "ACTIVE" ? "Đang quản lý" : "Ngừng quản lý")</span></div>
                    <dl>
                        <div><dt>Tầng</dt><dd>@item.FloorNumber</dd></div>
                        <div><dt>Loại căn hộ</dt><dd>@item.UnitType</dd></div>
                        <div><dt>Diện tích sử dụng</dt><dd>@item.UsableAreaM2.ToString("0.##") m²</dd></div>
                        <div><dt>Phòng ngủ</dt><dd>@(item.BedroomCount?.ToString() ?? "Chưa cập nhật")</dd></div>
                        <div><dt>Phòng tắm</dt><dd>@(item.BathroomCount?.ToString() ?? "Chưa cập nhật")</dd></div>
                        <div><dt>Ngày bàn giao</dt><dd>@(item.HandoverDate?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</dd></div>
                    </dl>
                </article>
            }
        </section>
    }
</main>

<style>
.resident-apartment-page{min-height:100vh;padding:28px clamp(20px,5vw,72px);background:radial-gradient(circle at 12% 12%,rgba(56,189,248,.16),transparent 30%),radial-gradient(circle at 88% 80%,rgba(99,102,241,.13),transparent 34%),#f4f8ff;color:#17233b;font-family:Inter,"Segoe UI",sans-serif}.resident-apartment-page .back{display:flex;align-items:center;gap:7px;border:0;background:transparent;color:#0284c7;font-weight:700;font-size:15px;cursor:pointer;margin-bottom:18px}.resident-apartment-page>header{display:flex;align-items:center;gap:16px;background:rgba(255,255,255,.9);border:1px solid #d9e7f5;border-radius:24px;padding:24px 28px;box-shadow:0 18px 44px rgba(51,65,85,.08)}.title-icon{width:52px;height:52px;border-radius:16px;display:grid;place-items:center;color:white;background:linear-gradient(135deg,#0284c7,#2563eb)}.title-icon span{font-size:28px}.resident-apartment-page h1{margin:2px 0 4px;font-size:28px}.resident-apartment-page header p{margin:0;color:#64748b}.eyebrow{color:#0284c7;font-size:12px;font-weight:800;letter-spacing:.1em}.refresh{margin-left:auto;width:44px;height:44px;border-radius:13px;border:1px solid #cfe0f1;background:#fff;color:#0284c7;cursor:pointer}.refresh:hover span{animation:resident-spin .65s linear}.apartment-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:20px;margin-top:22px}.apartment-grid article{background:rgba(255,255,255,.92);border:1px solid #d9e7f5;border-radius:22px;padding:24px;box-shadow:0 15px 35px rgba(51,65,85,.07)}.card-head{display:flex;align-items:center;gap:12px;padding-bottom:18px;border-bottom:1px solid #e7eef7}.card-head>span:first-child{width:44px;height:44px;border-radius:13px;background:#e0f2fe;color:#0284c7;display:grid;place-items:center}.card-head small{font-size:11px;font-weight:800;color:#0284c7;letter-spacing:.1em}.card-head h2{margin:2px 0 0;font-size:24px}.status{margin-left:auto;padding:7px 11px;border-radius:999px;font-size:12px;font-weight:700}.status.active{background:#dcfce7;color:#15803d}.status.inactive{background:#ffedd5;color:#c2410c}.apartment-grid dl{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin:20px 0 0}.apartment-grid dl div{background:#f8fafc;border-radius:14px;padding:13px}.apartment-grid dt{color:#64748b;font-size:12px;margin-bottom:5px}.apartment-grid dd{margin:0;font-weight:700}.state{margin-top:22px;min-height:220px;background:rgba(255,255,255,.9);border:1px solid #d9e7f5;border-radius:22px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;color:#64748b}.state>span{font-size:36px;color:#0284c7}.state.error>span{color:#dc2626}.state button{border:0;border-radius:12px;background:#0284c7;color:#fff;padding:10px 18px;font-weight:700;cursor:pointer}.spin{animation:resident-spin 1s linear infinite}@@keyframes resident-spin{to{transform:rotate(360deg)}}@@media(max-width:640px){.resident-apartment-page>header{align-items:flex-start}.refresh{margin-left:0}.apartment-grid dl{grid-template-columns:1fr}}
</style>

@code {
    private bool loading = true;
    private string? error;
    private IReadOnlyList<ResidentApartmentSelfItem> items = [];

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        loading = true;
        error = null;
        var result = await Apartments.MeAsync();
        if (result.IsSuccess) items = result.Data ?? [];
        else error = result.Message ?? "Không thể tải thông tin căn hộ. Vui lòng thử lại.";
        loading = false;
    }

    private void Back() => Navigation.NavigateTo("/resident");
}
