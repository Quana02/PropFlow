@using Microsoft.AspNetCore.Components.Authorization
@using PropFlow.Web.Client.Layout.Navigation.Accountant
@using PropFlow.Web.Client.Layout.Navigation.Operations

<AuthorizeView Roles="ACCOUNTANT">
    <Authorized><AccountantNavMenu /></Authorized>
    <NotAuthorized>
        <AuthorizeView Roles="MANAGER,STAFF" Context="operationsContext">
            <Authorized><OperationsNavMenu /></Authorized>
            <NotAuthorized>
                <div class="top-row ps-3 navbar navbar-dark">
                    <div class="container-fluid">
                        <a class="navbar-brand" href="">PropFlow</a>
                    </div>
                </div>
                <input type="checkbox" title="Navigation menu" class="navbar-toggler" />
                <div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
                    <nav class="flex-column">
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Trang chủ
                            </NavLink>
                        </div>
                    </nav>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </NotAuthorized>
</AuthorizeView>
