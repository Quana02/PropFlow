@using Microsoft.AspNetCore.Components.Authorization
@using PropFlow.Web.Client.Layout.Navigation.Admin
@using PropFlow.Web.Client.Layout.Navigation.Accountant
@using PropFlow.Web.Client.Layout.Navigation.Operations
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="app-floating-nav" @ref="railRef" aria-label="Điều hướng ứng dụng">
    <div class="app-nav-drag" role="button" tabindex="0"
         title="Kéo để di chuyển menu" aria-label="Di chuyển menu bằng cách kéo hoặc phím mũi tên">
        <span aria-hidden="true">⋮⋮</span>
    </div>
    <div class="app-nav-scroll">
        <AuthorizeView Roles="ADMIN"><AdminNavMenu /></AuthorizeView>
        <AuthorizeView Roles="ACCOUNTANT"><AccountantNavMenu /></AuthorizeView>
        <AuthorizeView Policy="@PropFlow.Web.Client.Features.Facility.Services.AssetPermissions.ViewPolicy"><OperationsNavMenu /></AuthorizeView>
    </div>
</div>

@code {
    private bool disposed;
    private ElementReference railRef;
    private IJSObjectReference? module;
    private IJSObjectReference? dragHandle;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var imported = await JS.InvokeAsync<IJSObjectReference>("import", "./js/app-shell-nav.js?v=20261109-2");
        if (disposed) { await imported.DisposeAsync(); return; }
        module = imported;
        var initialized = await module.InvokeAsync<IJSObjectReference>("initialize", railRef);
        if (disposed)
        {
            await initialized.InvokeVoidAsync("dispose");
            await initialized.DisposeAsync();
            return;
        }
        dragHandle = initialized;
    }

    public async ValueTask DisposeAsync()
    {
        if (disposed) return;
        disposed = true;
        try
        {
            if (dragHandle is not null)
            {
                await dragHandle.InvokeVoidAsync("dispose");
                await dragHandle.DisposeAsync();
            }
            if (module is not null) await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The browser may already be gone when the layout is disposed.
        }
    }
}
