{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cloudinary": {
    "ServiceRequestFolder": "propflow/service-request-evidence",
    "MaintenanceFolder": "propflow/maintenance-evidence"
  },
  "Payments": {
    "SePay": {
      "Enabled": false,
      "AuthenticationMode": "API_KEY",
      "WebhookPublicBaseUrl": "",
      "Gateway": "",
      "BankCode": "",
      "OAuth": {
        "Enabled": false,
        "ClientId": "",
        "RedirectUri": "https://localhost:7201/admin/sepay/callback"
      }
    }
  },
  "Parking": {
    "Ai": {
      "Model": "gemini-4-hydrogen",
      "ReadTimeoutSeconds": 40,
      "ReviewTimeoutSeconds": 35,
      "TotalTimeoutSeconds": 75,
      "OverloadCooldownSeconds": 30
    }
  },
  "FacilityRecommendations": {
    "Live": {
      "Enabled": true,
      "Model": "gemini-3.1-flash-live-preview",
      "SessionMinutes": 10,
      "MaxOutputTokens": 512,
      "EndOfSpeechSilenceMs": 400,
      "ThinkingBudget": 0
    }
  },
  "AiChatbot": {
    "QuestionsPerMinute": 10,
    "Gemini": {
      "Enabled": false,
      "AnswerModel": "gemini-3.1-flash-lite",
      "EmbeddingModel": "gemini-embedding-001",
      "EmbeddingDimensions": 768,
      "RequestsPerHour": 60,
      "TimeoutSeconds": 30
    }
  },
  "Communication": {
    "EmergencyCalls": {
      "StunUrls": ["stun:stun.l.google.com:19302"],
      "TurnUrls": [],
      "TurnCredentialLifetimeSeconds": 600
    }
  },
  "RemoteOnlineSign": {
    "SignaturePayloadCleanup": {
      "Enabled": true
    }
  },
  "AllowedHosts": "*"
}
