{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cloudinary": {
    "ServiceRequestFolder": "propflow/service-request-evidence",
    "MaintenanceFolder": "propflow/maintenance-evidence"
  },
  "Payments": {
    "SePay": {
      "Enabled": false,
      "AuthenticationMode": "API_KEY",
      "WebhookPublicBaseUrl": "",
      "Gateway": "",
      "BankCode": "",
      "OAuth": {
        "Enabled": false,
        "ClientId": "",
        "RedirectUri": "https://localhost:7201/admin/sepay/callback"
      }
    }
  },
  "AiChatbot": {
    "QuestionsPerMinute": 10,
    "OpenAI": {
      "Enabled": false,
      "AnswerModel": "gpt-4.1-mini",
      "EmbeddingModel": "text-embedding-3-small",
      "EmbeddingDimensions": 512,
      "RequestsPerHour": 60,
      "TimeoutSeconds": 30
    }
  },
  "AllowedHosts": "*"
}
