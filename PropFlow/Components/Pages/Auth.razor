@page "/"
@page "/auth"
@layout PropFlow.Components.Layout.EmptyLayout
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<div class="bg-background font-body-md text-on-surface w-full min-h-screen">
    <header class="fixed top-0 w-full z-50 bg-surface/10 backdrop-blur-md">
        <div class="h-14 w-full px-margin-edge flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span class="text-primary-fixed font-headline-lg text-label-caps tracking-[0.2em] uppercase">Aetheris</span>
                <div class="h-px w-8 bg-primary/30"></div>
                <span class="text-on-surface-variant font-label-caps text-label-caps">Control System</span>
            </div>
            <div class="flex items-center gap-gutter">
                <a class="text-label-caps font-label-caps text-on-surface-variant hover:text-primary transition-colors" href="#">System Status</a>
                <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
                </div>
            </div>
        </div>
    </header>
    <main class="w-full min-h-screen pt-14 bg-surface-container-lowest relative">
        <!-- 3D Background Container -->
        <div class="absolute inset-0 z-0 pointer-events-none opacity-100" id="threejs-bg"><canvas height="640" style="display: block; width: 1280px; height: 1024px;" width="800"></canvas></div>
        <div class="flex flex-col w-full h-[calc(100vh-56px)] relative overflow-hidden">
            <div class="relative z-10 w-full h-full flex items-center justify-center p-gutter">
                <div class="relative w-full max-w-[1200px] h-[700px] backdrop-blur-[2px] rounded-[2rem] shadow-[0_0_50px_rgba(0,0,0,0.5),0_0_20px_rgba(0,242,255,0.15)] overflow-hidden flex transition-all duration-700 ease-in-out border border-primary/30 bg-[#10141a]/20" id="auth-container">
                    <!-- Left Panel -->
                    <div class="w-1/2 h-full relative flex flex-col justify-center p-[60px] transition-transform duration-700 ease-in-out transform translate-x-0" id="left-panel">
                        <!-- Welcome Content (Visible in Login State) -->
                        <div class="absolute inset-0 p-[60px] flex flex-col justify-center transition-opacity duration-500 opacity-100 z-10 pointer-events-auto" id="welcome-content-left">
                            <div class="inline-flex items-center gap-2 mb-8 bg-primary/10 px-4 py-2 rounded-full border border-primary/20">
                                <div class="w-2 h-2 rounded-full bg-primary animate-pulse shadow-[0_0_8px_theme(colors.primary)]"></div>
                                <span class="font-label-caps text-label-caps text-primary tracking-widest uppercase">System Status: Optimal</span>
                            </div>
                            <h1 class="font-display-lg text-display-lg text-white mb-6 font-bold leading-tight drop-shadow-md">
                                AETHERIS<br />
                                <span class="text-primary bg-clip-text text-transparent bg-gradient-to-r from-primary to-secondary">CONTROL</span>
                            </h1>
                            <p class="font-body-md text-body-md text-white/90 max-w-md border-l-2 border-primary/30 pl-4 py-1" id="left-desc-text">
                                Establish neural link to manage your global infrastructure. Secure, predictive, and absolute.
                            </p>
                        </div>
                        <!-- Register Form (Visible in Register State) -->
                        <div class="absolute inset-0 p-[60px] flex flex-col justify-center transition-opacity duration-500 opacity-0 z-0 pointer-events-none" id="register-form-left">
                            <h2 class="font-headline-lg text-headline-lg text-white mb-2">New Uplink</h2>
                            <p class="font-body-md text-body-md text-white/90 mb-8">Register identity protocol.</p>
                            <form class="flex flex-col gap-6" onsubmit="event.preventDefault();">
                                <div class="flex flex-col gap-2 relative group">
                                    <label class="font-label-caps text-label-caps text-white/80 uppercase tracking-widest group-focus-within:text-primary transition-colors">Designation</label>
                                    <div class="relative">
                                        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-white/50 group-focus-within:text-primary transition-colors text-[20px]">badge</span>
                                        <input class="w-full bg-black/20 border-b border-white/20 text-white font-mono-data py-3 pl-12 pr-4 focus:outline-none focus:border-primary focus:bg-black/40 transition-all hover:bg-black/30 placeholder-white/30" placeholder="Operator Name" type="text" />
                                    </div>
                                </div>
                                <div class="flex flex-col gap-2 relative group">
                                    <label class="font-label-caps text-label-caps text-white/80 uppercase tracking-widest group-focus-within:text-primary transition-colors">Comms Link</label>
                                    <div class="relative">
                                        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-white/50 group-focus-within:text-primary transition-colors text-[20px]">mail</span>
                                        <input class="w-full bg-black/20 border-b border-white/20 text-white font-mono-data py-3 pl-12 pr-4 focus:outline-none focus:border-primary focus:bg-black/40 transition-all hover:bg-black/30 placeholder-white/30" placeholder="operator@aetheris.net" type="email" />
                                    </div>
                                </div>
                                <div class="flex flex-col gap-2 relative group">
                                    <label class="font-label-caps text-label-caps text-white/80 uppercase tracking-widest group-focus-within:text-primary transition-colors">Security Key</label>
                                    <div class="relative">
                                        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-white/50 group-focus-within:text-primary transition-colors text-[20px]">lock_reset</span>
                                        <input class="w-full bg-black/20 border-b border-white/20 text-white font-mono-data py-3 pl-12 pr-4 focus:outline-none focus:border-primary focus:bg-black/40 transition-all hover:bg-black/30 placeholder-white/30" placeholder="••••••••" type="password" />
                                    </div>
                                </div>
                                <button class="mt-4 w-full bg-primary text-on-primary font-label-caps text-label-caps uppercase tracking-widest py-4 rounded hover:bg-white hover:text-surface-lowest transition-all shadow-[0_0_20px_rgba(0,242,255,0.2)] hover:shadow-[0_0_30px_rgba(0,242,255,0.5)] flex items-center justify-center gap-2" type="submit">
                                    <span class="">Initialize Identity</span>
                                    <span class="material-symbols-outlined text-[18px]">rocket_launch</span>
                                </button>
                            </form>
                            <div class="mt-8 text-center">
                                <button class="font-label-caps text-label-caps text-white/80 hover:text-primary transition-colors uppercase tracking-widest" onclick="toggleAuthMode()">
                                    Return to Login
                                </button>
                            </div>
                        </div>
                    </div>
                    <!-- Right Panel -->
                    <div class="w-1/2 h-full relative flex flex-col justify-center p-[60px] transition-transform duration-700 ease-in-out transform translate-x-0 overflow-hidden" id="right-panel">
                        <!-- Login Form (Visible in Login State) -->
                        <div class="absolute inset-0 p-[60px] flex flex-col justify-center transition-all duration-500 opacity-100 translate-x-0 z-10 pointer-events-auto" id="login-form-right">
                            <h2 class="font-headline-lg text-headline-lg text-white mb-2">System Access</h2>
                            <p class="font-body-md text-body-md text-white/90 mb-12">Authenticate via verified terminal.</p>
                            <form class="flex flex-col gap-6" onsubmit="event.preventDefault();">
                                <div class="flex flex-col gap-2 relative group">
                                    <label class="font-label-caps text-label-caps text-white/80 uppercase tracking-widest group-focus-within:text-primary transition-colors">Node ID</label>
                                    <div class="relative">
                                        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-white/50 group-focus-within:text-primary transition-colors text-[20px]">dns</span>
                                        <input class="w-full bg-black/20 border-b border-white/20 text-white font-mono-data py-4 pl-12 pr-4 focus:outline-none focus:border-primary focus:bg-black/40 transition-all hover:bg-black/30 placeholder-white/30" placeholder="ND-8492-AX" type="text" />
                                    </div>
                                </div>
                                <div class="flex flex-col gap-2 relative group">
                                    <div class="flex justify-between items-center">
                                        <label class="font-label-caps text-label-caps text-white/80 uppercase tracking-widest group-focus-within:text-primary transition-colors">Access Key</label>
                                        <button class="font-label-caps text-[10px] text-white/70 hover:text-primary transition-colors uppercase tracking-widest focus:outline-none" onclick="showForgotPassword()" type="button">Forgot Key?</button>
                                    </div>
                                    <div class="relative">
                                        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-white/50 group-focus-within:text-primary transition-colors text-[20px]">key</span>
                                        <input class="w-full bg-black/20 border-b border-white/20 text-white font-mono-data py-4 pl-12 pr-4 focus:outline-none focus:border-primary focus:bg-black/40 transition-all hover:bg-black/30 placeholder-white/30" placeholder="••••••••" type="password" />
                                    </div>
                                </div>
                                <button class="mt-8 w-full bg-primary text-on-primary font-label-caps text-label-caps uppercase tracking-widest py-4 rounded hover:bg-white hover:text-surface-lowest transition-all shadow-[0_0_20px_rgba(0,242,255,0.2)] hover:shadow-[0_0_30px_rgba(0,242,255,0.4)] flex items-center justify-center gap-2" type="submit">
                                    <span class="">Authorize Access</span>
                                    <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                                </button>
                            </form>
                            <div class="mt-12 text-center border-t border-white/20 pt-6">
                                <span class="font-label-caps text-[11px] text-white/70 uppercase tracking-widest mr-2">Unregistered Node?</span>
                                <button class="font-label-caps text-label-caps text-primary hover:text-white transition-colors uppercase tracking-widest" onclick="toggleAuthMode()">
                                    Initialize New
                                </button>
                            </div>
                        </div>
                        <!-- Forgot Key / Password Recovery Form -->
                        <div class="absolute inset-0 p-[60px] flex flex-col justify-center transition-all duration-500 opacity-0 translate-x-8 z-0 pointer-events-none" id="forgot-form-right">
                            <div class="inline-flex items-center gap-2 mb-3 self-start bg-primary/10 px-3 py-1 rounded-full border border-primary/20">
                                <span class="material-symbols-outlined text-primary text-[14px]">vpn_key_alert</span>
                                <span class="font-label-caps text-[11px] text-primary tracking-widest uppercase">Protocol: Recovery</span>
                            </div>
                            <h2 class="font-headline-lg text-headline-lg text-white mb-2">Khôi Phục Mật Khẩu</h2>
                            <p class="font-body-md text-[14px] leading-relaxed text-white/90 mb-8 border-l-2 border-primary/30 pl-3">
                                Nhập địa chỉ Email đăng ký để nhận mã OTP khôi phục quyền truy cập.
                            </p>
                            <form class="flex flex-col gap-6" onsubmit="event.preventDefault(); handleForgotSubmit();">
                                <div class="flex flex-col gap-2 relative group">
                                    <label class="font-label-caps text-label-caps text-white/80 uppercase tracking-widest group-focus-within:text-primary transition-colors">ĐỊA CHỈ EMAIL / REGISTERED EMAIL</label>
                                    <div class="relative">
                                        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-white/50 group-focus-within:text-primary transition-colors text-[20px]">mail</span>
                                        <input class="w-full bg-black/20 border-b border-white/20 text-white font-mono-data py-4 pl-12 pr-4 focus:outline-none focus:border-primary focus:bg-black/40 transition-all hover:bg-black/30 placeholder-white/30" placeholder="resident@aetheris.control" required="" type="email" />
                                    </div>
                                </div>
                                <button class="mt-4 w-full bg-primary text-on-primary font-label-caps text-label-caps uppercase tracking-widest py-4 rounded hover:bg-white hover:text-surface-lowest transition-all shadow-[0_0_20px_rgba(0,242,255,0.25)] hover:shadow-[0_0_30px_rgba(0,242,255,0.5)] flex items-center justify-center gap-2 group" type="submit">
                                    <span class="font-semibold tracking-wider">GỬI MÃ XÁC THỰC OTP →</span>
                                    <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">send</span>
                                </button>
                            </form>
                            <div class="mt-10 text-center border-t border-white/20 pt-6">
                                <button class="inline-flex items-center gap-2 font-label-caps text-label-caps text-white/80 hover:text-primary transition-colors uppercase tracking-widest group focus:outline-none" onclick="hideForgotPassword()" type="button">
                                    <span class="material-symbols-outlined text-[16px] group-hover:-translate-x-1 transition-transform">arrow_back</span>
                                    <span>Quay lại đăng nhập</span>
                                </button>
                            </div>
                        </div>
                        <!-- Welcome Content (Visible in Register State) -->
                        <div class="absolute inset-0 p-[60px] flex flex-col justify-center items-end text-right transition-opacity duration-500 opacity-0 z-0 pointer-events-none" id="welcome-content-right">
                            <div class="inline-flex items-center gap-2 mb-8 bg-secondary/10 px-4 py-2 rounded-full border border-secondary/20">
                                <span class="font-label-caps text-label-caps text-secondary tracking-widest uppercase">Network Integration</span>
                                <div class="w-2 h-2 rounded-full bg-secondary animate-pulse shadow-[0_0_8px_theme(colors.secondary)]"></div>
                            </div>
                            <h1 class="font-display-lg text-display-lg text-white mb-6 font-bold leading-tight drop-shadow-md">
                                JOIN THE<br />
                                <span class="text-secondary bg-clip-text text-transparent bg-gradient-to-l from-secondary to-primary">NEXUS</span>
                            </h1>
                            <p class="font-body-md text-body-md text-white/90 max-w-md border-r-2 border-secondary/30 pr-4 py-1">
                                Expand the grid. Your computational resources will strengthen the collective capability of Aetheris.
                            </p>
                        </div>
                    </div>
                    <!-- Center Divider Line -->
                    <div class="absolute left-1/2 top-[10%] bottom-[10%] w-px bg-gradient-to-b from-transparent via-white/30 to-transparent pointer-events-none z-20"></div><div class="absolute top-3 left-3 w-4 h-4 border-t-2 border-l-2 border-primary/60 pointer-events-none z-20"></div><div class="absolute top-3 right-3 w-4 h-4 border-t-2 border-r-2 border-primary/60 pointer-events-none z-20"></div><div class="absolute bottom-3 left-3 w-4 h-4 border-b-2 border-l-2 border-primary/60 pointer-events-none z-20"></div><div class="absolute bottom-3 right-3 w-4 h-4 border-b-2 border-r-2 border-primary/60 pointer-events-none z-20"></div>
                </div>
            </div>
        </div>
    </main>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("initThreeJsBackground");
        }
    }
}