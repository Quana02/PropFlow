@page "/resident"
@layout PropFlow.Components.Layout.EmptyLayout
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<div class="resident-root h-full font-sans antialiased text-slate-800 dark:text-slate-100 flex flex-col justify-between selection:bg-sky-500 selection:text-white relative select-none sm:select-auto overflow-x-hidden">

    <!-- Aurora Orbs -->
    <div class="aurora-orb orb-1"></div>
    <div class="aurora-orb orb-2"></div>
    <div class="aurora-orb orb-3"></div>

    <!-- Interactive Ambient Canvas -->
    <canvas id="ambientCanvas"></canvas>

    <!-- ================================================================= -->
    <!-- MAIN CONTAINER                                                     -->
    <!-- ================================================================= -->
    <div class="relative z-10 min-h-screen w-full flex flex-col justify-between overflow-x-hidden p-4 sm:p-6 lg:p-8">

        <!-- ===== TOP NAVIGATION ===== -->
        <header class="w-full max-w-7xl mx-auto flex items-center justify-between z-30 mb-4 sm:mb-6">
            <!-- Left: Logo & Apartment -->
            <div class="flex items-center space-x-3 sm:space-x-4">
                <div class="flex items-center space-x-3 glass-panel px-4 py-2.5 rounded-2xl shadow-card dark:shadow-card-dark transition-transform hover:scale-[1.01]">
                    <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-sky-600 via-sky-500 to-indigo-600 flex items-center justify-center text-white font-display font-bold text-lg shadow-md shadow-sky-500/25">P</div>
                    <div>
                        <div class="flex items-center space-x-2">
                            <span class="font-display font-bold tracking-tight text-slate-900 dark:text-white text-base">PropFlow</span>
                            <span class="text-[11px] font-semibold uppercase tracking-wider bg-sky-100 dark:bg-sky-950/80 text-sky-700 dark:text-cyan-300 px-2 py-0.5 rounded-full border border-sky-200/50 dark:border-cyan-800/60">Resident</span>
                        </div>
                        <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">Tháp Landmark • Căn hộ P.1804</p>
                    </div>
                </div>
            </div>

            <!-- Right: Weather, Theme Toggle, Profile -->
            <div class="flex items-center space-x-3">
                <!-- Weather Widget -->
                <div class="hidden md:flex items-center space-x-3 glass-panel px-4 py-2 rounded-2xl shadow-card dark:shadow-card-dark">
                    <div class="text-amber-500 dark:text-amber-400">
                        <svg class="w-6 h-6 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
                        </svg>
                    </div>
                    <div>
                        <div class="flex items-center space-x-1.5 leading-none">
                            <span class="font-display font-bold text-slate-900 dark:text-white text-sm">26°C</span>
                            <span class="text-xs text-slate-500 dark:text-slate-400">• Trời quang</span>
                        </div>
                        <span class="text-[11px] text-slate-400 dark:text-slate-500">TP. Hồ Chí Minh</span>
                    </div>
                </div>

                <!-- Theme Toggle -->
                <button class="relative z-50 cursor-pointer glass-panel p-2.5 rounded-2xl shadow-card dark:shadow-card-dark text-slate-700 dark:text-amber-300 hover:text-sky-600 dark:hover:text-amber-200 transition-all duration-300 transform active:scale-90 hover:scale-105 focus:outline-none overflow-hidden group border border-white/80 dark:border-cyan-500/40 dark:bg-slate-900/80" id="theme-toggle-btn" onclick="toggleTheme(event)" title="Chuyển đổi chế độ Sáng / Tối" type="button">
                    <div class="transition-all duration-300 transform flex items-center justify-center" id="sunWrapper">
                        <svg class="w-5 h-5 text-amber-500 transition-transform duration-300 group-hover:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="4" stroke-width="2"/>
                            <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41m14.14-14.14l-1.41 1.41" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
                        </svg>
                    </div>
                    <div class="absolute inset-0 flex items-center justify-center transition-all duration-300 transform opacity-0 scale-50 rotate-90" id="moonWrapper">
                        <svg class="w-5 h-5 text-cyan-300 transition-transform duration-300 group-hover:-rotate-12" fill="currentColor" stroke="none" viewBox="0 0 24 24">
                            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                        </svg>
                    </div>
                </button>

                <!-- Profile Dropdown -->
                <div class="relative">
                    <button class="glass-panel flex items-center space-x-3 p-1.5 pr-3 rounded-2xl shadow-card dark:shadow-card-dark hover:border-sky-300 dark:hover:border-cyan-500/50 transition-all duration-300 focus:outline-none" id="profileDropdownBtn" type="button">
                        <div class="relative">
                            <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-sky-400 to-indigo-600 flex items-center justify-center text-white font-bold text-sm shadow-inner ring-2 ring-white/80 dark:ring-slate-700">HN</div>
                            <span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 bg-emerald-500 border-2 border-white dark:border-slate-800 rounded-full animate-pulse"></span>
                        </div>
                        <div class="text-left hidden sm:block">
                            <div class="text-xs font-bold text-slate-800 dark:text-slate-100 leading-tight">Nguyễn Hoàng Nam</div>
                            <div class="text-[11px] text-slate-400 dark:text-slate-400">P.1804 • Chủ hộ</div>
                        </div>
                        <svg class="w-4 h-4 text-slate-400 transition-transform duration-300" fill="none" id="dropdownArrow" stroke="currentColor" viewBox="0 0 24 24">
                            <path d="M19 9l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
                        </svg>
                    </button>

                    <!-- Dropdown Popover -->
                    <div class="hidden absolute right-0 mt-3 w-80 glass-panel rounded-3xl p-5 shadow-2xl z-50 transition-all transform origin-top-right border border-white/80 dark:border-slate-700/60" id="profilePopover">
                        <div class="flex items-center space-x-3.5 pb-4 border-b border-slate-200/60 dark:border-slate-700/50">
                            <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-sky-500 to-indigo-600 flex items-center justify-center text-white font-bold text-lg ring-4 ring-sky-100 dark:ring-sky-950">HN</div>
                            <div>
                                <h4 class="font-bold text-slate-900 dark:text-white text-base">Nguyễn Hoàng Nam</h4>
                                <p class="text-xs text-slate-500 dark:text-slate-400">Căn hộ P.1804 • Tháp Park View</p>
                                <span class="inline-block mt-1 text-[10px] uppercase font-semibold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 px-2 py-0.5 rounded-full border border-emerald-200 dark:border-emerald-800/40">Cư dân chính thức</span>
                            </div>
                        </div>
                        <div class="py-4 space-y-3">
                            <div class="flex justify-between items-center bg-slate-100/70 dark:bg-slate-800/50 p-3 rounded-2xl">
                                <div>
                                    <span class="text-xs text-slate-500 dark:text-slate-400 block">Số dư ví dịch vụ</span>
                                    <span class="font-display font-bold text-slate-900 dark:text-white text-base">12.500.000 đ</span>
                                </div>
                                <button class="text-xs font-semibold text-sky-600 dark:text-cyan-400 hover:underline">Nạp tiền</button>
                            </div>
                            <div class="bg-amber-500/10 border border-amber-500/20 p-3 rounded-2xl flex items-center justify-between">
                                <div>
                                    <span class="text-xs font-medium text-amber-700 dark:text-amber-300 block">Phí quản lý cần thanh toán</span>
                                    <span class="font-display font-bold text-amber-900 dark:text-amber-200 text-sm">1.850.000 đ</span>
                                </div>
                                <button class="px-3 py-1.5 text-xs font-semibold bg-amber-500 text-white rounded-xl shadow hover:bg-amber-600 transition-colors">Thanh toán ngay</button>
                            </div>
                        </div>
                        <div class="pt-2 border-t border-slate-200/60 dark:border-slate-700/50 space-y-1">
                            <button class="w-full flex items-center space-x-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-100/80 dark:hover:bg-slate-800/70 transition-colors text-left" id="openProfileModalBtn">
                                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
                                </svg>
                                <span>Hồ sơ cá nhân &amp; Xe đăng ký</span>
                            </button>
                            <button class="w-full flex items-center space-x-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors text-left">
                                <svg class="w-4 h-4 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
                                </svg>
                                <span>Đăng xuất khỏi thiết bị</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </header>
        <!-- ===== END TOP NAVIGATION ===== -->

        <!-- ===== HERO AREA ===== -->
        <main class="w-full max-w-7xl mx-auto flex-1 flex flex-col justify-center my-2 sm:my-4 z-20">
            <div class="flex flex-col items-center text-center">
                <!-- Greeting Capsule -->
                <div class="inline-flex items-center space-x-2 glass-panel px-4 py-1.5 rounded-full shadow-sm mb-4 border border-white/70 dark:border-cyan-500/25 animate-float-subtle">
                    <span class="text-sm">👋</span>
                    <span class="text-xs sm:text-sm font-semibold text-slate-700 dark:text-slate-200">Xin chào buổi sáng, Anh Nam</span>
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span>
                </div>

                <!-- Digital Clock -->
                <div class="flex items-baseline justify-center select-none animate-float-subtle">
                    <span class="font-display font-semibold text-6xl sm:text-7xl md:text-8xl tracking-tight text-slate-900 dark:text-white drop-shadow-sm transition-all" id="clockTime">11:11</span>
                    <span class="ml-3 font-display font-medium text-lg sm:text-2xl text-slate-500 dark:text-cyan-400" id="clockPeriod">AM</span>
                </div>
                <p class="mt-2 text-sm sm:text-base font-medium text-slate-500 dark:text-slate-400" id="clockDate">Đang tải...</p>

                <!-- Search Bar -->
                <div class="w-full max-w-2xl mt-7 px-2">
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none text-slate-400 group-focus-within:text-sky-500 dark:group-focus-within:text-cyan-400 transition-colors">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
                            </svg>
                        </div>
                        <input class="w-full pl-12 pr-16 py-4 glass-panel rounded-full text-slate-800 dark:text-white placeholder-slate-400 dark:placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-sky-400/40 dark:focus:ring-cyan-400/40 border border-white/80 dark:border-cyan-500/30 transition-all duration-300" placeholder="Tìm kiếm dịch vụ, tiện ích, hóa đơn, thông báo... (Ctrl + K)" type="text"/>
                        <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                            <kbd class="hidden sm:inline-block px-2.5 py-1 text-[11px] font-semibold text-slate-400 dark:text-slate-300 bg-white/70 dark:bg-slate-800/80 rounded-lg border border-slate-200 dark:border-slate-700 shadow-sm">⌘K</kbd>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ===== TAB CONTENT ===== -->
            <div class="w-full mt-10 transition-all duration-300">

                <!-- TAB HOME -->
                <div class="tab-pane block" id="tabHomeContent">
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-stretch">

                        <!-- CARD 1: Request Status -->
                        <section class="glass-panel rounded-3xl p-6 shadow-card dark:shadow-card-dark flex flex-col justify-between border border-white/70 dark:border-cyan-500/20 transition-all hover:shadow-2xl hover:border-sky-200 dark:hover:border-cyan-500/40">
                            <div>
                                <div class="flex items-center justify-between mb-4">
                                    <div>
                                        <h3 class="font-display font-bold text-base text-slate-900 dark:text-white">Tiến độ xử lý yêu cầu</h3>
                                        <p class="text-xs text-slate-400 mt-0.5">Cập nhật thời gian thực</p>
                                    </div>
                                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-sky-100 text-sky-700 dark:bg-cyan-950/80 dark:text-cyan-300 border border-sky-200/50 dark:border-cyan-800/60">Đã xong 2 / 5</span>
                                </div>
                                <div class="w-full bg-slate-200/70 dark:bg-slate-800 rounded-full h-2 mb-5 overflow-hidden">
                                    <div class="bg-gradient-to-r from-sky-500 to-indigo-500 dark:from-cyan-400 dark:to-sky-500 h-2 rounded-full transition-all duration-500" style="width: 40%"></div>
                                </div>
                                <div class="space-y-3">
                                    <div class="glass-inner p-3 rounded-2xl group cursor-pointer">
                                        <div class="flex items-start justify-between">
                                            <h5 class="text-xs font-bold text-slate-800 dark:text-slate-100 group-hover:text-sky-600 dark:group-hover:text-cyan-400 transition-colors line-clamp-1">Sửa cấp nước phòng tắm Master</h5>
                                            <span class="ml-2 text-[10px] font-semibold px-2 py-0.5 rounded-md bg-amber-100 text-amber-800 dark:bg-amber-950/80 dark:text-amber-300 whitespace-nowrap">Đang xử lý</span>
                                        </div>
                                        <div class="flex items-center justify-between mt-2 text-[11px] text-slate-500 dark:text-slate-400">
                                            <span>KTV: Lê Minh Tuấn</span>
                                            <span class="font-medium text-slate-400">10:30 Hôm nay</span>
                                        </div>
                                    </div>
                                    <div class="glass-inner p-3 rounded-2xl group cursor-pointer">
                                        <div class="flex items-start justify-between">
                                            <h5 class="text-xs font-bold text-slate-800 dark:text-slate-100 group-hover:text-sky-600 dark:group-hover:text-cyan-400 transition-colors line-clamp-1">Kiểm tra aptomat &amp; nguồn phòng khách</h5>
                                            <span class="ml-2 text-[10px] font-semibold px-2 py-0.5 rounded-md bg-blue-100 text-blue-800 dark:bg-blue-950/80 dark:text-blue-300 whitespace-nowrap">Chờ tiếp nhận</span>
                                        </div>
                                        <div class="flex items-center justify-between mt-2 text-[11px] text-slate-500 dark:text-slate-400">
                                            <span>Mã phiếu: #YC-8942</span>
                                            <span class="font-medium text-slate-400">08:15 Sáng nay</span>
                                        </div>
                                    </div>
                                    <div class="glass-inner p-3 rounded-2xl group cursor-pointer opacity-90">
                                        <div class="flex items-start justify-between">
                                            <h5 class="text-xs font-bold text-slate-800 dark:text-slate-100 group-hover:text-sky-600 dark:group-hover:text-cyan-400 transition-colors line-clamp-1">Hỗ trợ vệ sinh công nghiệp căn hộ</h5>
                                            <span class="ml-2 text-[10px] font-semibold px-2 py-0.5 rounded-md bg-emerald-100 text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-300 whitespace-nowrap">Đã xong ★ 5.0</span>
                                        </div>
                                        <div class="flex items-center justify-between mt-2 text-[11px] text-slate-500 dark:text-slate-400">
                                            <span>Đội Vệ Sinh Tầng 18</span>
                                            <span class="font-medium text-slate-400">Hôm qua</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-5 pt-4 border-t border-slate-200/50 dark:border-slate-800/80 flex items-center justify-between">
                                <button class="text-xs font-semibold text-sky-600 dark:text-cyan-400 hover:underline flex items-center space-x-1" onclick="switchTab('processing')">
                                    <span>Xem tất cả 5 yêu cầu</span>
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
                                </button>
                                <button class="px-3.5 py-1.5 text-xs font-semibold rounded-xl bg-slate-900 text-white dark:bg-cyan-400 dark:text-slate-950 hover:opacity-90 transition-opacity shadow-sm flex items-center space-x-1">
                                    <span>+ Tạo yêu cầu mới</span>
                                </button>
                            </div>
                        </section>

                        <!-- CARD 2: Services Catalog -->
                        <section class="glass-panel rounded-3xl p-6 shadow-card dark:shadow-card-dark flex flex-col justify-between border border-white/70 dark:border-cyan-500/20 transition-all hover:shadow-2xl hover:border-sky-200 dark:hover:border-cyan-500/40">
                            <div>
                                <div class="flex items-center justify-between mb-4">
                                    <div>
                                        <h3 class="font-display font-bold text-base text-slate-900 dark:text-white">Danh mục dịch vụ căn hộ</h3>
                                        <p class="text-xs text-slate-400 mt-0.5">Tiện ích cư dân 1 chạm</p>
                                    </div>
                                    <span class="text-xs font-medium text-slate-500 dark:text-slate-300 bg-slate-100 dark:bg-slate-800/80 px-2.5 py-1 rounded-full border border-slate-200/50 dark:border-slate-700/60">8 Dịch vụ</span>
                                </div>
                                <div class="grid grid-cols-4 gap-3 py-1">
                                    @foreach (var svc in _services)
                                    {
                                        <button class="service-btn flex flex-col items-center justify-center p-3 rounded-2xl glass-inner hover:scale-105 active:scale-95 group text-center cursor-pointer transition-all duration-300">
                                            <div class="service-icon w-10 h-10 rounded-xl @svc.BgClass flex items-center justify-center text-lg mb-2 transition-transform duration-300">@svc.Icon</div>
                                            <span class="text-[11px] font-semibold text-slate-700 dark:text-slate-200 line-clamp-1">@svc.Label</span>
                                        </button>
                                    }
                                </div>
                            </div>
                            <div class="mt-5 pt-4 border-t border-slate-200/50 dark:border-slate-800/80 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
                                <span class="flex items-center space-x-1.5">
                                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                                    <span>Tổng đài hỗ trợ trực tuyến 24/7</span>
                                </span>
                                <span class="font-semibold text-sky-600 dark:text-cyan-400">1900 8899</span>
                            </div>
                        </section>

                        <!-- CARD 3: Announcements -->
                        <section class="glass-panel rounded-3xl p-6 shadow-card dark:shadow-card-dark flex flex-col justify-between border border-white/70 dark:border-cyan-500/20 transition-all hover:shadow-2xl hover:border-sky-200 dark:hover:border-cyan-500/40">
                            <div>
                                <div class="flex items-center justify-between mb-4">
                                    <div>
                                        <h3 class="font-display font-bold text-base text-slate-900 dark:text-white">Thông báo ban quản lý</h3>
                                        <p class="text-xs text-slate-400 mt-0.5">Bản tin cư dân tòa nhà</p>
                                    </div>
                                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-rose-100 text-rose-700 dark:bg-rose-950/80 dark:text-rose-300 border border-rose-200/50 dark:border-rose-800/60">3 tin mới</span>
                                </div>
                                <div class="space-y-3">
                                    <div class="glass-inner p-3 rounded-2xl group cursor-pointer">
                                        <div class="flex items-center justify-between text-[11px] text-slate-400 mb-1">
                                            <span class="font-bold text-rose-600 dark:text-rose-400 flex items-center space-x-1">
                                                <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                                                <span>[Quan trọng]</span>
                                            </span>
                                            <span>20 phút trước</span>
                                        </div>
                                        <h5 class="text-xs font-bold text-slate-800 dark:text-slate-100 group-hover:text-sky-600 dark:group-hover:text-cyan-400 transition-colors line-clamp-1">Bảo trì hệ thống thang máy Tháp B 13:00 – 15:00</h5>
                                        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1 line-clamp-1">Kính đề nghị cư dân sử dụng thang hàng hoặc thang Tháp A...</p>
                                    </div>
                                    <div class="glass-inner p-3 rounded-2xl group cursor-pointer">
                                        <div class="flex items-center justify-between text-[11px] text-slate-400 mb-1">
                                            <span class="font-bold text-sky-600 dark:text-cyan-400 flex items-center space-x-1">
                                                <span class="w-1.5 h-1.5 rounded-full bg-sky-500 dark:bg-cyan-400"></span>
                                                <span>[Tài chính]</span>
                                            </span>
                                            <span>2 giờ trước</span>
                                        </div>
                                        <h5 class="text-xs font-bold text-slate-800 dark:text-slate-100 group-hover:text-sky-600 dark:group-hover:text-cyan-400 transition-colors line-clamp-1">Nhắc nhở quyết toán phí dịch vụ tháng 10/2024</h5>
                                        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1 line-clamp-1">Hạn chót thanh toán ngày 30/10 để đảm bảo các dịch vụ...</p>
                                    </div>
                                    <div class="glass-inner p-3 rounded-2xl group cursor-pointer opacity-90">
                                        <div class="flex items-center justify-between text-[11px] text-slate-400 mb-1">
                                            <span class="font-medium text-slate-500 dark:text-slate-400 flex items-center space-x-1">
                                                <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                                                <span>[Kế hoạch]</span>
                                            </span>
                                            <span>Hôm qua</span>
                                        </div>
