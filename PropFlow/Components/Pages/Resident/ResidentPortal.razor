                    <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-sky-500 to-indigo-600 flex items-center justify-center text-white font-bold text-xl ring-4 ring-sky-100 dark:ring-sky-950">HN</div>
                    <div>
                        <button class="text-xs font-semibold px-3 py-1.5 rounded-xl bg-sky-50 dark:bg-sky-950 text-sky-600 dark:text-cyan-300 border border-sky-200 dark:border-cyan-800 hover:bg-sky-100 transition-colors" type="button">Thay đổi ảnh đại diện</button>
                        <p class="text-[11px] text-slate-400 mt-1">Định dạng PNG, JPG tối đa 5MB</p>
