                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Biển số xe đã đăng ký</label>
                    <input class="w-full px-3.5 py-2.5 rounded-xl glass-inner text-xs sm:text-sm font-medium text-slate-800 dark:text-white focus:ring-2 focus:ring-sky-400 dark:focus:ring-cyan-400 focus:outline-none" type="text" value="30K-888.99 (Ô tô), 29B1-992.88 (Xe máy)"/>
                </div>
                <div class="pt-4 border-t border-slate-200/60 dark:border-slate-700/50 flex items-center justify-end space-x-3">
                    <button class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" onclick="closeProfileModal()" type="button">Hủy bỏ</button>
                    <button class="px-5 py-2 rounded-xl text-xs font-semibold bg-sky-600 dark:bg-cyan-500 dark:text-slate-950 text-white hover:bg-sky-500 shadow-md shadow-sky-500/20 transition-all" type="submit">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

