<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="PropFlow.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
    
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        "colors": {
                            "tertiary": "#fcf5ff",
                            "on-secondary": "#002b75",
                            "surface": "#10141a",
                            "surface-container-lowest": "#0a0e14",
                            "surface-container-low": "#181c22",
                            "secondary-fixed": "#dae1ff",
                            "on-secondary-container": "#f9f7ff",
                            "on-surface": "#dfe2eb",
                            "surface-bright": "#353940",
                            "surface-dim": "#10141a",
                            "inverse-primary": "#00696f",
                            "background": "#10141a",
                            "on-primary-fixed-variant": "#004f54",
                            "on-tertiary-fixed-variant": "#5700c9",
                            "on-tertiary": "#3c0090",
                            "surface-variant": "#31353c",
                            "on-primary-fixed": "#002022",
                            "on-secondary-fixed-variant": "#003fa4",
                            "inverse-surface": "#dfe2eb",
                            "primary-fixed-dim": "#00dbe7",
                            "on-tertiary-fixed": "#23005b",
                            "on-tertiary-container": "#7318ff",
                            "tertiary-fixed": "#e9ddff",
                            "on-error": "#690005",
                            "surface-container-high": "#262a31",
                            "secondary": "#b3c5ff",
                            "primary-fixed": "#74f5ff",
                            "error": "#ffb4ab",
                            "inverse-on-surface": "#2d3137",
                            "on-primary": "#00363a",
                            "outline-variant": "#3a494b",
                            "on-secondary-fixed": "#001849",
                            "primary": "#e1fdff",
                            "primary-container": "#00f2ff",
                            "outline": "#849495",
                            "tertiary-container": "#e3d4ff",
                            "error-container": "#93000a",
                            "surface-container": "#1c2026",
                            "surface-tint": "#00dbe7",
                            "secondary-container": "#0266ff",
                            "tertiary-fixed-dim": "#d1bcff",
                            "on-error-container": "#ffdad6",
                            "on-background": "#dfe2eb",
                            "secondary-fixed-dim": "#b3c5ff",
                            "on-surface-variant": "#b9cacb",
                            "on-primary-container": "#006a71",
                            "surface-container-highest": "#31353c"
                        },
                        "borderRadius": {
                            "DEFAULT": "0.125rem",
                            "lg": "0.25rem",
                            "xl": "0.5rem",
                            "full": "0.75rem"
                        },
                        "spacing": {
                            "unit": "4px",
                            "gutter": "24px",
                            "margin-edge": "40px",
                            "container-gap": "16px"
                        },
                        "fontFamily": {
                            "body-md": ["Inter", "sans-serif"],
                            "headline-lg-mobile": ["Space Grotesk", "sans-serif"],
                            "mono-data": ["Geist", "monospace"],
                            "label-caps": ["Geist", "monospace"],
                            "display-lg": ["Space Grotesk", "sans-serif"],
                            "headline-lg": ["Space Grotesk", "sans-serif"]
                        },
                        "fontSize": {
                            "body-md": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                            "headline-lg-mobile": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                            "mono-data": ["14px", { "lineHeight": "20px", "fontWeight": "500" }],
                            "label-caps": ["12px", { "lineHeight": "16px", "letterSpacing": "0.1em", "fontWeight": "600" }],
                            "display-lg": ["48px", { "lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                            "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "0.01em", "fontWeight": "600" }]
                        }
                    }
                }
            }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&amp;family=Inter:wght@400..700&amp;family=Geist:wght@400..700&amp;family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&amp;family=Inter:wght@100..900&amp;family=Space+Grotesk:wght@100..900&amp;display=swap" rel="stylesheet"/>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="js/auth.js"></script>
    <script src="js/landing.js"></script>
    
    <style type="text/tailwindcss">
        @@layer base {
            html, body {
                margin: 0;
                padding: 0;
                overflow-y: auto;
                scroll-behavior: smooth;
                background-color: #10141a;
                background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
                background-size: 24px 24px;
            }
            body {
                min-height: 100vh;
            }
            main > :first-child {
                margin-top: 0 !important;
            }
            main > :last-child {
                margin-bottom: 0 !important;
            }
        }
        
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(10, 14, 20, 0.7);
        }
        ::-webkit-scrollbar-thumb {
            background: #1c2026;
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #00dbe7;
        }
    </style>
</head>

<body class="bg-background text-on-surface antialiased">
    <Routes />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
